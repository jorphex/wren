    "lint-staged": "13.1.2",
    "nock": "13.3.0",
    "node-abi": "3.33.0",
    "node-watch": "0.7.4",
    "parcel": "2.16.4",
    "prebuild-install": "7.1.3",
    "prettier": "3.9.6",
    "rimraf": "4.4.0",
    "shx": "0.4.0",
    "stylus": "0.64.0",
    "tar-stream": "3.2.0",
    "tree-kill": "1.2.2",
    "typescript": "5.9.3",
