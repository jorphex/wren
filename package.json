{
  "name": "wren",
  "version": "0.1.0",
  "desktopName": "wren.desktop",
  "packageManager": "npm@11.12.0",
  "description": "Desktop EVM wallet and system-wide provider",
  "main": "compiled/main",
  "scripts": {
    "clean": "npx rimraf dist bundle compiled .parcel-cache node_modules",
    "setup:full": "npm run clean && npm cache clean --force && npm run setup:ci",
    "setup:clean": "npm run clean && npm run setup:ci",
    "setup:ci": "node scripts/check-toolchain.mjs && npm ci && npm run setup:scripts",
    "setup:deps": "npm run setup:ci",
    "setup:scripts": "allow-scripts run && npm run setup:electron && npm run setup:native",
    "setup:electron": "install-electron --no",
    "setup:native": "electron-rebuild --force --only node-hid",
    "setup": "npm run setup:ci && husky install",
    "start": "npm run launch",
    "bundle": "npm run bundle:clean && npm run bundle:bridge && npm run bundle:tray && npm run bundle:dash && npm run bundle:dapp && npm run bundle:onboard && npm run bundle:notify && npm run bundle:dapp:inject && npm run bundle:csp && npm run bundle:verify",
    "bundle:clean": "rimraf bundle .parcel-cache",
    "bundle:csp": "node scripts/apply-bundle-csp-nonces.mjs",
    "bundle:verify": "node scripts/verify-bundle.mjs",
    "bundle:bridge": "npm run parcel:build -- --target bridge resources/bridge/index.js",
    "bundle:tray": "npm run parcel:build -- --target tray app/tray/index.html",
    "bundle:dash": "npm run parcel:build -- --target dash app/dash/index.html",
    "bundle:dapp": "npm run parcel:build -- --target dapp app/dapp/index.html",
    "bundle:onboard": "npm run parcel:build -- --target onboard app/onboard/index.html",
    "bundle:notify": "npm run parcel:build -- --target notify app/notify/index.html",
    "bundle:dapp:inject": "npm run parcel:build -- --target inject main/dapps/server/inject/index.js",
    "serve": "npm run bundle:bridge && npm run dev:server & wait-on http://localhost:1234/tray/index.dev.html && npm run compile:watch",
    "dev": "node ./scripts/run-dev.mjs",
    "dev:server": "node ./scripts/bundler.mjs",
    "inspect": "npm run bundle && npm run launch:inspect",
    "launch": "cross-env NODE_ENV=production electron ./compiled/main",
    "launch:dev": "cross-env NODE_ENV=development ELECTRON_DISABLE_SECURITY_WARNINGS=true electron ./compiled/main --inspect",
    "launch:dev:traffic": "cross-env NODE_ENV=development LOG_TRAFFIC=true ELECTRON_DISABLE_SECURITY_WARNINGS=true electron ./compiled/main --inspect",
    "launch:dev:fullheight": "cross-env NODE_ENV=development FULL_HEIGHT=true ELECTRON_DISABLE_SECURITY_WARNINGS=true electron ./compiled/main --inspect",
    "launch:dev:worker": "cross-env NODE_ENV=development LOG_WORKER=true electron ./compiled/main",
    "launch:inspect": "cross-env NODE_ENV=production electron --inspect ./compiled/main",
    "lint": "eslint -c eslint.config.mjs .",
    "lint:fix": "eslint -c eslint.config.mjs --fix .",
    "format": "prettier --write '**/*.{yml,json,md,html,ts,js}'",
    "format:check": "prettier --check '**/*.{yml,json,md,html,ts,js}'",
    "prod": "npm run compile && npm run bundle && npm run launch",
    "compile:clean": "rimraf compiled",
    "compile": "npm run compile:clean && npm run copy-assets && node scripts/verify-tray-icons.mjs && tsc --project tsconfig.build.json && node scripts/write-build-identity.mjs",
    "compile:watch": "npm run compile:clean && npm run copy-assets && tsc --project tsconfig.build.json -w",
    "build": "npm run compile && sleep 4 && npm run bundle && sleep 4 && electron-builder --config=build/electron-builder-standard.js --publish never",
    "package:linux:x64": "node scripts/prepare-linux-package.mjs && electron-builder --config=build/electron-builder-standard.js --linux AppImage deb --x64 --publish never",
    "package:verify:linux": "node scripts/verify-linux-package.mjs",
    "sbom:linux": "node scripts/generate-sbom.mjs dist/wren.cdx.json",
    "sbom:verify:linux": "node scripts/verify-sbom.mjs dist/wren.cdx.json",
    "checksums:linux": "node scripts/write-linux-checksums.mjs",
    "release:verify:linux": "node scripts/verify-linux-release.mjs",
    "copy-assets": "shx mkdir -p ./compiled/main/windows ./compiled/main/yearn && shx cp ./main/windows/*.png ./compiled/main/windows && shx cp ./app/dash/Earn/assets/LICENSE.txt ./compiled/main/yearn/token-assets.LICENSE.txt && shx cp ./app/dash/Earn/assets/SOURCE.txt ./compiled/main/yearn/token-assets.SOURCE.txt",
    "parcel:build": "parcel build --no-autoinstall --public-url .",
    "publish": "node -e \"console.error('Direct publishing is disabled; use the qualified draft-release workflow.'); process.exit(1)\"",
    "publish:linux:arm64": "node -e \"console.error('Direct publishing is disabled; use a reviewed release workflow.'); process.exit(1)\"",
    "release": "node -e \"console.error('Direct releasing is disabled; use the qualified draft-release workflow.'); process.exit(1)\"",
    "test": "npm run test:unit",
    "test:exec": "jest --detectOpenHandles --runInBand",
    "test:unit": "npm run verify:privacy && npm run test:unit:main && npm run test:unit:components && npm run test:unit:resources",
    "test:unit:main": "npm run test:exec -- --env=node ./test/main && npm run test:unixfs",
    "test:unit:resources": "npm run test:exec -- --env=node --roots=test/resources --testPathIgnorePatterns=\\(/Components/ /Hooks/\\)",
    "test:unit:components": "npm run test:exec -- --env=jsdom --roots test/app test/resources/Hooks test/resources/Components --testTimeout=500",
    "test:e2e": "node -e \"console.error('E2E tests are disabled until they use an isolated app profile and ports.'); process.exit(1)\"",
    "test:usbAdapters": "ELECTRON_RUN_AS_NODE=true ./node_modules/.bin/electron ./node_modules/jest/bin/jest.js --runTestsByPath ./test/main/signers/ledger/adapter.test.js --testPathIgnorePatterns='^$'",
    "test:unixfs": "npm run compile && node scripts/test-unixfs.mjs",
    "verify:privacy": "node scripts/verify-no-upstream-telemetry.mjs && node scripts/verify-log-hygiene.mjs && node scripts/verify-independent-runtime.mjs",
    "audit:release": "npm audit --audit-level=high"
  },
  "author": {
    "name": "Jorphex and Wren contributors",
    "email": "jorphex@users.noreply.github.com",
    "url": "https://github.com/jorphex/wren"
  },
  "license": "GPL-3.0",
