.dropdownWrap
  position relative
  display flex
  align-items center
  min-width 0
  height 32px
  color var(--wren-text-primary)

.dropdown
  appearance none
  color-scheme dark
  min-width 130px
  max-width 100%
  height 32px
  padding 0 32px 0 12px
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size 13px
  font-weight 500
  letter-spacing .2px
  text-transform none
  text-overflow ellipsis
  background-color var(--wren-surface-inset)
  background-image linear-gradient(45deg, transparent 50%, var(--wren-text-tertiary) 50%), linear-gradient(135deg, var(--wren-text-tertiary) 50%, transparent 50%)
  background-position calc(100% - 16px) 13px, calc(100% - 11px) 13px
  background-repeat no-repeat
  background-size 5px 5px, 5px 5px
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  box-shadow var(--wren-shadow-inset)
  cursor pointer
  transition background-color var(--wren-motion-fast), border-color var(--wren-motion-fast)

  option
    color var(--wren-text-primary)
    background var(--wren-surface-inset)

  option:checked
    color var(--wren-text-inverse)
    background var(--wren-accent-primary)

  option:hover,
  option:focus
    color var(--wren-text-primary)
    background var(--wren-surface-active)

  &:hover:not(:disabled)
    background-color var(--wren-surface-hover)
    border-color var(--wren-border-strong)

  &:disabled
    opacity .5
    cursor default

.darkerDrop
  background-color var(--wren-surface-card)
