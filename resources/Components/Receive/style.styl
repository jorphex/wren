.receivePanel
  position fixed
  z-index 2147483647
  display flex
  flex-direction column
  align-items center
  gap 16px
  box-sizing border-box
  width 300px
  max-width calc(100vw - 24px)
  max-height calc(100vh - 24px)
  overflow-y auto
  padding 20px
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  background var(--wren-bg-subtle)
  box-shadow var(--wren-shadow-sm)
  color var(--wren-text-primary)

  h2
    margin 0
    font-size 16px

  code
    overflow-wrap anywhere
    text-align center
    font-size 13px
    line-height 20px

  .qrCode
    width 185px
    height 185px

  button
    min-height 44px
    width 100%

.receiveBackdrop
  position fixed
  inset 0
  z-index 2147483646
  backdrop-filter blur(4px)
  background rgba(7, 9, 7, .18)
  pointer-events none
