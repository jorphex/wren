.sliceTileGasPrice
  display flex
  align-items center
  justify-content center
  color var(--wren-text-primary)

  .sliceTileGasPriceIcon
    display flex
    margin-right var(--wren-space-2)

  .sliceTileGasPriceNumber
    margin-right var(--wren-space-1)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-body)
    letter-spacing -.5px

  .sliceTileGasPriceUnit
    margin-top 2px
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    font-weight 450

.gasDetailTiers,
.gasActionEstimates
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))

.gasDetailTiersLegacy
  grid-template-columns minmax(0, 1fr)

.gasDetailStat,
.gasActionEstimate
  display flex
  min-width 0
  min-height 60px
  align-items center
  justify-content center
  box-sizing border-box
  padding var(--wren-space-2)
  flex-direction column
  text-align center

.gasDetailValue,
.gasActionEstimateValue
  overflow hidden
  max-width 100%
  color var(--wren-text-primary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-body)
  text-overflow ellipsis
  white-space nowrap

  small
    margin-left var(--wren-space-1)
    color var(--wren-text-tertiary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-caption)

.gasDetailCaption,
.gasActionEstimateLabel
  overflow hidden
  max-width 100%
  margin-top 3px
  color var(--wren-text-secondary)
  font-size var(--wren-type-caption)
  font-weight 500
  text-overflow ellipsis
  white-space nowrap

.gasActionEstimate
  min-height 52px

.gasMonitorStandaloneToggle
  display flex
  width 100%
  min-height 52px
  align-items center
  justify-content space-between
  box-sizing border-box
  padding 0 var(--wren-space-3)
  border 0
  color var(--wren-text-primary)
  background transparent
  cursor pointer
  font inherit

  &:hover
    background var(--wren-ledger-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset -2px
