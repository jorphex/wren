.wrenToggle
  appearance none
  position relative
  width 44px
  height 44px
  flex 0 0 44px
  padding 0
  color inherit
  border 0
  background transparent
  box-shadow none
  cursor pointer

  &::before
    position absolute
    top 10px
    left 0
    width 44px
    height 24px
    box-sizing border-box
    border 1px solid var(--wren-border-default)
    border-radius 2px
    content ''
    background var(--wren-surface-inset)
    box-shadow var(--wren-shadow-inset)
    transition background var(--wren-motion-fast), border-color var(--wren-motion-fast)

  &:hover:not(:disabled)
    &::before
      border-color var(--wren-border-strong)
      background var(--wren-surface-hover)

  &:active:not(:disabled)
    &::before
      background var(--wren-surface-active)

  &:disabled
    cursor default

    &::before
      opacity .55

    .wrenToggleThumb
      opacity .72

  .wrenToggleThumb
    position absolute
    top 14px
    left 4px
    width 16px
    height 16px
    box-sizing border-box
    border-bottom 2px solid var(--wren-border-strong)
    border-radius 1px
    background var(--wren-text-secondary)
    box-shadow var(--wren-shadow-sm)
    transition transform var(--wren-motion-fast), background var(--wren-motion-fast)

.wrenToggleOn
  &::before
    border-color var(--wren-success)
    background var(--wren-success-soft)

  &:hover:not(:disabled)
    &::before
      border-color var(--wren-accent-secondary-hover)
      background var(--wren-accent-secondary-soft)

  .wrenToggleThumb
    background var(--wren-success)
    transform translateX(20px)

  &:disabled .wrenToggleThumb
    opacity 1
