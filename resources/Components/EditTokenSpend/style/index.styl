.wrenTokenApprovalEditor
  width 100%
  height 100%
  margin 0
  padding var(--wren-space-5)
  box-sizing border-box
  overflow-y auto
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)

.wrenTokenApprovalContext
  display grid
  overflow hidden
  grid-template-columns minmax(0, 1fr)

  > div
    display grid
    min-width 0
    min-height 52px
    padding var(--wren-space-1) 0
    box-sizing border-box
    grid-template-columns var(--wren-review-label-column) minmax(0, 1fr)
    align-items center
    gap var(--wren-space-4)

.wrenTokenApprovalContextLabel
  display block
  margin 0
  color var(--wren-text-muted)
  font-size var(--wren-type-caption)

.wrenTokenApprovalIdentity
  display flex
  min-width 0
  align-items center

  > span
    min-width 0

  strong,
  small
    display block

  strong
    overflow hidden
    font-size var(--wren-type-small)
    font-weight 620
    text-overflow ellipsis
    white-space nowrap

  small
    margin-top 2px
    color var(--wren-text-secondary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

.wrenTokenApprovalAddress
  appearance none
  display flex
  min-width 0
  min-height 44px
  padding 4px 0
  justify-content center
  border 1px solid transparent
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background transparent
  flex-direction column
  cursor pointer
  text-align left

  code
    display block
    max-width 100%
    overflow-wrap anywhere
    font-family var(--wren-font-mono)
    font-size 12px
    line-height 18px

  strong,
  span
    display block
    overflow hidden
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    font-weight 500
    text-overflow ellipsis
    white-space nowrap

  span
    margin-top 2px
    color var(--wren-text-muted)
    font-size 12px

  &:hover
    border-color var(--wren-border-subtle)
    color var(--wren-text-primary)
    background var(--wren-ledger-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.wrenTokenApprovalContext > .wrenTokenApprovalExpiry
  grid-column 1 / -1
  padding var(--wren-space-2) 0

  strong
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    font-weight 560

.wrenTokenApprovalDecision
  padding var(--wren-space-4) 0 0

.wrenTokenApprovalDecisionHeading
  display grid
  min-height 44px
  grid-template-columns var(--wren-review-label-column) minmax(0, 1fr)
  align-items center
  gap var(--wren-space-4)

  > div > span
    display block
    font-size var(--wren-type-small)
    font-weight 620

.wrenTokenApprovalCurrentValue
  display flex
  min-width 0
  min-height 44px
  padding 0
  color var(--wren-text-primary)
  align-items center
  gap 5px

  strong
    font-family var(--wren-font-utility)
    font-size var(--wren-type-body)
    font-weight 600

  span
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)

.wrenTokenApprovalModes
  margin-top var(--wren-space-3)

button.wrenControl.wrenTokenApprovalRevoke
  min-height 44px
  margin var(--wren-space-2) 0 0

  &[aria-pressed='true']:not(:disabled)
    background-color var(--wren-surface-active)
    box-shadow var(--wren-control-shadow-pressed)

.wrenTokenApprovalAmountEditor
  margin-top var(--wren-space-2)

  > label
    display block
    margin-bottom var(--wren-space-1)
    color var(--wren-text-secondary)
    font-size var(--wren-type-caption)

.approveTokenSpendAmount.wrenInputGroup
  position relative
  display flex
  width 100%
  height 46px
  align-items center

  input.wrenInput
    min-width 0
    width 100%
    height 100%
    padding 0 calc(164px + var(--wren-space-2)) 0 var(--wren-space-3)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-body)
    text-align left

.wrenTokenApprovalAmountSymbol
  position absolute
  top 50%
  right 100px
  max-width 64px
  overflow hidden
  color var(--wren-text-muted)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  transform translateY(-50%)
  text-overflow ellipsis
  white-space nowrap
  pointer-events none

.wrenTokenApprovalAmountAction,
.wrenTokenApprovalAmountStatus
  appearance none
  position absolute
  top 0
  right 0
  bottom 0
  display flex
  width 68px
  padding 0 var(--wren-space-2)
  align-items center
  justify-content center
  border 0
  border-left 1px solid var(--wren-border-subtle)
  color var(--wren-accent-primary-hover)
  background transparent
  font-family var(--wren-font-ui)
  font-size var(--wren-type-caption)
  font-weight 650

.wrenTokenApprovalAmountAction
  cursor pointer

  &:hover:not(:disabled)
    color var(--wren-text-primary)
    background var(--wren-ledger-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset -2px

.wrenTokenApprovalStatusSuccess
  color var(--wren-success)

.wrenTokenApprovalStatusDanger
  width 112px
  color var(--wren-danger)

.wrenTokenApprovalDecisionCopy,
.wrenTokenApprovalUnavailable
  margin var(--wren-space-2) 0 0
  color var(--wren-text-secondary)
  font-size var(--wren-type-caption)
  line-height 1.5

.wrenTokenApprovalDecisionCopyWarning
  padding-left var(--wren-space-2)
  border-left 2px solid var(--wren-warning)
  color var(--wren-warning)

.wrenTokenApprovalUnavailable
  color var(--wren-warning)

.wrenTokenApprovalBalance
  display flex
  min-width 0
  min-height 72px
  padding var(--wren-space-3)
  box-sizing border-box
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)
  margin 0 0 var(--wren-space-2)
  gap var(--wren-space-4)
  align-items center
  justify-content space-between

  > span
    min-width 0

  strong
    display block
    margin-top 2px
    overflow-wrap anywhere
    font-family var(--wren-font-utility)
    font-size var(--wren-type-small)
    font-weight 500

  > button.wrenControl
    flex-shrink 0
    min-height 44px
    padding 0 var(--wren-space-4)
