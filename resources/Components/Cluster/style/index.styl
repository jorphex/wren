.cluster
  display flow-root
  margin var(--wren-space-2)
  padding var(--wren-space-1)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-md)
  color var(--wren-text-primary)
  background var(--wren-bg-subtle)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-small)
  font-weight 400
  -webkit-app-region no-drag

  .clusterRow
    display flex
    align-items stretch
    gap var(--wren-space-1)

  .clusterRow + .clusterRow
    margin-top var(--wren-space-1)

  .clusterValue
    position relative
    box-sizing border-box
    display flex
    flex-grow 1
    align-items center
    justify-content center
    min-width 0
    margin 0
    padding 0
    overflow hidden
    border 1px solid var(--wren-border-subtle)
    border-radius var(--wren-radius-sm)
    color inherit
    background var(--wren-surface-card)
    font inherit
    text-align inherit
    -webkit-app-region no-drag
    transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

    *
      pointer-events none

    .clusterInputLabel
      position absolute
      top 0
      left 0
      display flex
      width 60px
      align-items center
      justify-content center

  .clusterValueClickable
    cursor pointer

  .clusterValueContent
    display contents

  .clusterValueAction
    position absolute
    inset 0
    z-index 2
    width 100%
    height 100%
    padding 0
    border 0
    border-radius inherit
    color inherit
    background transparent
    cursor inherit
    font inherit
    pointer-events auto !important

  .clusterValueAction:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset -2px

  .clusterValueDisabled
    cursor default
    color var(--wren-text-disabled)
    background var(--wren-bg-elevated)
    opacity .7

  .clusterValueInteractable
    *
      pointer-events auto

  .clusterValueButton .clusterValueContent
    pointer-events none

    *
      pointer-events none

  .clusterValueClickable:not(.clusterValueDisabled):hover
    border-color var(--wren-border-default)
    background var(--wren-surface-hover)

  .clusterValueClickable:not(.clusterValueDisabled):active
    border-color var(--wren-border-strong)
    background var(--wren-surface-active)

  .clusterValueTransparent
    border-color transparent
    background transparent

  .clusterColumn
    display flex
    flex-direction column
    flex-grow 1
    gap var(--wren-space-1)
    min-width 0
    font-size var(--wren-type-small)

.clusterStatus
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0

.clusterBoxSubtitle
  position relative
  left var(--wren-space-1)
  color var(--wren-text-tertiary)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  font-weight 400

.clusterTag
  padding var(--wren-space-2)
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  font-weight 450
  line-height 18px
  text-align center

.clusterTagButton,
.clusterAddressButton
  appearance none
  width 100%
  border 0
  border-radius var(--wren-radius-sm)
  color inherit
  background transparent
  cursor pointer
  font-family inherit

.clusterTagButton:disabled
  cursor default
  color var(--wren-text-disabled)
  opacity .7

.clusterTagButton:not(:disabled):hover,
.clusterAddressButton:hover
  background var(--wren-surface-hover)

.clusterTagButton:not(:disabled):active,
.clusterAddressButton:active
  background var(--wren-surface-active)

.clusterTagButton:focus-visible,
.clusterAddressButton:focus-visible
  outline 2px solid var(--wren-focus)
  outline-offset -2px

.clusterFocus
  padding var(--wren-space-4) var(--wren-space-2)
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  font-weight 450
  line-height 20px
  text-align center

  .clusterFocusHighlight
    color var(--wren-success)
    font-size var(--wren-type-body)
    font-weight 550

.clusterAddress
  padding var(--wren-space-3)
  color var(--wren-text-primary)
  font-size var(--wren-type-small)
  font-weight 500
  cursor pointer

.clusterAddressRecipient
  display flex
  align-items center
  justify-content center
  color var(--wren-text-primary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-small)
  font-weight 400
  line-height 18px
  pointer-events none

  svg
    padding 0 var(--wren-space-1) !important

.clusterAddressRecipientLabeled
  flex-direction column
  gap var(--wren-space-1)

.clusterAddressRecipientComplete
  min-width 0
  overflow-wrap anywhere
  word-break break-all
  font-size var(--wren-type-caption)
  letter-spacing -.2px

.clusterAddressLabel
  display flex
  align-items baseline
  gap 7px
  max-width 100%
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-body)
  font-weight 550

  small
    color var(--wren-text-tertiary)
    font-size var(--wren-type-caption)
    font-weight 400

.clusterAddressEvidence
  color var(--wren-text-tertiary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)
  font-weight 400
  letter-spacing -.2px

.clusterAddressRecipientFull
  position absolute
  inset 0
  z-index 4
  display flex
  align-items center
  justify-content center
  border-radius var(--wren-radius-sm)
  color var(--wren-text-primary)
  background var(--wren-surface-hover)
  box-shadow var(--wren-shadow-sm)
  font-weight 500
  opacity 0
  transition opacity var(--wren-motion-fast) var(--wren-ease)

.clusterAddressRecipientFull:hover,
.clusterValueClickable:hover .clusterAddressRecipientFull,
.clusterAddressRecipientFullCopied
  opacity 1

.clusterAddressRecipientFullNoHover
  pointer-events none
  opacity 0

.clusterValueClickable:hover .clusterAddressRecipientFullNoHover
  opacity 0

.clusterAddressRecipientFullNoHover.clusterAddressRecipientFullCopied
  opacity 1

.clusterFira
  position relative
  top 1px
  font-family var(--wren-font-mono)
