.confirmationDialog
  font-family 'MainFont'
  font-weight 300

.confirmButtonOptions
  display flex
  justify-content center
  align-items center

  .confirmButton
    appearance none
    margin 8px
    padding 0px 16px
    height 44px
    font-weight 500
    background var(--wren-surface-card)
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    border-radius var(--wren-radius-sm)
    display flex
    justify-content center
    align-items center
    border 1px solid var(--wren-border-default)
    cursor pointer
    *
      pointer-events none

  .confirmButton:hover:not(:disabled)
    background var(--wren-surface-hover)

  .confirmButton:disabled
    opacity .5
    cursor default

.confirmText
  font-size var(--wren-type-heading)
  padding 0 42px 42px
  font-weight 500
  font-variation-settings var(--wren-font-heading-settings)

.confirmTextWithDescription
  padding-bottom 18px

.confirmDescription
  max-width 420px
  margin 0 auto 24px
  padding 0 42px
  color var(--wren-text-secondary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-body)
  line-height 1.5
