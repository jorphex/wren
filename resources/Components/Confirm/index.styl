.confirmationDialog
  font-family 'MainFont'
  font-weight 300

.confirmButtonOptions
  display flex
  justify-content center
  align-items center

  .confirmButton
    appearance none
    margin 8px
    padding 0px 16px
    height 38px
    font-weight 300
    background var(--ghostB)
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    border-radius 16px
    display flex
    justify-content center
    align-items center
    border 1px solid var(--wren-border-default)
    cursor pointer
    *
      pointer-events none

  .confirmButton:hover:not(:disabled)
    background var(--ghostC)

  .confirmButton:disabled
    opacity .5
    cursor default

.confirmText
  font-size 20px
  padding 0px 42px 42px 42px
  font-weight 300
