@keyframes lit
  from
    opacity .55
  to
    opacity 1

.requestItem
  position relative
  width 100%
  margin-top var(--wren-space-1)
  overflow hidden
  border-radius var(--wren-radius-md)
  color var(--wren-text-primary)
  background var(--wren-surface-card)
  font-family var(--wren-font-ui)
  font-weight 400
  transition background var(--wren-motion-fast) var(--wren-ease)

.requestLedger
  margin var(--wren-space-2)
  padding 0
  border 0
  border-top 1px solid var(--wren-ledger-rule)
  border-radius 0
  background transparent

  .clusterRow
    gap 0

  .clusterRow + .clusterRow
    margin-top 0

  .clusterValue
    border 0
    border-bottom 1px solid var(--wren-ledger-rule)
    border-radius 0
    background transparent

  .clusterRow:last-child .clusterValue
    border-bottom 0

  .clusterValueClickable:not(.clusterValueDisabled):hover
    border-color var(--wren-ledger-rule)
    background var(--wren-ledger-hover)

  .requestItem,
  .requestItem:hover,
  .requestItem:active
    margin-top 0
    border-radius 0
    background transparent

.requestItem:hover
  background var(--wren-surface-hover)

.requestItem:active
  background var(--wren-surface-active)

.requestItemBackground,
.requestItemCorner,
.requestItem::after
  pointer-events none

.requestItemBackground
  position absolute
  inset 0
  border-radius inherit
  opacity .06

.requestItemCorner
  display none

.requestItemNotice
  display flex
  align-items center
  justify-content center
  margin var(--wren-space-3) var(--wren-space-4)
  padding var(--wren-space-3) 0 0
  border-top 1px solid var(--wren-border-subtle)
  color var(--wren-warning)
  font-size var(--wren-type-small)
  font-weight 500
  line-height 18px
  text-align center

.requestItemNoticeGood
  color var(--wren-success)

.requestItemNoticeBad
  color var(--wren-danger)

.requestItemNoticeNeutral
  color var(--wren-text-tertiary)

.requestItemDetails
  display flex
  align-items center
  justify-content space-between
  width 100px
  height 30px
  color var(--wren-text-tertiary)
  font-size var(--wren-type-small)
  font-weight 450

  svg
    margin-left auto

  span
    position relative
    top -1px
    padding-left var(--wren-space-2)

.requestItemDetailsGood
  color var(--wren-success)

.requestItemDetailsBad
  color var(--wren-danger)

.requestItemDetailsNeutral
  color var(--wren-text-tertiary)

.requestItemDetailsIndicatorStill .requestItemDetailsIndicatorMarker
  animation none

.requestItemDetailsGood .requestItemDetailsIndicatorMarker
  background var(--wren-success)

.requestItemDetailsBad .requestItemDetailsIndicatorMarker
  background var(--wren-danger)

.requestItemDetailsNeutral .requestItemDetailsIndicatorMarker
  background var(--wren-text-tertiary)

.requestItemDetailsView
  display flex
  align-items center
  justify-content center
  margin-right var(--wren-space-1)

  .requestItemDetailsViewText
    font-weight 500

  .requestItemDetailsViewArrow
    display flex
    align-items center
    justify-content center

    div
      width var(--wren-space-2)

    svg
      transform rotate(90deg)

.requestItemRow
  position relative
  z-index 3
  display flex
  width 100%
  align-items center
  box-sizing border-box
  margin-bottom var(--wren-space-2)

  .requestItemRowIcon,
  .requestItemRowIconLarge
    display flex
    width 40px
    height 20px
    align-items center
    justify-content center

  .requestItemRowChainIcon
    position absolute
    top 0
    right 20px
    bottom 0
    display flex
    width 20px
    align-items center
    justify-content center
    border-radius var(--wren-radius-sm)

  .requestItemRowTitle,
  .requestItemRowTitleLarge
    position relative
    margin-left 9px
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    font-weight 450

  .requestItemRowTitleLarge
    display flex
    align-items center
    justify-content center

.requestItemIcon
  display flex
  width 32px
  height 32px
  align-items center
  justify-content center
  overflow hidden
  border-radius var(--wren-radius-sm)
  color var(--wren-accent-primary-hover)
  background var(--wren-surface-inset)
  box-shadow var(--wren-shadow-inset)
  -webkit-app-region no-drag

.requestItemTitle
  position relative
  display flex
  align-items center
  justify-content space-between
  min-height 58px
  padding var(--wren-space-3) var(--wren-space-4) var(--wren-space-2)
  overflow hidden
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-body)

  .requestItemTitleLeft
    display flex
    min-width 0
    align-items center

  .requestItemMain
    display flex
    min-width 0
    flex-direction column
    justify-content flex-start
    margin-top 1px

  .requestItemTitleMain
    display flex
    min-width 0
    align-items center
    gap var(--wren-space-2)
    margin-left var(--wren-space-2)
    overflow hidden
    font-weight 550
    white-space nowrap

    > span:first-child
      overflow hidden
      text-overflow ellipsis

  .requestItemQueueState
    flex none
    color var(--wren-text-secondary)
    font-size 12px
    font-weight 500

  .requestItemTitleTime
    position absolute
    top var(--wren-space-2)
    right var(--wren-space-4)
    display flex
    align-items center
    justify-content center

    .requestItemTitleTimeItem
      color var(--wren-text-tertiary)
      font-family var(--wren-font-mono)
      font-size var(--wren-type-caption)
      font-weight 400

.requestItemQueueActive
  box-shadow inset 2px 0 0 var(--wren-accent-primary)

.requestItemQueueWaiting
  color var(--wren-text-secondary)

  .requestItemDetailsSlide
    color var(--wren-text-tertiary)

  .requestItemDetailsIndicatorMarker
    background var(--wren-text-tertiary)
    animation none

.requestItemTitleSub
  display flex
  align-items center
  justify-content flex-start
  margin-top 3px
  color var(--wren-text-tertiary)
  font-size var(--wren-type-small)
  font-weight 400

  .requestItemTitleSubIcon
    margin 1px var(--wren-space-2) 0 0
    color var(--wren-text-tertiary)

  .requestItemTitleSubText
    font-weight 450

.requestItemSource
  position absolute
  top 0
  right 20px
  bottom 0
  display flex
  align-items center
  justify-content center
  margin-top -2px
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  font-weight 450

  div
    margin-right 5px

  svg
    position relative
    top 1px

.requestItemOrigin
  position absolute
  top var(--wren-space-4)
  right var(--wren-space-4)
  display flex
  align-items center
  color var(--wren-text-tertiary)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  font-weight 400

  .requestItemOriginIcon
    display flex
    align-items center
    justify-content center
    margin-right var(--wren-space-1)

.requestItemStatus
  position absolute
  bottom var(--wren-space-4)
  left 64px
  color var(--wren-text-tertiary)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-small)
  font-weight 400

.requestItemRight
  position relative
  left 1px
  display flex
  width 64px
  align-items center
  justify-content center
  transform scaleX(-1)

.requestItemDetailsSlide
  display flex
  align-items center
  padding-top var(--wren-space-1)
  padding-left var(--wren-space-2)
  color var(--wren-warning)
  font-size var(--wren-type-small)
  font-weight 500
  letter-spacing 0

.requestItemDetailsIndicator
  display flex
  width 10px
  height 10px
  align-items center
  justify-content center
  margin-right var(--wren-space-1)
  border 1px solid var(--wren-border-default)
  border-radius 50%

  .requestItemDetailsIndicatorMarker
    position relative
    width 5px
    height 5px
    border-radius 50%
    background var(--wren-warning)
    animation lit 1s ease-in-out infinite alternate

.requestItemWave,
.requestItemWaveDisabled
  display none

.requestItemSummary
  display flex
  align-items center
  justify-content center
  padding var(--wren-space-2) var(--wren-space-4) var(--wren-space-4)
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  font-weight 450
  text-align center

.requestItemHeader,
.requestItemHeader:hover,
.requestItemHeader:active
  margin 0
  background transparent
  pointer-events none
