.ringIcon
  height 33px
  width 33px
  border-radius 23px
  position relative
  -webkit-app-region no-drag
  transition none
  pointer-events auto
  transform translate3d(0, 0, 0)
  border 2px solid var(--outerspace)
  background var(--ghostB)
  *
    pointer-events none

  .ringIconInner
    position absolute
    top 3px
    right 3px
    bottom 3px
    left 3px
    border-radius 18px
    display flex
    justify-content center
    align-items center
    background var(--outerspace)
    overflow hidden
    color var(--ghostB)

    img
      display block
      width 100%
      height 100%
      object-fit contain
      object-position center
      border-radius inherit

.ringIconSmall
  height 23px
  width 23px

  .ringIconInner
    position absolute
    top 2px
    right 2px
    bottom 2px
    left 2px
    img
      width 100%
      height 100%

.ringIconNoRing
  border 0px solid var(--outerspace)
  background transparent
  border-radius 0px

  .ringIconInner
    inset 0
    background transparent
    border-radius 0px
    overflow visible

    > div,
    > svg
      display flex
      max-width 100%
      max-height 100%
      align-items center
      justify-content center
