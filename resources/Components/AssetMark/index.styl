.assetMark
  --asset-mark-size 32px
  --asset-mark-glyph-size 30px
  --asset-mark-chain-size 12px
  --asset-mark-image-size 22px
  --asset-mark-vector-size 18px
  --asset-mark-art-size var(--asset-mark-image-size)
  position relative
  display inline-flex
  width var(--asset-mark-size)
  height var(--asset-mark-size)
  flex 0 0 var(--asset-mark-size)
  align-items center
  justify-content center
  box-sizing border-box
  color var(--wren-text-primary)

.assetMarkGlyph
  --asset-mark-render-size var(--asset-mark-art-size)
  position relative
  display flex
  width var(--asset-mark-glyph-size)
  height var(--asset-mark-glyph-size)
  align-items center
  justify-content center
  overflow hidden
  box-sizing border-box
  border 1px solid var(--wren-border-strong)
  border-radius 50%
  background var(--wren-surface-inset)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)
  font-weight 650
  line-height 1

  img
    position absolute
    top 50%
    left 50%
    display block
    width var(--asset-mark-image-size)
    height var(--asset-mark-image-size)
    object-fit contain
    object-position center
    transform translate(-50%, -50%)

  > div
    position absolute
    top 50%
    left 50%
    display flex
    width var(--asset-mark-render-size)
    min-width var(--asset-mark-render-size)
    max-width var(--asset-mark-render-size)
    height var(--asset-mark-render-size)
    min-height var(--asset-mark-render-size)
    max-height var(--asset-mark-render-size)
    align-items center
    justify-content center
    transform translate(-50%, -50%)

  > svg
    position absolute
    top 50%
    left 50%
    display block
    width var(--asset-mark-render-size)
    height var(--asset-mark-render-size)
    transform translate(-50%, -50%)

  > div > svg
    display block
    width 100%
    height 100%

  &.assetMarkGlyphVector
    --asset-mark-render-size var(--asset-mark-vector-size)

  .ringIconFallback
    position absolute
    top 50%
    left 50%
    display grid
    width var(--asset-mark-art-size)
    height var(--asset-mark-art-size)
    place-items center
    transform translate(calc(-50% + 1px), calc(-50% + 1px))

.assetMark-plain .assetMarkGlyph
  border-color transparent
  background transparent
  box-shadow none

.assetMarkChain
  position absolute
  right -2px
  bottom -2px
  width var(--asset-mark-chain-size)
  min-width var(--asset-mark-chain-size)
  max-width var(--asset-mark-chain-size)
  height var(--asset-mark-chain-size)
  min-height var(--asset-mark-chain-size)
  max-height var(--asset-mark-chain-size)
  aspect-ratio 1
  box-sizing border-box
  border 2px solid var(--wren-bg-canvas)
  border-radius 999px
  background var(--asset-mark-chain-color)

.assetMark-card
  --asset-mark-size 34px
  --asset-mark-glyph-size 32px
  --asset-mark-image-size 24px
  --asset-mark-vector-size 19px

.assetMark-position
  --asset-mark-size 31px
  --asset-mark-glyph-size 29px
  --asset-mark-image-size 22px
  --asset-mark-vector-size 17px

.assetMark-hero
  --asset-mark-size 48px
  --asset-mark-glyph-size 46px
  --asset-mark-chain-size 20px
  --asset-mark-image-size 35px
  --asset-mark-vector-size 27px

  .assetMarkGlyph
    box-shadow 0 4px 12px rgba(0, 0, 0, .28)
