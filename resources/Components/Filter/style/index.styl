.filter
  position relative
  width 100%
  box-sizing border-box
  height 34px
  margin 32px 0px 32px 0px

  .filterWrap
    background var(--wren-surface-inset)
    border 1px solid var(--wren-border-default)
    position absolute
    left 0px
    top 0
    bottom 0
    right 105px
    border-radius var(--wren-radius-sm)
    box-sizing border-box

    .filterInput
      background transparent
      border 0
      outline 0
      color var(--outerspace)
      position absolute
      left 36px
      top 0
      bottom 0
      right 0px
      font-size 16px
      font-weight 300

  .filterIcon
    position absolute
    left 0
    top 2px
    bottom 0
    width 40px
    display flex
    justify-content center
    align-items center
    color var(--outerspace03)

.filterWrap:hover
  border-color var(--wren-border-strong)

.filterButton
  appearance none
  background var(--wren-surface-card)
  border 1px solid var(--wren-border-default)
  color inherit
  font-family inherit
  text-transform none
  font-size 14px
  font-weight 500
  width 60px
  border-radius var(--wren-radius-sm)
  position absolute 
  top 0px
  right 0px
  bottom 0px
  cursor pointer
  box-sizing border-box
  padding 0
  display flex
  justify-content center
  align-items center
  gap 2px

  *
    pointer-events none

.filterButton:hover
  background var(--wren-surface-hover)
