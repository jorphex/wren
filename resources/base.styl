body
  // Wren foundation. FiraCode remains the provisional technical face.
  --wren-font-ui 'MainFont', sans-serif
  --wren-font-mono 'FiraCode', monospace
  --wren-font-utility var(--wren-font-mono)
  --wren-font-body-settings 'CASL' .03, 'CRSV' 0
  --wren-font-heading-settings 'CASL' .28, 'CRSV' 0

  --wren-type-display 32px
  --wren-type-title 24px
  --wren-type-heading 20px
  --wren-type-body 15px
  --wren-type-small 13px
  --wren-type-caption 12px
  --wren-type-label var(--wren-type-caption)

  --wren-space-1 4px
  --wren-space-2 8px
  --wren-space-3 12px
  --wren-space-4 16px
  --wren-space-5 20px
  --wren-space-6 24px
  --wren-space-8 32px
  --wren-space-10 40px
  --wren-space-12 48px

  --wren-radius-sm 5px
  --wren-radius-md 8px
  --wren-radius-lg 10px
  --wren-radius-xl 14px
  --wren-radius-pill 999px

  --wren-shadow-sm 0 1px 2px rgba(0, 0, 0, .22)
  --wren-shadow-md 0 6px 18px rgba(0, 0, 0, .22)
  --wren-shadow-lg 0 12px 28px rgba(0, 0, 0, .28)
  --wren-shadow-inset inset 0 1px 0 rgba(255, 255, 255, .03)

  // Direction-free top light and a deeper lower edge keep controls tactile without patterned noise.
  --wren-control-texture-dark linear-gradient(180deg, rgba(255, 255, 255, .04), rgba(255, 255, 255, 0) 55%)
  --wren-control-texture-light linear-gradient(180deg, rgba(250, 245, 233, .16), rgba(250, 245, 233, 0) 52%)
  --wren-control-shadow inset 0 1px 0 rgba(255, 255, 255, .06), inset 0 -2px 0 rgba(0, 0, 0, .42), 0 1px 2px rgba(0, 0, 0, .24)
  --wren-control-shadow-hover inset 0 1px 0 rgba(255, 255, 255, .08), inset 0 -2px 0 rgba(0, 0, 0, .38), 0 2px 5px rgba(0, 0, 0, .26)
  --wren-control-shadow-pressed inset 0 1px 2px rgba(0, 0, 0, .42), 0 1px 1px rgba(0, 0, 0, .18)
  --wren-control-shadow-disabled inset 0 1px 0 rgba(255, 255, 255, .02)

  --wren-motion-fast 120ms
  --wren-motion-standard 180ms
  --wren-motion-slow 240ms
  --wren-motion-page 260ms
  --wren-ease cubic-bezier(.2, .8, .2, 1)

  // Shadows
  --cardDrop 0px 1px 1px rgba(0, 34, 32, 0.1)

  // Transistions
  --standardFaster .08s cubic-bezier(.82,0,.12,1) all
  --standardFast .16s cubic-bezier(.82,0,.12,1) all
  --standard .32s cubic-bezier(.82,0,.12,1) all
  --standardVibe .48s cubic-bezier(.82,0,.12,1) all
  --standardSlow .64s cubic-bezier(.82,0,.12,1) all
  --standardSlower .96s cubic-bezier(.82,0,.12,1) all
  --standardSlowest 1.6s cubic-bezier(.82,0,.12,1) all
  --slowRocket 2.4s cubic-bezier(.52,0,.12,1) all

  --cubic cubic-bezier(.82,0,.12,1)

  font-feature-settings 'ss04', 'zero'
  font-variation-settings var(--wren-font-body-settings)

h1, h2, h3, h4
  font-family var(--wren-font-ui)
  font-variation-settings var(--wren-font-heading-settings)
  letter-spacing -.01em

[class$='Title'], [class$='Heading'], [class$='Headline']
  font-variation-settings var(--wren-font-heading-settings)

button, input, select, textarea
  font-family inherit
  font-feature-settings inherit

button
  color inherit

.wrenUtilityText
  font-family var(--wren-font-utility)

:focus-visible
  outline 2px solid var(--wren-focus, var(--moon))
  outline-offset 2px

@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    animation-duration 1ms !important
    animation-iteration-count 1 !important
    scroll-behavior auto !important
    transition-duration 1ms !important

.frameOverlay
  position absolute
  top 0 
  right 0
  bottom 0 
  left 0
  background linear-gradient(-35deg, var(--overlayA) 0%, var(--overlayB) 100%)
  z-index 9999999999999999
  pointer-events none

.suspend
  *
    animation-play-state paused !important

.clip
  *
    transition none !important

