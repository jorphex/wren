.cardShow
  z-index 3000001
  animation cardShow 400ms linear both
  animation-delay 0s

.cardHide
  opacity 0
  pointer-events none

.glitch
  position absolute
  top 0
  right 0
  bottom 0
  left 0
  display flex
  justify-content center
  align-items center
  color var(--outerspace)

.line
  display none

.lastLine
  display block
  opacity 1

.glitchOn
  .line
    display block
    will-change clip-path

  .line:not(:first-child)
