body
  // Wren foundation. MainFont and FiraCode remain provisional aliases.
  --wren-font-ui 'MainFont', sans-serif
  --wren-font-mono 'FiraCode', monospace

  --wren-space-1 4px
  --wren-space-2 8px
  --wren-space-3 12px
  --wren-space-4 16px
  --wren-space-5 20px
  --wren-space-6 24px
  --wren-space-8 32px
  --wren-space-10 40px
  --wren-space-12 48px

  --wren-radius-sm 8px
  --wren-radius-md 12px
  --wren-radius-lg 16px
  --wren-radius-xl 20px
  --wren-radius-pill 999px

  --wren-shadow-sm 0 1px 2px rgba(0, 0, 0, .22)
  --wren-shadow-md 0 6px 18px rgba(0, 0, 0, .22)
  --wren-shadow-lg 0 12px 28px rgba(0, 0, 0, .28)
  --wren-shadow-inset inset 0 1px 0 rgba(255, 255, 255, .03)

  --wren-motion-fast 120ms
  --wren-motion-standard 180ms
  --wren-motion-slow 240ms
  --wren-ease cubic-bezier(.2, .8, .2, 1)

  // Shadows
  --cardDrop 0px 1px 1px rgba(0, 34, 32, 0.1)

  // Transistions
  --standardFaster .08s cubic-bezier(.82,0,.12,1) all
  --standardFast .16s cubic-bezier(.82,0,.12,1) all
  --standard .32s cubic-bezier(.82,0,.12,1) all
  --standardVibe .48s cubic-bezier(.82,0,.12,1) all
  --standardSlow .64s cubic-bezier(.82,0,.12,1) all
  --standardSlower .96s cubic-bezier(.82,0,.12,1) all
  --standardSlowest 1.6s cubic-bezier(.82,0,.12,1) all
  --slowRocket 2.4s cubic-bezier(.52,0,.12,1) all

  --cubic cubic-bezier(.82,0,.12,1)

  font-feature-settings 'ss04', 'zero'

:focus-visible
  outline 2px solid var(--wren-focus, var(--moon))
  outline-offset 2px

@media (prefers-reduced-motion: reduce)
  *, *::before, *::after
    animation-duration 1ms !important
    animation-iteration-count 1 !important
    scroll-behavior auto !important
    transition-duration 1ms !important

.frameOverlay
  position absolute
  top 0 
  right 0
  bottom 0 
  left 0
  background linear-gradient(-35deg, var(--overlayA) 0%, var(--overlayB) 100%)
  z-index 9999999999999999
  pointer-events none

.suspend
  *
    animation-play-state paused !important

.clip
  *
    transition none !important

