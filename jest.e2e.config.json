{
  "roots": ["test/e2e"],
  "testEnvironment": "node",
  "testTimeout": 10000,
  "setupFiles": ["<rootDir>/test/e2e/setup/isolation.js"],
  "transform": {
    "\\.[jt]sx?$": ["babel-jest", { "configFile": "./.babelrc.json" }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@ethereumjs/wallet|@ethereumjs/util|ethereum-cryptography|@noble/[^/]+|@scure/[^/]+)(/|$))"
  ],
  "clearMocks": true
}
