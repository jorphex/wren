body
  width 100%
  height 100%
  margin 0
  padding 0px
  font-family 'MainFont'
  font-weight 300

::-webkit-scrollbar
  width 6px
  height 6px
  background transparent

::-webkit-scrollbar-track
  background transparent

::-webkit-scrollbar-thumb
  border 2px solid transparent
  border-radius 2px
  background-color var(--wren-text-muted)
  background-clip content-box

::-webkit-scrollbar-thumb:hover
  border-width 1px
  background-color var(--wren-text-tertiary)

@import '../../../resources/Components/Button'
  
