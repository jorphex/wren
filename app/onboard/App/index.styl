body
  width 100%
  height 100%
  margin 0
  padding 0px
  font-family 'MainFont'
  font-weight 300

::-webkit-scrollbar
  width 6px
  height 6px
  background transparent

::-webkit-scrollbar-track
  background transparent

::-webkit-scrollbar-thumb
  border 2px solid transparent
  border-radius 2px
  background-color unquote('color-mix(in srgb, var(--wren-text-muted) 40%, transparent)')
  background-clip content-box

::-webkit-scrollbar-thumb:hover
  background-color unquote('color-mix(in srgb, var(--wren-text-muted) 60%, transparent)')

@import '../../../resources/Components/Button'
  
