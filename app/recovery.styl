.walletRecovery
  position absolute
  right 0
  top 0
  width 100%
  max-width 620px
  height 100%
  box-sizing border-box
  padding var(--wren-space-6)
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap var(--wren-space-5)
  background var(--wren-bg-canvas)
  color var(--wren-text-primary)
  border-radius var(--wren-radius-xl)

.workspace-edge-left .walletRecovery
  right auto
  left 0

.walletRecoveryActions
  display flex
  gap var(--wren-space-3)

  button
    min-height 44px
    font inherit
    color var(--wren-text-primary)
    padding 12px 18px
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-md)
    background var(--wren-bg-elevated)
    box-shadow var(--wren-control-shadow)
    cursor pointer

    &:hover
      box-shadow var(--wren-control-shadow-hover)

    &:active
      box-shadow var(--wren-control-shadow-pressed)

    &:focus-visible
      outline 2px solid var(--wren-text-muted)
      outline-offset 3px
