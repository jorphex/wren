  padding 20px 20px 32px
  color var(--wren-text-primary)

  h1
    margin 0
    font-size 24px
    font-weight 600
    line-height 32px
    letter-spacing 0

  h2
    margin 0 0 12px
    font-size 14px
    font-weight 600
    line-height 20px
