.earn, .earnDetails, .earnActivityView
  min-height 100%
  box-sizing border-box
  padding 10px 8px 44px
  color var(--outerspace)

.earnHero, .earnDetailsHero
  position relative
  margin 0 0 8px
  padding 26px 22px 22px
  border-radius 27px
  overflow hidden
  color #fff
  background linear-gradient(145deg, #0675f9, #034daa)
  border-bottom 2px solid rgba(0, 0, 0, .22)
  box-shadow 0 6px 16px rgba(0, 33, 92, .28)

  h1
    margin 4px 0 7px
    font-size 34px
    line-height 1
    font-weight 300
    letter-spacing -1px

  p
    position relative
    z-index 1
    max-width 300px
    margin 0
    font-size 13px
    line-height 19px

  .earnEyebrow
    color rgba(255, 255, 255, .72)

.earnEyebrow
  color var(--outerspace06)
  font-size var(--wren-type-caption)
  font-weight 500
  letter-spacing 1.5px
  text-transform uppercase

.earnRefresh
  position absolute
  top 25px
  right 18px
  border 0
  border-radius 13px
  padding 8px 12px
  z-index 2
  color #fff
  background rgba(255, 255, 255, .16)
  font-family 'MainFont'
  font-size var(--wren-type-caption)
  letter-spacing 1px
  text-transform uppercase
  cursor pointer

.earnRefresh:disabled
  opacity .5

.earnRefresh:not(:disabled):hover
  background rgba(255, 255, 255, .26)

@keyframes earnSkeletonPulse
  0%, 100%
    opacity .45

  50%
    opacity .78

.earnSkeleton
  display block
  flex none
  border-radius 999px
  background var(--ghostC)
  animation earnSkeletonPulse 1.4s ease-in-out infinite

  &:before
    display none !important

.earnSkeletonArtwork
  width 40px
  height 40px

.earnSkeletonCopy
  display flex
  min-width 0
  flex 1
  flex-direction column
  justify-content center
  gap 7px

.earnSkeletonTitle
  width min(154px, 72%)
  height 13px

.earnSkeletonLine
  width min(205px, 88%)
  height 10px

.earnSkeletonAmount
  width 68px
  height 17px
  align-self center

.earnSkeletonMetric
  display inline-block
  width 64px
  height 18px

.earnSkeletonInline
  width 128px
  height 12px

.earnSkeletonInlineShort
  width 78px

.earnSkeletonHeading
  width 112px
  height 19px

.earnLoadingLabel
  position absolute
  width 1px
  height 1px
  overflow hidden
  clip-path inset(50%)
  white-space nowrap

.earnCatalogLoading
  .earnHero
    min-height 131px
    box-sizing border-box

  .earnChain
    margin-top 18px

.earnTabsSkeleton
  .earnSkeletonTab
    width 100%
    height 35px
    border-radius 14px

.earnVaultSkeleton
  cursor default
  pointer-events none

  .earnVaultTop
    align-items center

.earnPositionSkeleton
  min-height 70px
  box-sizing border-box
  cursor default
  pointer-events none
  transition none

  &:hover
    transform none
    background var(--ghostAZ)

.earnPositionsLoading
  position relative

.earnNoticeLoading
  position relative

  .earnSkeletonInline
    flex 1

.earnWorkflowsLoading
  position relative

  .earnWorkflow
    display flex
    flex-direction column
    gap 9px

@media (prefers-reduced-motion: reduce)
  .earnSkeleton
    animation none

.earnTabs
  display grid
  grid-template-columns repeat(4, 1fr)
  gap 4px
  margin 12px 1px 18px
  padding 4px
  border-radius 18px
  background var(--ghostA)

  button
    height 35px
    border 0
    border-radius 14px
    color var(--outerspace07)
    background transparent
    font-family 'MainFont'
    font-size var(--wren-type-caption)
    font-weight 500
    cursor pointer

  .earnTabActive
    color var(--outerspace)
    background var(--ghostC)
    box-shadow 0 2px 5px var(--ghostY)

  button:not(.earnTabActive):hover
    color var(--outerspace)
    background var(--ghostB)

  button:focus-visible
    box-shadow 0 0 0 2px var(--moon)

.earnAccount
  display flex
  align-items center
  gap 8px
  margin 10px 7px 0
  font-size var(--wren-type-small)

  span
    color var(--outerspace06)
    text-transform uppercase
    letter-spacing 1px

  strong
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  em
    margin-left auto
    padding 4px 7px
    border-radius 8px
    background var(--ghostB)
    font-size var(--wren-type-caption)
    font-style normal
    text-transform uppercase

.earnChain
  margin-bottom 24px

.earnChainHeading
  display flex
  align-items flex-end
  justify-content space-between
  padding 0 10px 8px

  h2
    margin 0
    font-size 21px
    font-weight 300

  span
    color var(--outerspace06)
    font-size var(--wren-type-small)

.earnPositionsOverview
  margin 0 7px 18px
  padding 0 0 17px
  border-bottom 1px solid var(--ghostC)

  h2
    margin 0 3px 9px
    color var(--outerspace07)
    font-size var(--wren-type-small)
    font-weight 500
    letter-spacing 1.2px
    text-transform uppercase

.earnPositionList, .earnVaultList
  display grid
  gap 7px

  .earnPosition, .earnVault
    margin 0

.earnVault, .earnPosition
  width 100%
  margin 0 0 7px
  border 0
  border-bottom 2px solid var(--ghostZ)
  border-radius 23px
  color var(--outerspace)
  background var(--ghostAZ)
  box-shadow 0 3px 7px var(--ghostY)
  font-family 'MainFont'
  text-align left
  cursor pointer
  transition transform 120ms ease, background 120ms ease

  *
    cursor inherit

.earnVault
  padding 17px 18px 16px

.earnVault:hover, .earnPosition:hover
  transform translateY(-1px)
  background var(--ghostA)

.earnVaultTop
  display flex
  justify-content space-between
  gap 12px

.earnVaultIdentity
  display flex
  min-width 0
  align-items center
  gap 11px

  > div
    min-width 0

.earnVaultArtwork
  flex none

.earnVaultName, .earnPositionName
  font-size 16px
  font-weight 500

.earnVaultAsset, .earnPositionChain
  margin-top 4px
  color var(--outerspace06)
  font-size var(--wren-type-small)
  letter-spacing .4px

.earnApy
  display flex
  flex-direction column
  align-items flex-end
  min-width 78px

  strong
    font-family 'FiraCode'
    font-size 18px
    font-weight 400

  span
    margin-top 3px
    color var(--outerspace06)
    font-size var(--wren-type-caption)
    text-transform uppercase

.earnVaultMetrics
  display flex
  align-items center
  gap 8px
  margin-top 14px
  color var(--outerspace07)
  flex-wrap wrap
  font-size var(--wren-type-small)
  line-height 16px

  span + span:before
    content '/'
    margin-right 8px

  .earnPositionPill
    margin-left auto
    padding 4px 7px
    border-radius 8px
    color var(--outerspace)
    background var(--good)

  .earnPositionPill:before
    display none

.earnVaultUnavailable
  opacity .68

.earnVaultReason
  margin-top 10px
  font-size var(--wren-type-caption)
  line-height 16px

.earnPosition
  display flex
  align-items center
  justify-content space-between
  gap 12px
  padding 14px 18px

.earnPositionAmounts
  display flex
  flex-direction column
  gap 5px
  text-align right
  font-family 'FiraCode'
  font-size var(--wren-type-small)
  line-height 17px

.earnPositionAmount
  display flex
  flex-direction column

  span
    color var(--outerspace06)
    font-family 'MainFont'
    font-size var(--wren-type-caption)
    text-transform uppercase

.earnNotice
  display flex
  align-items center
  justify-content space-between
  gap 12px
  margin 7px 2px
  padding 11px 14px
  border-radius 15px
  background var(--ghostB)
  font-size var(--wren-type-small)
  line-height 17px

  button
    flex none
    border 0
    background transparent
    font-family 'MainFont'
    cursor pointer

.earnYearnLink
  margin 8px 8px 12px
  border 0
  background transparent
  font-family 'MainFont'
  cursor pointer

.earnDetailsHero
  padding 22px

  h1
    position relative
    z-index 1
    margin 3px 0 0
    font-size 27px

.earnDetailsIdentity
  position relative
  z-index 1
  display flex
  align-items center
  gap 13px
  margin-bottom 12px

.earnDetailsMetrics
  display grid
  grid-template-columns repeat(3, 1fr)
  gap 5px
  margin 8px 0

.earnMetric
  min-height 74px
  padding 13px 10px
  border-radius 17px
  background var(--ghostA)
  box-sizing border-box

.earnMetricLabel
  color var(--outerspace06)
  font-size var(--wren-type-caption)
  letter-spacing .8px
  text-transform uppercase

.earnMetricValue
  margin-top 8px
  font-size 15px
  font-weight 500

.earnVariants, .earnOwned
  margin-top 12px
  padding 16px
  border-radius 22px
  background var(--ghostA)

  h2
    margin 0 0 11px
    font-size 14px
    font-weight 500

.earnVariantGrid
  display grid
  grid-template-columns 1fr 1fr
  gap 6px

.earnVariant
  border 0
  padding 12px
  color var(--outerspace)
  border-radius 15px
  background var(--ghostB)
  font-family 'MainFont'
  text-align left
  cursor pointer

  strong, span
    display block

  strong
    font-size 13px

  span
    margin-top 5px
    font-family 'FiraCode'
    font-size var(--wren-type-small)

  p
    margin 8px 0 0
    color var(--outerspace07)
    font-size var(--wren-type-small)
    line-height 17px

.earnVariantSelected
  box-shadow inset 0 0 0 2px var(--outerspace04)
  background var(--ghostC)

.earnVariant:not(.earnVariantSelected):hover
  background var(--ghostC)

.earnVariant:focus-visible
  outline 2px solid var(--moon)
  outline-offset 1px

.earnProductNote
  margin-top 10px
  padding 14px 16px
  border-radius 18px
  background var(--ghostA)
  font-size var(--wren-type-small)
  line-height 18px

.earnCooldownNotice
  display flex
  flex-direction column
  gap 5px

  strong
    font-size var(--wren-type-small)

.earnOwnedLine
  display flex
  justify-content space-between
  padding 7px 0
  border-top 1px solid var(--ghostC)
  font-size var(--wren-type-small)

  strong:only-child
    margin-left auto

  em
    margin-left 8px
    color var(--outerspace06)
    font-size var(--wren-type-caption)
    font-style normal
    text-transform uppercase

.earnDetailsNotice
  margin-top 12px

.earnActions
  display grid
  grid-template-columns 1fr 1fr
  gap 7px
  margin-top 12px

  button
    height 48px
    border 0
    border-bottom 2px solid var(--ghostZ)
    border-radius 18px
    color var(--outerspace)
    background var(--ghostA)
    box-shadow 0 3px 7px var(--ghostY)
    font-family 'MainFont'
    font-size var(--wren-type-small)
    font-weight 500
    cursor pointer

  button:disabled
    opacity .35
    cursor default

  button:not(:disabled):hover
    background var(--ghostC)

  button.active
    background var(--ghostC)
    box-shadow inset 0 0 0 2px var(--outerspace04), 0 3px 7px var(--ghostY)

.earnSecondaryActions, .earnWorkflowActions
  display flex
  gap 6px
  margin-top 7px

  button
    flex 1
    min-height 36px
    border 0
    border-radius 14px
    color var(--outerspace)
    background var(--ghostB)
    font-family 'MainFont'
    font-size var(--wren-type-caption)
    cursor pointer

  button:disabled
    opacity .35
    cursor default

  button:not(:disabled):hover
    background var(--ghostC)

.earnActionForm
  margin-top 12px
  padding 17px
  border-radius 22px
  background var(--ghostA)
  box-shadow 0 3px 7px var(--ghostY)

  > p
    margin 10px 0 15px
    color var(--outerspace07)
    font-size var(--wren-type-small)
    line-height 18px

.earnActionHead, .earnWorkflowHead
  display flex
  align-items center
  justify-content space-between

.earnActionHead
  span
    color var(--outerspace06)
    font-size var(--wren-type-caption)
    letter-spacing 1px
    text-transform uppercase

  h2
    margin 3px 0 0
    font-size 18px
    font-weight 400

.earnAmountField
  display block

  > label
    display block
    margin 0 0 6px
    color var(--outerspace06)
    font-size var(--wren-type-caption)
    letter-spacing .7px
    text-transform uppercase

  > div
    display flex
    overflow hidden
    border-radius 16px
    background var(--ghostB)

  input
    width 100%
    min-width 0
    height 46px
    border 0
    padding 0 14px
    color var(--outerspace)
    outline 0
    background transparent
    font-family 'FiraCode'
    font-size 15px

  input:focus-visible
    box-shadow inset 0 0 0 2px var(--outerspace04)

  button
    width 58px
    border 0
    color var(--outerspace07)
    background transparent
    font-family 'MainFont'
    font-size var(--wren-type-caption)
    cursor pointer

  button.active
    color var(--outerspace)
    background var(--ghostC)

  button:not(:disabled):hover
    color var(--outerspace)
    background var(--ghostC)

.earnAvailable
  display flex
  flex-direction column
  gap 3px
  margin 7px 3px 0
  color var(--outerspace06)
  font-size var(--wren-type-caption)

.earnActionSafety
  margin 14px 0 10px
  padding 11px 12px
  border-radius 12px
  background var(--ghostB)
  font-size var(--wren-type-small)
  line-height 17px

.earnPrimaryAction
  width 100%
  height 46px
  border 0
  border-bottom 2px solid var(--ghostZ)
  border-radius 16px
  color var(--outerspace)
  background var(--ghostC)
  font-family 'MainFont'
  font-size var(--wren-type-small)
  font-weight 500
  cursor pointer

.earnPrimaryAction:disabled
  opacity .4
  cursor default

.earnPrimaryAction:not(:disabled):hover
  background var(--ghostB)

.earnWorkflows
  margin-top 15px

  > h2
    margin 0 10px 8px
    color var(--outerspace06)
    font-size var(--wren-type-caption)
    letter-spacing 1px
    text-transform uppercase

.earnWorkflowsPreview
  position relative

  > div
    display flow-root

.earnMoreButton
  width 100%
  height 38px
  margin 0 0 7px
  border 0
  border-radius 14px
  color var(--outerspace06)
  background var(--ghostB)
  font-family 'MainFont'
  font-size var(--wren-type-caption)
  letter-spacing 1px
  text-transform uppercase
  cursor pointer

.earnMoreButton:hover
  color var(--outerspace)
  background var(--ghostC)

.earnMoreButton:focus-visible
  outline 2px solid var(--outerspace04)
  outline-offset 1px

.earnWorkflow
  margin-bottom 7px
  padding 15px
  border-radius 19px
  background var(--ghostA)

  ol
    margin 12px 0 0
    padding 0
    list-style none

  li
    display flex
    align-items center
    gap 9px
    padding 7px 0
    border-top 1px solid var(--ghostC)

    > span
      display flex
      width 20px
      height 20px
      align-items center
      justify-content center
      border-radius 50%
      background var(--ghostB)
      font-family 'FiraCode'
      font-size var(--wren-type-caption)

    div
      display flex
      flex 1
      flex-wrap wrap
      justify-content space-between
      gap 8px

    strong, em
      font-size var(--wren-type-caption)

    em
      color var(--outerspace06)
      font-style normal
      text-transform uppercase

    .earnReceiptLink
      flex-basis 100%
      margin 0
      padding 0
      border 0
      background transparent
      font-family 'MainFont'
      text-align left
      cursor pointer

    .earnReceiptTransfers
      display flex
      flex-basis 100%
      flex-direction column
      gap 3px
      color var(--outerspace07)
      font-family 'FiraCode'
      font-size var(--wren-type-caption)

      span, em
        font-size var(--wren-type-caption)

      em
        text-transform none

  li.confirmed > span
    background var(--good)

  li.error > span
    background var(--bad)

.earnWorkflowHead
  strong
    font-size var(--wren-type-small)

  span
    color var(--outerspace06)
    font-size var(--wren-type-caption)
    text-transform uppercase

.earnWorkflowAmount
  margin-top 5px
  font-family 'FiraCode'
  font-size var(--wren-type-caption)

.earnWorkflowError
  margin-top 8px
  color var(--bad)
  font-size var(--wren-type-caption)
  line-height 16px

.earnDetailsFooter
  display flow-root

.earnActivityHeader
  margin 7px 10px 20px
  padding-bottom 16px
  border-bottom 1px solid var(--ghostC)

  h1
    margin 5px 0 4px
    font-size 28px
    font-weight 300

  p
    margin 0
    color var(--outerspace07)
    font-size 13px

.earnWorkflowsExpanded
  margin-top 0

.earnYearnLink
  display block
  margin 18px auto 10px

.earnRiskDisclosure
  margin var(--wren-space-3) var(--wren-space-2)
  padding var(--wren-space-3) var(--wren-space-4)
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background var(--wren-warning-soft)
  font-size var(--wren-type-caption)
  line-height 18px

.earnYearnLink,
.earnNotice button,
.earnWorkflow li .earnReceiptLink
  color var(--outerspace06)
  font-size var(--wren-type-caption)
  font-weight 400
  letter-spacing 1px
  text-decoration none
  text-transform uppercase

.earnYearnLink:hover,
.earnNotice button:hover,
.earnWorkflow li .earnReceiptLink:hover
  color var(--outerspace08)

.earnState
  display flex
  min-height 100%
  align-items center
  justify-content center
  flex-direction column
  gap 14px
  color var(--outerspace07)
  font-size var(--wren-type-small)

  button
    border 0
    border-radius 14px
    padding 10px 16px
    color var(--outerspace)
    background var(--ghostB)
    font-family 'MainFont'
    cursor pointer

// Wren Earn surface

// Earn uses the same content gutter and typography across catalog and detail views.
