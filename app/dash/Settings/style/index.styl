.wrenSettings
  .localSettingsWrap
    padding var(--wren-space-2) var(--wren-space-5) var(--wren-space-8)

  .wrenSettingsSection
    margin 0
    padding 0

  .wrenSettingsSection + .wrenSettingsSection
    margin-top var(--wren-space-5)

  .wrenSettingsSectionTitle
    margin 0
    padding var(--wren-space-4) var(--wren-space-2) var(--wren-space-2)
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    font-weight 500
    letter-spacing 0
    line-height 18px
    text-transform none

  .localSetting
    min-height 56px
    margin 0
    padding 12px var(--wren-space-2)
    box-sizing border-box
    border 0
    border-bottom 1px solid var(--wren-border-subtle)
    border-radius 0
    background transparent
    box-shadow none

    &:first-of-type
      border-top 1px solid var(--wren-border-subtle)

    &:hover
      background var(--wren-surface-hover)

    .signerPermissionControls
      min-height 32px
      align-items center
      gap var(--wren-space-4)

    .signerPermissionSetting
      max-width none
      padding 0
      color var(--wren-text-primary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-body)
      font-weight 500
      line-height 20px

    .signerPermissionDetails
      position absolute
      width 1px
      height 1px
      margin -1px
      padding 0
      overflow hidden
      clip rect(0 0 0 0)
      clip-path inset(50%)
      white-space nowrap

    .dropdownWrap
      flex 0 0 auto

    .dropdown
      min-width 130px

  .localSettingShortcut
    min-height 72px

    .settingsShortcutSetting
      display flex
      align-items center
      gap var(--wren-space-3)
      flex-wrap wrap

    .signerPermissionControls
      min-height 28px

    .signerPermissionSetting
      overflow visible
      white-space normal

    .signerPermissionDetails
      position static
      width auto
      height auto
      margin 3px 0 0
      padding 0
      overflow visible
      clip auto
      clip-path none
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)
      line-height 20px
      white-space normal

    .keyCommand,
    .keyCommandLoading
      min-height 24px
      height 24px
      margin-left var(--wren-space-2)
      padding 0 var(--wren-space-2)

  .interfaceScaleSetting
    min-height 104px

  .interfaceScaleHeader
    display flex
    width 100%
    min-width 0
    align-items center
    justify-content space-between
    gap var(--wren-space-5)

  .interfaceScaleCopy
    min-width 0

  .interfaceScaleDescription,
  .interfaceScaleStatus
    margin-top var(--wren-space-1)
    color var(--wren-text-tertiary)
    font-family var(--wren-font-ui)
    font-size 12px
    font-weight 400
    line-height 18px

  .interfaceScaleStatus
    color var(--wren-text-secondary)

  .interfaceScaleOptions
    display grid
    flex none
    grid-template-columns repeat(3, minmax(56px, 1fr))
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    overflow hidden

  .interfaceScaleOption
    min-width 56px
    min-height 44px
    padding 0 var(--wren-space-2)
    border 0
    border-radius 0
    box-shadow none
    font-size 12px

    & + .interfaceScaleOption
      border-left 1px solid var(--wren-border-default)

    &[aria-pressed='true']
      color var(--wren-text-inverse)
      background var(--wren-control-texture-light), var(--wren-accent-primary)

  .interfaceScaleAnnouncement
    position absolute
    width 1px
    height 1px
    margin -1px
    padding 0
    overflow hidden
    clip rect(0 0 0 0)
    clip-path inset(50%)
    white-space nowrap

  .connectionCustomInput
    margin-top var(--wren-space-2)

  .appInfo
    display flex
    padding var(--wren-space-4) var(--wren-space-2)
    flex-direction column
    align-items center
    border-top 1px solid var(--wren-border-subtle)
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)

    button
      appearance none
      border 0
      color inherit
      background transparent
      font-family inherit
      cursor pointer

      &:focus-visible
        outline 2px solid var(--wren-focus)
        outline-offset 2px

    .appInfoLine
      display flex
      align-items center
      justify-content center
      text-align center

    .appInfoLineInstanceId
      width 100%
      max-width 100%
      margin 0 0 var(--wren-space-3)
      overflow hidden
      color var(--wren-text-muted)
      font-family var(--wren-font-mono)
      font-size var(--wren-type-caption)
      text-overflow ellipsis
      text-transform none
      white-space nowrap

    .instanceIdCopied
      color var(--wren-success)
      text-transform none

    .appInfoLineVersion
      color var(--wren-text-tertiary)
      font-family var(--wren-font-mono)
      font-size var(--wren-type-caption)

    .appInfoViewLicense
      margin-top var(--wren-space-3)
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)

      &:hover
        color var(--wren-text-primary)

    .appInfoLineReset
      width 100%
      margin var(--wren-space-2) 0 0
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)
      line-height 24px

    .appInfoLineResetConfirm
      display flex
      max-width 520px
      margin var(--wren-space-3) auto 0
      padding var(--wren-space-3)
      flex-direction column
      gap var(--wren-space-2)
      border 1px solid rgba(213, 116, 104, .36)
      border-radius var(--wren-radius-sm)
      color var(--wren-text-secondary)
      background var(--wren-danger-soft)
      font-size var(--wren-type-small)
      line-height 18px
      text-align left

      strong
        color var(--wren-text-primary)
        font-size 14px
        font-weight 500

    .appInfoLineResetConfirmButtons
      display flex
      justify-content flex-end
      gap var(--wren-space-2)

      button
        min-height 40px
        padding 0 var(--wren-space-4)

    .appInfoLineResetButton
      padding 0
      color var(--wren-text-muted)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-caption)

      &:hover
        color var(--wren-danger)

  .wrenSettingsSection:last-child .localSetting:last-child
    border-bottom 1px solid var(--wren-border-subtle)

@media (max-height: 760px)
  .wrenSettings
    .localSettingsWrap
      padding-top 0

    .wrenSettingsSection + .wrenSettingsSection
      margin-top var(--wren-space-3)

    .wrenSettingsSectionTitle
      padding-top var(--wren-space-3)

    .localSetting
      min-height 52px
      padding-top 10px
      padding-bottom 10px

    .interfaceScaleSetting
      min-height 96px

@media (max-width: 620px)
  .wrenSettings
    .interfaceScaleHeader
      align-items flex-start
      flex-direction column
      gap var(--wren-space-3)

    .interfaceScaleOptions
      width 100%
