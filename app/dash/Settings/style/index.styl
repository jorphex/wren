.wrenSettings
  .localSettingsWrap
    padding var(--wren-space-2) var(--wren-page-gutter) var(--wren-space-8)

  .wrenSettingsSection
    margin 0
    padding 0
    overflow hidden
    border 1px solid var(--wren-border-instrument)
    border-radius var(--wren-radius-md)
    background-color var(--wren-surface-instrument)
    background-image var(--wren-control-texture-dark)
    box-shadow var(--wren-shadow-instrument-quiet)

  .wrenSettingsSection + .wrenSettingsSection
    margin-top var(--wren-space-5)

  .wrenSettingsSectionTitle
    margin 0
    padding var(--wren-space-3) var(--wren-space-4)
    border-bottom 1px solid var(--wren-border-instrument-divider)
    color var(--wren-text-secondary)
    background rgba(7, 10, 8, .24)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    font-weight 500
    letter-spacing 0
    line-height 18px
    text-transform none

  .localSetting
    min-height 56px
    margin 0
    padding 12px var(--wren-space-4)
    box-sizing border-box
    border 0
    border-radius 0
    background transparent
    box-shadow none

    &:hover
      background var(--wren-surface-hover)

    .signerPermissionControls
      min-height 32px
      align-items center
      gap var(--wren-space-4)

    .signerPermissionSetting
      width auto
      min-width 0
      max-width none
      flex 1
      padding 0
      color var(--wren-text-primary)
      direction ltr
      font-family var(--wren-font-ui)
      font-size var(--wren-type-body)
      font-weight 500
      line-height 20px
      text-align left

    .signerPermissionDetails
      position absolute
      width 1px
      height 1px
      margin -1px
      padding 0
      overflow hidden
      clip rect(0 0 0 0)
      clip-path inset(50%)
      white-space nowrap

    .dropdownWrap
      flex 0 0 auto
      height 44px

    .dropdown
      min-width 130px
      height 44px
      background-position calc(100% - 16px) 19px, calc(100% - 11px) 19px

  .localSettingShortcut
    min-height 72px

    .settingsShortcutSetting
      display flex
      align-items center
      gap var(--wren-space-3)
      flex-wrap wrap
      direction ltr

    .signerPermissionControls
      min-height 28px

    .signerPermissionSetting
      overflow visible
      white-space normal

    .signerPermissionDetails
      position static
      width auto
      height auto
      margin 3px 0 0
      padding 0
      overflow visible
      clip auto
      clip-path none
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)
      line-height 20px
      white-space normal

    .keyCommand,
    .keyCommandLoading
      min-height 24px
      height 24px
      margin-left var(--wren-space-2)
      padding 0 var(--wren-space-2)

  .localSettingExplained
    min-height 76px

    .signerPermissionDetails
      position static
      width auto
      height auto
      margin 3px 0 0
      padding 0
      overflow visible
      clip auto
      clip-path none
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)
      line-height 18px
      white-space normal

  .recentRecipientsSetting,
  .recentRecipientsClear
    height auto

  .recentRecipientsDialog
    width 100%

  .contractVerificationCredential
    height auto

  .contractVerificationCredentialIdentity
    min-width 150px
    flex 1

  .contractVerificationCredentialStatus,
  .contractVerificationCredentialHint,
  .contractVerificationCredentialMessage,
  .contractVerificationCredentialError
    color var(--wren-text-tertiary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-caption)
    line-height 18px

  .contractVerificationCredentialActions
    display flex
    align-items center
    justify-content flex-end
    gap var(--wren-space-2)

    button
      min-height 44px
      flex none

  .contractVerificationCredentialInput
    width 180px
    height 44px
    box-sizing border-box

  .contractVerificationCredentialMessage
    min-height 18px
    color var(--wren-success)

  .contractVerificationCredentialHint
    margin-top var(--wren-space-1)
    color var(--wren-text-secondary)

  .contractVerificationCredentialError
    min-height 18px
    color var(--wren-danger)
    box-sizing border-box

  .recentRecipientsStatus
    min-height 18px
    padding 4px var(--wren-space-2) 0
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-caption)
    line-height 18px

  .interfaceScaleSetting
    min-height 104px

  button.localConnectionTarget.wrenControl
    min-height 44px

  .interfaceScaleHeader
    display flex
    width 100%
    min-width 0
    align-items center
    justify-content space-between
    gap var(--wren-space-5)

  .interfaceScaleCopy
    min-width 0

  .interfaceScaleDescription,
  .interfaceScaleStatus
    margin-top var(--wren-space-1)
    color var(--wren-text-tertiary)
    font-family var(--wren-font-ui)
    font-size 12px
    font-weight 400
    line-height 18px

  .interfaceScaleStatus
    color var(--wren-text-secondary)

  .interfaceScaleOptions
    display grid
    flex none
    grid-template-columns repeat(3, minmax(56px, 1fr))
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    overflow hidden

  .interfaceScaleOption
    min-width 56px
    min-height 44px
    padding 0 var(--wren-space-2)
    border 0
    border-radius 0
    box-shadow none
    font-size 12px

    & + .interfaceScaleOption
      border-left 1px solid var(--wren-border-default)

    &.wrenControlGhost:hover:not(:disabled)
      color var(--wren-text-primary)
      background-color var(--wren-surface-active)
      box-shadow inset 0 0 0 1px var(--wren-border-strong)

    &[aria-pressed='true']
      border-color var(--wren-accent-primary-hover)
      color var(--wren-text-inverse)
      background-color var(--wren-accent-primary)
      background-image var(--wren-control-texture-light)
      box-shadow var(--wren-control-primary-shadow)

    &[aria-pressed='true']:hover:not(:disabled),
    &[aria-pressed='true']:active:not(:disabled),
    &[aria-pressed='true']:focus-visible
      border-color var(--wren-control-primary-border-hover)
      color var(--wren-text-inverse)
      background-color var(--wren-accent-primary-hover)
      background-image var(--wren-control-texture-light)
      box-shadow var(--wren-control-primary-shadow-hover)

    &:focus-visible
      outline-offset -3px

  .interfaceScaleAnnouncement
    position absolute
    width 1px
    height 1px
    margin -1px
    padding 0
    overflow hidden
    clip rect(0 0 0 0)
    clip-path inset(50%)
    white-space nowrap

  .connectionCustomInput
    margin-top var(--wren-space-2)

  .recoverySettings
    display flex
    padding 0 var(--wren-space-2)
    flex-direction column
    gap var(--wren-space-2)

  .recoveryOption
    display flex
    min-height 72px
    padding var(--wren-space-3) 0
    align-items center
    justify-content space-between
    gap var(--wren-space-5)

    > button
      min-width 148px
      flex none

  .recoveryOptionCopy
    display flex
    min-width 0
    flex-direction column
    gap var(--wren-space-1)

    strong
      color var(--wren-text-primary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-body)
      font-weight 500

    span
      max-width 560px
      color var(--wren-text-tertiary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-caption)
      line-height 18px

  .recoveryOptionActions
    display flex
    flex none
    gap var(--wren-space-2)

    button
      min-width 132px

  .recoveryPanel
    display flex
    padding var(--wren-space-4)
    flex-direction column
    gap var(--wren-space-3)
    border 1px solid var(--wren-border-subtle)
    border-radius 2px
    color var(--wren-text-primary)
    background var(--wren-surface-inset)

    > strong
      font-family var(--wren-font-ui)
      font-size var(--wren-type-body)
      font-weight 600

  .recoveryReplacePanel
    border-color rgba(213, 116, 104, .42)
    background var(--wren-danger-soft)

  .recoveryPanelCopy
    margin 0
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    line-height 19px

  .recoveryFields
    display grid
    grid-template-columns minmax(128px, .34fr) minmax(0, 1fr)
    align-items center
    gap var(--wren-space-2) var(--wren-space-3)

    label
      color var(--wren-text-secondary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-small)

    input
      width 100%
      min-height 44px
      padding 0 var(--wren-space-3)
      font-family var(--wren-font-mono)

  .recoveryActions
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap var(--wren-space-2)

  .recoveryError,
  .recoveryStatus
    padding var(--wren-space-3)
    border-radius 2px
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    line-height 18px

  .recoveryError
    color var(--wren-danger)
    background var(--wren-danger-soft)

  .recoveryStatus
    color var(--wren-text-secondary)
    background var(--wren-surface-inset)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

  .recoveryMetadata
    display grid
    margin 0
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap var(--wren-space-2)

    > div
      padding var(--wren-space-2)
      background var(--wren-bg-panel)

    dt,
    dd
      margin 0
      font-family var(--wren-font-ui)

    dt
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)

    dd
      margin-top 3px
      color var(--wren-text-primary)
      font-size var(--wren-type-small)

  .appInfo
    display flex
    padding var(--wren-space-4) var(--wren-space-2)
    flex-direction column
    align-items center
    border-top 0
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)

    button
      appearance none
      min-height 44px
      border 0
      color inherit
      background transparent
      font-family inherit
      cursor pointer

      &:focus-visible
        outline 2px solid var(--wren-focus)
        outline-offset 2px

    .appInfoLine
      display flex
      align-items center
      justify-content center
      text-align center

    .appInfoLineInstanceId
      width 100%
      max-width 100%
      margin 0 0 var(--wren-space-3)
      overflow hidden
      color var(--wren-text-muted)
      font-family var(--wren-font-mono)
      font-size var(--wren-type-caption)
      text-overflow ellipsis
      text-transform none
      white-space nowrap

    .appInfoLineInstanceId,
    .appInfoViewLicense,
    .appInfoLineResetButton
      display inline-flex
      align-items center
      justify-content center

    .instanceIdCopied
      color var(--wren-success)
      text-transform none

    .appInfoLineVersion
      color var(--wren-text-tertiary)
      font-family var(--wren-font-mono)
      font-size var(--wren-type-caption)

    .appInfoViewLicense
      margin-top var(--wren-space-3)
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)

      &:hover
        color var(--wren-text-primary)

    .appInfoLineReset
      width 100%
      margin var(--wren-space-2) 0 0
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)
      line-height 24px

    .appInfoLineResetConfirm
      display flex
      max-width 520px
      margin var(--wren-space-3) auto 0
      padding var(--wren-space-3)
      flex-direction column
      gap var(--wren-space-2)
      border 1px solid rgba(213, 116, 104, .36)
      border-radius var(--wren-radius-sm)
      color var(--wren-text-secondary)
      background var(--wren-danger-soft)
      font-size var(--wren-type-small)
      line-height 18px
      text-align left

      strong
        color var(--wren-text-primary)
        font-size 14px
        font-weight 500

    .appInfoLineResetConfirmButtons
      display flex
      justify-content flex-end
      gap var(--wren-space-2)

      button
        min-height 40px
        padding 0 var(--wren-space-4)

    .appInfoLineResetButton
      padding 0
      color var(--wren-text-muted)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-caption)

      &:hover
        color var(--wren-danger)

@media (max-height: 760px)
  .wrenSettings
    .localSettingsWrap
      padding-top 0

    .wrenSettingsSection + .wrenSettingsSection
      margin-top var(--wren-space-3)

    .wrenSettingsSectionTitle
      padding-top var(--wren-space-3)

    .localSetting
      min-height 52px
      padding-top 10px
      padding-bottom 10px

    .interfaceScaleSetting
      min-height 96px

@media (max-width: 620px)
  .wrenSettings
    .interfaceScaleHeader
      align-items flex-start
      flex-direction column
      gap var(--wren-space-3)

    .interfaceScaleOptions
      width 100%

    .recoveryOption
      align-items stretch
      flex-direction column
      gap var(--wren-space-3)

      > button
        width 100%

    .recoveryFields
      grid-template-columns 1fr

    .recoveryMetadata
      grid-template-columns 1fr

    .contractVerificationCredentialControls,
    .contractVerificationCredentialActions
      width 100%
      align-items stretch
      flex-direction column

    .contractVerificationCredentialInput,
    .contractVerificationCredentialActions button
      width 100%
