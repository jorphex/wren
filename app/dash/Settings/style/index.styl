.wrenSettings
  .localSettingsWrap
    padding var(--wren-space-2) var(--wren-page-gutter) var(--wren-space-8)

  .wrenSettingsSection
    margin 0
    padding 0

  .wrenSettingsSection + .wrenSettingsSection
    margin-top var(--wren-space-5)

  .wrenSettingsSectionTitle
    margin 0
    padding var(--wren-space-4) var(--wren-space-2) var(--wren-space-2)
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    font-weight 500
    letter-spacing 0
    line-height 18px
    text-transform none

  .localSetting
    min-height 56px
    margin 0
    padding 12px var(--wren-space-2)
    box-sizing border-box
    border 0
    border-radius 0
    background transparent
    box-shadow none

    &:hover
      background var(--wren-surface-hover)

    .signerPermissionControls
      min-height 32px
      align-items center
      gap var(--wren-space-4)

    .signerPermissionSetting
      width auto
      min-width 0
      max-width none
      flex 1
      padding 0
      color var(--wren-text-primary)
      direction ltr
      font-family var(--wren-font-ui)
      font-size var(--wren-type-body)
      font-weight 500
      line-height 20px
      text-align left

    .signerPermissionDetails
      position absolute
      width 1px
      height 1px
      margin -1px
      padding 0
      overflow hidden
      clip rect(0 0 0 0)
      clip-path inset(50%)
      white-space nowrap

    .dropdownWrap
      flex 0 0 auto
      height 44px

    .dropdown
      min-width 130px
      height 44px
      background-position calc(100% - 16px) 19px, calc(100% - 11px) 19px

  .localSettingShortcut
    min-height 72px

    .settingsShortcutSetting
      display flex
      align-items center
      gap var(--wren-space-3)
      flex-wrap wrap
      direction ltr

    .signerPermissionControls
      min-height 28px

    .signerPermissionSetting
      overflow visible
      white-space normal

    .signerPermissionDetails
      position static
      width auto
      height auto
      margin 3px 0 0
      padding 0
      overflow visible
      clip auto
      clip-path none
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)
      line-height 20px
      white-space normal

    .keyCommand,
    .keyCommandLoading
      min-height 24px
      height 24px
      margin-left var(--wren-space-2)
      padding 0 var(--wren-space-2)

  .localSettingExplained
    min-height 76px

    .signerPermissionDetails
      position static
      width auto
      height auto
      margin 3px 0 0
      padding 0
      overflow visible
      clip auto
      clip-path none
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)
      line-height 18px
      white-space normal

  .recentRecipientsSetting,
  .recentRecipientsClear
    height auto

  .recentRecipientsDialog
    width 100%

  .contractVerificationCredential
    height auto

  .contractVerificationCredentialIdentity
    display flex
    width 100%
    min-width 0
    align-items center
    justify-content space-between
    gap var(--wren-space-3)

  .contractVerificationCredentialControls
    width 100%
    align-items stretch
    flex-direction column
    gap var(--wren-space-2)

  .contractVerificationCredentialStatus,
  .contractVerificationCredentialHint,
  .contractVerificationCredentialMessage,
  .contractVerificationCredentialError
    color var(--wren-text-tertiary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-caption)
    line-height 18px

  .contractVerificationCredentialActions
    display flex
    width 100%
    align-items center
    justify-content flex-start
    gap var(--wren-space-2)

    button
      min-height 44px
      flex none

  .contractVerificationCredentialInput
    width auto
    height 44px
    box-sizing border-box
    flex 1 1 auto

  .contractVerificationCredentialMessage
    min-height 0
    color var(--wren-success)

    &:empty
      display none

  .contractVerificationCredentialHint
    margin-top var(--wren-space-1)
    color var(--wren-text-secondary)

  .contractVerificationCredentialError
    min-height 18px
    color var(--wren-danger)
    box-sizing border-box

  .recentRecipientsStatus
    min-height 18px
    padding 4px var(--wren-space-2) 0
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-caption)
    line-height 18px

  .interfaceScaleSetting
    min-height 104px

  button.localConnectionTarget.wrenControl
    min-height 44px

  .interfaceScaleHeader
    display flex
    width 100%
    min-width 0
    align-items center
    justify-content space-between
    gap var(--wren-space-5)

  .interfaceScaleCopy
    min-width 0

  .interfaceScaleDescription,
  .interfaceScaleStatus
    margin-top var(--wren-space-1)
    color var(--wren-text-tertiary)
    font-family var(--wren-font-ui)
    font-size 12px
    font-weight 400
    line-height 18px

  .interfaceScaleStatus
    color var(--wren-text-secondary)

  .interfaceScaleOptions
    display grid
    flex none
    grid-template-columns repeat(3, minmax(56px, 1fr))
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    overflow hidden

  .interfaceScaleOption
    min-width 56px
    min-height 44px
    padding 0 var(--wren-space-2)
    border 0
    border-radius 0
    box-shadow none
    font-size 12px

    & + .interfaceScaleOption
      border-left 1px solid var(--wren-border-default)

    &.wrenControlGhost:hover:not(:disabled)
      color var(--wren-text-primary)
      background-color var(--wren-surface-active)
      box-shadow inset 0 0 0 1px var(--wren-border-strong)

    &[aria-pressed='true']
      border-color var(--wren-accent-primary-hover)
      color var(--wren-text-inverse)
      background-color var(--wren-accent-primary)
      background-image var(--wren-control-texture-light)
      box-shadow var(--wren-control-primary-shadow)

    &[aria-pressed='true']:hover:not(:disabled),
    &[aria-pressed='true']:active:not(:disabled),
    &[aria-pressed='true']:focus-visible
      border-color var(--wren-control-primary-border-hover)
      color var(--wren-text-inverse)
      background-color var(--wren-accent-primary-hover)
      background-image var(--wren-control-texture-light)
      box-shadow var(--wren-control-primary-shadow-hover)

    &:focus-visible
      outline-offset -3px

  .interfaceScaleAnnouncement
    position absolute
    width 1px
    height 1px
    margin -1px
    padding 0
    overflow hidden
    clip rect(0 0 0 0)
    clip-path inset(50%)
    white-space nowrap

  .connectionCustomInput
    margin-top var(--wren-space-2)

  .recoverySettings
    display flex
    padding 0 var(--wren-space-2)
    flex-direction column
    gap var(--wren-space-2)

  .recoveryOption
    display flex
    min-height 72px
    padding var(--wren-space-3) 0
    align-items center
    justify-content space-between
    gap var(--wren-space-5)

    > button
      min-width 148px
      flex none

  .recoveryOptionCopy
    display flex
    min-width 0
    flex-direction column
    gap var(--wren-space-1)

    strong
      color var(--wren-text-primary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-body)
      font-weight 500

    span
      max-width 560px
      color var(--wren-text-tertiary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-caption)
      line-height 18px

  .recoveryOptionActions
    display flex
    flex none
    gap var(--wren-space-2)

    button
      min-width 132px

  .recoveryPanel
    display flex
    padding var(--wren-space-4)
    flex-direction column
    gap var(--wren-space-3)
    border 1px solid var(--wren-border-subtle)
    border-radius 2px
    color var(--wren-text-primary)
    background var(--wren-surface-inset)

    > strong
      font-family var(--wren-font-ui)
      font-size var(--wren-type-body)
      font-weight 600

  .recoveryReplacePanel
    border-color rgba(213, 116, 104, .42)
    background var(--wren-danger-soft)

  .recoveryPanelCopy
    margin 0
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    line-height 19px

  .recoveryFields
    display grid
    grid-template-columns minmax(128px, .34fr) minmax(0, 1fr)
    align-items center
    gap var(--wren-space-2) var(--wren-space-3)

    label
      color var(--wren-text-secondary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-small)

    input
      width 100%
      min-height 44px
      padding 0 var(--wren-space-3)
      font-family var(--wren-font-mono)

  .recoveryActions
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap var(--wren-space-2)

  .recoveryError,
  .recoveryStatus
    padding var(--wren-space-3)
    border-radius 2px
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    line-height 18px

  .recoveryError
    color var(--wren-danger)
    background var(--wren-danger-soft)

  .recoveryStatus
    color var(--wren-text-secondary)
    background var(--wren-surface-inset)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

  .recoveryMetadata
    display grid
    margin 0
    grid-template-columns repeat(3, minmax(0, 1fr))
    gap var(--wren-space-2)

    > div
      padding var(--wren-space-2)
      background var(--wren-bg-panel)

    dt,
    dd
      margin 0
      font-family var(--wren-font-ui)

    dt
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)

    dd
      margin-top 3px
      color var(--wren-text-primary)
      font-size var(--wren-type-small)

  .appInfo
    display grid
    min-height 44px
    padding 0 var(--wren-space-2)
    grid-template-columns minmax(0, 1fr) auto auto auto
    column-gap var(--wren-space-3)
    align-items center
    border-top 0
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)

    button
      appearance none
      min-height 44px
      border 0
      color inherit
      background transparent
      font-family inherit
      cursor pointer

      &:focus-visible
        outline 2px solid var(--wren-focus)
        outline-offset 2px

    .appInfoLine
      display flex
      align-items center
      justify-content center
      text-align center

    .appInfoLineInstanceId
      width 100%
      max-width 100%
      margin 0
      justify-content flex-start
      overflow hidden
      color var(--wren-text-muted)
      font-family var(--wren-font-mono)
      font-size var(--wren-type-caption)
      text-overflow ellipsis
      text-transform none
      white-space nowrap

    .appInfoLineInstanceId,
    .appInfoViewLicense,
    .appInfoLineResetButton
      display inline-flex
      align-items center
      justify-content center

    .instanceIdCopied
      color var(--wren-success)
      text-transform none

    .appInfoLineVersion
      color var(--wren-text-tertiary)
      font-family var(--wren-font-mono)
      font-size var(--wren-type-caption)

    .appInfoViewLicense
      margin 0
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)

      &:hover
        color var(--wren-text-primary)

    .appInfoLineReset
      width auto
      margin 0
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)
      line-height 24px

      &:has(.appInfoLineResetConfirm)
        width 100%
        grid-column 1 / -1

    .appInfoLineResetConfirm
      display flex
      max-width 520px
      margin var(--wren-space-3) auto 0
      padding var(--wren-space-3)
      flex-direction column
      gap var(--wren-space-2)
      border 1px solid rgba(213, 116, 104, .36)
      border-radius var(--wren-radius-sm)
      color var(--wren-text-secondary)
      background var(--wren-danger-soft)
      font-size var(--wren-type-small)
      line-height 18px
      text-align left

      strong
        color var(--wren-text-primary)
        font-size 14px
        font-weight 500

    .appInfoLineResetConfirmButtons
      display flex
      justify-content flex-end
      gap var(--wren-space-2)

      button
        min-height 40px
        padding 0 var(--wren-space-4)

    .appInfoLineResetButton
      padding 0
      color var(--wren-text-muted)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-caption)

      &:hover
        color var(--wren-danger)

// Perch Settings landing: shared Control navigation and stacked real settings cards.
.wrenSettings.wrenSettingsPerch
  color #d6d2c8
  justify-content flex-start

  .localSettingsWrap
    width 100%
    padding 20px 18px 24px
    box-sizing border-box

  .wrenSettingsSection
    position relative
    margin 0 0 12px
    padding 14px 20px 8px
    box-sizing border-box
    border 1px solid rgba(150, 182, 150, .16)
    border-radius 10px
    background linear-gradient(172deg, rgba(255, 255, 255, .022), rgba(255, 255, 255, 0) 46%), rgba(13, 18, 16, .66)
    box-shadow 0 10px 26px rgba(0, 0, 0, .5)

    &::before
      position absolute
      inset 0
      border-radius inherit
      box-shadow inset 1px 1px 0 rgba(150, 182, 150, .05), inset 0 1px 0 rgba(255, 255, 255, .05)
      content ''
      pointer-events none

  .wrenSettingsSection + .wrenSettingsSection
    margin-top 0

  .wrenSettingsSectionTitle
    margin 0
    padding 0 0 6px
    color #97917f
    font-family var(--wren-font-mono)
    font-size 12px
    font-weight 600
    letter-spacing 1.4px
    line-height 18px
    text-transform uppercase

  .localSetting
    min-height 64px
    margin 0
    padding 10px 0
    border 0
    border-bottom 1px solid rgba(150, 182, 150, .10)
    border-radius 0
    background transparent
    box-shadow none

    &:last-child
      border-bottom 0

    &:hover
      background transparent

    .signerPermissionControls
      min-height 44px
      gap 16px

    .signerPermissionSetting
      color #f2efe8
      font-size 14px
      font-weight 500

    .signerPermissionDetails
      position absolute
      width 1px
      height 1px
      margin -1px
      padding 0
      overflow hidden
      clip rect(0 0 0 0)
      clip-path inset(50%)
      white-space nowrap

    .dropdownWrap
      height 44px

  .localSettingShortcut,
  .localSettingExplained
    min-height 72px

    .signerPermissionDetails
      position static
      width auto
      height auto
      margin 3px 60px 0 0
      padding 0
      overflow visible
      clip auto
      clip-path none
      color #97917f
      font-family var(--wren-font-ui)
      font-size 12px
      line-height 18px
      white-space normal

  .interfaceScaleSetting
    min-height 104px

  .interfaceScaleDescription
    display none

  .interfaceScaleStatus
    color #97917f

  .interfaceScaleOptions
    border-color rgba(150, 182, 150, .16)
    border-radius 7px
    background rgba(8, 12, 10, .34)

  .interfaceScaleOption
    color #97917f

    &[aria-pressed='true'],
    &[aria-pressed='true']:hover:not(:disabled),
    &[aria-pressed='true']:active:not(:disabled),
    &[aria-pressed='true']:focus-visible
      color var(--wren-text-primary)
      background var(--wren-bg-elevated)
      border-color transparent
      box-shadow var(--wren-shadow-sm)

  .recoverySettings
    padding 0

  .appInfo
    padding 0

@media (max-height: 760px)
  .wrenSettings
    .localSettingsWrap
      padding-top 0

    .wrenSettingsSection + .wrenSettingsSection
      margin-top var(--wren-space-3)

    .wrenSettingsSectionTitle
      padding-top var(--wren-space-3)

    .localSetting
      min-height 52px
      padding-top 10px
      padding-bottom 10px

    .interfaceScaleSetting
      min-height 96px

@media (max-width: 620px)
  .wrenSettings
    .interfaceScaleHeader
      align-items flex-start
      flex-direction column
      gap var(--wren-space-3)

    .interfaceScaleOptions
      width 100%

    .recoveryOption
      align-items stretch
      flex-direction column
      gap var(--wren-space-3)

      > button
        width 100%

    .recoveryFields
      grid-template-columns 1fr

    .recoveryMetadata
      grid-template-columns 1fr

    .contractVerificationCredentialControls
      width 100%
      align-items stretch
      flex-direction column

    .contractVerificationCredentialActions
      width 100%
      align-items center
      flex-direction row

    .contractVerificationCredentialInput
      width auto

    .contractVerificationCredentialActions button
      width auto
