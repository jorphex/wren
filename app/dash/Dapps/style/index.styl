.connectedApps
  display flow-root
  width 100%
  min-height 100%
  box-sizing border-box
  padding 0 var(--wren-page-gutter) var(--wren-space-8)

.connectedAppsScope
  margin 0 0 var(--wren-space-4)
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  line-height 20px

.sliceTileUsage
  display flex
  align-items center
  justify-content center
  width 100%
  height 100%
  color var(--wren-text-secondary)
  font-size var(--wren-type-caption)
  font-weight 400
  text-transform none

  .sliceTileUsageCount
    display flex
    align-items center
    justify-content center
    margin-right var(--wren-space-2)
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-body)

.sliceOrigin
  appearance none
  display flex
  align-items center
  width 100%
  min-height 60px
  box-sizing border-box
  margin 0
  padding 10px var(--wren-space-3)
  border 0
  border-bottom 1px solid var(--wren-ledger-rule)
  border-radius 0
  color var(--wren-text-primary)
  background transparent
  font-family var(--wren-font-ui)
  font-size var(--wren-type-small)
  text-align left
  cursor pointer
  transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

  *
    pointer-events none

.sliceOriginIdentity
  display flex
  flex 1
  min-width 0
  flex-direction column
  align-items flex-start
  padding 0 var(--wren-space-3) 0 var(--wren-space-3)

  .sliceOriginTitle
    max-width 100%
    overflow hidden
    color var(--wren-text-primary)
    font-weight 500
    text-overflow ellipsis
    white-space nowrap

  .sliceOriginStatus
    margin-top 2px
    color var(--wren-text-tertiary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    line-height 14px

.sliceOrigin:hover
  background var(--wren-ledger-hover)

.sliceOrigin:active
  background var(--wren-surface-active)

.sliceOrigin:focus-visible
  outline 2px solid var(--wren-focus)
  outline-offset 2px

.sliceOriginGroup
  display block

.sliceOriginList
  margin 0 0 var(--wren-space-3)
  overflow hidden
  border 1px solid var(--wren-border-instrument)
  border-radius var(--wren-radius-md)
  background-color var(--wren-surface-instrument)
  background-image var(--wren-control-texture-dark)
  box-shadow var(--wren-shadow-instrument-quiet)

  .sliceOrigin:last-child
    border-bottom 0

.sliceOrigin:disabled
  color var(--wren-text-disabled)
  cursor not-allowed
  opacity .65

.sliceOriginIndicator
  flex 0 0 auto
  width 8px
  height 8px
  border-radius 50%
  background var(--wren-success)

.sliceOriginIndicatorOff
  background var(--wren-text-muted)

.connectedAppsEmpty
  display flex
  flex-direction column
  align-items center
  justify-content center
  min-height 410px
  box-sizing border-box
  padding 28px 24px 48px
  color var(--wren-text-secondary)
  text-align center

  .connectedAppsEmptyArtwork
    display block
    width min(100%, 420px)
    max-height 230px
    margin-bottom var(--wren-space-4)
    object-fit contain

  strong
    color var(--wren-text-primary)
    font-size 18px
    font-weight 600

  span
    max-width 340px
    margin-top 7px
    font-size var(--wren-type-small)
    line-height 20px

.originSwapOrigin
  display flex
  align-items center
  justify-content center
  min-height 112px
  padding var(--wren-space-4)
  box-sizing border-box
  color var(--wren-text-primary)
  font-size var(--wren-type-heading)
  font-weight 500

  .originSwapOriginText
    margin-left var(--wren-space-2)

.originSwapTitle
  padding 0 var(--wren-space-4) var(--wren-space-2)
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  font-weight 500
  text-transform none

.originSwapChainList
  margin var(--wren-space-2)
  padding var(--wren-space-1)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-md)
  background var(--wren-surface-inset)

  .originChainItem
    appearance none
    position relative
    display flex
    align-items center
    width 100%
    min-height 58px
    box-sizing border-box
    margin 0
    padding var(--wren-space-2) 52px var(--wren-space-2) var(--wren-space-2)
    border 1px solid transparent
    border-radius var(--wren-radius-sm)
    color var(--wren-text-primary)
    background transparent
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    font-weight 500
    text-align left
    cursor pointer
    transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

  .originChainItem:hover
    border-color var(--wren-border-default)
    background var(--wren-surface-hover)

  .originChainItem:active
    background var(--wren-surface-active)

  .originChainItem:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  .originChainItem:disabled
    cursor default
    opacity .65

  .originChainItemIcon
    display flex
    align-items center
    justify-content center
    width 36px
    margin-right var(--wren-space-3)

  .originChainItemCheck
    position absolute
    top 50%
    right var(--wren-space-3)
    display flex
    align-items center
    justify-content center
    width 28px
    height 28px
    border-radius var(--wren-radius-sm)
    color var(--wren-success)
    background var(--wren-success-soft)
    transform translateY(-50%)

  .originChainItemActive
    color var(--wren-success)

.connectedAppsDetails
  .originSwapTitle
    padding-right 0
    padding-left 0

  .originSwapChainList
    margin-right 0
    margin-left 0

.originAccessContext
  margin-bottom var(--wren-space-5)

  p
    margin 0
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    line-height 20px

.connectedAppMissing
  display flex
  align-items center
  justify-content center
  min-height 220px
  padding var(--wren-space-6)
  color var(--wren-text-secondary)
  text-align center

@media (max-width: 540px)
  .connectedApps
    padding-right var(--wren-space-3)
    padding-left var(--wren-space-3)
