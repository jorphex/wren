.network
  position relative
  margin 0 var(--wren-space-2)
  overflow hidden
  border 0
  border-radius 0
  background transparent
  box-shadow none

  .signerTop
    min-height 66px
    padding 0

  .networkDetailsTrigger
    appearance none
    align-self stretch
    flex 1 1 auto
    min-width 0
    justify-content flex-start
    gap var(--wren-space-3)
    padding var(--wren-space-3) var(--wren-space-4)
    border 0
    outline none
    color inherit
    background transparent
    font inherit
    text-align left
    cursor pointer
    transition background var(--wren-motion-fast) var(--wren-ease)

    .signerName
      width auto
      min-width 0
      height auto
      padding 0
      color var(--wren-text-primary)
      font-size var(--wren-type-body)
      font-weight 560
      line-height 1.35

    .networkIdentityText
      flex 1 1 auto
      min-width 0

    .networkChainId
      overflow hidden
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)
      line-height 1.35
      text-overflow ellipsis
      white-space nowrap

  .networkDetailsTrigger:hover
    background var(--wren-ledger-hover)

  .networkDetailsTrigger:active
    background var(--wren-surface-active)

  .networkDetailsTrigger:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset -2px

  .networkDetailsChevron
    display flex
    flex none
    align-items center
    justify-content center
    color var(--wren-text-muted)
    transition color var(--wren-motion-fast) var(--wren-ease), transform var(--wren-motion-fast) var(--wren-ease)

  .networkDetailsTrigger:hover .networkDetailsChevron
    color var(--wren-text-secondary)
    transform translateX(1px)

  .signerMenuItems
    align-self stretch
    flex none
    padding-right var(--wren-space-4)

  .chainModules
    .cluster
      margin 0
      padding 0
      border 0
      border-radius 0
      background transparent

    .clusterRow
      gap 0
      margin 0
      border 0

    .clusterRow:empty
      display none

    .clusterValue
      min-height 46px
      border 0
      border-radius 0
      background transparent

    .clusterValueClickable:not(.clusterValueDisabled):hover
      border-color transparent
      background var(--wren-ledger-hover)

    .clusterValueClickable:not(.clusterValueDisabled):active
      border-color transparent
      background var(--wren-surface-active)

.network + .network
  margin-top var(--wren-space-2)

.phaseNetworkLine
  position relative
  height 84px

.localSettings
  position absolute
  inset 0
  display flex
  flex-direction column
  justify-content center
  background var(--wren-bg-canvas)

  .customInput
    width 100%
    height 100%
    box-sizing border-box
    border 0
    outline none
    color var(--wren-text-primary)
    background transparent
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    text-align center

  .phaseNetworkRemove:hover
    background var(--wren-danger)

  .phaseNetworkSubmit
    position absolute
    top 45px
    right 0
    bottom 1px
    width 60px

  .phaseNetworkName
    position absolute
    top 1px
    right 160px
    bottom 40px
    left 0

    input
      font-size var(--wren-type-heading)
      text-align left

  .phaseNetworkSymbol, .phaseNetworkId
    position absolute
    top 0
    bottom 40px
    width 60px

    input
      font-family var(--wren-font-mono)
      font-size var(--wren-type-body)

  .phaseNetworkSymbol
    right 0

  .phaseNetworkId
    right 80px

  .phaseNetworkExplorer
    position absolute
    top 45px
    right 80px
    bottom 0
    left 0

    input
      text-align left

  .localSettingsAddNetwork
    position absolute
    right 145px
    display flex
    align-items center
    justify-content center
    width 28px
    height 28px
    padding 0
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    color var(--wren-text-primary)
    background var(--wren-bg-elevated)
    font-size 20px
    cursor pointer

  .localSettingsAddNetwork:hover
    background var(--wren-surface-hover)

  .localSettingsWrapFadeTop, .localSettingsWrapFadeBot
    display none

  .localSettingsWrap
    position relative
    z-index 2
    overflow-x hidden
    overflow-y auto

  .localSettingsTitle
    display flex
    align-items flex-start
    margin 0
    padding var(--wren-space-4)
    color var(--wren-text-primary)
    font-size var(--wren-type-title)
    font-weight 500

.signerSetting
  display flex
  flex-direction column
  align-items center
  justify-content center
  padding-bottom var(--wren-space-5)

.settingsTitle, .settingsItems
  display flex
  flex-direction column
  align-items center
  justify-content center
  width 100%
  padding var(--wren-space-5)
  box-sizing border-box
  background var(--wren-bg-subtle)

.settingsItem
  display flex
  align-items center
  width 100%
  padding var(--wren-space-5)
  box-sizing border-box

.discordInvite
  appearance none
  display flex
  align-items center
  justify-content center
  width calc(100% - 16px)
  min-height 44px
  margin var(--wren-space-4) var(--wren-space-2)
  padding var(--wren-space-3) var(--wren-space-2)
  border 0
  border-radius 0
  color var(--wren-text-secondary)
  background transparent
  font-family var(--wren-font-ui)
  font-size var(--wren-type-small)
  cursor pointer
  transition background var(--wren-motion-fast) var(--wren-ease)

  .discordLink
    margin-left var(--wren-space-1)
    color var(--wren-accent-primary-hover)

.discordInvite:hover
  background var(--wren-surface-hover)

.discordInvite:focus-visible
  outline 2px solid var(--wren-focus)
  outline-offset -2px

.connectionLevels
  position relative
  width 100%

  .connectionLevel
    position relative

  .connectionTitle
    display flex
    align-items center
    justify-content center
    min-height 28px
    padding 0 var(--wren-space-4)
    color var(--wren-text-tertiary)
    font-size var(--wren-type-caption)
    font-weight 500
    letter-spacing 0
    text-transform none

.infoContainer
  position relative
  margin var(--wren-space-2)
  border-radius var(--wren-radius-sm)
  font-size var(--wren-type-small)

.chainCurrencyItem
  display flex
  align-items center
  justify-content center
  position relative

.chainCurrencyItemSymbol, .sliceChainIdNumber
  font-size var(--wren-type-small)
  font-weight 500

.chainCurrencyItemAt
  margin 0 var(--wren-space-2)
  color var(--wren-success)
  font-size var(--wren-type-caption)

.sliceContainer
  position relative
  margin 0 var(--wren-space-2) var(--wren-space-3)
  padding var(--wren-space-1)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)

  .sliceContainerClose
    display flex
    align-items center
    justify-content center
    min-height 28px
    color var(--wren-text-tertiary)
    cursor pointer

  .sliceTile
    display flex
    align-items center
    justify-content space-between
    min-height 56px
    border-radius var(--wren-radius-sm)
    background var(--wren-bg-elevated)

  .sliceTileHighlight, .sliceTileClickable:hover
    background var(--wren-surface-hover)

.sliceTileConnectionName
  padding 0 var(--wren-space-3)
  color var(--wren-text-primary)
  font-size var(--wren-type-small)
  font-weight 500
  letter-spacing 0
  text-transform none

.networkConnectionSummary
  display flex
  width 100%
  min-height 46px
  box-sizing border-box
  padding 0 var(--wren-space-4)
  align-items center
  justify-content space-between
  gap var(--wren-space-3)

.networkConnectionState
  display flex
  flex 1 1 auto
  min-width 0
  align-items center

  .sliceTileConnectionName
    min-width 0
    overflow hidden
    padding 0 0 0 var(--wren-space-2)
    text-overflow ellipsis
    white-space nowrap

.networkConnectionActive
  flex none
  margin-left var(--wren-space-2)
  color var(--wren-text-tertiary)
  font-size var(--wren-type-caption)

.networkConnectionStats
  display flex
  flex none
  align-items center
  gap var(--wren-space-4)

.networkConnectionStat
  display flex
  align-items baseline
  gap var(--wren-space-1)
  white-space nowrap

.networkConnectionStatLabel
  color var(--wren-text-tertiary)
  font-size var(--wren-type-caption)

.networkConnectionStatValue
  color var(--wren-text-secondary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)
  font-variant-numeric tabular-nums

.networkConnectionGas
  .sliceTileGasPrice
    padding 0

  .sliceTileGasPriceIcon
    display none

  .sliceTileGasPriceNumber,
  .sliceTileGasPriceUnit
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    font-variant-numeric tabular-nums

.sliceTileIndicator, .sliceTileIndicatorLarge
  width 8px
  height 8px
  border-radius 50%
  background var(--wren-success)

.sliceTileIndicatorLarge
  margin-left var(--wren-space-2)

.sliceTileIndicatorActive, .sliceTileIndicatorGood
  background var(--wren-success)

.sliceTileIndicatorPending
  background var(--wren-info)

.sliceTileIndicatorWarning
  background var(--wren-warning)

.sliceTileIndicatorBad
  background var(--wren-danger)

.sliceTileChangeChain
  display flex
  align-items center
  justify-content center
  width 40px
  height 40px
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  cursor pointer

.sliceTileChangeChain:hover
  background var(--wren-surface-hover)

.sliceTileChangeConnected
  color var(--wren-success)
  background var(--wren-success-soft)

.connectionOption
  margin var(--wren-space-1) var(--wren-space-2)
  padding var(--wren-space-3)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-bg-elevated)

  .connectionOptionToggle, .connectionOptionDetailsInset
    display flex
    align-items center
    justify-content space-between

  .connectionOptionDetails
    padding-top var(--wren-space-3)

  .connectionOptionDetailsInset
    min-height 28px
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    text-transform none

  .connectionOptionStatus
    display flex
    align-items center
    min-width 86px
    font-family var(--wren-font-utility)

  .connectionOptionStatusIndicator
    display flex
    align-items center
    margin-right var(--wren-space-2)

    div
      width 8px
      height 8px
      border-radius 50%

  .connectionOptionStatusIndicatorGood
    background var(--wren-success)

  .connectionOptionStatusIndicatorBad
    background var(--wren-danger)

  .connectionOptionStatusIndicatorPending
    background var(--wren-info)

  .connectionOptionStatusIndicatorWarning
    background var(--wren-warning)

  .signerOptionSet
    display flex
    height 26px
    padding 2px
    border 1px solid var(--wren-border-subtle)
    border-radius var(--wren-radius-sm)
    background var(--wren-surface-inset)

    .signerOptionSetButton
      display flex
      align-items center
      justify-content center
      width 28px
      border-radius 3px

.connectionCustomInput
  height 0
  margin 0 var(--wren-space-2)
  overflow hidden
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)
  opacity 0
  transition height var(--wren-motion-standard) var(--wren-ease), opacity var(--wren-motion-fast) var(--wren-ease)

  input
    width 100%
    box-sizing border-box
    padding var(--wren-space-2) var(--wren-space-3)
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    outline none
    color var(--wren-text-primary)
    background var(--wren-surface-inset)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-small)

  input:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.connectionCustomInputOn
  height 40px
  margin-top var(--wren-space-2)
  margin-bottom var(--wren-space-2)
  opacity 1

.mainnetToggleLock
  display flex
  align-items center
  justify-content center
  width 40px
  height 20px
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)

  svg
    color var(--wren-text-muted)

.chainIdBadgeBackground
  display none

.chainIdBadge, .chainSettings
  display flex
  align-items center
  justify-content center
  min-height 24px
  padding 0 var(--wren-space-2)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)

.chainSettings
  cursor pointer

.chainSettings:hover
  background var(--wren-surface-hover)

.networkBreak
  margin-top var(--wren-space-5)
  margin-bottom var(--wren-space-2)
  padding 0 var(--wren-space-4)

.networkBreakLayer
  padding-bottom 0
  color var(--wren-text-secondary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-small)
  font-weight 500
  letter-spacing 0
  text-transform none

.networkBreak:first-child
  padding-top 0

.networkAdd
  padding var(--wren-space-6) 0 var(--wren-space-4)

  .networkAddButton
    min-height 44px
    margin 0 var(--wren-space-2)
    padding var(--wren-space-3)
    border 1px solid var(--wren-border-subtle)
    border-radius var(--wren-radius-sm)
    color var(--wren-text-secondary)
    background var(--wren-bg-elevated)
    font-size var(--wren-type-small)
    font-weight 500
    letter-spacing 0
    text-align center
    text-transform none
    cursor pointer

  .networkAddButton:hover
    border-color var(--wren-border-default)
    color var(--wren-text-primary)
    background var(--wren-surface-hover)

// Perch Networks landing
.dashNetworksPerch
  color #d6d2c8
  justify-content flex-start

  .localSettingsWrap
    width 100%
    padding 20px 18px 24px
    box-sizing border-box

.dashNetworksCard
  padding 14px 20px 8px

.dashNetworksCardHeader
  display grid
  grid-template-columns minmax(0, 1fr) auto auto
  gap 10px
  min-height 50px
  align-items center

  h2
    margin 0

button.dashNetworksAdd.wrenControl
  position relative
  isolation isolate
  display flex
  width 84px
  height 44px
  min-height 44px
  padding 0 13px
  align-items center
  justify-content center
  gap 8px
  border 0
  color #d6d2c8
  background transparent
  box-shadow none
  font-size 13px
  font-weight 500

  &::before
    position absolute
    z-index -1
    inset 6px 0
    border 1px solid rgba(150, 182, 150, .14)
    border-radius 7px
    content ''
    background linear-gradient(178deg, rgba(255, 255, 255, .04), rgba(18, 24, 20, .62))
    box-shadow 0 2px 5px rgba(0, 0, 0, .18), inset 0 -1px 0 rgba(0, 0, 0, .25)

  &:hover:not(:disabled)
    border-color transparent
    background transparent
    box-shadow none

    &::before
      border-color rgba(150, 182, 150, .24)
      background linear-gradient(178deg, rgba(255, 255, 255, .065), rgba(24, 31, 26, .7))

  &:active:not(:disabled)
    transform none

    &::before
      transform translateY(1px)

.dashNetworksLedger
  margin-top 10px

  > div
    display contents

  .network
    margin 0
    border-bottom 1px solid rgba(150, 182, 150, .10)

  .network:last-child
    border-bottom 0

  .network + .network
    margin-top 0

  .network .signerTop
    min-height 62px
    padding 0
    transition background var(--wren-motion-fast) var(--wren-ease)

  .network .signerTop:has(.networkDetailsTrigger:hover)
    background var(--wren-ledger-hover)

  .networkDetailsTrigger
    min-height 62px
    padding 8px 0
    gap 12px

  .networkDetailsTrigger:hover
    background transparent

  .networkDetailsTrigger:active
    background rgba(10, 14, 12, .5)

  .networkDetailsTrigger .signerName
    color #f2efe8
    font-size 14px
    font-weight 500

  .networkDetailsTrigger .networkChainId
    color #97917f
    font-family var(--wren-font-mono)
    font-size 12px

  .networkDetailsChevron
    display none

  .signerIcon
    width 38px
    height 38px
    flex none

  .networkRowStatus
    flex none
    min-width 68px
    color #97917f
    font-family var(--wren-font-mono)
    font-size 12px
    text-align right

  .networkRowStatusConnected
    color #a5ad8f

  .networkRowStatusUnavailable
    color #c98c76

  .signerMenuItems
    padding-right 0
    padding-left 10px

  .networkBreak
    margin 0
    padding 11px 0 5px
    border-bottom 1px solid rgba(150, 182, 150, .10)

  .networkBreakLayer
    color #97917f
    font-family var(--wren-font-mono)
    font-size 10px
    font-weight 600
    letter-spacing 1.2px
    text-transform uppercase

.dashNetworkScopeControls
  position relative
  isolation isolate
  display inline-flex
  gap 0
  height 44px
  padding 0
  border 0
  background transparent

  &::before
    position absolute
    z-index -2
    inset 6px 0
    border 1px solid rgba(150, 182, 150, .12)
    border-radius 7px
    content ''
    background rgba(8, 12, 10, .34)

.dashNetworkScopeButton
  position relative
  isolation isolate
  min-width 54px
  height 44px
  padding 0 12px
  border 0
  color #777c70
  background transparent
  font-family var(--wren-font-mono)
  font-size 12px
  font-weight 500
  cursor pointer

  &::before
    position absolute
    z-index -1
    inset 6px 2px
    border 1px solid transparent
    border-radius 6px
    content ''
    background transparent

  &:hover
    color #d6d2c8

    &::before
      background rgba(150, 182, 150, .035)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 1px

.dashNetworkScopeButtonSelected
  color #d6d2c8

  &::before
    border-color rgba(150, 182, 150, .18)
    background rgba(25, 34, 28, .56)
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .025), 0 2px 5px rgba(0, 0, 0, .16)

.chainConfig
  margin var(--wren-space-1)
  padding var(--wren-space-2)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-bg-elevated)

  .chainConfigRow
    display flex
    justify-content space-between
    gap var(--wren-space-2)
    margin-bottom var(--wren-space-2)

    .chainIdInput
      width 80px

    .chainSymbolInput
      width 102px
      text-transform none

    input
      height 30px
      box-sizing border-box
      padding 0 var(--wren-space-2)
      border 1px solid var(--wren-border-default)
      border-radius var(--wren-radius-sm)
      color var(--wren-text-primary)
      background var(--wren-surface-inset)
      font-size var(--wren-type-small)

.chainData
  padding var(--wren-space-3)

.chainConfigSave, .chainMore
  padding var(--wren-space-2)
  cursor pointer

.appInfo
  display flex
  flex-direction column
  align-items center
  padding var(--wren-space-6) var(--wren-space-4) var(--wren-space-8)
  color var(--wren-text-tertiary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-small)

  button
    appearance none
    border 0
    color inherit
    background transparent
    font-family inherit
    cursor pointer

  button:hover
    color var(--wren-text-primary)

  button:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  .appInfoLine
    display flex
    align-items center
    justify-content center
    text-align center

  .appInfoViewLicense, .appInfoLineReset
    margin-top var(--wren-space-3)
    color var(--wren-text-secondary)
    font-size var(--wren-type-caption)
    font-weight 500
    text-transform none

  .appInfoLineResetConfirmButton:hover, .appInfoLineResetButton:hover
    color var(--wren-danger)

  .appInfoLineVersion, .appInfoLineInstanceId
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)

  .appInfoLineInstanceId
    max-width 100%
    overflow hidden
    color var(--wren-text-tertiary)
    text-overflow ellipsis
    white-space nowrap

  .instanceIdCopied
    color var(--wren-success)
    text-transform none

@import '../Chain/style/index.styl'
