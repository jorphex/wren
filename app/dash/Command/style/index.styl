.command
  height 63px
  position absolute
  top 10px
  left 6px
  right 6px
  z-index 3000000

  .commandTitle
    position absolute 
    left 73px
    right 70px
    top 1px
    bottom 0
    display flex
    justify-content center
    align-items center
    text-transform uppercase
    letter-spacing 2px
    font-weight 500
    font-size 11px

  .commandItem
    height 38px
    width 48px
    top 8px
    border-radius 16px
    display flex
    justify-content center
    align-items center
    -webkit-app-region no-drag
    transition none
    pointer-events auto
    transform translate3d(0, 0, 0)
    background var(--ghostB)
    position absolute
    cursor pointer
    border 3px solid var(--ghostZ)
    color inherit
    padding 0


    *
      pointer-events none

  .commandItem:hover
    background var(--ghostC)

  .commandItem:focus-visible
    box-shadow 0 0 0 2px var(--moon)

  .commandItemBack
    left 14px

  .commandItemClose
    right 14px

.commandBack
  padding 20px
  cursor pointer
  position absolute
  top 0
  left 0
  bottom 0
  width 64px

.commandClose
  padding 20px
  cursor pointer
  position absolute
  top 0
  right 0
  bottom 0
  width 64px

// Wren dashboard chrome
.command
  top 8px
  left 12px
  right 12px
  height 56px

  .commandTitle
    left 58px
    right 58px
    top 0
    color var(--wren-text-secondary)
    font-size 12px
    font-weight 500
    letter-spacing .2px
    text-transform none

  .commandItem
    width 40px
    height 40px
    top 8px
    padding 0
    border 1px solid var(--wren-border-subtle)
    border-radius var(--wren-radius-md)
    color var(--wren-text-secondary)
    background var(--wren-bg-elevated)
    transition background var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease)

    &:hover
      color var(--wren-text-primary)
      background var(--wren-surface-hover)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px
      box-shadow none

  .commandItemBack
    left 0

  .commandItemClose
    right 0
