.command
  height 63px
  position absolute
  top 10px
  left 6px
  right 6px
  z-index 3000000

  .commandTitle
    position absolute 
    left 73px
    right 70px
    top 1px
    bottom 0
    display flex
    justify-content center
    align-items center
    text-transform uppercase
    letter-spacing 2px
    font-weight 500
    font-size var(--wren-type-caption)

  .commandItem
    height 38px
    width 48px
    top 8px
    border-radius 16px
    display flex
    justify-content center
    align-items center
    -webkit-app-region no-drag
    transition none
    pointer-events auto
    transform translate3d(0, 0, 0)
    background var(--ghostB)
    position absolute
    cursor pointer
    border 3px solid var(--ghostZ)
    color inherit
    padding 0


    *
      pointer-events none

  .commandItem:hover
    background var(--ghostC)

  .commandItem:focus-visible
    box-shadow 0 0 0 2px var(--moon)

  .commandItemBack
    left 14px

  .commandItemClose
    right 14px

.commandBack
  padding 20px
  cursor pointer
  position absolute
  top 0
  left 0
  bottom 0
  width 64px

.commandClose
  padding 20px
  cursor pointer
  position absolute
  top 0
  right 0
  bottom 0
  width 64px

// Wren dashboard chrome
.command
  top 0
  left 0
  right 0
  height 64px
  box-sizing border-box
  border-bottom 1px solid rgba(150, 182, 150, .10)
  -webkit-app-region drag

  .commandTitle
    left 76px
    right 76px
    top 0
    min-width 0
    overflow hidden
    justify-content flex-start
    color var(--wren-text-primary)
    font-size 14px
    font-weight 600
    letter-spacing .2px
    text-transform none

    > .expandedSignerTitle
      min-width 0
      max-width 100%
      overflow hidden

      .expandedSignerIcon
        flex none
        color var(--wren-accent-primary-hover)

      .signerName
        min-width 0
        overflow hidden
        text-overflow ellipsis
        white-space nowrap

  .commandItem
    width 40px
    height 40px
    top 12px
    padding 0
    border 0
    border-radius 6px
    color var(--wren-text-secondary)
    background transparent
    -webkit-app-region no-drag
    transition background var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease)

    &:hover
      color var(--wren-accent-primary-hover)
      background var(--wren-surface-hover)
      border-color var(--wren-border-default)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px
      box-shadow none

  .commandItemBack
    left 18px

  .commandItemClose
    right 18px

.command.commandHome
  top 0
  left 0
  right 0
  height 64px
  display flex
  align-items center
  gap 11px
  padding 0 16px 0 20px
  border-bottom 1px solid rgba(150, 182, 150, .10)
  box-sizing border-box
  -webkit-app-region drag

.commandHomeMark
  width 26px
  height 26px
  flex none
  opacity .92

.commandHomeIdentity
  display flex
  height 26px
  min-width 0
  align-items center

  strong
    color #f2efe8
    font-size 14px
    font-weight 600
    letter-spacing .2px
    line-height 18px

.commandHomeSpacer
  flex 1

.commandHomeClose
  display flex
  width 40px
  height 40px
  flex none
  min-width 40px
  min-height 40px
  padding 0
  align-items center
  justify-content center
  -webkit-app-region no-drag
