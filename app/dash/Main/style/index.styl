.loaderWrap
  width: 18.5px;
  height: 18.5px;
  margin-left 10px

@keyframes load
  0%
    transform rotate(0deg)
  100%
    transform rotate(360deg)

.loader,
.loader:after
  border-radius 100%
  width 7em
  height 7em

.loader 
  font-size 2px
  position relative
  text-indent -9999em
  border-top 2px solid var(--outerspace01)
  border-right 2px solid var(--outerspace01)
  border-bottom 2px solid var(--outerspace01)
  border-left 2px solid var(--outerspace08)
  transform translateZ(0)
  animation load 1.1s infinite linear !important

.requestFeature
  padding 0px 0px 0px 0px
  display flex
  justify-content center
  align-items center

  .requestFeatureButton:active
    transform translateY(0px)
    box-shadow 0px 1px 2px var(--ghostY)
    background var(--ghostAZ)

  .requestFeatureButton:hover
    transform translateY(-1px)
    box-shadow 0px 4px 8px var(--ghostY)
    background var(--ghostA)

  .requestFeatureButton
    padding 0px 30px
    border-radius 26px
    height 74px
    font-size 14px
    display flex
    justify-content center
    align-items center
    width 294px
    margin-bottom 8px
    font-weight 400
    cursor pointer
    box-sizing border-box
    background var(--ghostAZ)
    border-bottom 2px solid var(--ghostZ)
    border-top 0
    border-right 0
    border-left 0
    box-shadow 0px 2px 4px var(--ghostY)
    color inherit
    font-family 'MainFont'
    *
      pointer-events none

  .requestFeatureButtonMoon
    color var(--moon)

  .requestFeatureButtonGood
    color var(--good)

.snipIt
  display flex
  flex-direction column
  justify-content center
  align-items center
  transform translateZ(0)
  padding 0px 10px
  font-size 13px
  font-weight 400
  font-family 'MainFont'
  position relative
  z-index 1
  line-height 22px
  margin-bottom 32px
  margin-top 32px

  @keyframes spin
    0% 
      transform rotate(0deg)
    100%
      transform rotate(360deg)

  @keyframes spinReverse
    0% 
      transform rotate(0deg)
    100%
      transform rotate(-360deg)

  .snipItBrowserExtensionIcons
    display flex
    justify-content center
    align-items center
    padding 10px
    width 100%
    
    .snipItBrowserExtensionIcon:active
      transform translateY(0px)
      box-shadow 0px 1px 2px var(--ghostY)
      background var(--ghostA)

    .snipItBrowserExtensionIcon:hover
      transform translateY(-1px)
      box-shadow 0px 4px 8px var(--ghostY)
      background var(--ghostA)

    .snipItBrowserExtensionIcon
      display flex
      justify-content center
      align-items center
      height 74px
      width 74px
      border-radius 26px
      margin 8px
      cursor pointer
      background var(--ghostAZ)
      border-bottom 2px solid var(--ghostZ)
      border-top 0
      border-right 0
      border-left 0
      box-shadow 0px 2px 4px var(--ghostY)
      color inherit
      padding 0

      *
        pointer-events none

// .dashModules
//   .dashModule:first-child
//     border-top-left-radius 26px
//     border-top-right-radius 26px
//   .dashModule:last-child
//     border-bottom-left-radius 26px
