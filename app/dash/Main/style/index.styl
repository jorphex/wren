.dashModule
  height 120px
  margin-bottom 8px
  border-radius 26px
  cursor pointer
  display flex
  justify-content center
  align-items center
  margin 6px
  font-size 18px
  font-weight 300
  border-radius 26px
  background var(--ghostAZ)
  box-shadow 0px 2px 4px var(--ghostY)
  border-bottom 2px solid var(--ghostZ)

  *
    pointer-events none

  .dashModuleIcon
    margin-right 20px

.dashModule:hover
  transform translateY(-1px)
  box-shadow 0px 4px 8px var(--ghostY)
  background var(--ghostA)
  z-index 200
  position relative

.dashModule:active
  transform translateY(0px)
  box-shadow 0px 1px 2px var(--ghostY)
  background var(--ghostB)

button.dashModule
  width calc(100% - 12px)
  border-top 0
  border-right 0
  border-left 0
  color inherit
  font-family 'MainFont'

button.dashModule:focus-visible
  box-shadow 0 0 0 2px var(--moon), 0px 2px 4px var(--ghostY)

button.snipItBrowserExtensionIcon:focus-visible,
button.requestFeatureButton:focus-visible
  box-shadow 0 0 0 2px var(--moon), 0px 2px 4px var(--ghostY)

.signerSettings
  position absolute
  top 10px
  right 0
  bottom 0
  left 0
  transition var(--standard)
  transform translateZ(0)
  overflow hidden

  .signerSlide
    position absolute
    top 50px
    right 0
    left 0
    bottom 0
    transition var(--standard)
    padding-bottom 50px
    overflow-y scroll
    overflow-x hidden
    .signerSubslider
      width 1000%
      display flex
    .signerSubsliderSlide
      width 10%
    .signerSubsliderSlideMessage
      padding 20px
      display flex
      flex-direction column
      justify-content flex-start
      align-items center
      text-align center
    .renameAccountButtonWrap
      padding 10px
      display flex
      justify-content center
      align-items center
      text-align center

  .signerSettingsTitle:before
    content ''
    position absolute
    bottom -2px
    right 10px
    left 10px
    height 4px
    border-radius 2px
    background var(--thin)

  .signerSettingsTitle
    position relative
    display flex
    align-items flex-end
    justify-content space-between
    height 40px
    font-size 22px
    padding 0px 10px 10px 10px

.signerSettingsHidden
  left 100%
  right -100%

.signerPermission
  position relative
  justify-content space-between
  padding 12px 0px 0px 0px 
  font-size 15px
  font-weight 300
  transform translateZ(0)
  z-index 2000
  border-radius 26px
  background var(--ghostA)
  box-shadow 0px 4px 6px var(--ghostY)
  border-bottom 2px solid var(--ghostZ)

  .signerPermissionControls
    display flex
    position relative
    justify-content space-between
    transform translateZ(0)
    z-index 40

  .signerPermissionDetails
    display flex
    position relative
    justify-content space-between
    transform translateZ(0)
    font-size 13px
    padding 12px 0px 0px 1px
    z-index 20
    font-weight 300
    font-family 'MainFont'
    line-height 18px

  .keyCommand
    margin-left 5px
    padding 1px 6px 2px 6px
    font-weight 400
    border-radius 5px
    font-size 12px
    border 1px solid var(--outerspace05)
    color var(--outerspace)
    height 30px

  .keyCommandLoading
    margin-left 5px
    padding 1px 6px 2px 6px
    font-weight 400
    border-radius 5px
    font-size 12px
    border 1px solid var(--outerspace05)
    color var(--outerspace)
    height 30px

  .nodeProviderStatus
    display flex
    justify-content center
    align-items center
    height 18px
    border-radius 10px
    font-size 10px
    text-transform uppercase
    padding-left 8px
    padding-right 8px
    background var(--bad)
    padding-bottom 1px
    font-weight 400
    color #f3f6fd
    text-shadow 0px 1px 2px rgba(100, 0, 0, 0.2), 0px 1px 0px rgba(100, 0, 0, 0.2)
    transform translateZ(0)

  .nodeProviderConnected
    background var(--good)
    text-shadow 0px 1px 2px rgba(0, 50, 50, 0.2), 0px 1px 0px rgba(0, 50, 50, 0.2)

  .signerPermissionOrigin
    background transparent
    width 250px
    direction rtl
    text-overflow ellipsis
    overflow hidden
    text-align left
    white-space nowrap
    font-weight 300
    margin-top 2px

  .signerPermissionNoPermissions
    font-weight 300
    text-align center
    width 100%
    font-size 14px

  .signerPermissionSetting
    background transparent
    width 250px
    direction rtl
    text-overflow ellipsis
    overflow hidden
    text-align left
    white-space nowrap
    font-family 'MainFont'
    font-weight 300
    font-size 18px
    position relative
    padding-top 4px

.localSetting
  background var(--ghostAZ)
  border-radius 27px
  margin 6px
  padding 20px
  box-shadow 0px 4px 8px var(--ghostY)

.addCustomTokenButton
  padding 0px
  margin-bottom 6px
  border-radius 12px
  height 46px
  font-size 13px
  text-transform uppercase
  font-weight 400
  letter-spacing 1px
  display flex
  justify-content center
  align-items center
  background var(--ghostA)
  transition var(--standardFast)
  cursor pointer
  box-sizing border-box
  box-shadow 0px 4px 8px var(--ghostY)
  * 
    pointer-events none

.addCustomTokenButton:hover
  background var(--ghostB)

.signerPermissionToggle
  position relative
  background var(--bad)
  height 20px
  width 40px
  margin-right 6px
  margin-left 12px
  margin-top 4px
  border-radius 10px
  transition var(--standard)
  transform translateZ(0)
  cursor pointer

  .signerPermissionToggleSwitch
    position absolute
    top 2px
    left 2px
    bottom 2px
    width 16px
    border-radius 10px
    transition var(--standard)
    background var(--ghostC)
    transform translateZ(0)
    pointer-events none
    border-bottom 2px solid var(--ghostZ)

  .signerPermissionToggleSwitchLocked
    position absolute
    top 0px
    left 0px
    bottom 0px
    right 0px
    border-radius 10px
    display flex
    align-items center
    justify-content center
    cursor pointer
    *
      pointer-events none

    .signerPermissionToggleSwitch
      opacity 1
      transition var(--standard)

    svg
      transition var(--standard)
      opacity 0
      color var(--ghostC)

  .signerPermissionToggleSwitchLocked:hover
    .signerPermissionToggleSwitch
      opacity 0

    svg
      opacity 1

.signerPermissionToggleOn
  background var(--good)
  .signerPermissionToggleSwitch
    position absolute
    transform translateX(20px)

.signerPermissionToggle:hover
  .signerPermissionToggleSwitch
    background var(--ghostD)

.signerPermissionToggleSmall
  position relative
  background var(--bad)
  height 14px
  width 30px
  border-radius 10px
  transition var(--standard)
  transform translateZ(0)
  margin-top 2px
  margin-right 4px
  cursor pointer

  .signerPermissionToggleSwitch
    position absolute
    top 2px
    left 2px
    bottom 2px
    width 10px
    border-radius 10px
    transition var(--standard)
    background var(--ghostC)
    transform translateZ(0)
    box-shadow 0px 3px 3px 0px var(--tripleThick) 
    pointer-events none

.signerPermissionToggleSmallOn
  background var(--good)

  .signerPermissionToggleSwitch
    position absolute
    transform translateX(16px)

.signerPermissionToggleSmall:hover
  .signerPermissionToggleSwitch
    background var(--ghostD)

// Wren dashboard home
.localSettings
  justify-content flex-start

  .localSettingsWrap
    width 100%
    padding var(--wren-space-5) var(--wren-space-4) var(--wren-space-8)
    box-sizing border-box

.dashHomeHeader
  padding var(--wren-space-2) var(--wren-space-2) var(--wren-space-5)

  h1
    margin var(--wren-space-1) 0 var(--wren-space-2)
    color var(--wren-text-primary)
    font-size 28px
    font-weight 500
    letter-spacing -.6px
    line-height 34px

  p
    max-width 480px
    margin 0
    color var(--wren-text-secondary)
    font-size 14px
    line-height 20px

.dashHomeEyebrow
  color var(--wren-accent-primary-hover)
  font-size 10px
  font-weight 500
  letter-spacing 1.4px
  text-transform uppercase

.dashModuleSection
  margin-bottom var(--wren-space-5)

  h2
    margin 0 var(--wren-space-2) var(--wren-space-2)
    color var(--wren-text-tertiary)
    font-size 11px
    font-weight 500
    letter-spacing 1.2px
    text-transform uppercase

.dashModuleList
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--wren-space-2)

.dashModuleSection:first-child .dashModuleList
  grid-template-columns repeat(3, minmax(0, 1fr))

button.dashModule
  position relative
  display grid
  grid-template-columns 28px minmax(0, 1fr) 16px
  column-gap var(--wren-space-2)
  width 100%
  height 68px
  margin 0
  padding var(--wren-space-2)
  align-items center
  border 0
  border-radius 4px
  color var(--wren-text-primary)
  background transparent
  box-shadow none
  font-family var(--wren-font-ui)
  text-align left
  transition background var(--wren-motion-fast) var(--wren-ease)

  &:hover
    z-index auto
    transform none
    background var(--wren-surface-hover)
    box-shadow none

  &:active
    transform none
    background var(--wren-surface-active)
    box-shadow none

  &:focus-visible
    z-index 1
    outline 2px solid var(--wren-focus)
    outline-offset -2px
    box-shadow none

  .dashModuleIcon
    position static
    display flex
    flex none
    width 24px
    height 24px
    margin 0
    align-items center
    justify-content center
    color var(--wren-accent-primary-hover)
    background transparent

  .dashModuleCopy
    position static
    display flex
    min-width 0
    flex none
    flex-direction column
    gap 3px

  .dashModuleTitle
    font-size 14px
    font-weight 500
    line-height 18px

  .dashModuleDescription
    overflow hidden
    color var(--wren-text-tertiary)
    font-size 12px
    font-weight 300
    line-height 16px
    display -webkit-box
    min-height 32px
    overflow hidden
    -webkit-box-orient vertical
    -webkit-line-clamp 2

  .dashModuleArrow
    position static
    display flex
    justify-self end
    margin 0
    color var(--wren-text-muted)
    transition transform var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease)

  &:hover .dashModuleArrow
    color var(--wren-text-secondary)
    transform translateX(2px)

.dashModuleSection:first-child button.dashModule
  height 60px

  .dashModuleDescription
    display none

.dashCompanion
  display flex
  min-height 72px
  margin-bottom var(--wren-space-3)
  padding var(--wren-space-3) var(--wren-space-2)
  align-items center
  gap var(--wren-space-3)
  border 0
  background transparent
  box-sizing border-box

.dashCompanionCopy
  min-width 0
  flex 1

  h2
    margin 0 0 var(--wren-space-1)
    font-size 14px
    font-weight 500

  p
    margin 0
    color var(--wren-text-tertiary)
    font-size 12px
    line-height 17px

.dashCompanion .snipItBrowserExtensionIcons
  display flex
  flex none
  gap var(--wren-space-2)

  .snipItBrowserExtensionIcon
    display flex
    width 38px
    height 38px
    padding 0
    align-items center
    justify-content center
    border 0
    border-radius 4px
    color var(--wren-text-secondary)
    background transparent
    cursor pointer
    transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

    &:hover
      background var(--wren-surface-hover)

.dashSupportActions
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap var(--wren-space-2)
  margin-bottom var(--wren-space-6)

  .requestFeatureButton
    min-height 38px
    padding 0 var(--wren-space-3)
    border 0
    border-radius 4px
    color var(--wren-text-secondary)
    background transparent
    font-family var(--wren-font-ui)
    font-size 12px
    cursor pointer

    &:hover
      color var(--wren-text-primary)
      background var(--wren-surface-hover)

  .requestFeatureButtonDanger:hover
    color var(--wren-danger)
    background var(--wren-danger-soft)

.localSettings .appInfo
  padding var(--wren-space-4) var(--wren-space-2) var(--wren-space-2)
  border-top 1px solid var(--wren-border-subtle)
  color var(--wren-text-muted)
  font-size 11px

  .appInfoLineInstanceId
    width 100%
    max-width 100%
    margin 0 0 var(--wren-space-3)
    overflow hidden
    color var(--wren-text-muted)
    font-family var(--wren-font-mono)
    font-size 10px
    text-align center
    text-overflow ellipsis
    text-transform none
    white-space nowrap

  .appInfoLineVersion
    color var(--wren-text-tertiary)
    font-family var(--wren-font-mono)
    font-size 11px

  .appInfoViewLicense
    margin-top var(--wren-space-3)
    color var(--wren-text-tertiary)
    font-size 10px

  .appInfoLineReset
    margin var(--wren-space-2) 0 0
    color var(--wren-text-tertiary)
    font-size 10px
    line-height 24px

  .appInfoLineResetButton
    padding 0
    color var(--wren-text-muted)
    background transparent
    border 0
    font-family var(--wren-font-ui)
    font-size 10px
    cursor pointer

    &:hover
      color var(--wren-danger)
