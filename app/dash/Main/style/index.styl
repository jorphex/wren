.loaderWrap
  width: 18.5px;
  height: 18.5px;
  margin-left 10px

@keyframes load
  0%
    transform rotate(0deg)
  100%
    transform rotate(360deg)

.loader,
.loader:after
  border-radius 100%
  width 7em
  height 7em

.loader 
  font-size 2px
  position relative
  text-indent -9999em
  border-top 2px solid var(--outerspace01)
  border-right 2px solid var(--outerspace01)
  border-bottom 2px solid var(--outerspace01)
  border-left 2px solid var(--outerspace08)
  transform translateZ(0)
  animation load 1.1s infinite linear !important

.dashModule
  height 120px
  margin-bottom 8px
  border-radius 26px
  cursor pointer
  display flex
  justify-content center
  align-items center
  margin 6px
  font-size 18px
  font-weight 300
  border-radius 26px
  background var(--ghostAZ)
  box-shadow 0px 2px 4px var(--ghostY)
  border-bottom 2px solid var(--ghostZ)

  *
    pointer-events none

  .dashModuleIcon
    margin-right 20px

.dashModule:hover
  transform translateY(-1px)
  box-shadow 0px 4px 8px var(--ghostY)
  background var(--ghostA)
  z-index 200
  position relative

.dashModule:active
  transform translateY(0px)
  box-shadow 0px 1px 2px var(--ghostY)
  background var(--ghostB)

button.dashModule
  width calc(100% - 12px)
  border-top 0
  border-right 0
  border-left 0
  color inherit
  font-family 'MainFont'

button.dashModule:focus-visible
  box-shadow 0 0 0 2px var(--moon), 0px 2px 4px var(--ghostY)

button.requestFeatureButton:focus-visible
  box-shadow 0 0 0 2px var(--moon), 0px 2px 4px var(--ghostY)

.signerPermission
  position relative
  justify-content space-between
  padding 12px 0px 0px 0px 
  font-size 15px
  font-weight 300
  transform translateZ(0)
  z-index 2000
  border-radius 26px
  background var(--ghostA)
  box-shadow 0px 4px 6px var(--ghostY)
  border-bottom 2px solid var(--ghostZ)

  .signerPermissionControls
    display flex
    position relative
    justify-content space-between
    transform translateZ(0)
    z-index 40

  .signerPermissionDetails
    display flex
    position relative
    justify-content space-between
    transform translateZ(0)
    font-size 13px
    padding 12px 0px 0px 1px
    z-index 20
    font-weight 300
    font-family 'MainFont'
    line-height 18px

  .keyCommand
    margin-left 5px
    padding 1px 6px 2px 6px
    font-weight 400
    border-radius 5px
    font-size var(--wren-type-small)
    border 1px solid var(--outerspace05)
    color var(--outerspace)
    height 30px

  .keyCommandLoading
    margin-left 5px
    padding 1px 6px 2px 6px
    font-weight 400
    border-radius 5px
    font-size var(--wren-type-small)
    border 1px solid var(--outerspace05)
    color var(--outerspace)
    height 30px

  .nodeProviderStatus
    display flex
    justify-content center
    align-items center
    height 18px
    border-radius 10px
    font-size var(--wren-type-caption)
    text-transform uppercase
    padding-left 8px
    padding-right 8px
    background var(--bad)
    padding-bottom 1px
    font-weight 400
    color #f3f6fd
    text-shadow 0px 1px 2px rgba(100, 0, 0, 0.2), 0px 1px 0px rgba(100, 0, 0, 0.2)
    transform translateZ(0)

  .nodeProviderConnected
    background var(--good)
    text-shadow 0px 1px 2px rgba(0, 50, 50, 0.2), 0px 1px 0px rgba(0, 50, 50, 0.2)

  .signerPermissionOrigin
    background transparent
    width 250px
    direction rtl
    text-overflow ellipsis
    overflow hidden
    text-align left
    white-space nowrap
    font-weight 300
    margin-top 2px

  .signerPermissionNoPermissions
    font-weight 300
    text-align center
    width 100%
    font-size 14px

  .signerPermissionSetting
    background transparent
    width 250px
    direction rtl
    text-overflow ellipsis
    overflow hidden
    text-align left
    white-space nowrap
    font-family 'MainFont'
    font-weight 300
    font-size 18px
    position relative
    padding-top 4px

.localSetting
  background var(--ghostAZ)
  border-radius 27px
  margin 6px
  padding 20px
  box-shadow 0px 4px 8px var(--ghostY)

.signerPermissionToggle
  appearance none
  border 0
  padding 0
  position relative
  background var(--bad)
  height 20px
  width 40px
  margin-right 6px
  margin-left 12px
  margin-top 4px
  border-radius 2px
  transition var(--standard)
  transform translateZ(0)
  cursor pointer

  &:disabled
    cursor default

  .signerPermissionToggleSwitch
    position absolute
    top 2px
    left 2px
    bottom 2px
    width 16px
    border-radius 1px
    transition var(--standard)
    background var(--ghostC)
    transform translateZ(0)
    pointer-events none
    border-bottom 2px solid var(--ghostZ)

  .signerPermissionToggleSwitchLocked
    position absolute
    top 0px
    left 0px
    bottom 0px
    right 0px
    border-radius 2px
    display flex
    align-items center
    justify-content center
    cursor pointer
    *
      pointer-events none

    .signerPermissionToggleSwitch
      opacity 1
      transition var(--standard)

    svg
      transition var(--standard)
      opacity 0
      color var(--ghostC)

  .signerPermissionToggleSwitchLocked:hover
    .signerPermissionToggleSwitch
      opacity 0

    svg
      opacity 1

.signerPermissionToggleOn
  background var(--good)
  .signerPermissionToggleSwitch
    position absolute
    transform translateX(20px)

.signerPermissionToggle:hover
  .signerPermissionToggleSwitch
    background var(--ghostD)

// Wren dashboard home
.localSettings
  justify-content flex-start

  .localSettingsWrap
    width 100%
    padding var(--wren-space-5) var(--wren-page-gutter) var(--wren-space-8)
    box-sizing border-box

  .localSetting
    margin 0 0 var(--wren-space-2)
    padding var(--wren-space-4)
    border 1px solid var(--wren-border-subtle)
    border-radius var(--wren-radius-sm)
    background var(--wren-surface-card)
    box-shadow var(--wren-shadow-sm), var(--wren-shadow-inset)

    .signerPermissionSetting
      width auto
      max-width calc(100% - 90px)
      color var(--wren-text-primary)
      font-size 15px
      font-weight 500
      text-transform none

    .signerPermissionDetails
      padding-top var(--wren-space-2)
      color var(--wren-text-tertiary)
      font-size 13px
      line-height 18px

    .keyCommand,
    .keyCommandLoading
      min-height 28px
      height auto
      border-color var(--wren-border-default)
      border-radius var(--wren-radius-sm)
      color var(--wren-text-secondary)
      background var(--wren-surface-inset)
      font-family var(--wren-font-mono)

  .localSetting:last-of-type
    margin-bottom 0

.dashHomeHeader
  display grid
  padding var(--wren-space-2) var(--wren-space-2) var(--wren-space-5)
  grid-template-columns minmax(0, 1fr) 96px
  align-items center
  column-gap var(--wren-space-4)

  h1
    margin 0 0 var(--wren-space-2)
    color var(--wren-text-primary)
    font-size 28px
    font-weight 500
    letter-spacing -.6px
    line-height 34px

  p
    max-width 480px
    margin 0
    color var(--wren-text-secondary)
    font-size 14px
    line-height 20px

.dashHomeIntro
  min-width 0

.dashHomeWren
  display block
  width 96px
  height 96px
  flex none
  justify-self end
  object-fit contain
  pointer-events none
  user-select none

.dashModuleSection
  min-width 0
  margin 0

  h2
    margin 0 var(--wren-space-2) var(--wren-space-2)
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    font-weight 500
    letter-spacing 0
    line-height 18px
    text-transform none

.dashModuleList
  display grid
  grid-template-columns minmax(0, 1fr)
  gap var(--wren-space-2)

.dashModules
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--wren-space-5)
  margin-bottom var(--wren-space-5)

button.dashModule.wrenControl
  position relative
  display grid
  grid-template-columns 28px minmax(0, 1fr) 16px
  column-gap var(--wren-space-2)
  width 100%
  min-height 72px
  height auto
  margin 0
  padding var(--wren-space-2)
  align-items center
  border 0
  border-radius 4px
  color var(--wren-text-primary)
  background transparent
  box-shadow none
  font-family var(--wren-font-ui)
  text-align left
  transition background var(--wren-motion-fast) var(--wren-ease)

  &:hover
    z-index auto
    transform none
    background var(--wren-surface-hover)
    box-shadow none

  &:active
    transform none
    background var(--wren-surface-active)
    box-shadow none

  &:focus-visible
    z-index 1
    outline 2px solid var(--wren-focus)
    outline-offset -2px
    box-shadow none

button.dashModule.wrenControl.wrenControlGhost
  border-color transparent
  background-color transparent
  background-image none
  box-shadow none

  &:hover:not(:disabled)
    border-color transparent
    background-color var(--wren-surface-hover)
    background-image none
    box-shadow none

  &:active:not(:disabled)
    transform none
    background-color var(--wren-surface-active)
    box-shadow none

  .dashModuleIcon
    position static
    display flex
    flex none
    width 24px
    height 24px
    margin 0
    align-items center
    justify-content center
    color var(--wren-accent-primary-hover)
    background transparent

  .dashModuleCopy
    position static
    display flex
    min-width 0
    flex none
    flex-direction column
    gap 3px

  .dashModuleTitle
    font-size 14px
    font-weight 500
    line-height 18px

  .dashModuleDescription
    color var(--wren-text-tertiary)
    font-size var(--wren-type-small)
    font-weight 300
    line-height 16px
    white-space normal

  .dashModuleArrow
    position static
    display flex
    justify-self end
    margin 0
    color var(--wren-text-muted)
    transition transform var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease)

  &:hover .dashModuleArrow
    color var(--wren-text-secondary)
    transform translateX(2px)

.dashCompanion
  display flex
  min-height 72px
  margin-bottom var(--wren-space-3)
  padding var(--wren-space-3) var(--wren-space-2) var(--wren-space-3) calc(var(--wren-space-2) + 28px + var(--wren-space-2))
  align-items center
  gap var(--wren-space-3)
  border 0
  background transparent
  box-sizing border-box

.dashCompanionCopy
  min-width 0
  flex 1

  h2
    margin 0 0 var(--wren-space-1)
    font-size 14px
    font-weight 500

  p
    margin 0
    color var(--wren-text-tertiary)
    font-size var(--wren-type-small)
    line-height 17px

.dashCompanionBrowserActions
  display flex
  flex none
  gap var(--wren-space-2)

.dashSupportWrenDisclosure
  position relative
  min-width 0

button.dashSupportWrenButton.wrenControl
  width 100%
  min-height 44px
  padding 0 var(--wren-space-3)
  gap var(--wren-space-1)
  color var(--wren-text-secondary)
  white-space nowrap

.dashSupportWrenPreview
  position absolute
  left 0
  bottom calc(100% - 1px)
  z-index 20001
  width 217px
  padding var(--wren-space-3)
  box-sizing border-box
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  color var(--wren-text-primary)
  background-color var(--wren-bg-elevated)
  background-image var(--wren-control-texture-dark)
  box-shadow var(--wren-shadow-lg), var(--wren-shadow-inset)
  animation cardShow var(--wren-motion-fast) var(--wren-ease) both

  &::after
    content ''
    position absolute
    left 28px
    bottom -5px
    width 9px
    height 9px
    border-right 1px solid var(--wren-border-default)
    border-bottom 1px solid var(--wren-border-default)
    background var(--wren-bg-elevated)
    transform rotate(45deg)

.dashSupportWrenQrCode
  display block
  width 185px
  max-width 100%
  height auto
  margin 0 auto

.dashSupportWrenAddress
  margin-top var(--wren-space-2)
  overflow-wrap anywhere
  color var(--wren-text-secondary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)
  line-height 1.45

.dashSupportWrenPreviewNote
  margin var(--wren-space-2) 0 0
  color var(--wren-text-tertiary)
  font-size var(--wren-type-caption)
  line-height 1.45

.dashSupportWrenStatus
  position absolute
  width 1px
  height 1px
  overflow hidden
  clip rect(0 0 0 0)
  white-space nowrap

.dashSupportActions
  display flex
  flex-direction row
  align-items center
  justify-content space-evenly
  padding-top var(--wren-space-3)
  margin-bottom var(--wren-space-6)

  button.requestFeatureButton.wrenControl
    min-height 44px
    padding 0 var(--wren-space-2)
    gap var(--wren-space-1)
    font-size var(--wren-type-caption)
    white-space nowrap

@media (max-height: 760px)
  .localSettings .localSettingsWrap
    padding-top var(--wren-space-3)
    padding-bottom var(--wren-space-3)

  .dashHomeHeader
    padding-bottom var(--wren-space-3)

  .dashModules
    margin-bottom var(--wren-space-3)

  button.dashModule
    min-height 68px

  .dashCompanion
    min-height 58px
    margin-bottom var(--wren-space-1)
    padding-top var(--wren-space-2)
    padding-bottom var(--wren-space-2)

  .dashSupportActions
    margin-bottom var(--wren-space-2)

@media (max-width: 560px)
  .dashHomeHeader
    grid-template-columns minmax(0, 1fr)
    column-gap 0

  .dashHomeWren
    display none

  .dashModules
    grid-template-columns minmax(0, 1fr)
    gap var(--wren-space-4)
