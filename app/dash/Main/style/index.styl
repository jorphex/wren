.loaderWrap
  width: 18.5px;
  height: 18.5px;
  margin-left 10px

@keyframes load
  0%
    transform rotate(0deg)
  100%
    transform rotate(360deg)

.loader,
.loader:after
  border-radius 100%
  width 7em
  height 7em

.loader 
  font-size 2px
  position relative
  text-indent -9999em
  border-top 2px solid var(--outerspace01)
  border-right 2px solid var(--outerspace01)
  border-bottom 2px solid var(--outerspace01)
  border-left 2px solid var(--outerspace08)
  transform translateZ(0)
  animation load 1.1s infinite linear

.dashModule
  height 120px
  margin-bottom 8px
  border-radius 26px
  cursor pointer
  display flex
  justify-content center
  align-items center
  margin 6px
  font-size 18px
  font-weight 300
  border-radius 26px
  background var(--ghostAZ)
  box-shadow 0px 2px 4px var(--ghostY)
  border-bottom 2px solid var(--ghostZ)

  *
    pointer-events none

  .dashModuleIcon
    margin-right 20px

.dashModule:hover
  transform translateY(-1px)
  box-shadow 0px 4px 8px var(--ghostY)
  background var(--ghostA)
  z-index 200
  position relative

.dashModule:active
  transform translateY(0px)
  box-shadow 0px 1px 2px var(--ghostY)
  background var(--ghostB)

button.dashModule
  width calc(100% - 12px)
  border-top 0
  border-right 0
  border-left 0
  color inherit
  font-family 'MainFont'

button.dashModule:focus-visible
  box-shadow 0 0 0 2px var(--moon), 0px 2px 4px var(--ghostY)

button.requestFeatureButton:focus-visible
  box-shadow 0 0 0 2px var(--moon), 0px 2px 4px var(--ghostY)

.signerPermission
  position relative
  justify-content space-between
  padding 12px 0px 0px 0px 
  font-size 15px
  font-weight 300
  transform translateZ(0)
  z-index 2000
  border-radius 26px
  background var(--ghostA)
  box-shadow 0px 4px 6px var(--ghostY)
  border-bottom 2px solid var(--ghostZ)

  .signerPermissionControls
    display flex
    position relative
    justify-content space-between
    transform translateZ(0)
    z-index 40

  .signerPermissionDetails
    display flex
    position relative
    justify-content space-between
    transform translateZ(0)
    font-size 13px
    padding 12px 0px 0px 1px
    z-index 20
    font-weight 300
    font-family 'MainFont'
    line-height 18px

  .keyCommand
    margin-left 5px
    padding 1px 6px 2px 6px
    font-weight 400
    border-radius 5px
    font-size var(--wren-type-small)
    border 1px solid var(--outerspace05)
    color var(--outerspace)
    height 30px

  .keyCommandLoading
    margin-left 5px
    padding 1px 6px 2px 6px
    font-weight 400
    border-radius 5px
    font-size var(--wren-type-small)
    border 1px solid var(--outerspace05)
    color var(--outerspace)
    height 30px

  .nodeProviderStatus
    display flex
    justify-content center
    align-items center
    height 18px
    border-radius 10px
    font-size var(--wren-type-caption)
    text-transform uppercase
    padding-left 8px
    padding-right 8px
    background var(--bad)
    padding-bottom 1px
    font-weight 400
    color #f3f6fd
    text-shadow 0px 1px 2px rgba(100, 0, 0, 0.2), 0px 1px 0px rgba(100, 0, 0, 0.2)
    transform translateZ(0)

  .nodeProviderConnected
    background var(--good)
    text-shadow 0px 1px 2px rgba(0, 50, 50, 0.2), 0px 1px 0px rgba(0, 50, 50, 0.2)

  .signerPermissionOrigin
    background transparent
    width 250px
    direction rtl
    text-overflow ellipsis
    overflow hidden
    text-align left
    white-space nowrap
    font-weight 300
    margin-top 2px

  .signerPermissionNoPermissions
    font-weight 300
    text-align center
    width 100%
    font-size 14px

  .signerPermissionSetting
    background transparent
    width 250px
    direction rtl
    text-overflow ellipsis
    overflow hidden
    text-align left
    white-space nowrap
    font-family 'MainFont'
    font-weight 300
    font-size 18px
    position relative
    padding-top 4px

.localSetting
  background var(--ghostAZ)
  border-radius 27px
  margin 6px
  padding 20px
  box-shadow 0px 4px 8px var(--ghostY)

.signerPermissionToggle
  appearance none
  border 0
  padding 0
  position relative
  background var(--bad)
  height 20px
  width 40px
  margin-right 6px
  margin-left 12px
  margin-top 4px
  border-radius 2px
  transition var(--standard)
  transform translateZ(0)
  cursor pointer

  &:disabled
    cursor default

  .signerPermissionToggleSwitch
    position absolute
    top 2px
    left 2px
    bottom 2px
    width 16px
    border-radius 1px
    transition var(--standard)
    background var(--ghostC)
    transform translateZ(0)
    pointer-events none
    border-bottom 2px solid var(--ghostZ)

  .signerPermissionToggleSwitchLocked
    position absolute
    top 0px
    left 0px
    bottom 0px
    right 0px
    border-radius 2px
    display flex
    align-items center
    justify-content center
    cursor pointer
    *
      pointer-events none

    .signerPermissionToggleSwitch
      opacity 1
      transition var(--standard)

    svg
      transition var(--standard)
      opacity 0
      color var(--ghostC)

  .signerPermissionToggleSwitchLocked:hover
    .signerPermissionToggleSwitch
      opacity 0

    svg
      opacity 1

.signerPermissionToggleOn
  background var(--good)
  .signerPermissionToggleSwitch
    position absolute
    transform translateX(20px)

.signerPermissionToggle:hover
  .signerPermissionToggleSwitch
    background var(--ghostD)

// Wren dashboard home
.localSettings
  justify-content flex-start

  .localSettingsWrap
    width 100%
    padding var(--wren-space-5) var(--wren-page-gutter) var(--wren-space-8)
    box-sizing border-box

  .localSetting
    margin 0 0 var(--wren-space-2)
    padding var(--wren-space-4)
    border 1px solid var(--wren-border-subtle)
    border-radius var(--wren-radius-sm)
    background var(--wren-surface-card)
    box-shadow var(--wren-shadow-sm), var(--wren-shadow-inset)

    .signerPermissionSetting
      width auto
      max-width calc(100% - 90px)
      color var(--wren-text-primary)
      font-size 15px
      font-weight 500
      text-transform none

    .signerPermissionDetails
      padding-top var(--wren-space-2)
      color var(--wren-text-tertiary)
      font-size 13px
      line-height 18px

    .keyCommand,
    .keyCommandLoading
      min-height 28px
      height auto
      border-color var(--wren-border-default)
      border-radius var(--wren-radius-sm)
      color var(--wren-text-secondary)
      background var(--wren-surface-inset)
      font-family var(--wren-font-mono)

  .localSetting:last-of-type
    margin-bottom 0

.dashHomePerch
  color #d6d2c8

  .localSettingsWrap
    width 100%
    padding 2px 18px 16px
    box-sizing border-box

.dashModules
  display flex
  flex-direction column
  gap 8px
  margin-bottom 12px

button.dashModule.wrenControl
  position relative
  display grid
  grid-template-columns 30px minmax(0, 1fr) auto
  gap 12px
  width 100%
  height 50px
  min-height 50px
  margin 0
  padding 0 15px
  align-items center
  border 1px solid rgba(150, 182, 150, .16)
  border-radius 10px
  color #d6d2c8
  background rgba(13, 18, 16, .55)
  box-shadow 0 6px 14px rgba(0, 0, 0, .3)
  font-family var(--wren-font-ui)
  text-align left
  transform none

  &:hover:not(:disabled)
    z-index auto
    border-color rgba(150, 182, 150, .22)
    background rgba(20, 26, 22, .6)
    box-shadow 0 6px 14px rgba(0, 0, 0, .3)
    transform none

  &:active:not(:disabled)
    background rgba(10, 14, 12, .72)
    transform translateY(1px)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px
    box-shadow 0 6px 14px rgba(0, 0, 0, .3)

  .dashModuleIcon
    position static
    display flex
    width 30px
    height 30px
    margin 0
    align-items center
    justify-content center
    border 1px solid rgba(150, 182, 150, .22)
    border-radius 8px
    color #d6d2c8
    background #121813
    box-sizing border-box

  .dashModuleCopy
    position static
    display block
    min-width 0

  .dashModuleTitle
    display block
    color inherit
    font-size 14px
    font-weight 500
    line-height 18px

  .dashModuleDescription
    position absolute
    width 1px
    height 1px
    overflow hidden
    clip rect(0 0 0 0)
    white-space nowrap

  .dashModuleMeta
    color #6d7568
    font-family var(--wren-font-mono)
    font-size 12px
    font-weight 400

  .dashModuleArrow
    display flex
    color #6d7568

button.dashModule.wrenControl.wrenControlGhost
  border-color rgba(150, 182, 150, .16)
  background-color rgba(13, 18, 16, .55)
  background-image none
  box-shadow 0 6px 14px rgba(0, 0, 0, .3)

  &:hover:not(:disabled)
    border-color rgba(150, 182, 150, .22)
    background-color rgba(20, 26, 22, .6)
    background-image none
    box-shadow 0 6px 14px rgba(0, 0, 0, .3)

button.dashModuleCurrent.wrenControl
  border-color rgba(168, 116, 63, .13)
  background linear-gradient(180deg, rgba(168, 116, 63, .10), rgba(13, 18, 16, .55))
  box-shadow inset 0 0 0 1px rgba(168, 116, 63, .34), 0 6px 14px rgba(0, 0, 0, .3)

  .dashModuleTitle
    color #f2efe8

  .dashModuleIcon
    border-color rgba(168, 116, 63, .13)
    color #c08d54

.dashHomeCard
  position relative
  margin-bottom 12px
  padding 16px
  border 1px solid rgba(150, 182, 150, .16)
  border-radius 10px
  background linear-gradient(172deg, rgba(255, 255, 255, .022), rgba(255, 255, 255, 0) 46%), rgba(13, 18, 16, .66)
  box-shadow 0 10px 26px rgba(0, 0, 0, .5)
  box-sizing border-box

  &::before
    position absolute
    inset 0
    border-radius inherit
    box-shadow inset 1px 1px 0 rgba(150, 182, 150, .05), inset 0 1px 0 rgba(255, 255, 255, .05)
    content ''
    pointer-events none

  h2
    margin 0 0 12px
    color #97917f
    font-family var(--wren-font-mono)
    font-size 12px
    font-weight 600
    letter-spacing 1.4px
    line-height 16px
    text-transform uppercase

.dashCompanionCopy
  p
    margin 0
    padding 2px
    color #97917f
    font-size 12.5px
    line-height 1.5

.dashCompanionBrowserActions
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 9px
  margin-top 12px

  button.wrenControl.wrenControlGhost
    width 100%
    height 40px
    min-height 40px
    border 1px solid rgba(135, 168, 128, .22)
    border-radius 10px
    color #d6d2c8
    background linear-gradient(178deg, rgba(255, 255, 255, .03), rgba(15, 20, 17, .6))
    box-shadow inset 0 -1px 0 rgba(0, 0, 0, .4)
    font-size 12.5px

    &:hover:not(:disabled)
      border-color rgba(135, 168, 128, .3)
      background-color transparent
      background linear-gradient(178deg, rgba(255, 255, 255, .05), rgba(20, 26, 22, .6))
      box-shadow inset 0 -1px 0 rgba(0, 0, 0, .4)

    span
      font-size 12.5px

.dashSupportWrenDisclosure
  position relative
  min-width 0

button.dashSupportWrenButton.wrenControl
  width 100%
  min-height 44px
  padding 0 var(--wren-space-3)
  gap var(--wren-space-1)
  color var(--wren-text-secondary)
  white-space nowrap

.dashSupportWrenPreview
  position absolute
  left 0
  bottom calc(100% - 1px)
  z-index 20001
  width 217px
  padding var(--wren-space-3)
  box-sizing border-box
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  color var(--wren-text-primary)
  background-color var(--wren-bg-elevated)
  background-image var(--wren-control-texture-dark)
  box-shadow var(--wren-shadow-lg), var(--wren-shadow-inset)
  animation cardShow var(--wren-motion-fast) var(--wren-ease) both

  &::after
    content ''
    position absolute
    left 28px
    bottom -5px
    width 9px
    height 9px
    border-right 1px solid var(--wren-border-default)
    border-bottom 1px solid var(--wren-border-default)
    background var(--wren-bg-elevated)
    transform rotate(45deg)

.dashSupportWrenQrCode
  display block
  width 185px
  max-width 100%
  height auto
  margin 0 auto

.dashSupportWrenAddress
  margin-top var(--wren-space-2)
  overflow-wrap anywhere
  color var(--wren-text-secondary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)
  line-height 1.45

.dashSupportWrenPreviewNote
  margin var(--wren-space-2) 0 0
  color var(--wren-text-tertiary)
  font-size var(--wren-type-caption)
  line-height 1.45

.dashSupportWrenStatus
  position absolute
  width 1px
  height 1px
  overflow hidden
  clip rect(0 0 0 0)
  white-space nowrap

.dashSupportActions
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap 8px
  margin-bottom 0

  button.requestFeatureButton.wrenControl
    justify-content center
    width 100%
    height 48px
    min-height 48px
    padding 0 10px
    gap 7px
    border 1px solid rgba(150, 182, 150, .16)
    border-radius 9px
    color #d6d2c8
    background linear-gradient(178deg, rgba(255, 255, 255, .025), rgba(13, 18, 16, .62))
    box-shadow 0 5px 12px rgba(0, 0, 0, .28), inset 0 -1px 0 rgba(0, 0, 0, .35)
    font-size 12px
    font-weight 500
    white-space nowrap

    &:hover:not(:disabled)
      color #f2efe8
      border-color rgba(150, 182, 150, .24)
      background linear-gradient(178deg, rgba(255, 255, 255, .045), rgba(20, 26, 22, .64))
      box-shadow 0 6px 14px rgba(0, 0, 0, .32), inset 0 -1px 0 rgba(0, 0, 0, .35)

  .dashSupportWrenDisclosure
    min-width 0

    button.requestFeatureButton.wrenControl
      padding 0 8px

  .requestFeatureDanger
    color #df8377 !important
    border-color rgba(223, 131, 119, .18) !important
    background linear-gradient(178deg, rgba(223, 131, 119, .055), rgba(18, 12, 11, .5)) !important

.dashToolsCard
  margin-bottom 12px

.dashToolList
  display flex
  flex-direction column

  button.dashModuleCompact.wrenControl
    height 44px
    min-height 44px
    padding 0
    grid-template-columns 30px minmax(0, 1fr) auto
    border 0
    border-bottom 1px solid rgba(150, 182, 150, .10)
    border-radius 0
    background transparent
    box-shadow none

    &:last-child
      border-bottom 0

    &:hover:not(:disabled)
      border-color rgba(150, 182, 150, .10)
      background transparent
      box-shadow none

    .dashModuleIcon
      border 0
      color #97917f
      background transparent

@media (max-height: 760px)
  .dashHomePerch .localSettingsWrap
    padding-bottom 12px

@media (max-width: 560px)
  .dashCompanionBrowserActions
    grid-template-columns minmax(0, 1fr)

  .dashSupportActions
    grid-template-columns repeat(2, minmax(0, 1fr))
