.newTokenView
  width 100%
  min-height 100%
  padding var(--wren-space-5) var(--wren-space-6) var(--wren-space-8)
  box-sizing border-box
  color var(--wren-text-primary)
  background transparent
  font-family var(--wren-font-ui)

.newTokenFormInner
  width 100%
  max-width 520px
  margin 0 auto

.newTokenTitle
  margin 0
  padding var(--wren-space-3) 0 var(--wren-space-5)
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-title)
  font-weight 620
  line-height 1.2

.newTokenChainSelectChain
  width 100%

.newTokenView .originSwapChainList
  border-top 1px solid var(--wren-ledger-rule)

  .originChainItem
    appearance none
    display flex
    width 100%
    min-height 52px
    padding 0 var(--wren-space-3)
    box-sizing border-box
    align-items center
    border 0
    border-bottom 1px solid var(--wren-ledger-rule)
    color var(--wren-text-primary)
    background transparent
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    font-weight 500
    text-align left
    cursor pointer
    transition background var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease)

    .originChainItemIcon
      display flex
      width 32px
      height 32px
      margin-right var(--wren-space-3)
      align-items center
      justify-content center

    &:hover:not(:disabled)
      background var(--wren-ledger-hover)

    &:active:not(:disabled)
      background var(--wren-surface-active)

    &:focus-visible
      position relative
      z-index 1
      outline 2px solid var(--wren-focus)
      outline-offset -2px

    &:disabled
      color var(--wren-text-disabled)
      cursor default
      opacity .65

.newTokenEmpty
  min-height 88px
  display flex
  align-items center
  justify-content center
  border-top 1px solid var(--wren-ledger-rule)
  border-bottom 1px solid var(--wren-ledger-rule)
  color var(--wren-text-tertiary)
  font-size var(--wren-type-body)

.newTokenChainSelectFooter
  display flex
  margin-top var(--wren-space-5)
  justify-content flex-start

  .newTokenEnableChainLink
    min-height 44px

.newTokenForm,
.addToken
  display grid
  gap var(--wren-space-5)

.newTokenNetwork
  color var(--wren-text-tertiary)
  font-size var(--wren-type-small)
  font-weight 500

.newTokenContext
  display flex
  min-height 44px
  margin-bottom var(--wren-space-5)
  padding var(--wren-space-2) 0
  box-sizing border-box
  align-items center
  justify-content space-between
  gap var(--wren-space-3)
  border-top 1px solid var(--wren-ledger-rule)
  border-bottom 1px solid var(--wren-ledger-rule)

.newTokenChainAddress
  display flex
  min-width 0
  align-items center
  color var(--wren-text-secondary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-small)

  svg
    margin 0 var(--wren-space-1)

.tokenFieldRow
  display grid
  grid-template-columns minmax(0, 1fr) minmax(112px, .62fr)
  gap var(--wren-space-4)

.tokenInputLabel
  display grid
  min-width 0
  gap var(--wren-space-2)
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  font-weight 590
  text-align left

.tokenInput
  width 100%
  min-height 44px
  padding 0 var(--wren-space-3)
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-body)
  font-weight 400
  text-align left

.tokenInputAddress
  font-family var(--wren-font-mono)
  font-size var(--wren-type-small)

.newTokenActions
  display flex
  min-height 44px
  justify-content flex-end
  gap var(--wren-space-3)

  .wrenControl
    min-height 44px

.newTokenSaveError
  padding var(--wren-space-3)
  border 1px solid var(--wren-danger)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)
  color var(--wren-danger)
  font-size var(--wren-type-small)
  line-height 1.45

.newTokenError
  display flex
  min-height 240px
  flex-direction column
  justify-content center

  .newTokenTitle
    max-width 460px
    color var(--wren-danger)
    font-size var(--wren-type-heading)
    line-height 1.35

  .newTokenActions
    justify-content flex-start

.newTokenLoading
  display flex
  min-height 180px
  flex-direction column
  align-items center
  justify-content center
  gap var(--wren-space-4)
  color var(--wren-text-secondary)
  font-size var(--wren-type-body)

  .signerLoading
    position relative
    width 40px
    height 40px

@media (max-height: 760px)
  .newTokenView
    padding-top var(--wren-space-3)
    padding-bottom var(--wren-space-5)

  .newTokenTitle
    padding-bottom var(--wren-space-4)

  .newTokenForm,
  .addToken
    gap var(--wren-space-4)

  .newTokenContext
    margin-bottom var(--wren-space-4)

@media (max-width: 520px)
  .tokenFieldRow
    grid-template-columns 1fr

  .newTokenContext
    align-items flex-start
    flex-direction column
