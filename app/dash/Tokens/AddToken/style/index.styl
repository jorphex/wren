.addTokenTop
  display flex
  justify-content center
  align-items center
  flex-direction column

.addTokenTitle
  padding var(--wren-space-8) 0 var(--wren-space-6)
  color var(--wren-text-primary)
  font-size var(--wren-type-title)
  font-weight 500

.addToken
  position relative
  z-index 3
  width 100%
  padding-bottom var(--wren-space-8)
  box-sizing border-box
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-body)
  word-break break-word

.newTokenView
  min-height 100%
  width 100%
  display flex
  justify-content center
  align-items center
  flex-direction column
  padding var(--wren-space-6)
  box-sizing border-box
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)

.newTokenChainSelectTitle
  display flex
  justify-content center
  align-items center
  flex-direction column
  padding-bottom var(--wren-space-6)
  color var(--wren-text-primary)
  font-size var(--wren-type-heading)
  font-weight 500
  text-align center

.newTokenErrorTitle
  max-width 440px
  margin-bottom var(--wren-space-5)
  color var(--wren-danger)
  font-size var(--wren-type-body)
  font-weight 500
  line-height 22px
  text-align center

.newTokenChainAddress
  color var(--wren-text-secondary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-body)

  svg
    margin 0 var(--wren-space-1)

.newTokenChainSelectChain
  width 100%
  max-width 480px

.newTokenView .originSwapChainList
  padding var(--wren-space-1)
  background var(--wren-bg-elevated)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-md)

  .originChainItem
    appearance none
    width 100%
    min-height 48px
    display flex
    align-items center
    padding 0 var(--wren-space-3)
    border 1px solid transparent
    border-radius var(--wren-radius-sm)
    background transparent
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    font-weight 500
    text-align left
    cursor pointer
    transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

    .originChainItemIcon
      width 28px
      height 28px
      display flex
      justify-content center
      align-items center
      margin-right var(--wren-space-3)

  .originChainItem:hover
    background var(--wren-surface-hover)
    border-color var(--wren-border-default)

  .originChainItem:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  .originChainItem:disabled
    color var(--wren-text-disabled)
    cursor default
    opacity .65

  .originChainItem:disabled:hover
    background transparent
    border-color transparent

.newTokenChainSelectSubtitle
  margin-top var(--wren-space-1)
  color var(--wren-text-tertiary)
  font-size var(--wren-type-small)
  font-weight 400

.newTokenChainSelectFooter
  margin var(--wren-space-6) 0
  color var(--wren-text-tertiary)
  font-size var(--wren-type-small)
  line-height 18px
  text-align center

  .newTokenEnableChainLink
    appearance none
    padding 0
    margin-left var(--wren-space-1)
    border 0
    background transparent
    color var(--wren-accent-secondary-hover)
    font-family inherit
    font-size inherit
    font-weight 500
    cursor pointer

  .newTokenEnableChainLink:hover
    color var(--wren-accent-primary-hover)
    text-decoration underline

  .newTokenEnableChainLink:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  .newTokenEnableChainLink:disabled
    color var(--wren-text-disabled)
    cursor default

  .newTokenEnableChainLink:disabled:hover
    color var(--wren-text-disabled)
    text-decoration none

.tokenRow
  width 100%
  display flex
  justify-content space-between
  gap var(--wren-space-2)
  padding 0 var(--wren-space-1) var(--wren-space-5)
  box-sizing border-box

.tokenRow:last-child
  padding-bottom 0

.tokenName,
.tokenAddress,
.tokenLogoUri,
.tokenExplorer,
.tokenRpc
  width 100%
  text-align center

.tokenChainId
  width calc(35% - 4px)

.tokenDecimals,
.tokenSymbol
  width calc(50% - 4px)
  text-align center

.tokenInput
  width 100%
  min-height 44px
  padding 0 var(--wren-space-3)
  box-sizing border-box
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  outline none
  background var(--wren-surface-inset)
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-body)
  font-weight 400
  text-align center
  transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

  &.dropdown
    margin-top var(--wren-space-3)
    padding 0

.tokenInput:hover:not(:disabled)
  border-color var(--wren-border-strong)
  background var(--wren-bg-elevated)

.tokenInput:focus-visible
  border-color var(--wren-focus)
  outline 2px solid var(--wren-focus)
  outline-offset 2px

.tokenInput:disabled
  color var(--wren-text-disabled)
  cursor default
  opacity .65

.tokenInputLabel
  display flex
  flex-direction column
  gap var(--wren-space-2)
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  font-weight 500
  text-align left

.tokenInputDim
  color var(--wren-text-tertiary) !important

.tokenInputAddress
  font-family var(--wren-font-mono)
  font-size var(--wren-type-small)

.tokenSetAddress
  appearance none
  min-height 38px
  margin-top var(--wren-space-2)
  padding 0 var(--wren-space-5)
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  background var(--wren-bg-elevated)
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-small)
  font-weight 500
  cursor pointer
  transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

.tokenSetAddress:hover
  background var(--wren-surface-hover)
  border-color var(--wren-border-strong)

.tokenSetAddress:focus-visible,
.addTokenSubmit:focus-visible
  outline 2px solid var(--wren-focus)
  outline-offset 2px

.tokenSetAddress:disabled
  color var(--wren-text-disabled)
  cursor default
  opacity .65

.tokenSetAddress:disabled:hover
  background var(--wren-bg-elevated)
  border-color var(--wren-border-default)

.addTokenSubmit
  appearance none
  min-height 44px
  display flex
  justify-content center
  align-items center
  margin auto
  padding 0 var(--wren-space-5)
  box-sizing border-box
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  background var(--wren-bg-elevated)
  color var(--wren-text-disabled)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-body)
  font-weight 500
  text-align center
  pointer-events none

  span
    opacity .65

  svg
    margin-right var(--wren-space-2)

.addTokenSubmitEnabled
  border-color var(--wren-accent-primary)
  background var(--wren-accent-primary)
  color var(--wren-text-inverse)
  cursor pointer
  pointer-events auto
  transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

  span
    pointer-events none
    opacity 1

.addTokenSubmitEnabled:hover
  background var(--wren-accent-primary-hover)
  border-color var(--wren-accent-primary-hover)

.addTokenSubmit:disabled
  cursor default
  opacity .65

.addTokenSubmitEnabled:disabled
  border-color var(--wren-border-default)
  background var(--wren-bg-elevated)
  color var(--wren-text-disabled)

.addTokenSubmitEnabled:disabled:hover
  border-color var(--wren-border-default)
  background var(--wren-bg-elevated)
