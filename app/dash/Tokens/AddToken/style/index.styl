.newTokenView
  width 100%
  padding var(--wren-space-5) var(--wren-space-6) var(--wren-space-8)
  box-sizing border-box
  color var(--wren-text-primary)
  background transparent
  font-family var(--wren-font-ui)

.newTokenFormInner
  width 100%
  max-width 520px
  margin 0 auto
  padding 0 20px 20px
  box-sizing border-box
  overflow hidden
  border 1px solid rgba(150, 182, 150, .16)
  border-radius 10px
  background var(--wren-surface-card)
  box-shadow 0 12px 28px rgba(0, 0, 0, .42), inset 1px 1px 0 rgba(150, 182, 150, .04)

.newTokenTitle
  margin 0
  padding var(--wren-space-4) 0 var(--wren-space-5)
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-title)
  font-weight 620
  line-height 1.2

.newTokenChainSelectChain
  width 100%

.newTokenEmpty
  min-height 88px
  display flex
  align-items center
  justify-content center
  margin var(--wren-space-2)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-md)
  background var(--wren-surface-inset)
  color var(--wren-text-tertiary)
  font-size var(--wren-type-body)

.newTokenChainSelectFooter
  display flex
  margin-top var(--wren-space-5)
  justify-content flex-start

  .newTokenEnableChainLink
    min-height 44px

.newTokenForm,
.addToken
  display grid
  gap var(--wren-space-5)

.newTokenDetails
  display grid
  gap var(--wren-space-5)
  margin-top var(--wren-space-1)
  padding-top var(--wren-space-4)
  border-top 1px solid var(--wren-ledger-rule)

.newTokenDetailsTitle
  margin 0
  color var(--wren-text-primary)
  font-size var(--wren-type-heading)
  font-weight 600
  line-height 1.3

.newTokenLookupStatus
  display flex
  min-height 20px
  margin-top calc(-1 * var(--wren-space-3))
  align-items center
  gap var(--wren-space-2)
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  line-height 1.4

.newTokenLookupStatus-ready
  color var(--wren-success)

.newTokenLookupStatus-checking
  color var(--wren-warning)

  svg
    animation newTokenLookupChecking var(--wren-motion-slow) linear infinite

.newTokenLookupStatus-error
  color var(--wren-danger)

@keyframes newTokenLookupChecking
  to
    transform rotate(360deg)

@media (prefers-reduced-motion: reduce)
  .newTokenLookupStatus-checking svg
    animation none

.newTokenNetwork
  color var(--wren-text-tertiary)
  font-size var(--wren-type-small)
  font-weight 500

.newTokenContext
  display flex
  min-height 44px
  margin-bottom var(--wren-space-5)
  padding var(--wren-space-2) 0
  box-sizing border-box
  align-items center
  justify-content space-between
  gap var(--wren-space-3)
  border-top 1px solid var(--wren-ledger-rule)
  border-bottom 1px solid var(--wren-ledger-rule)

.newTokenChainAddress
  display flex
  min-width 0
  align-items center
  color var(--wren-text-secondary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-small)

  svg
    margin 0 var(--wren-space-1)

.tokenFieldRow
  display grid
  grid-template-columns minmax(0, 1fr) minmax(112px, .62fr)
  gap var(--wren-space-4)

.tokenInputLabel
  display grid
  min-width 0
  gap var(--wren-space-2)
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  font-weight 590
  text-align left

.tokenInput
  width 100%
  min-height 44px
  padding 0 var(--wren-space-3)
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-body)
  font-weight 400
  text-align left

.tokenInputAddress
  font-family var(--wren-font-mono)
  font-size var(--wren-type-small)

.newTokenActions
  display flex
  min-height 44px
  justify-content flex-end
  gap var(--wren-space-3)

  .wrenControl
    min-height 44px

.newTokenSaveError
  padding var(--wren-space-3)
  border 1px solid var(--wren-danger)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)
  color var(--wren-danger)
  font-size var(--wren-type-small)
  line-height 1.45

@media (max-height: 760px)
  .newTokenView
    padding-top var(--wren-space-3)
    padding-bottom var(--wren-space-5)

  .newTokenTitle
    padding-bottom var(--wren-space-4)

  .newTokenForm,
  .addToken
    gap var(--wren-space-4)

  .newTokenContext
    margin-bottom var(--wren-space-4)

@media (max-width: 520px)
  .tokenFieldRow
    grid-template-columns 1fr

  .newTokenContext
    align-items flex-start
    flex-direction column
