.customTokens
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)

  .customTokensTitle
    min-height 47px
    display flex
    justify-content space-between
    align-items center
    padding 0 var(--wren-space-3)
    color var(--wren-text-primary)
    font-size var(--wren-type-body)
    font-weight 500
    border-bottom 1px solid var(--wren-border-subtle)

    .customTokensAddToken
      appearance none
      min-height 30px
      display flex
      justify-content center
      align-items center
      padding 0 var(--wren-space-3)
      border 1px solid var(--wren-border-default)
      border-radius var(--wren-radius-sm)
      background var(--wren-bg-elevated)
      color var(--wren-text-primary)
      font-family inherit
      font-size var(--wren-type-small)
      font-weight 500
      cursor pointer
      transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

      *
        pointer-events none

    .customTokensAddToken:hover
      background var(--wren-surface-hover)
      border-color var(--wren-border-strong)

    .customTokensAddToken:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

  .customTokensFooter
    position absolute
    right 0
    bottom 0
    left 0
    min-height 64px
    display flex
    justify-content center
    align-items center
    color var(--wren-text-secondary)
    font-size var(--wren-type-body)
    font-weight 500

  .customTokensList
    padding var(--wren-space-3) 0
    border-top 1px solid var(--wren-ledger-rule)
    z-index 2

  .customTokensListNoTokens
    display flex
    flex-direction column
    justify-content center
    align-items center
    gap var(--wren-space-2)
    min-height 260px
    padding var(--wren-space-4) var(--wren-space-6) var(--wren-space-6)
    color var(--wren-text-tertiary)
    font-size var(--wren-type-small)
    text-align center

    img
      display block
      width min(410px, 100%)
      height 150px
      object-fit cover
      object-position center

    strong
      color var(--wren-text-primary)
      font-size var(--wren-type-body)
      font-weight 550

    span
      max-width 300px
      line-height 19px

  .customTokensListItem
    position relative
    box-sizing border-box
    min-height 58px
    overflow hidden
    border-bottom 1px solid var(--wren-ledger-rule)
    background transparent
    transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

    &:last-child
      border-bottom 0

    .customTokensListItemTitle
      min-height 58px
      display flex
      justify-content space-between
      align-items center
      padding var(--wren-space-2) var(--wren-space-3)
      box-sizing border-box

      .customTokensListItemExpand
        appearance none
        width 30px
        height 30px
        margin-left var(--wren-space-2)
        padding 6px
        box-sizing border-box
        border 1px solid var(--wren-border-default)
        border-radius var(--wren-radius-sm)
        background var(--wren-bg-elevated)
        color var(--wren-text-secondary)
        cursor pointer
        transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease), transform var(--wren-motion-fast) var(--wren-ease)
        transform rotate(-180deg)

        *
          pointer-events none

      .customTokensListItemExpand:hover
        background var(--wren-surface-hover)
        border-color var(--wren-border-strong)
        color var(--wren-text-primary)

      .customTokensListItemExpand:focus-visible
        outline 2px solid var(--wren-focus)
        outline-offset 2px

      .customTokensListItemExpand:disabled
        color var(--wren-text-disabled)
        cursor default
        opacity .6

      .customTokensListItemExpandActive
        transform rotate(0deg)

      .customTokensListItemName
        min-width 0
        display flex
        align-items center
        color var(--wren-text-primary)
        font-weight 500

        img
          width 28px
          height 28px
          margin-right var(--wren-space-3)
          border 1px solid var(--wren-border-default)
          border-radius var(--wren-radius-sm)
          background var(--wren-bg-elevated)
          object-fit contain

        .customTokensListItemText
          min-width 0
          display flex
          flex-direction column
          align-items flex-start

        .customTokensListItemSymbol
          max-width 100%
          overflow hidden
          color var(--wren-text-primary)
          font-size var(--wren-type-body)
          font-weight 500
          line-height 18px
          text-overflow ellipsis
          white-space nowrap

        .customTokensListItemSub
          max-width 100%
          margin-top 2px
          overflow hidden
          color var(--wren-text-tertiary)
          font-size var(--wren-type-small)
          line-height 16px
          text-overflow ellipsis
          white-space nowrap

      .customTokensListItemChain
        display flex
        align-items center
        color var(--wren-text-secondary)
        font-family var(--wren-font-mono)
        font-size var(--wren-type-small)

    .customTokensListItemChainLabel
      margin-right var(--wren-space-1)
      color var(--wren-text-tertiary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-small)

    .customTokensListItemAddress
      appearance none
      width calc(100% - 24px)
      min-height 32px
      display flex
      justify-content center
      align-items center
      margin 0 var(--wren-space-3)
      padding 0 var(--wren-space-2)
      overflow hidden
      border 1px solid var(--wren-border-default)
      border-radius var(--wren-radius-sm)
      background var(--wren-surface-inset)
      color var(--wren-text-secondary)
      font-family var(--wren-font-mono)
      font-size var(--wren-type-small)
      text-overflow ellipsis
      white-space nowrap
      cursor pointer
      transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease)

    .customTokensListItemAddress:hover
      background var(--wren-surface-hover)
      border-color var(--wren-border-strong)
      color var(--wren-text-primary)

    .customTokensListItemAddress:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

    .customTokensListItemAddress:disabled
      color var(--wren-text-disabled)
      cursor default
      opacity .6

    .customTokensListItemAddress:disabled:hover
      background var(--wren-surface-inset)
      border-color var(--wren-border-default)

    .customTokensCopyStatus
      position absolute
      width 1px
      height 1px
      padding 0
      margin -1px
      overflow hidden
      clip rect(0, 0, 0, 0)
      white-space nowrap
      border 0

    .customTokensListItemBottom
      height 48px
      display flex
      align-items center
      gap var(--wren-space-2)
      padding 0 var(--wren-space-3)

      .customTokensListItemButton
        appearance none
        width 50%
        min-height 30px
        display flex
        justify-content center
        align-items center
        box-sizing border-box
        padding 0 var(--wren-space-2)
        border 1px solid var(--wren-border-default)
        border-radius var(--wren-radius-sm)
        background var(--wren-bg-elevated)
        color var(--wren-text-primary)
        font-family inherit
        font-size var(--wren-type-small)
        font-weight 500
        cursor pointer
        transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

        *
          pointer-events none

      .customTokensListItemButton:hover
        background var(--wren-surface-hover)
        border-color var(--wren-border-strong)

      .customTokensListItemButton:focus-visible
        outline 2px solid var(--wren-focus)
        outline-offset 2px

      .customTokensListItemButton:disabled,
      .customTokensListItemButton[aria-disabled='true']
        color var(--wren-text-disabled)
        cursor default
        opacity .6

      .customTokensListItemButton:disabled:hover,
      .customTokensListItemButton[aria-disabled='true']:hover
        background var(--wren-bg-elevated)
        border-color var(--wren-border-default)

      .editButton
        color var(--wren-accent-secondary-hover)

      .removeButton
        color var(--wren-danger)

  .customTokensListItemExpanded
    min-height 146px
    background var(--wren-bg-elevated)
    border-color var(--wren-border-default)

  .customTokensListItemChainDecimal
    display flex
    justify-content center
    align-items center
    color var(--wren-text-secondary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-small)
