.contracts
  width 100%
  min-height 100%
  box-sizing border-box
  padding var(--wren-space-4) var(--wren-page-gutter) 0
  overflow-x clip
  color var(--wren-text-primary)

.contractsModeSwitch.sendModeSwitch
  margin 0 0 var(--wren-space-3)

.contractsPanel[hidden]
  display none

.contractsPanel
  min-width 0
  box-sizing border-box
  padding 0 2px

  > .deployment,
  > .contractVerification
    min-height 0
    overflow-x visible
    padding-right 0
    padding-left 0

  > .deployment .deploymentActionShelf,
  > .contractVerification .contractVerificationActionShelf
    margin-right 0
    margin-left 0
    padding-right 0
    padding-left 0

@media (max-width: 540px)
  .contracts
    padding-right var(--wren-space-3)
    padding-left var(--wren-space-3)
