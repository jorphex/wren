.addressBook, .addressBookEditor
  min-height 100%
  box-sizing border-box
  padding var(--wren-space-6) var(--wren-page-gutter) var(--wren-space-8)
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)

.addressBook
  display flex
  flex-direction column

.addressBookHeader, .addressBookEditorHeader
  display flex
  align-items flex-start
  justify-content space-between
  gap var(--wren-space-4)
  padding 0 var(--wren-space-1) var(--wren-space-5)

  h2
    margin 0 0 var(--wren-space-2)
    color var(--wren-text-primary)
    font-size 20px
    font-weight 500
    font-variation-settings var(--wren-font-heading-settings)
    line-height 24px

  p
    max-width 310px
    margin 0
    color var(--wren-text-secondary)
    font-size 13px
    line-height 19px

.addressBookCount
  min-width 32px
  height 32px
  display flex
  align-items center
  justify-content center
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  background var(--wren-bg-elevated)
  color var(--wren-text-secondary)
  font-family var(--wren-font-utility)
  font-size 13px

.addressBookToolbar
  display block
  margin-bottom var(--wren-space-4)

  input
    height 44px
    box-sizing border-box
    border-radius var(--wren-radius-md)
    font-family var(--wren-font-ui)
    font-size 14px

  input
    min-width 0
    padding 0 var(--wren-space-3)
    border 1px solid var(--wren-border-default)
    outline none
    background var(--wren-surface-inset)
    color var(--wren-text-primary)
    transition border-color var(--wren-motion-fast) var(--wren-ease), background var(--wren-motion-fast) var(--wren-ease)

    &::placeholder
      color var(--wren-text-muted)

    &:hover
      border-color var(--wren-border-strong)
      background var(--wren-bg-subtle)

    &:focus-visible
      border-color var(--wren-focus)
      outline 2px solid var(--wren-focus)
      outline-offset 2px

.addressBookSearch
  display flex
  min-width 0
  height 44px
  box-sizing border-box
  align-items center
  gap var(--wren-space-2)
  padding 0 var(--wren-space-3)
  color var(--wren-text-muted)

  input.wrenInput
    min-width 0
    height 44px
    flex 1
    padding 0
    border 0
    border-radius 0
    background transparent
    box-shadow none

    &:hover,
    &:focus-visible
      border 0
      outline 0
      background transparent
      box-shadow none

.addressBookList
  display flex
  flex-direction column
  gap 0

.addressBookRow
  display grid
  grid-template-columns minmax(0, 1fr) 54px 76px
  min-height 82px
  overflow hidden
  border 0
  border-bottom 1px solid var(--wren-ledger-rule)
  border-radius 0
  background transparent

  &:last-child
    border-bottom 0

.addressBookCardMain, .addressBookEdit, .addressBookRemove
  border 0
  color inherit
  font-family var(--wren-font-ui)
  cursor pointer

.addressBookCardMain
  min-width 0
  display flex
  align-items center
  gap var(--wren-space-3)
  padding var(--wren-space-2) var(--wren-space-3)
  background transparent
  text-align left
  transition background var(--wren-motion-fast) var(--wren-ease)

  &:hover
    background var(--wren-surface-hover)

  &:active
    background var(--wren-surface-active)

  &:focus-visible
    position relative
    z-index 1
    outline 2px solid var(--wren-focus)
    outline-offset -2px

.addressBookCopyPrompt
  position absolute
  width 1px
  height 1px
  overflow hidden
  clip rect(0 0 0 0)
  clip-path inset(50%)
  white-space nowrap

.addressBookIdentity
  min-width 0
  display flex
  flex-direction column
  gap 2px

  strong
    overflow hidden
    color var(--wren-text-primary)
    font-size 15px
    font-weight 500
    line-height 19px
    text-overflow ellipsis
    white-space nowrap

.addressBookAddress
  overflow-wrap anywhere
  color var(--wren-accent-primary-hover)
  font-family var(--wren-font-mono)
  font-size 12px
  line-height 18px

.addressBookNote
  overflow hidden
  color var(--wren-text-secondary)
  font-size 13px
  line-height 18px
  text-overflow ellipsis
  white-space nowrap

.addressBookVerificationSummary
  overflow hidden
  color var(--wren-text-muted)
  font-size 12px
  line-height 17px
  text-overflow ellipsis
  white-space nowrap

.addressBookEdit, .addressBookRemove
  border-left 0
  background transparent
  color var(--wren-text-tertiary)
  font-size 13px
  transition background var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease)

  &:focus-visible
    position relative
    z-index 1
    outline 2px solid var(--wren-focus)
    outline-offset -2px

  &:disabled
    background transparent
    color var(--wren-text-disabled)
    cursor not-allowed

.addressBookEdit
  &:hover:not(:disabled)
    background var(--wren-surface-hover)
    color var(--wren-text-primary)

  &:active:not(:disabled)
    background var(--wren-surface-active)

button.addressBookRemove.wrenControl.wrenControlGhost
  &:hover:not(:disabled)
    background var(--wren-danger-soft)
    color var(--wren-danger)

  &:active:not(:disabled)
    background var(--wren-surface-active)

.addressBookRemoveConfirm
  background var(--wren-danger-soft)
  color var(--wren-danger)

.addressBookRemovalDialog
  position relative
  z-index 4
  grid-template-columns minmax(0, 1fr) 64px 84px
  box-shadow 0 0 0 100vmax rgba(2, 4, 3, .72)
  background var(--wren-bg-elevated)

.addressBookRemovalCopy
  min-width 0
  display flex
  flex-direction column
  justify-content center
  gap 2px
  padding var(--wren-space-3)

  strong
    color var(--wren-text-primary)
    font-size 14px
    font-weight 600
    line-height 19px

  span
    color var(--wren-text-secondary)
    font-size 12px
    line-height 17px

.addressBookEmpty
  min-height 230px
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap var(--wren-space-2)
  color var(--wren-text-secondary)
  text-align center

  .addressBookEmptyArtwork
    width 168px
    max-width 100%
    height 126px
    margin-bottom var(--wren-space-1)
    object-fit contain

  .addressBookEmptyIcon
    height 32px
    display flex
    align-items center
    justify-content center
    color var(--wren-text-tertiary)

  strong
    color var(--wren-text-primary)
    font-size 16px
    font-weight 500
    line-height 22px

  span
    max-width 260px
    font-size 13px
    line-height 19px

.addressBookTransfer
  display flex
  justify-content center
  gap var(--wren-space-2)
  padding var(--wren-space-5) 0 var(--wren-space-2)

  button
    min-width 104px

.addressBookAddAction
  display flex
  justify-content flex-end
  margin-top auto
  padding var(--wren-space-4) 0 0

  button.wrenControl.wrenControlPrimary
    min-width 132px
    min-height 44px

.addressBookStatus, .addressBookError
  margin var(--wren-space-2) 0
  padding var(--wren-space-3)
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  background var(--wren-bg-elevated)
  color var(--wren-text-secondary)
  font-size 13px
  line-height 19px
  text-align center

.addressBookError
  border-color var(--wren-danger)
  background var(--wren-danger-soft)
  color var(--wren-danger)

.addressBookEditor
  display flex
  flex-direction column
  min-height 0
  height 100%
  overflow hidden
  padding 0

.addressBookEditorScroll
  min-height 0
  display flex
  flex 1
  flex-direction column
  gap var(--wren-space-4)
  overflow-y auto
  padding var(--wren-space-6) var(--wren-page-gutter) var(--wren-space-4)

.addressBookActionShelf
  z-index 2
  display flex
  min-height 76px
  align-items center
  justify-content flex-end
  box-sizing border-box
  padding 14px var(--wren-page-gutter) 16px
  border-top 1px solid var(--wren-border-subtle)
  background var(--wren-bg-canvas)

.addressBookEditorHeader
  justify-content flex-start

.addressBookEditorIcon
  width 42px
  height 42px
  flex 0 0 42px
  display flex
  align-items center
  justify-content center
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  background var(--wren-bg-elevated)
  color var(--wren-accent-primary)

.addressBookField
  display flex
  flex-direction column
  gap var(--wren-space-2)
  color var(--wren-text-secondary)
  font-size 13px
  font-weight 500
  line-height 18px

  input, textarea
    width 100%
    box-sizing border-box
    padding var(--wren-space-3)
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-md)
    outline none
    background var(--wren-surface-inset)
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size 14px
    font-weight 400
    line-height 20px
    resize none
    transition border-color var(--wren-motion-fast) var(--wren-ease), background var(--wren-motion-fast) var(--wren-ease)

    &::placeholder
      color var(--wren-text-muted)

    &:hover:not(:disabled):not([readonly])
      border-color var(--wren-border-strong)
      background var(--wren-bg-subtle)

    &:focus-visible
      border-color var(--wren-focus)
      outline 2px solid var(--wren-focus)
      outline-offset 2px

    &:disabled
      border-color var(--wren-border-subtle)
      background var(--wren-bg-subtle)
      color var(--wren-text-disabled)
      cursor not-allowed

    &[readonly]
      border-color var(--wren-border-subtle)
      background var(--wren-bg-subtle)
      color var(--wren-text-secondary)

  small
    color var(--wren-text-tertiary)
    font-size 13px
    font-weight 400
    line-height 18px

.addressBookProvenanceField
  display flex
  flex-direction column
  gap var(--wren-space-3)
  padding var(--wren-space-4)
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  background var(--wren-bg-subtle)
  color var(--wren-text-secondary)

  legend
    padding 0 var(--wren-space-2)
    color var(--wren-text-primary)
    font-size 13px
    font-weight 600

  > small
    color var(--wren-text-tertiary)
    font-size 12px
    line-height 18px

.addressBookProvenanceOptions
  display grid
  grid-template-columns minmax(0, .8fr) minmax(0, 1.4fr)
  gap var(--wren-space-2)

  label
    position relative
    min-height 44px
    display flex
    align-items center
    gap var(--wren-space-2)
    padding 0 var(--wren-space-3)
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-md)
    background var(--wren-surface-inset)
    color var(--wren-text-secondary)
    cursor pointer
    font-size 13px

    &:focus-within
      border-color var(--wren-focus)
      outline 2px solid var(--wren-focus)
      outline-offset 2px

    &::before
      width 16px
      height 16px
      flex 0 0 16px
      box-sizing border-box
      border 1px solid var(--wren-border-strong)
      border-radius 50%
      content ''

    &:has(input:checked)
      border-color var(--wren-accent-primary)
      color var(--wren-text-primary)
      background var(--wren-surface-active)

      &::before
        border-color var(--wren-accent-primary)
        box-shadow inset 0 0 0 4px var(--wren-surface-inset)
        background var(--wren-accent-primary)

  input
    position absolute
    width 1px
    height 1px
    overflow hidden
    opacity 0
    pointer-events none

.addressBookVerificationNote
  margin-top var(--wren-space-1)

@media (max-width: 520px)
  .addressBookProvenanceOptions
    grid-template-columns 1fr

.addressBookFieldError
  input
    border-color var(--wren-danger)

.addressBookEnsStatusfailed
  color var(--wren-danger) !important

.addressBookEnsStatusresolved
  color var(--wren-success) !important

.addressBookPrimaryButton
  align-self flex-end
  width auto
  min-width 176px
  height 46px
  margin-top 0
  border 1px solid var(--wren-accent-primary)
  border-radius var(--wren-radius-md)
  outline none
  background var(--wren-accent-primary)
  color var(--wren-text-inverse)
  cursor pointer
  font-family var(--wren-font-ui)
  font-size 14px
  font-weight 600
  transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

  &:hover:not(:disabled)
    border-color var(--wren-accent-primary-hover)
    background var(--wren-accent-primary-hover)

  &:active:not(:disabled)
    border-color var(--wren-accent-primary-active)
    background var(--wren-accent-primary-active)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  &:disabled
    border-color var(--wren-border-default)
    background var(--wren-bg-panel-strong)
    color var(--wren-text-disabled)
    cursor default

.addressBookMissing
  min-height 100%
  box-sizing border-box
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap var(--wren-space-3)
  padding var(--wren-space-8)
  color var(--wren-text-secondary)
  text-align center

  > div
    color var(--wren-text-tertiary)

  strong
    color var(--wren-text-primary)
    font-size 16px
    font-weight 500
    line-height 22px

  span
    max-width 280px
    font-size 13px
    line-height 19px

  button
    margin-top var(--wren-space-1)
    padding var(--wren-space-2) var(--wren-space-3)
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    outline none
    background var(--wren-bg-elevated)
    color var(--wren-text-primary)
    cursor pointer
    font-family var(--wren-font-ui)
    font-size 13px
    transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

    &:hover
      border-color var(--wren-border-strong)
      background var(--wren-surface-hover)

    &:active
      background var(--wren-surface-active)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

.addressBookExportNotice
  max-width 360px
  margin 0 auto
  color var(--wren-text-tertiary)
  font-size 12px
  line-height 18px
  text-align center
