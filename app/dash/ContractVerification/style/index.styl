.contractVerification
  width 100%
  min-height 100%
  box-sizing border-box
  padding 0 var(--wren-page-gutter) var(--wren-space-6)
  overflow-x clip
  color var(--wren-text-primary)

.contractVerificationHeader
  padding var(--wren-space-4) 0 var(--wren-space-3)

  > span
    color var(--wren-text-tertiary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    letter-spacing .08em

  h1
    margin var(--wren-space-1) 0
    font-size 25px
    font-weight 500
    letter-spacing -.4px

  p
    max-width 620px
    margin 0
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    line-height 19px

.contractVerificationForm
  display flex
  min-width 0
  flex-direction column
  gap var(--wren-space-3)

.contractVerificationTargetFields,
.contractVerificationContext
  display grid
  grid-template-columns minmax(0, .72fr) minmax(0, 1.28fr)
  gap var(--wren-space-3)

.contractVerificationTargetFields label,
.contractVerificationField
  display flex
  min-width 0
  flex-direction column
  gap 6px

  > span
    color var(--wren-text-secondary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

  select,
  input
    width 100%
    min-height 44px
    box-sizing border-box
    padding-right var(--wren-space-3)
    padding-left var(--wren-space-3)
    font-size 12px

.contractVerificationContext
  margin-bottom var(--wren-space-4)
  padding var(--wren-space-2) 0

  > div
    display flex
    min-width 0
    flex-direction column
    gap 3px

  span,
  small
    color var(--wren-text-muted)
    font-size 12px

  strong,
  small
    overflow-wrap anywhere

  strong
    font-size var(--wren-type-small)
    font-weight 500

.contractVerificationChoose
  display flex
  align-items center
  gap var(--wren-space-3)
  min-height 58px

  button
    min-width 168px

  p
    max-width 500px
    margin 0
    color var(--wren-text-muted)
    font-size 12px
    line-height 17px

.contractVerificationArtifact,
.contractVerificationEvidence,
.contractVerificationResult,
.contractVerificationRecovery,
.contractVerificationRecent
  min-width 0
  scroll-margin-top var(--wren-space-4)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 4px

.contractVerificationSectionHeading
  display flex
  align-items flex-start
  justify-content space-between
  gap var(--wren-space-3)

  h2,
  h3
    margin 0
    font-size 18px
    font-weight 500

  p
    margin var(--wren-space-1) 0 0
    color var(--wren-text-muted)
    font-size 12px
    line-height 17px

  > button
    min-height 44px
    flex none

.contractVerificationLedger,
.contractVerificationDestinations
  margin var(--wren-space-2) 0 0

.contractVerificationRecent
  margin var(--wren-space-4) 0

.contractVerificationRecentList
  display flex
  flex-direction column
  margin-top var(--wren-space-2)

button.contractVerificationRecentRow
  width 100%
  min-height 52px
  justify-content space-between
  padding var(--wren-space-2)
  text-align left

  > span:first-child
    display flex
    min-width 0
    flex-direction column
    gap 3px

  strong,
  small
    overflow-wrap anywhere

  strong
    color var(--wren-text-secondary)
    font-size 12px
    font-weight 500

  small
    color var(--wren-text-muted)
    font-size 12px

  > span:last-child
    color var(--wren-text-muted)
    font-size 12px
    text-transform capitalize

.contractVerificationLedgerRow,
.contractVerificationDestination
  display grid
  grid-template-columns minmax(150px, .34fr) minmax(0, 1fr)
  min-height 42px

  dt,
  dd
    display flex
    align-items center
    min-width 0
    box-sizing border-box
    margin 0
    padding var(--wren-space-2)

  dt
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

  dd
    overflow-wrap anywhere
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    line-height 18px

.contractVerificationDestination dd
  justify-content space-between
  gap var(--wren-space-2)

.contractVerificationDestinationStatus
  display flex
  flex-direction column
  gap var(--wren-space-1)

  small
    max-width 560px
    color var(--wren-text-muted)
    font-size 12px
    line-height 17px

.contractVerificationDestination button.contractVerificationExternal
  min-height 44px

.contractVerificationResultActions
  display flex
  align-items center
  justify-content flex-end
  flex-wrap wrap
  gap var(--wren-space-2)

.contractVerificationResultActions button.wrenControl
  min-height 44px

.contractVerificationMono
  font-family var(--wren-font-mono)

.contractVerificationPublication
  display flex
  flex-direction column
  gap var(--wren-space-3)

.contractVerificationNotice
  max-width 680px
  margin 0
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  line-height 19px

.contractVerificationAcknowledgement
  display flex
  align-items center
  gap var(--wren-space-2)
  min-height 44px
  max-width 680px
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  line-height 19px
  cursor pointer
  scroll-margin-bottom 152px

  input
    width 18px
    height 18px
    min-width 18px
    margin 0
    accent-color var(--wren-accent-primary)

  &:has(input:focus-visible)
    outline 2px solid var(--wren-focus)
    outline-offset 4px

.contractVerificationDirect,
.contractVerificationRecovery
  margin-top var(--wren-space-3)

  p
    margin var(--wren-space-1) 0 0
    color var(--wren-text-muted)
    font-size 12px
    line-height 17px

  button.wrenControl
    min-height 44px

.contractVerificationDirect p.contractVerificationNotice
  margin-top var(--wren-space-3)
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  line-height 19px

.contractVerificationRecovery
  display flex
  flex-direction column
  gap var(--wren-space-3)

  h3
    margin 0
    font-size 16px
    font-weight 500

.contractVerificationTextAction
  min-height 44px
  border 0
  padding 0 var(--wren-space-1)
  color var(--wren-accent-primary)
  background transparent
  font inherit
  cursor pointer

  &:hover
    color var(--wren-accent-primary-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.contractVerificationFieldError
  color var(--wren-danger) !important

.contractVerificationFeedback
  min-height 40px
  padding-top var(--wren-space-2)

  p
    margin 0
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    line-height 19px

  [role='alert']
    color var(--wren-danger)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 3px

.contractVerificationActionShelf
  position sticky
  z-index 4
  bottom 0
  display flex
  justify-content flex-end
  gap var(--wren-space-3)
  margin 0 calc(-1 * var(--wren-page-gutter)) calc(-1 * var(--wren-space-6))
  padding var(--wren-space-4) var(--wren-page-gutter) var(--wren-space-4)
  background transparent
  pointer-events none

  button
    min-width 168px
    pointer-events auto

@media (max-width: 540px)
  .contractVerification
    padding-right var(--wren-space-3)
    padding-left var(--wren-space-3)

  .contractVerificationTargetFields,
  .contractVerificationContext,
  .contractVerificationLedgerRow,
  .contractVerificationDestination
    grid-template-columns 1fr

  .contractVerificationChoose,
  .contractVerificationSectionHeading
    align-items stretch
    flex-direction column

  .contractVerificationChoose button,
  .contractVerificationSectionHeading > button,
  .contractVerificationResultActions,
  .contractVerificationResultActions button
    width 100%

  .contractVerificationLedgerRow,
  .contractVerificationDestination
    padding var(--wren-space-1) 0

    dt,
    dd
      padding var(--wren-space-1) 0

  .contractVerificationActionShelf
    flex-direction column
    margin-right calc(-1 * var(--wren-space-3))
    margin-left calc(-1 * var(--wren-space-3))
    padding-right var(--wren-space-3)
    padding-left var(--wren-space-3)

    button
      width 100%
      min-width 0
      flex none

@media (prefers-reduced-motion: reduce)
  .contractVerification,
  .contractVerification *,
  .contractVerification *::before,
  .contractVerification *::after
    scroll-behavior auto !important
    transition-duration .01ms !important
    animation-duration .01ms !important
