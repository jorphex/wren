@keyframes headShake
  0%
    transform translateX(0)
  32%
    transform translateX(-3px)
  66%
    transform translateX(2px)
  100%
    transform translateX(0)

@keyframes fadeInDown
  0%
    opacity 0
    transform translate3d(0, -20px, 0)
  100%
    opacity 1
    transform translate3d(0, 0, 0)

.signerStatus
  position relative
  // z-index 99999
  // top 0px
  // left 3px
  // right 3px
  // pointer-events auto

  .signerStatusWrap
    position relative
    // width 100%
    // height 100%
    // animation-name fadeInDown
    // animation-duration 400ms
    // animation-timing-function cubic-bezier(.82,0,.12,1)
    // z-index 40000

  .signerStatusTop
    position relative
    height 7px
    display none

    .signerStatusTopArrow
      background var(--ghostB)
      width 20px
      height 20px 
      border-top-left-radius 3px
      transform rotate(45deg)
      position absolute
      top 6px
      left 26px

  .signerStatusMain
    background var(--ghostZ)
    border-radius 20px
    // box-shadow 0px 0px 10px var(--ghostZ), 0px 10px 20px var(--ghostZ)
    padding 3px
    margin 12px 6px 21px 6px

.signerStatusHidden
  transform translateY(-40px)
  opacity 0
  pointer-events none

.signerUnlockWrap
  display flex
  align-items center
  flex-direction column
  transform translateY(0px)
  width 100%

  .signerUnlockHeader
    padding-bottom 32px
    text-transform uppercase
    font-size 13px
    font-weight 400
    text-shadow 0px 1px 2px var(--ghostX)

  .signerUnlockInput
    position relative
    height 61px
    width 100%
    border 0
    outline 0
    background var(--ghostZ)
    font-size 26px
    letter-spacing 6px
    display flex
    justify-content center
    align-items center
    text-align center
    color var(--outerspace)
    box-sizing border-box
    border-radius 8px
    border-top-right-radius 17px
    border-top-left-radius 17px
    position relative
    z-index 4
    padding-bottom 10px

  .signerUnlockInputLabel
    position absolute
    top 46px
    font-size var(--wren-type-caption)
    border-radius 8px
    border-bottom-left-radius 17px
    border-bottom-right-radius 17px
    display flex
    justify-content center
    align-items center
    text-transform uppercase
    margin-top 4px
    font-weight 400
    z-index 40000
    letter-spacing 1px
    margin-left -1px

  .signerUnlockSubmit
    appearance none
    border 0
    font-family inherit
    height 30px
    background var(--ghostA)
    color var(--outerspace)
    font-size var(--wren-type-small)
    box-sizing border-box
    padding-top 1px
    margin 3px 0px 0px 0px
    width 140px
    border-radius 8px
    display flex
    justify-content center
    align-items center
    font-weight 500
    cursor pointer
    width 100%
    text-transform uppercase
    cursor pointer 
    border-bottom-left-radius 17px
    border-bottom-right-radius 17px

    *
      pointer-events none

  .signerUnlockSubmit:not(:disabled):hover
    background var(--ghostB)
    // animation 5s shake ease-in-out infinite alternate
    // box-shadow 0px 2px 8px var(--ghostZ)

  .signerUnlockSubmit:active
    transform translateY(0px)
    // animation shake-little 2s ease-in-out infinite
    // box-shadow 0px 2px 8px var(--ghostZ)

  .signerUnlockSubmit:disabled
    cursor default
    opacity 0.55

  .signerUnlockError
    color var(--bad)
    font-size var(--wren-type-caption)
    line-height 16px
    margin 4px 8px
    text-align center

.headShake
  animation-duration var(--wren-motion-standard)
  animation-fill-mode both
  animation-timing-function var(--wren-ease)
  animation-name headShake
  transform translateZ(0)

// Wren signer unlock: one chiseled field and one clear action.
.expandedSigner .signerStatus
  .signerStatusMain
    padding 0
    margin 0 0 var(--wren-space-5)
    border-radius 0
    background transparent

  .signerUnlockWrap
    display grid
    grid-template-columns minmax(0, 1fr) auto
    gap var(--wren-space-3)
    width 100%
    max-width 620px
    margin 0 auto
    align-items end

    .signerUnlockInputLabel
      position static
      grid-column 1 / -1
      grid-row 1
      justify-content flex-start
      margin 0
      color var(--wren-text-secondary)
      font-size var(--wren-type-small)
      font-weight 500
      letter-spacing 0
      line-height 1.4
      text-transform none

    .signerUnlockInput
      grid-column 1
      grid-row 2
      width 100%
      height 39px
      padding 0 var(--wren-space-3)
      border 2px solid #050705
      border-radius 0
      background var(--wren-surface-inset)
      box-shadow inset 0 0 0 1px var(--wren-border-subtle), inset 1px 1px 2px rgba(0, 0, 0, .6), 0 0 0 1px var(--wren-border-strong)
      color var(--wren-text-primary)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-body)
      letter-spacing .08em
      text-align left

      &:focus,
      &:focus-visible
        border-color var(--wren-accent-primary)
        outline 0
        box-shadow inset 0 0 0 1px #6f5b3e, inset 1px 1px 2px rgba(0, 0, 0, .56), 0 0 0 1px var(--wren-accent-primary-hover), 0 0 0 2px rgba(166, 138, 97, .12)

    .signerUnlockSubmit
      grid-column 2
      grid-row 2
      width auto
      min-width 132px
      height 42px
      margin 0

    .signerUnlockError
      grid-column 1 / -1
      margin 0
      color var(--wren-danger)
      text-align left

@media (max-width: 560px)
  .expandedSigner .signerStatus .signerUnlockWrap
    grid-template-columns 1fr

    .signerUnlockSubmit
      grid-column 1
      grid-row 3
      justify-self end

    .signerUnlockError
      grid-row 4
