@keyframes headShake
  0%
    transform translateX(0)
  32%
    transform translateX(-3px)
  66%
    transform translateX(2px)
  100%
    transform translateX(0)

@keyframes fadeInDown
  0%
    opacity 0
    transform translate3d(0, -20px, 0)
  100%
    opacity 1
    transform translate3d(0, 0, 0)

.signerStatus
  position relative
  // z-index 99999
  // top 0px
  // left 3px
  // right 3px
  // pointer-events auto

  .signerStatusWrap
    position relative
    // width 100%
    // height 100%
    // animation-name fadeInDown
    // animation-duration 400ms
    // animation-timing-function cubic-bezier(.82,0,.12,1)
    // z-index 40000

  .signerStatusTop
    position relative
    height 7px
    display none

    .signerStatusTopArrow
      background var(--ghostB)
      width 20px
      height 20px 
      border-top-left-radius 3px
      transform rotate(45deg)
      position absolute
      top 6px
      left 26px

  .signerStatusMain
    background var(--ghostZ)
    border-radius 20px
    // box-shadow 0px 0px 10px var(--ghostZ), 0px 10px 20px var(--ghostZ)
    padding 3px
    margin 12px 6px 21px 6px

.signerStatusHidden
  transform translateY(-40px)
  opacity 0
  pointer-events none

.signerUnlockWrap
  display flex
  align-items center
  flex-direction column
  transform translateY(0px)
  width 100%

  .signerUnlockHeader
    padding-bottom 32px
    text-transform uppercase
    font-size 13px
    font-weight 400
    text-shadow 0px 1px 2px var(--ghostX)

  .signerUnlockInputLabel
    position absolute
    top 46px
    font-size var(--wren-type-caption)
    border-radius 8px
    border-bottom-left-radius 17px
    border-bottom-right-radius 17px
    display flex
    justify-content center
    align-items center
    text-transform uppercase
    margin-top 4px
    font-weight 400
    z-index 40000
    letter-spacing 1px
    margin-left -1px

  .signerUnlockError
    color var(--bad)
    font-size var(--wren-type-caption)
    line-height 16px
    margin 4px 8px
    text-align center

.headShake
  animation-duration var(--wren-motion-standard)
  animation-fill-mode both
  animation-timing-function var(--wren-ease)
  animation-name headShake
  transform translateZ(0)

// Wren signer unlock: one chiseled field and one clear action.
.expandedSigner .signerStatus
  .signerStatusMain
    padding 0
    margin 0 0 var(--wren-space-5)
    border-radius 0
    background transparent

  .signerUnlockWrap
    display grid
    grid-template-columns minmax(0, 1fr) auto
    gap var(--wren-space-3)
    width 100%
    max-width 620px
    margin 0 auto
    align-items end

    .signerUnlockInputLabel
      position static
      grid-column 1 / -1
      grid-row 1
      justify-content flex-start
      margin 0
      color var(--wren-text-secondary)
      font-size var(--wren-type-small)
      font-weight 500
      letter-spacing 0
      line-height 1.4
      text-transform none

    .signerUnlockInput
      grid-column 1
      grid-row 2
      width 100%
      height 44px
      padding 0 var(--wren-space-3)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-body)
      letter-spacing .08em
      text-align left

    .signerUnlockSubmit
      grid-column 2
      grid-row 2
      min-width 132px
      margin 0

    .signerUnlockError
      grid-column 1 / -1
      margin 0
      color var(--wren-danger)
      text-align left

@media (max-width: 560px)
  .expandedSigner .signerStatus .signerUnlockWrap
    grid-template-columns 1fr

    .signerUnlockSubmit
      grid-column 1
      grid-row 3
      justify-self end

    .signerUnlockError
      grid-row 4
