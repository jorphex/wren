.expandedSigner
  position relative
  overflow hidden
  box-sizing border-box
  margin 6px
  padding-bottom 24px
  border-radius 27px
  background var(--ghostA)
  transform translate3d(0, 0, 0)
  padding-top 8px

.signer
  position relative
  width 100%
  overflow hidden
  box-sizing border-box
  margin 6px 0px 0px 0px
  padding-bottom 24px
  border-radius 27px
  box-shadow 0px 4px 8px var(--ghostY)
  transform translate3d(0, 0, 0)
  border-radius 27px
  background var(--ghostAZ)
  box-shadow 0px 4px 8px var(--ghostY), 0px 2px 8px var(--ghostY)
  border-bottom 2px solid var(--ghostY)

.signerMenuItems
  display flex
  justify-content center
  align-items center

.signerTop
  position relative
  display flex
  justify-content space-between
  align-items center
  padding 24px 16px

.signerDetails
  display flex
  justify-content center
  align-items center

  .signerName
    height 28px
    padding-left 14px
    border-radius 8px
    font-size 18px
    font-weight 300
    padding-top 4px
    box-sizing border-box
    font-family 'MainFont'
    text-transform capitalize
    letter-spacing 0px
    font-weight 400
    white-space nowrap
    overflow hidden
    text-overflow ellipsis
    width 190px

    .signerNameUpdate
      position absolute
      width 28px
      height 28px
      right -34px
      color var(--good)
      display flex
      align-items center
      cursor pointer
      pointer-events none
      opacity 0
      *
        pointer-events none

.signerExpand
  appearance none
  color inherit
  height 26px
  width 54px
  border-radius 20px
  box-sizing border-box
  background var(--ghostA)
  border 3px solid var(--ghostZ)
  cursor pointer
  display flex
  justify-content center
  align-items center

  *
    pointer-events none

.signerExpand:hover
  background var(--ghostB)

.signerNameFocused
  background var(--ghostZ)
  .signerNameUpdate
    opacity 1
    
.signerType
  position absolute
  top 20px
  right 44px
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  text-transform uppercase
  font-weight 400
  letter-spacing 0px


.signerStatusIndicator
  position absolute
  top 26px
  right 18px
  font-size var(--wren-type-small)
  text-transform uppercase
  font-weight 400
  background var(--ghostZ)
  width 10px
  height 10px
  border-radius 5px

.signerStatusIndicatorLocked
  background var(--moon)

.signerStatusIndicatorReady
  background var(--good)

.signerStatusText
  padding 0px 32px 16px 32px
  margin 0px 6px 6px 6px
  border-radius 20px
  font-family var(--wren-font-utility)
  font-size var(--wren-type-small)
  text-transform uppercase
  text-align center
  font-weight 500
  letter-spacing 1px
  color var(--outerspace)

.signerStatusError
  color var(--bad)

.signerStatusIssue
  color var(--moon)

.signerStatusReady
  color var(--good)

.signerStatusWarning
  color var(--wren-warning)

.signerStatusDanger
  color var(--wren-danger)

.signerBottom
  left 0
  right 0
  bottom 0
  height 20px
  display flex
  justify-content space-between
  align-items center
  font-size 14px
  font-weight 300
  display flex
  justify-content center
  align-items center
  padding 18px 16px 10px 16px

  .signerBottomPages
    border-radius 8px
    font-size 13px
    font-weight 400
    width 66px
    text-align center

  .signerBottomPageBack
    appearance none
    padding 0
    color inherit
    background var(--ghostA)
    padding 2px 1px 2px 2px
    height 30px
    width 45px
    border-radius 15px
    cursor pointer
    box-sizing border-box
    border 3px solid var(--ghostZ)
    cursor pointer
    box-sizing border-box
    display flex
    justify-content center
    *
      pointer-events none

  .signerBottomPageNext
    appearance none
    padding 0
    color inherit
    background var(--ghostA)
    transform rotate(180deg)
    padding 2px 2px 2px 1px
    height 30px
    width 45px
    border-radius 15px
    cursor pointer
    box-sizing border-box
    border 3px solid var(--ghostZ)
    display flex
    justify-content center
    *
      pointer-events none

  .signerBottomPageBack:hover, .signerBottomPageNext:hover
    background var(--ghostB)

  .signerBottomPageBack:disabled, .signerBottomPageNext:disabled
    opacity .35
    cursor default

.signerDrawer
  position relative
  height 60px

  .showControls
    position absolute
    height 20px
    border-radius 13px
    border 3px solid var(--ghostZ)
    background var(--ghostA)
    z-index 2
    top 14px
    left 50%
    width 100px
    margin-left -53px
    padding-bottom 2px
    letter-spacing 1px
    font-size var(--wren-type-caption)
    display flex
    justify-content center
    align-items center
    text-transform uppercase
    cursor pointer
    color var(--outerspace)
    transition var(--standardFast)
    font-weight 400

  .showControls:hover
    background var(--ghostB)
    color var(--outerspace)

  .showControlsLine
    height 3px
    position absolute 
    top 50%
    left 0
    right 0
    background var(--ghostZ)
    z-index 1
    margin-top -3px

.signerControls
  padding-top 16px

  .signerControlDetail
    height 40px
    margin 0px 10px 11px 10px
    display flex
    justify-content center
    align-items center
    box-sizing border-box
    font-size 16px
    font-weight 400
    border 2px solid var(--ghostA)
    border-radius 9px

    .signerControlDetailKey
      font-size var(--wren-type-caption)
      margin 4px 4px 6px 4px
      letter-spacing 1px

    .signerControlDetailValue
      margin 4px
      font-family 'FiraCode'

  .signerControlOption
    appearance none
    width calc(100% - 20px)
    font-family inherit
    height 52px
    margin 0px 10px 11px 10px
    background var(--ghostA)
    border-radius 20px
    color var(--outerspace)
    display flex
    justify-content center
    align-items center
    font-weight 400
    font-size 13px
    cursor pointer
    letter-spacing 0px
    box-sizing border-box
    text-transform uppercase
    border 3px solid var(--ghostZ)

    *
      pointer-events none

  .signerControlOption:not(:disabled):hover
    background var(--ghostB)

  .signerControlOption:disabled
    cursor default
    opacity 0.55

  .signerControlOptionImportant
    color var(--bad)

  .signerControlOptionEffect
    color var(--moon)

  .signerControlOptionSuccess
    color var(--good)

.signerLatticePair
  height 200px

  .signerLatticePairTitle
    height 40px
    display flex
    justify-content center
    align-items center
    font-size 14px
    font-weight 300
    text-transform none
    color var(--moon)

  .signerLatticePairInput
    background var(--ghostC)
    height 60px
    border-radius 12px
    margin 10px 10px 20px 10px

    input
      width 100%
      height 100%
      background transparent
      border none
      outline none
      color var(--outerspace)
      text-align center
      font-size 22px
      letter-spacing 6px
      padding-left 6px
      font-family 'MainFont'

  .signerLatticePairSubmit
    appearance none
    color inherit
    border 0
    font-family inherit
    width 100px
    height 30px
    display flex
    justify-content center
    align-items center
    background var(--ghostC)
    border-radius 12px
    position relative
    left 50%
    margin-left -50px
    cursor pointer
    letter-spacing 1px
    font-size 13px
    text-transform uppercase
    font-weight 300
    padding-left 1px

    *
      pointer-events none

  .signerLatticePairSubmit:disabled
    cursor default
    opacity 0.55

  .signerLatticePairError
    color var(--bad)
    font-size var(--wren-type-caption)
    text-align center

.signerAccountsTitle
  // background pink
  font-size var(--wren-type-small)
  font-weight 300
  display flex
  justify-content center
  align-items center
  // height 40px
  padding 0px 12px 0px 12px

.signerAccountsTitleActive
  text-transform uppercase
  font-size var(--wren-type-caption)
  font-weight 300
  letter-spacing 1px
  display flex
  justify-content center
  align-items center
  color var(--outerspace)

  .signerAccountsTitleActiveCount
    font-size 13px
    margin-left 5px
    font-weight 400
    margin-top -1px
    height 24px
    width 24px
    border-radius 12px
    box-sizing border-box
    display flex
    justify-content center
    align-items center
    padding-left 1px
    background var(--ghostB)

.signerAccounts
  //position absolute
  // bottom 30px
  // right 8px
  // left 8px
  margin 7px 6px
  // padding 8px
  text-align center
  
  // border-radius 8px
  font-size var(--wren-type-caption)
  // text-transform uppercase
  font-weight 400
  // height 204px
  overflow hidden
  // overflow-x hidden
  background var(--ghostZ)
  border-radius 20px

  .signerAccount:first-child
    border-top-right-radius 17px
    border-top-left-radius 17px

  .signerAccount:last-child
    border-bottom-right-radius 17px
    border-bottom-left-radius 17px

  .signerAccount:first-child:last-child
    border-radius 17px

  .signerAccountsAdd
    appearance none
    width 100%
    color inherit
    background transparent
    border 0
    font-family inherit
    padding 16px
    font-size var(--wren-type-small)
    cursor pointer
    text-transform uppercase
    font-weight 400
    letter-spacing 1px

  .signerAccountsAdd:hover
    color var(--good)

  .signerAccount
    appearance none
    padding 0
    border 0
    font-family inherit
    display flex
    height 36px
    margin 3px
    width calc(100% - 6px)
    position relative
    background var(--ghostZ)
    color var(--outerspace)
    border-radius 8px
    box-sizing border-box
    cursor pointer

    *
      pointer-events none

    .signerAccountIndex
      position absolute
      top 2px
      left 3px
      bottom 3px
      width 30px
      display flex
      justify-content center
      align-items center
      font-weight 500
      
    .signerAccountAddress
      display flex
      justify-content center
      align-items center
      position absolute
      left 30px
      bottom 7px
      right 40px
      font-size 15px
      overflow hidden
      font-family 'FiraCode'
      font-weight 250

      svg
        margin 2px 4px 0px 4px

    .signerAccountCheck
      position absolute
      top 15px
      right 16px
      bottom 0
      width 6px
      height 6px
      border-radius 3px
      display flex
      justify-content center
      align-items center
      color var(--ghostZ)
      background var(--outerspace)

  .signerAccountAdded
    background var(--ghostA)

    // .signerAccountIndex
    //   color var(--good)

    .signerAccountCheck
      background var(--good)

  .signerAccount:hover
    background var(--ghostA)

  .signerAccountAdded:hover
    background var(--ghostB)

  .signerAccountDisabled
    background var(--ghostA)
    cursor auto

  .signerAccountDisabled:hover
    background var(--ghostA)

.signerLoading
  height 60px
  display flex
  justify-content center
  align-items center
  padding 20px

.signerLoadingLoader, .signerLoadingLoaderafter
  border-radius 50%
  width 50px
  height 50px

.signerLoadingLoader
  margin 60px auto
  font-size 10px // Spinner geometry; no visible text.
  position relative
  text-indent -9999em
  border-top 3px solid var(--ghostZ)
  border-right 3px solid var(--ghostZ)
  border-bottom 3px solid var(--ghostZ)
  border-left 3px solid var(--good)
  transform translateZ(0)
  animation load8 0.5s infinite linear
  will-change transform

@keyframes load8
  0%
    -webkit-transform rotate(0deg)
    transform rotate(0deg)

  100%
    -webkit-transform rotate(360deg)
    transform rotate(360deg)

.signerInterface
  font-size 16px
  width 100%
  transition var(--standard)
  position relative
  display flex
  text-align center
  flex-direction column
  overflow hidden
  font-size 14px

  .trezorPhraseInput
    position relative
    display flex
    justify-content center
    align-items center
    background var(--ghostY)
    height 36px
    border-radius 8px
    width calc(100% - 20px)
    overflow hidden
    margin-bottom 18px

    svg
      margin 0px 5px

    input 
      position absolute
      top 0
      right 0
      bottom 0
      left 0
      width 100%
      height 100%
      text-align center
      font-size 20px
      outline 0
      border 0
      background transparent
      color var(--outerspace)
      letter-spacing 4px

  .trezorPinWrap
    width 100%
    position relative
    display flex
    justify-content center
    transition var(--standard)
    overflow hidden
    display flex
    justify-content center
    align-items center
    flex-direction column
    z-index 20
    padding-bottom 0.5em

    .trezorPinError
      color var(--bad)
      font-size var(--wren-type-small)
      line-height 16px
      margin-bottom 12px

    .signerPinMessageOr
      font-size var(--wren-type-caption)
      text-transform uppercase
      font-weight 300
      padding 5px

    .signerPinDot
      display block
      width 8px
      height 8px
      border-radius 50%
      background currentColor
      transition transform var(--wren-motion-fast) var(--wren-ease)

    .signerPinMessage
      overflow hidden
      position relative

    .signerPinActions
      position relative
      width 250px

      .signerPinSubmit
        width 100%

      .signerPinDelete
        appearance none
        position absolute
        display flex
        justify-content center
        align-items center
        top 0px
        bottom 0px
        width 40px
        left 0px
        color inherit
        border 0
        border-radius 8px
        background var(--ghostC)
        cursor pointer

      .signerPinDelete:hover
        background var(--ghostD)

    .signerPinSubmit
      width 250px

      .signerPinDelete
        left 0px

    .trezorPinInputWrap
      width 100%
      position relative
      display flex
      justify-content center
      transition var(--standard)
      padding 10px 0px 25px 0px
      height 100px

      .trezorPinInput
        display flex
        width 120px
        height 120px
        flex-wrap wrap-reverse
        z-index 1000

        .trezorPinInputButton
          appearance none
          padding 0
          color inherit
          background transparent
          border 0
          min-width 40px
          min-height 40px
          display flex
          justify-content center
          align-items center

        .trezorPinInputButton:not(:disabled):hover
          .signerPinDot
            transform scale(1.7)

        .trezorPinInputButton:disabled
          opacity 0.45

        .trezorPinInputButton:active
          .signerPinDot
            transform scale(2.1)
            transition none

.expandedSignerTitle
  display flex
  justify-content center
  align-items center
  text-transform none
  font-family 'MainFont'
  letter-spacing 0px
  font-size 16px
  font-weight 400
  padding-right 2px
  text-transform capitalize

  .expandedSignerIcon
    margin-right 12px

.signerAddedAccountTitle
  display flex
  justify-content center
  align-items center
  text-transform uppercase
  font-size var(--wren-type-caption)
  margin 2px 0px 4px 0px
  font-weight 500
  letter-spacing 1px
  padding-top 8px

@import '../SignerStatus/style'

// Wren signer surfaces
.expandedSigner, .signer
  margin 6px
  padding-top var(--wren-space-2)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-card)
  box-shadow var(--wren-shadow-sm), var(--wren-shadow-inset)

.signerTop
  padding var(--wren-space-5) var(--wren-space-4)

.signerDetails .signerName
  font-weight 500
  font-variation-settings var(--wren-font-heading-settings)

.signerIdentity
  min-width 0

.signerIdentity > .signerStatusText
  margin var(--wren-space-1) 0 0
  padding 0
  text-align left
  white-space nowrap

.signerPreviewSummary
  display flex
  min-height 44px
  margin 0 var(--wren-space-4)
  box-sizing border-box
  align-items center
  justify-content space-between
  gap var(--wren-space-3)

.signerPreviewAccountCount
  min-width 0
  color var(--wren-text-tertiary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-small)
  line-height 18px

.signerPreviewManage
  min-width 132px
  min-height 44px
  flex none
  padding 0 var(--wren-space-3)
  font-size var(--wren-type-small)

.signerExpand,
.signerBottom .signerBottomPageBack,
.signerBottom .signerBottomPageNext,
.signerDrawer .showControls
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-card)
  box-shadow none

  &:not(:disabled):hover
    background var(--wren-surface-hover)

.signerType, .signerStatusText, .signerDrawer .showControls, .signerAddedAccountTitle
  text-transform none
  letter-spacing 0

.signerStatusText
  margin 0 var(--wren-space-2) var(--wren-space-2)
  padding 0 var(--wren-space-4) var(--wren-space-3)
  border-radius 0
  font-size var(--wren-type-small)

.signerDrawer .showControlsLine
  height 1px
  background var(--wren-border-subtle)

.signerControls .signerControlDetail,
.signerAccounts .signerAccount,
.signerAccounts .signerAccountsAdd
  border-radius var(--wren-radius-sm)
  background var(--wren-bg-elevated)
  box-shadow none

.signerControls .signerControlOption,
.signerLatticePair .signerLatticePairSubmit,
.signerInterface .signerPinDelete
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-card)
  box-shadow none
  text-transform none
  letter-spacing 0
  font-weight 500

  &:not(:disabled):hover
    background var(--wren-surface-hover)

.signerLatticePair .signerLatticePairInput,
.signerInterface .trezorPhraseInput
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)
  box-shadow none

// Wren signer ledger: one document, no nested cards.
.dash .dashMain .signers
  .signersMid
    padding 0 var(--wren-space-5) 72px

  .signersList
    display block

  .signersList .signer
    width 100%
    margin 0
    padding 0 0 var(--wren-space-3)
    overflow visible
    border 0
    border-bottom 1px solid var(--wren-ledger-rule)
    border-radius 0
    background transparent
    box-shadow none

  .signersList .signer:last-child
    border-bottom 1px solid var(--wren-ledger-rule)

  .signerTop
    display grid
    min-height 62px
    box-sizing border-box
    padding var(--wren-space-3) var(--wren-space-2) var(--wren-space-2)
    grid-template-columns minmax(0, 1fr) 44px
    align-items center
    column-gap var(--wren-space-3)

  .signerDetails
    display grid
    min-width 0
    grid-template-columns 38px minmax(0, 1fr)
    align-items center
    gap var(--wren-space-3)

    .signerIcon,
    .signerIconWrap
      display flex
      width 38px
      height 38px
      box-sizing border-box
      align-items center
      justify-content center

    .signerIcon
      border 1px solid var(--wren-border-subtle)
      border-radius 50%
      color var(--wren-accent-primary-hover)
      background var(--wren-surface-inset)

    .signerName
      width auto
      min-width 0
      height auto
      margin 0
      padding 0
      overflow hidden
      color var(--wren-text-primary)
      font-size var(--wren-type-body)
      font-weight 560
      line-height 1.35
      text-overflow ellipsis

  .signerExpand
    flex none

  .signerStatusReady
    color var(--wren-success)

  .signerStatusIssue
    color var(--wren-warning)

  .signerStatusWarning
    color var(--wren-warning)

  .signerStatusDanger
    color var(--wren-danger)

  .signerPreviewSummary
    margin 0 0 0 46px
    padding 0 var(--wren-space-1) var(--wren-space-2) 0

  .signerPreviewManage
    height 44px
    min-height 44px

  .signerAddedAccountTitle
    justify-content flex-start
    margin 0 52px
    padding var(--wren-space-2) 0
    color var(--wren-text-tertiary)
    font-size var(--wren-type-caption)
    line-height 1.3

  .signerAccounts
    margin 0 52px var(--wren-space-2)
    overflow visible
    border-radius 0
    background transparent

    .signerAccountsAdd
      width auto
      min-width 148px
      margin var(--wren-space-2) 0 0
      padding 0 var(--wren-space-4)

    .signerAccount
      width 100%
      height 44px
      margin 0
      border-radius 0
      border-top 1px solid var(--wren-ledger-rule)
      color var(--wren-text-secondary)
      background transparent

      &:last-child
        border-bottom 1px solid var(--wren-ledger-rule)

      .signerAccountIndex
        left 0
        width 32px
        color var(--wren-text-muted)
        font-family var(--wren-font-utility)
        font-size var(--wren-type-caption)

      .signerAccountAddress
        left 40px
        right 36px
        bottom auto
        top 0
        height 43px
        justify-content flex-start
        color var(--wren-text-secondary)
        font-size var(--wren-type-small)

      .signerAccountCheck
        top 18px
        right 12px
        width 7px
        height 7px
        border-radius 1px
        background var(--wren-text-disabled)

    .signerAccountAdded
      background transparent

      .signerAccountCheck
        background var(--wren-success)

    .signerAccountCurrent
      background var(--wren-ledger-selected)

    .signerAccount:not(.signerAccountDisabled):hover
      background var(--wren-ledger-hover)

.expandedSigner
  width auto
  margin 0 var(--wren-space-5)
  padding var(--wren-space-2) 0 var(--wren-space-8)
  overflow visible
  border 0
  border-radius 0
  background transparent
  box-shadow none

  > .signerStatusText
    margin 0 0 var(--wren-space-3)
    padding 0
    color var(--wren-text-muted)
    text-align left

  > .signerAddedAccountTitle
    justify-content flex-start
    margin 0
    padding var(--wren-space-3) 0 var(--wren-space-2)
    border-bottom 1px solid var(--wren-ledger-rule)
    color var(--wren-text-tertiary)

  > .signerAccounts
    margin 0
    overflow visible
    border-radius 0
    background transparent

    .signerAccount
      width 100%
      height 44px
      margin 0
      border 0
      border-bottom 1px solid var(--wren-ledger-rule)
      border-radius 0
      color var(--wren-text-secondary)
      background transparent

      &:hover
        background var(--wren-ledger-hover)

      &.signerAccountAdded
        background var(--wren-ledger-selected)

      .signerAccountIndex
        top 0
        bottom 0
        left 0
        width 36px
        color var(--wren-text-muted)
        font-family var(--wren-font-utility)
        font-size var(--wren-type-caption)

      .signerAccountAddress
        top 0
        bottom auto
        left 44px
        right 42px
        height 43px
        justify-content flex-start
        color var(--wren-text-secondary)
        font-size var(--wren-type-small)

      .signerAccountCheck
        top 18px
        right 14px
        width 8px
        height 8px
        border-radius 1px

  .signerBottom
    height 52px
    padding var(--wren-space-3) 0 0
    gap var(--wren-space-3)

    .signerBottomPages
      width 72px
      color var(--wren-text-muted)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)

    .signerBottomPageBack,
    .signerBottomPageNext
      padding 0

  .signerControls
    display flex
    flex-wrap wrap
    justify-content flex-end
    gap var(--wren-space-3)

    margin-top var(--wren-space-4)
    padding var(--wren-space-4) 0 0
    border-top 1px solid var(--wren-ledger-rule)

    .signerControlDetail
      width 100%
      height auto
      min-height 40px
      margin 0
      justify-content flex-start
      border 0
      border-radius 0
      color var(--wren-text-muted)
      background transparent

    .signerControlOption
      width auto
      min-width 156px
      height 44px
      min-height 44px
      margin 0

  .signerRemovalConfirm
    width 100%
    display flex
    flex-direction column
    gap var(--wren-space-2)

    .signerRemovalConfirmTitle
      color var(--wren-text-primary)
      font-weight 550

    .signerRemovalConfirmDescription
      max-width 560px
      color var(--wren-text-secondary)
      font-size var(--wren-type-small)
      line-height 18px

    .signerRemovalConfirmActions
      display flex
      flex-wrap wrap
      gap var(--wren-space-3)
      padding-top var(--wren-space-2)

      .signerControlOption
        min-width 156px
        min-height 44px

  .signerLatticePair
    height auto
    max-width 620px
    margin var(--wren-space-6) auto

    .signerLatticePairTitle
      height auto
      justify-content flex-start
      margin-bottom var(--wren-space-3)
      color var(--wren-text-secondary)

    .signerLatticePairInput
      height 39px
      margin 0 0 var(--wren-space-3)

    .signerLatticePairSubmit
      left auto
      width auto
      min-width 124px
      height 42px
      margin 0 0 0 auto

  .signerInterface
    max-width 620px
    margin var(--wren-space-5) auto

    .trezorPinWrap
      gap var(--wren-space-3)

    .trezorPinHeading
      width 100%
      max-width 480px
      text-align left

      h3,
      p
        margin 0

      h3
        color var(--wren-text-primary)
        font-size var(--wren-type-body)
        font-weight 650

      p
        margin-top var(--wren-space-2)
        color var(--wren-text-secondary)
        font-family var(--wren-font-utility)
        font-size var(--wren-type-small)
        line-height 18px

    .trezorPinEntryStatus
      display flex
      width 100%
      max-width 480px
      min-height 44px
      padding 0 var(--wren-space-3)
      box-sizing border-box
      align-items center
      justify-content space-between
      border 1px solid var(--wren-border-default)
      border-radius var(--wren-radius-sm)
      color var(--wren-text-secondary)
      background var(--wren-surface-inset)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-small)

    .trezorPinEntryDots
      display flex
      min-width 0
      align-items center
      justify-content flex-end
      gap var(--wren-space-1)

    .trezorPinInputWrap
      width 100%
      height auto
      padding var(--wren-space-2) 0

      .trezorPinInput
        width 148px
        height 148px
        gap var(--wren-space-2)

        .trezorPinInputButton
          flex 0 0 44px
          min-width 44px
          min-height 44px
          border 1px solid var(--wren-border-default)
          border-radius var(--wren-radius-sm)
          background var(--wren-surface-card)
          cursor pointer

        .trezorPinInputButton:not(:disabled):hover
          border-color var(--wren-border-strong)
          background var(--wren-surface-hover)

        .trezorPinInputButton:focus-visible
          outline 2px solid var(--wren-focus)
          outline-offset 2px

    .trezorPhraseInput
      width 100%
      height 39px
      margin 0

    .signerPinMessageOr
      padding 0
      color var(--wren-text-muted)
      text-transform none

    .signerPinSubmit
      width auto
      min-width 190px
      min-height 44px
      height 44px
      padding 0 var(--wren-space-4)
      border-radius var(--wren-radius-sm)
      font-family var(--wren-font-ui)
      font-size 13px
      font-weight 550
      letter-spacing .01em
      line-height 1
      text-transform none

      &:disabled
        color var(--wren-text-muted)
        opacity 1

    .signerPinActions
      display flex
      width 250px
      align-items center
      justify-content center
      gap var(--wren-space-2)

      .signerPinSubmit
        flex 1
        width auto

      .signerPinDelete
        position static
        flex 0 0 44px
        width 44px
        min-height 44px

.hardwareSignerPromptOverlay
  position fixed
  z-index 5000
  inset 0
  display flex
  padding var(--wren-space-5)
  box-sizing border-box
  align-items center
  justify-content center
  background rgba(7, 10, 14, 0.76)

.hardwareSignerPromptSurface.expandedSigner
  width min(520px, 100%)
  max-height calc(100vh - 40px)
  margin 0
  padding var(--wren-space-5)
  overflow auto
  box-sizing border-box
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  background var(--wren-bg-elevated)
  box-shadow var(--wren-shadow-lg)

.hardwareSignerPromptHeader
  display grid
  margin-bottom var(--wren-space-5)
  grid-template-columns 40px minmax(0, 1fr)
  align-items center
  gap var(--wren-space-3)

.hardwareSignerPromptMark
  display flex
  width 40px
  height 40px
  align-items center
  justify-content center
  border 1px solid var(--wren-border-subtle)
  border-radius 50%
  color var(--wren-accent-primary-hover)
  background var(--wren-surface-inset)

.hardwareSignerPromptIdentity
  min-width 0

  h2
    margin 0
    color var(--wren-text-primary)
    font-size var(--wren-type-heading)
    font-weight 580

  .signerStatusText
    margin var(--wren-space-1) 0 0
    padding 0
    text-align left

.hardwareSignerPromptBusy
  min-height 140px
  display flex
  align-items center
  justify-content center

  .signerLoadingLoader
    margin 0

@media (max-height: 760px)
  .dash .dashMain .signers .signersMid
    padding-bottom var(--wren-space-10)

  .expandedSigner
    padding-bottom var(--wren-space-5)
