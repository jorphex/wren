.sendComposer,
.sendPicker,
.sendUnavailable
  box-sizing border-box
  min-height 100%
  color var(--wren-text-primary)
  background transparent
  font-family var(--wren-font-ui)

.sendRequestState
  box-sizing border-box
  min-height 100%
  color var(--wren-text-primary)
  background var(--wren-bg-canvas)
  font-family var(--wren-font-ui)

.sendComposer
  display flex
  min-height calc(100vh - 64px)
  flex-direction column

.sendModeSwitch
  display grid
  grid-template-columns 1fr 1fr
  gap 4px
  margin 14px 24px 0
  padding 4px
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-md)
  background var(--wren-surface-inset)

  button
    min-height 44px
    padding 0 12px
    border 0
    border-radius var(--wren-radius-sm)
    color var(--wren-text-secondary)
    background transparent
    font-family var(--wren-font-ui)
    font-weight 610
    cursor pointer

    &[aria-pressed='true']
      color var(--wren-text-primary)
      background var(--wren-bg-elevated)
      box-shadow var(--wren-shadow-sm)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

    &:disabled
      color var(--wren-text-disabled)
      cursor default

.sendLedger
  flex 1
  padding 12px 24px 0

.sendComposerSweep .sendLedger
  flex none

.sendComposerSweep .sendSweepSelect
  flex 1

.sendLedgerRow
  position relative
  width 100%
  min-height 76px
  box-sizing border-box
  border 0
  color inherit
  background transparent
  font inherit
  text-align left

.sendAssetRow
  display flex
  min-height 86px
  align-items stretch
  justify-content center
  flex-direction column
  gap 8px
  padding 12px 0 10px

.sendRowLabel
  color var(--wren-text-muted)
  font-size var(--wren-type-caption)
  font-weight 560
  letter-spacing .055em
  text-transform uppercase
  cursor default
  user-select none

.sendRowValue
  display flex
  align-items center
  gap 10px

.sendAssetValue
  appearance none
  width 100%
  min-height 44px
  justify-content space-between
  padding 0
  border 0
  color var(--wren-text-secondary)
  background transparent
  font-family var(--wren-font-ui)
  text-align left
  cursor pointer

  &:hover
    color var(--wren-text-primary)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 4px

  .sendAssetIdentityCluster
    display flex
    min-width 0
    align-items center
    gap 10px

    > span:not(.assetMark)
      display flex
      min-width 70px
      flex-direction column
      align-items flex-start
      gap 2px

  strong
    color var(--wren-text-primary)
    font-size var(--wren-type-body)
    font-weight 620

  small
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)

.sendInputRow
  display grid
  grid-template-columns 1fr auto
  grid-template-rows 24px minmax(42px, auto) minmax(24px, auto)
  align-items center
  padding 15px 0 8px

  .sendRowLabel
    grid-column 1
    grid-row 1

.sendInputWrap
  display flex
  min-width 0
  min-height 44px
  grid-column 1 / -1
  grid-row 2
  align-items center
  padding 0 6px 0 12px

  input
    height 44px
    min-width 0
    flex 1
    border 0
    outline 0
    color var(--wren-text-primary)
    background transparent
    font-family var(--wren-font-ui)
    font-size 19px
    font-weight 510

    &::placeholder
      color var(--wren-text-disabled)
      font-family var(--wren-font-ui)
      font-weight 430

.sendRecipientInput
  font-family var(--wren-font-mono) !important
  font-size 15px !important

.sendRowHint
  overflow hidden
  grid-column 1 / -1
  grid-row 3
  color var(--wren-text-muted)
  font-size var(--wren-type-caption)
  text-overflow ellipsis
  user-select none
  white-space nowrap

.sendAmountHints
  display flex
  align-items center
  gap var(--wren-space-3)

.sendAvailableHint
  flex none

.sendMaxReason
  overflow hidden
  min-width 0
  text-overflow ellipsis

.sendRowError
  .sendRowHint
    color var(--wren-danger)

.sendInlineAction,
.sendMaxAction
  border 0
  color var(--wren-text-secondary)
  background transparent
  font-family var(--wren-font-ui)
  cursor pointer

  &:hover
    color var(--wren-text-primary)

  &:focus-visible
    border-radius 4px
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.sendInlineAction
  display flex
  width 44px
  height 44px
  align-items center
  justify-content center

.sendAmountRow
  min-height 126px

.sendAmountInput
  font-family var(--wren-font-mono) !important
  font-size 30px !important
  font-weight 580 !important
  letter-spacing -.035em

  &::placeholder
    font-family var(--wren-font-mono) !important
    font-weight 430 !important

.sendAmountSymbol
  margin-left 12px
  color var(--wren-text-secondary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-body)
  font-weight 620

.sendMaxAction
  min-width 0
  height 44px
  margin-left 10px
  padding 0 9px
  font-size var(--wren-type-caption)
  font-weight 620

  &:disabled,
  &:disabled:hover,
  &:disabled:active
    border-color transparent
    color var(--wren-text-disabled)
    background transparent
    box-shadow none
    cursor default
    transform none

.sendFeeRow
  cursor default
  user-select none
  display grid
  min-height 88px
  grid-template-columns 120px 1fr
  grid-template-rows 40px 28px
  align-items end
  padding 8px 0 10px

  .sendRowLabel
    grid-column 1
    grid-row 1

  .sendRowHint
    grid-column 1 / -1
    grid-row 2

.sendFeeValue
  overflow hidden
  grid-column 2
  grid-row 1
  color var(--wren-text-secondary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-small)
  text-align right
  text-overflow ellipsis
  user-select none
  white-space nowrap

.sendQuotePanel
  display flex
  gap var(--wren-space-3)
  margin 12px 0 4px
  padding var(--wren-space-4)
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  background var(--wren-surface-inset)
  flex-direction column

  > span,
  > p
    margin 0
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    line-height 1.45

.sendQuotePanelReview
  border-color var(--wren-accent-primary)

.sendQuoteHeading
  display flex
  min-width 0
  align-items flex-start
  justify-content space-between
  gap var(--wren-space-3)

  > div
    display flex
    min-width 0
    flex-direction column
    gap 3px

    span
      color var(--wren-text-muted)
      font-size var(--wren-type-caption)

    strong
      overflow-wrap anywhere
      font-family var(--wren-font-mono)
      font-size var(--wren-type-body)

.sendQuoteBadge
  flex none
  padding 4px 7px
  border-radius 999px
  color var(--wren-text-secondary)
  background var(--wren-success-soft)
  font-size var(--wren-type-caption)

.sendQuoteEdit
  align-self flex-start

.sendQuoteFacts
  display grid
  gap 6px
  margin 0

  div
    display grid
    grid-template-columns minmax(110px, .8fr) minmax(0, 1.2fr)
    gap 10px

  dt
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)

  dd
    min-width 0
    margin 0
    overflow-wrap anywhere
    color var(--wren-text-primary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    text-align right

.sendSweepSelect,
.sendSweepReview
  display flex
  padding 0 24px
  flex-direction column

.sendSweepReview
  background var(--wren-bg-canvas)

.sendSweepChain
  display grid
  grid-template-columns auto minmax(0, 1fr)
  align-items center
  gap var(--wren-space-3)
  padding var(--wren-space-3) 0

  .sendSweepChainLabel
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)
    font-weight 600
    text-transform uppercase

  .dropdownWrap
    height 44px

  .dropdown.wrenInput
    width 100%
    min-height 44px
    height 44px
    padding-right 36px
    background-image linear-gradient(45deg, transparent 50%, var(--wren-text-tertiary) 50%), linear-gradient(135deg, var(--wren-text-tertiary) 50%, transparent 50%), linear-gradient(180deg, rgba(255, 255, 255, .012), transparent 48%)
    background-position calc(100% - 16px) 19px, calc(100% - 11px) 19px, 0 0
    background-repeat no-repeat
    background-size 5px 5px, 5px 5px, auto

.sendSweepHeader
  display flex
  align-items flex-end
  justify-content space-between
  gap var(--wren-space-3)
  padding var(--wren-space-3) 0 var(--wren-space-2)

  > div
    display flex
    flex-direction column
    gap 3px

  strong
    font-size var(--wren-type-body)

  span
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)

.sendSweepHeaderActions
  display flex
  flex none
  align-items flex-end
  gap var(--wren-space-2)

button.sendSweepSelectAll.wrenControl
  min-width max-content
  color var(--wren-text-secondary)

.sendSweepAssets
  display flex
  gap 0
  flex-direction column

  > label
    position relative
    display grid
    min-height 62px
    grid-template-columns 24px 34px minmax(0, 1fr) auto
    align-items center
    gap 10px
    padding 0 10px
    border 0
    border-radius 0
    background transparent
    cursor pointer
    transition background-color var(--wren-motion-fast) var(--wren-ease)

    &:hover
      background var(--wren-ledger-hover)

    &:focus-within
      outline 2px solid var(--wren-focus)
      outline-offset 1px

    &.sendSweepAssetSelected
      background var(--wren-ledger-selected)
      box-shadow none

    > span
      min-width 0

      &:last-child
        font-family var(--wren-font-mono)
        font-size var(--wren-type-small)

      strong,
      code
        display block
        overflow hidden
        text-overflow ellipsis
        white-space nowrap

      code
        margin-top 3px
        color var(--wren-text-muted)
        font-family var(--wren-font-mono)
        font-size var(--wren-type-caption)

    input
      position absolute
      z-index 2
      left 0
      width 44px
      height 44px
      margin 0
      opacity 0
      cursor pointer

      &:disabled
        cursor default

    .sendSweepCheckbox
      display flex
      width 18px
      height 18px
      align-items center
      justify-content center
      box-sizing border-box
      border 1px solid var(--wren-border-strong)
      border-radius 3px
      color var(--wren-text-inverse)
      background var(--wren-surface-inset)
      box-shadow var(--wren-shadow-inset)

    &.sendSweepAssetSelected .sendSweepCheckbox
      border-color var(--wren-accent-primary-hover)
      background var(--wren-accent-primary)

    &:has(input:disabled) .sendSweepCheckbox
      opacity .55

.sendSweepWarning
  display flex
  gap 4px
  margin var(--wren-space-3) 0
  padding 10px 12px
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background var(--wren-warning-soft)
  font-size var(--wren-type-small)
  line-height 1.45
  flex-direction column

.sendSweepWarningCompact
  display block

.sendSweepTruth
  display flex
  border-top 1px solid var(--wren-border-subtle)
  flex-direction column

  > div
    display grid
    grid-template-columns minmax(0, 1fr) auto
    gap 5px 10px
    padding var(--wren-space-3) 0
    border-bottom 1px solid var(--wren-border-subtle)

    > span:first-child
      grid-column 1 / -1
      color var(--wren-text-muted)
      font-size var(--wren-type-caption)
      font-weight 600

    > code
      min-width 0
      overflow-wrap anywhere
      color var(--wren-text-primary)
      font-family var(--wren-font-mono)
      font-size var(--wren-type-caption)
      line-height 18px

    > button,
    > .sendSweepCopies
      grid-column 2
      grid-row 2 / span 2
      align-self center

.sendSweepCopies
  display flex
  flex-direction column
  gap 4px

.sendSweepPrivacyCopy
  margin var(--wren-space-2) 0 0
  color var(--wren-text-muted)
  font-size var(--wren-type-caption)
  line-height 1.4

.sendSweepCalls
  margin var(--wren-space-3) 0
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)

  summary
    min-height 44px
    line-height 44px
    cursor pointer

  > div
    display flex
    gap 3px
    padding 8px 0
    border-top 1px solid var(--wren-border-subtle)
    flex-direction column

    code
      overflow-wrap anywhere
      font-family var(--wren-font-mono)
      font-size var(--wren-type-caption)

.sendSweepReviewActions
  position sticky
  bottom 0
  display flex
  justify-content flex-end
  gap var(--wren-space-2)
  margin 10px -24px 0
  padding 14px 24px 16px
  background var(--wren-bg-canvas)

.sendSweepShelf
  margin-right -24px
  margin-left -24px

.sendComposerError
  margin 12px 24px 0
  padding 10px 12px
  border 0
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background var(--wren-danger-soft)
  font-size var(--wren-type-small)
  line-height 1.45

.sendComposerNotice
  background var(--wren-warning-soft)

.sendActionShelf
  position sticky
  z-index 5
  bottom 0
  display flex
  min-height 76px
  align-items center
  justify-content flex-end
  box-sizing border-box
  margin-top 12px
  padding 14px 24px 16px
  border-top 1px solid rgba(61, 73, 63, .62)
  background rgba(7, 9, 7, .92)
  backdrop-filter blur(10px)

  button
    min-width 164px

.sendActionShelf.sendSweepShelf
  margin-top auto

.sendPicker
  padding 14px 24px 24px

.sendPickerSearch
  display flex
  height 48px
  align-items center
  gap 10px
  padding 0 var(--wren-space-3)
  color var(--wren-text-muted)

  input.wrenInput
    min-width 0
    height 44px
    flex 1
    padding 0
    border 0
    background transparent
    box-shadow none

    &::placeholder
      color var(--wren-text-disabled)
      font-family var(--wren-font-ui)
      font-weight 430

.sendAssetList
  display flex
  flex-direction column

.sendContactList
  display flex
  flex-direction column

.sendPickerSection
  display flex
  flex-direction column

  h3
    margin 0
    padding 18px 2px 8px
    color var(--wren-text-tertiary)
    font-size var(--wren-type-caption)
    font-weight 620
    letter-spacing .055em
    text-transform uppercase

.sendPickerSectionTitle
  margin 0
  padding 22px 2px 8px
  color var(--wren-text-tertiary)
  font-size var(--wren-type-caption)
  font-weight 620
  letter-spacing .055em
  text-transform uppercase

.sendContactOption
  display grid
  min-height 64px
  grid-template-columns 36px minmax(0, 1fr) auto
  align-items center
  gap 10px
  padding 8px 2px
  border 0
  border-radius var(--wren-radius-sm)
  color var(--wren-text-primary)
  background transparent
  font-family var(--wren-font-ui)
  text-align left
  cursor pointer

  &:hover
    background var(--wren-ledger-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset -2px

.sendContactIcon
  display flex
  width 32px
  height 32px
  align-items center
  justify-content center
  color var(--wren-text-secondary)

.sendContactIdentity
  display flex
  min-width 0
  flex-direction column
  gap 3px

  strong,
  span
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  strong
    font-size var(--wren-type-body)
    font-weight 610

  span
    color var(--wren-text-muted)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)

  code
    color var(--wren-text-muted)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    line-height 17px
    overflow-wrap anywhere
    word-break break-word

.sendRecentRecipientOption
  min-height 76px
  align-items start
  padding-top 10px
  padding-bottom 10px

  .sendContactIcon
    margin-top 2px

  .sendContactContext
    white-space normal

.sendContactContext
  max-width 132px
  overflow hidden
  color var(--wren-text-tertiary)
  font-size var(--wren-type-caption)
  line-height 17px
  text-align right
  text-overflow ellipsis

.sendAssetOption
  display grid
  min-height 68px
  grid-template-columns 42px minmax(90px, 1fr) minmax(100px, auto) 22px
  align-items center
  gap 10px
  padding 8px 2px
  border 0
  border 1px solid transparent
  border-radius var(--wren-radius-sm)
  color var(--wren-text-primary)
  background transparent
  font-family var(--wren-font-ui)
  text-align left
  cursor pointer

  &:hover
    border-color var(--wren-border-subtle)
    background var(--wren-ledger-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset -2px

  &[aria-pressed='true'],
  &.sendAssetOptionSelected
    border-color var(--wren-border-default)
    background var(--wren-ledger-selected)
    box-shadow var(--wren-shadow-inset)

    &:hover
      border-color var(--wren-border-strong)
      background var(--wren-surface-active)

.sendAssetSelection
  display flex
  width 22px
  align-items center
  justify-content center

.sendAssetIdentity,
.sendAssetBalance
  display flex
  min-width 0
  flex-direction column
  gap 3px

  strong,
  span
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  strong
    font-size var(--wren-type-body)
    font-weight 610

  span
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)

.sendAssetBalance
  align-items flex-end
  text-align right

.sendPickerEmpty,
.sendUnavailable
  display flex
  align-items center
  justify-content center
  color var(--wren-text-muted)
  font-size var(--wren-type-body)

.sendUnavailableAsset
  gap var(--wren-space-5)
  padding var(--wren-space-6)
  flex-direction column
  text-align center

.sendUnavailable .wrenEmptyStateExpanded
  min-height auto
  padding 0 var(--wren-space-5)
  flex-direction column
  justify-content center
  background transparent
  text-align center

  .wrenEmptyStateImage
    position static
    width 190px
    margin 0 0 var(--wren-space-3)
    transform none

  .wrenEmptyStateText
    max-width 320px

.sendPickerEmpty
  min-height 180px

.sendRequestState
  display flex
  min-height 100%
  align-items center
  justify-content center
  flex-direction column
  padding 40px
  text-align center

  h2
    margin 18px 0 8px
    font-size 20px
    font-weight 620

  p
    max-width 340px
    margin 0 0 26px
    color var(--wren-text-secondary)
    font-size var(--wren-type-body)
    line-height 1.5


.sendConfirmedDestination
  width min(100%, 430px)
  box-sizing border-box
  display grid
  grid-template-columns minmax(0, 1fr) auto
  gap 4px var(--wren-space-3)
  padding var(--wren-space-3) var(--wren-space-4)
  margin 0 0 var(--wren-space-5)
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  background var(--wren-surface-inset)
  text-align left

  > span
    grid-column 1 / -1
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)
    font-weight 600
    text-transform uppercase

  strong
    grid-column 1 / -1
    color var(--wren-text-primary)
    font-size var(--wren-type-body)
    font-weight 610

  code
    min-width 0
    overflow-wrap anywhere
    color var(--wren-accent-primary-hover)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    line-height 18px

  button
    align-self center

.sendConfirmedActions
  display flex
  flex-wrap wrap
  justify-content center
  gap var(--wren-space-2)

  button
    min-width 132px

.sendRecipientFeedback
  min-height 18px

.sendRecipientResolved
  min-width 0
  display grid
  grid-template-columns minmax(0, 1fr) auto
  align-items center
  gap 2px var(--wren-space-2)
  text-overflow clip
  white-space normal

  > span
    grid-column 1 / -1

  code
    min-width 0
    overflow-wrap anywhere
    color var(--wren-accent-primary-hover)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    line-height 18px

.sendRecipientCopy
  min-width 44px
  min-height 44px
  margin -13px 0
  padding 0 var(--wren-space-2)
  border 0
  border-radius var(--wren-radius-sm)
  background transparent
  color var(--wren-text-secondary)
  cursor pointer
  font-family var(--wren-font-ui)
  font-size var(--wren-type-caption)

  &:hover
    background var(--wren-surface-hover)
    color var(--wren-text-primary)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.sendCopyStatus
  min-height 18px
  grid-column 1 / -1
  color var(--wren-text-muted)
  font-size var(--wren-type-caption)
  text-align center

.sendRequestGlyph
  display flex
  width 58px
  height 58px
  align-items center
  justify-content center
  border 1px solid var(--wren-border-strong)
  border-radius 12px
  color var(--wren-accent-primary)
  background var(--wren-surface-inset)

.sendRequestStateSuccess .sendRequestGlyph
  color var(--wren-success)

@media (max-height: 760px)
  .sendLedger
    padding-top 6px

  .sendLedgerRow
    min-height 66px

  .sendInputRow
    padding-top 10px

  .sendAmountRow
    min-height 108px

  .sendFeeRow
    min-height 74px

  .sendActionShelf
    min-height 66px
    padding-top 10px
    padding-bottom 10px
