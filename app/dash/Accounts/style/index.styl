.dashAccountsPerch
  color var(--wren-text-primary)
  justify-content flex-start

  .localSettingsWrap
    width 100%
    padding 20px 18px 24px
    box-sizing border-box

  .dashHomeCard
    padding 14px 20px

  .dashAccountsSignerCard
    padding-bottom 8px

.dashAccountsCardHeader
  display flex
  min-height 34px
  align-items flex-start
  justify-content space-between

  h2
    margin 0
    color var(--wren-text-tertiary)
    font-family var(--wren-font-mono)
    font-size 12px
    font-weight 600
    letter-spacing 1.4px
    line-height 18px
    text-transform uppercase

.dashAccountSignerLedger
  width 100%

.dashAccountSigner
  appearance none
  display grid
  width 100%
  min-height 72px
  padding 0
  grid-template-columns 42px minmax(0, 1fr) auto 16px
  align-items center
  gap 12px
  border 0
  border-top 1px solid rgba(150, 182, 150, .10)
  color var(--wren-text-primary)
  background transparent
  font-family var(--wren-font-ui)
  text-align left
  cursor pointer

  &:first-child
    border-top 0

  &:hover
    background var(--wren-surface-hover)

  &:active
    background rgba(10, 14, 12, .5)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset -2px

.dashAccountSignerIcon
  display flex
  width 42px
  height 42px
  align-items center
  justify-content center
  box-sizing border-box
  border 1px solid rgba(150, 182, 150, .18)
  border-radius 8px
  color var(--wren-text-secondary)
  background rgba(18, 24, 19, .72)

.dashAccountSignerIdentity
  display flex
  min-width 0
  flex-direction column
  gap 3px

  strong,
  span
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  strong
    color var(--wren-text-primary)
    font-size 14px
    font-weight 500

  span
    color var(--wren-text-tertiary)
    font-family var(--wren-font-mono)
    font-size 12px

.dashAccountSignerRole
  color var(--wren-text-tertiary)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  text-transform capitalize

.dashAccountsAddCard
  padding-bottom 16px !important

.dashAccountsActions
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap var(--wren-space-2)

  button
    appearance none
    display flex
    min-width 0
    min-height 44px
    padding 0 var(--wren-space-3)
    align-items center
    justify-content center
    gap var(--wren-space-2)
    border 1px solid rgba(150, 182, 150, .16)
    border-radius 9px
    color var(--wren-text-secondary)
    background var(--wren-bg-elevated)
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .018)
    font-family var(--wren-font-ui)
    font-size 13px
    font-weight 500
    text-align center
    cursor pointer
    transition border-color var(--wren-motion-fast) var(--wren-ease), background var(--wren-motion-fast) var(--wren-ease)

    svg
      flex none
      color currentColor

    &:hover
      border-color rgba(150, 182, 150, .25)
      color var(--wren-text-primary)
      background var(--wren-surface-hover)

    &:active
      background rgba(8, 11, 9, .56)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

.dashAccountsWatchCard
  padding-bottom 14px !important

  .dashAccountsEmptyCopy
    min-height 36px

  .watchAccount
    min-height 62px
    padding 0

  .watchAccount:hover
    background var(--wren-surface-hover)

  .watchAccount:active
    background rgba(10, 14, 12, .5)

  .watchAccountIcon
    width 42px
    height 42px
    margin-right 12px
    border 1px solid rgba(150, 182, 150, .18)
    border-radius 8px
    color var(--wren-text-secondary)
    background rgba(18, 24, 19, .72)

  .watchAccountName
    color var(--wren-text-primary)
    font-size 14px
    font-weight 500

  .watchAccountAddress
    color var(--wren-text-tertiary)
    font-size 12px

.dashAccountsEmptyCopy
  min-height 52px
  margin 0
  display flex
  align-items center
  color var(--wren-text-tertiary)
  font-size 13px
  line-height 1.5

.dashAccountsPerch > .localSettingsWrap > .delegationRevocation
  margin 80px 0 12px
  padding 16px 20px
  border 1px solid rgba(150, 182, 150, .16)
  border-radius 10px
  background linear-gradient(172deg, rgba(255, 255, 255, .022), rgba(255, 255, 255, 0) 46%), var(--wren-surface-card)
  box-shadow 0 10px 26px rgba(0, 0, 0, .5)

@media (max-width: 560px)
  .dashAccountsActions
    grid-template-columns repeat(3, minmax(0, 1fr))

    button
      padding 0 var(--wren-space-2)
      font-size var(--wren-type-caption)

.accountTypeAdvanced > summary
  box-sizing border-box
  min-height 44px
  padding 12px 0
  cursor pointer
  font-size 12px
  line-height 20px
.dashAccountsActions
  grid-template-columns repeat(2, minmax(0, 1fr))

.accountDelegationEntry
  margin 20px 0

  > summary
    min-height 44px
    padding 12px 0
    box-sizing border-box
    cursor pointer
    font-size 14px
