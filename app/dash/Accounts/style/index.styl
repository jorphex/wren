.dashAccountsPerch
  color #d6d2c8
  justify-content flex-start

  .localSettingsWrap
    width 100%
    padding 20px 18px 24px
    box-sizing border-box

  .dashHomeCard
    padding 14px 20px

  .dashAccountsSignerCard
    padding-bottom 8px

.dashAccountsCardHeader
  display flex
  min-height 34px
  align-items flex-start
  justify-content space-between

  h2
    margin 0
    color #97917f
    font-family var(--wren-font-mono)
    font-size 12px
    font-weight 600
    letter-spacing 1.4px
    line-height 18px
    text-transform uppercase

.dashAccountSignerLedger
  width 100%

.dashAccountSigner
  appearance none
  display grid
  width 100%
  min-height 72px
  padding 0
  grid-template-columns 42px minmax(0, 1fr) auto
  align-items center
  gap 12px
  border 0
  border-top 1px solid rgba(150, 182, 150, .10)
  color #d6d2c8
  background transparent
  font-family var(--wren-font-ui)
  text-align left
  cursor pointer

  &:first-child
    border-top 0

  &:hover
    background transparent

  &:active
    background rgba(10, 14, 12, .5)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset -2px

.dashAccountSignerIcon
  display flex
  width 42px
  height 42px
  align-items center
  justify-content center
  box-sizing border-box
  border 1px solid rgba(150, 182, 150, .18)
  border-radius 8px
  color #d6d2c8
  background rgba(18, 24, 19, .72)

.dashAccountSignerIdentity
  display flex
  min-width 0
  flex-direction column
  gap 3px

  strong,
  span
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  strong
    color #f2efe8
    font-size 14px
    font-weight 500

  span
    color #97917f
    font-family var(--wren-font-mono)
    font-size 12px

.dashAccountSignerRole
  color #d6d2c8
  font-size 13px

.dashAccountsAddCard
  padding-bottom 16px !important

.dashAccountsActions
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 10px

  button
    appearance none
    display flex
    min-width 0
    min-height 64px
    padding 0 18px
    align-items center
    gap 10px
    border 1px solid rgba(150, 182, 150, .16)
    border-radius 9px
    color #d6d2c8
    background rgba(9, 13, 11, .28)
    box-shadow inset 0 1px 0 rgba(255, 255, 255, .018)
    font-family var(--wren-font-ui)
    font-size 14px
    font-weight 500
    text-align left
    cursor pointer
    transition border-color var(--wren-motion-fast) var(--wren-ease), background var(--wren-motion-fast) var(--wren-ease)

    svg
      flex none
      color #d6d2c8

    &:hover
      border-color rgba(150, 182, 150, .25)
      background rgba(20, 26, 22, .5)

    &:active
      background rgba(8, 11, 9, .56)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

.dashAccountsWatchCard
  padding-bottom 14px !important

  .dashAccountsEmptyCopy
    min-height 36px

  .watchAccount
    min-height 62px
    padding 0

  .watchAccount:hover
    background transparent

  .watchAccount:active
    background rgba(10, 14, 12, .5)

  .watchAccountIcon
    width 42px
    height 42px
    margin-right 12px
    border 1px solid rgba(150, 182, 150, .18)
    border-radius 8px
    color #d6d2c8
    background rgba(18, 24, 19, .72)

  .watchAccountName
    color #f2efe8
    font-size 14px
    font-weight 500

  .watchAccountAddress
    color #97917f
    font-size 12px

.dashAccountsEmptyCopy
  min-height 52px
  margin 0
  display flex
  align-items center
  color #97917f
  font-size 13px
  line-height 1.5

.dashAccountsPerch > .localSettingsWrap > .delegationRevocation
  margin 80px 0 12px
  padding 16px 20px
  border 1px solid rgba(150, 182, 150, .16)
  border-radius 10px
  background linear-gradient(172deg, rgba(255, 255, 255, .022), rgba(255, 255, 255, 0) 46%), rgba(13, 18, 16, .66)
  box-shadow 0 10px 26px rgba(0, 0, 0, .5)

@media (max-width: 560px)
  .dashAccountsActions
    grid-template-columns minmax(0, 1fr)
