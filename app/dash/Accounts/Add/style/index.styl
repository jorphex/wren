.addAccountTrigger
  appearance none
  padding 0
  color inherit
  font-family inherit
  font-size inherit
  border 0
  background transparent

.addAccountItem
  display flex
  justify-content center
  align-items center
  flex-direction column
  transition var(--standardSlowest)
  transition-delay 0.32s
  position relative
  overflow hidden
  position relative
  position absolute
  top 0
  left 0
  bottom 0
  right 0

  .addAccountItemWrap
    width 100%
    height 100%
    background var(--ghostZ)
    border-radius 4px
    z-index 2
    display flex
    justify-content center
    align-items center
    flex-direction column
    position relative

  &:not(.generatedWalletSetup) .addAccountItemWrap
    background transparent

    &::before
      content ''
      position absolute
      inset 22px 24px 24px
      z-index -1
      border 1px solid rgba(150, 182, 150, .16)
      border-radius 10px
      background linear-gradient(172deg, rgba(255, 255, 255, .022), rgba(255, 255, 255, 0) 46%), var(--wren-surface-card)
      box-shadow 0 12px 28px rgba(0, 0, 0, .44), inset 1px 1px 0 rgba(150, 182, 150, .04)

  &:not(.generatedWalletSetup) .addAccountItemTopType
    top 18px
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size 20px
    font-weight 600

  &:not(.generatedWalletSetup) .addAccountItemSummary
    top 82px
    border-color var(--wren-ledger-rule)
    color var(--wren-text-secondary)
    background rgba(8, 12, 10, .3)

  &:not(.generatedWalletSetup) .addAccountItemOptionTitle
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size 14px
    font-weight 500
    letter-spacing 0
    text-transform none

  &:not(.generatedWalletSetup) .addAccountItemOptionSubmit
    height 44px
    min-width 156px
    padding 0 24px
    border-radius var(--wren-radius-md)
    box-shadow none
    text-transform none

  .addAccountItemClose
    position absolute
    top 18px
    right 10px
    border-radius 8px
    cursor pointer
    background var(--ghostB)
    width 90px
    height 30px
    display flex
    justify-content center
    align-items center
    font-size var(--wren-type-caption)
    letter-spacing 1px
    font-weight 300
    padding-bottom 1px
    padding-left 1px
    text-transform uppercase

    *
      pointer-events none

  .addAccountItemClose:hover
    background var(--ghostC)
  
  .addAccountItemTopType
    position absolute
    top 0
    left 0
    right 0
    display flex
    justify-content center
    align-items center
    font-size 22px
    font-family 'MainFont'
    font-weight 300
    width 100%
    margin 16px 0px

    .addAccountItemIconLedger
      position relative
      top -2px

    .addAccountItemIconTrezor
      position relative
      top -2px

    // .addAccountItemIconHot
    //   color var(--hot)

    // .addAccountItemIconMock
    //   color rgb(205, 170, 255)

    .addAccountItemTopTitle
      margin-top 0px
      margin-left 0px
      margin-bottom 2px
      text-transform capitalize
      text-shadow 0px 4px 8px var(--ghostX)

    .addAccountItemIcon
      position relative
      height 40px
      width 40px
      display flex
      justify-content center
      align-items center
      color var(--outerspace)
      margin 2px 9px 2px 0px
      border-radius 12px
      transform scale(1)

    .addAccountItemIconHex
      width 45px
      height 45px
      opacity 1
      position absolute
      border-radius 8px
      display none
      
  .addAccountItemSummary
    display flex
    align-items center
    justify-content center
    z-index 9999
    font-size 13px
    text-align center
    box-sizing border-box
    position absolute
    font-weight 400
    top 80px
    left 50px
    right 50px
    padding 16px
    border 1px solid var(--outerspace)
    border-radius 12px

  .addAccountItemTrezorBridgeWarning
    display flex
    align-items center
    justify-content space-between
    flex-direction column
    z-index 9999999
    text-transform uppercase
    letter-spacing 0px
    text-align center
    min-height 22px
    box-sizing border-box
    position absolute
    font-weight 400
    bottom 20px
    left 20px
    right 20px

    .openBridgeUrl
      color var(--good)
      cursor pointer

    .openBridgeUrl:hover
      text-decoration underline
      transform translateY(0)
      transition var(--standardFast)

  .addAccountItemFooter:before
    content ''
    position absolute
    top 0px
    left 8px
    right 8px
    height 4px
    border-radius 2px
    background var(--ghostA)

  .addAccountItemFooter
    display flex
    align-items center
    justify-content center
    z-index 9999999
    line-height 22px
    font-size var(--wren-type-caption)
    text-transform uppercase
    letter-spacing 1px
    text-align justify
    text-align-last center-justify
    min-height 50px
    box-sizing border-box
    position absolute
    bottom 8px
    left 8px
    right 8px
    display none
  
  .addAccountItemDevices
    position absolute
    top 120px
    left 0px
    bottom 0px
    right 0px
    padding 10px
    font-size var(--wren-type-small)
    text-transform uppercase
    letter-spacing 2px
    margin-top 12px
    transition var(--standardSlow)
    overflow hidden
    font-weight 400
    flex-direction column
    overflow-y scroll

    .addAccountItemDevice
      min-height 250px
      display flex
      justify-content center
      align-items center
      flex-direction column
      padding 12px 16px 24px

    .addAccountItemDeviceArtwork
      display block
      width min(100%, 360px)
      max-height 190px
      margin-bottom 12px
      object-fit contain

    .addAccountItemDeviceTitle
      color var(--wren-text-primary)
      font-size 14px
      font-weight 500
      text-align center
      text-transform none
      letter-spacing 0

    .addAccountItemDeviceStatus
      margin-top 6px
      color var(--wren-text-secondary)
      font-size var(--wren-type-small)
      display flex
      justify-content center
      align-items center
      text-align center
      text-transform none
      letter-spacing 0

  .addAccountItemOption
    position absolute 
    top 150px
    left 0
    right 0
    bottom 60px
    line-height 22px
    font-size 14px
    text-transform uppercase
    transition var(--standardSlow)
    overflow hidden
    font-weight 400

  .addAccountItemOptionSetup
    position absolute
    top 0px
    right 0
    bottom 0
    left 0
    opacity 0
    pointer-events none
    transition var(--standardSlow)
    transform translateX(0%)

    .addAccountItemOptionSetupFrames
      display flex
      width 1000%
      height 100%

      .addAccountItemOptionSetupFrame
        display flex
        align-items center
        flex-direction column
        transition var(--standardSlow)
        width 10%
        overflow-y scroll
        height 100%
        display flex
        justify-content center
        align-items center
        padding 0px 10px
        box-sizing border-box

        .signerAddressAdded
          color var(--good)

        .addAccountItemOptionTitle
          margin-bottom 12px
          text-align center
          font-size 15px
          font-weight 400
          box-sizing border-box

  .addAccountItemOptionError
    height 34px
    padding 0px 20px
    margin-top 12px
    font-size var(--wren-type-small)
    color var(--moon)
    text-align center
  
  .addAccountItemOptionProcessing
    height 34px
    padding 0px 20px
    margin-top 12px
    font-size var(--wren-type-small)
    text-align center

  .addAccountItemOptionPasswordConsent
    position relative
    display flex
    align-items center
    max-width 390px
    min-height 44px
    margin-top 4px
    padding 0px 20px
    box-sizing border-box
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    line-height 1.35
    cursor pointer

    input
      position absolute
      inset 0
      width 100%
      height 100%
      margin 0
      opacity 0
      cursor pointer

    span
      display flex
      align-items center
      gap 8px

      &::before
        content ''
        flex 0 0 18px
        width 18px
        height 18px
        box-sizing border-box
        border 1px solid var(--wren-border-default)
        border-radius var(--wren-radius-sm)
        color var(--wren-text-inverse)
        background var(--wren-surface-inset)
        font-size 13px
        font-weight 700
        line-height 16px
        text-align center

    input:checked + span::before
      content '\2713'
      border-color var(--wren-accent-primary-hover)
      background var(--wren-accent-primary)

    input:focus-visible + span::before
      outline 2px solid var(--wren-accent-primary-hover)
      outline-offset 2px

  .addAccountItemOptionSubmit
    appearance none
    color inherit
    font-family inherit
    font-size inherit
    border 0
    height 32px
    border-radius 16px
    padding 0px 40px
    margin-top 12px
    display flex
    text-align center
    justify-content center
    align-items center
    cursor pointer
    background var(--ghostA)
    border-bottom 2px solid var(--ghostZ)
    transform translate3d(0, 0, 0)
    box-shadow 0px 1px 6px var(--ghostY)

  .addAccountItemOptionSubmit:not(:disabled):hover
    background var(--ghostC)

  .addAccountItemOptionSubmit:disabled
    cursor default
    opacity 0.45

  .addAccountResolvingEns

    .addAccountItemOptionSubmit
      margin-top 28px

  .addAccountItemOptionList
    width calc(100% - 0px)
    border-radius 4px
    padding 50px 0px
    height calc(100% - 60px)
    top 20px
    position relative
    overflow hidden
    box-sizing border-box
    overflow-x hidden
    overflow-y scroll

  .fira
    font-family 'FiraCode'
    text-transform none

  .addAccountItemOptionListItem
    text-align center
    padding 16px 8px 16px 8px
    margin-left -3px
    margin 10px
    font-weight 300
    cursor pointer
    border-radius 8px
    background var(--ghostB)
    *
      cursor pointer

    .actingAccountAddress
      font-family 'FiraCode'
      font-size 20px
      display flex
      justify-content center
      align-items center
      text-transform none

      svg
        padding 2px 3px 0px 3px

    .actingAccountTag
      font-weight 400
      font-size var(--wren-type-small)
      text-transform none
      color var(--outerspace08)

  .addAccountItemOptionListItem:hover
    background var(--ghostC)

  .addAccountItemOptionInput
    width calc(100% - 40px)
    border-radius 6px
    height 50px
    padding 10px
    position relative
    overflow hidden
    background var(--ghostA)

    textarea
      width calc(100%)
      background transparent
      border none
      outline none
      color var(--foreverwhite)
      text-align center
      font-size 13px
      line-height 20px
      font-family 'FiraCode'
      padding-bottom 100px
      overflow hidden
      margin 4px 0px 0px 3px

    textarea::selection
      background rgba(5, 25, 35, 1)

  .addAccountItemOptionInput
    width 100%
    border-radius 16px
    padding 0px 0px
    position relative
    overflow hidden
    background var(--ghostA)
    border-bottom 2px solid var(--ghostZ)
    transform translate3d(0, 0, 0)
    box-shadow 0px 2px 8px var(--ghostY)
    color var(--outerspace)

    input
      width 100%
      height 100%
      padding 10px 20px 13px 21px
      background transparent
      border none
      outline none
      color var(--outerspace)
      text-align center
      font-size 22px
      line-height 20px
      font-weight 400
      display flex
      justify-content center
      align-items center
      letter-spacing 1px
      resize none
      transform translate3d(0, 0, 0)
      font-family 'MainFont'

    input::selection
      background var(--moon)

  .addAccountItemOptionInput.phrase
    height 122px

    // display flex
    // justify-content center
    // align-items center
    // text-align center

    .addAccountItemOptionSubtitle
      position absolute
      bottom 0
      display flex
      justify-content center
      align-items center
      text-align center
      font-size var(--wren-type-caption)
      width 100%
      font-weight 300
      letter-spacing 1px
      box-sizing border-box

    textarea
      width 100%
      height 100%
      padding 10px 20px
      background transparent
      border none
      outline none
      color var(--outerspace)
      text-align center
      font-size 15px
      line-height 20px
      font-family 'FiraCode'
      display flex
      justify-content center
      align-items center
      overflow-x hidden
      overflow-y scroll
      resize none

    textarea::selection
      background var(--moon)

  .addAccountItemOptionInput.address

    input
      font-size var(--wren-type-small)
      padding 10px 10px

  .addAccountItemOptionInputPassword
    height 72px

    input
      padding-left 52px
      padding-right 52px

    .addAccountItemOptionPasswordReveal
      position absolute
      top 50%
      right 8px
      width 40px
      min-width 40px
      height 40px
      transform translateY(-50%)

  .addAccountItemColorBar
    position absolute
    top 0px
    left -40px
    right -40px
    height 4px
    background var(--outerspace)
    border-radius 6px

  // .addAccountItemHardware
  //   background var(--hardware)

  // .addAccountItemHot
  //   background rgb(255, 150, 150)

  // .addAccountItemMock
  //   background rgb(205, 170, 255)

.addAccountItemAdding
  .addAccountItemOptionIntro
    opacity 0
    pointer-events none
  .addAccountItemOptionSetup
    opacity 1
    pointer-events auto

.addAccountMainActive
  .addAccountMainInner
    .addAccountItem
      opacity 1
      transform translateY(0) scale(1)

.addAccountMainActive
  pointer-events auto
  opacity 1
  transform translateY(0px) scale(1) rotateY(0deg)
  transition-delay 0.00s

// Wren account setup surfaces
.addAccountItem
  .addAccountItemWrap
    border-radius 0
    background transparent

  .addAccountItemClose,
  .addAccountItemOptionSubmit
    min-width 156px
    min-height 42px
    padding 0 var(--wren-space-4)
    border 1px solid var(--wren-accent-primary)
    border-radius var(--wren-radius-sm)
    color var(--wren-text-inverse)
    background var(--wren-accent-primary)
    box-shadow var(--wren-shadow-sm)
    text-transform none
    letter-spacing 0
    font-family var(--wren-font-ui)
    font-size 14px
    font-weight 600

    &:not(:disabled):hover
      color var(--wren-text-inverse)
      border-color var(--wren-accent-primary-hover)
      background var(--wren-accent-primary-hover)

    &:not(:disabled):active
      border-color var(--wren-accent-primary-active)
      background var(--wren-accent-primary-active)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

    &:disabled
      border-color var(--wren-border-default)
      color var(--wren-text-disabled)
      background var(--wren-bg-panel-strong)
      box-shadow none

  .addAccountItemTopType
    color var(--wren-text-primary)
    font-weight 500
    font-variation-settings var(--wren-font-heading-settings)

    .addAccountItemTopTitle
      text-shadow none
      text-transform none

    .addAccountItemIcon
      border 0
      border-radius 0
      color var(--wren-accent-primary-hover)
      background transparent

  .addAccountItemSummary
    top 76px
    left 80px
    right 80px
    min-height 24px
    padding 0
    border 0
    border-radius 0
    color var(--wren-text-secondary)
    background transparent
    line-height 20px

  .addAccountItemOption
    top 210px
    bottom 40px

  .addAccountItemOptionSetup .addAccountItemOptionSetupFrames .addAccountItemOptionSetupFrame
    justify-content flex-start
    padding 36px var(--wren-space-8) var(--wren-space-5)
    box-sizing border-box

  .addAccountItemTrezorBridgeWarning,
  .addAccountItemOption,
  .addAccountItemDevices
    text-transform none
    letter-spacing 0

  .addAccountItemOptionListItem
    border 1px solid var(--wren-border-subtle)
    border-radius var(--wren-radius-sm)
    background var(--wren-surface-card)

    &:hover
      border-color var(--wren-border-default)
      background var(--wren-surface-hover)

  .addAccountItemOptionInput
    max-width 620px
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    background var(--wren-surface-inset)
    box-shadow none

    input
      font-size 16px
      letter-spacing 0

    textarea
      color var(--wren-text-primary)
      font-family var(--wren-font-mono)

  .addAccountItemOptionInput.address input
    color var(--wren-text-primary)
    font-family var(--wren-font-mono)
    font-size 14px

  .addAccountItemOptionInput.phrase.addAccountItemOptionInputSingleLine
    height 54px

    textarea
      padding 15px var(--wren-space-3)
      overflow hidden
      white-space nowrap

  .addAccountItemOptionTitle
    color var(--wren-text-primary)
    font-size 15px
    font-weight 500
    text-transform none

  .addAccountItemOptionError,
  .addAccountItemOptionProcessing
    color var(--wren-text-secondary)
    font-size 13px
    text-transform none

  .addAccountItemColorBar
    height 2px
    border-radius 0
    background var(--wren-accent-primary)

@media (max-height: 760px)
  .addAccountItem
    .addAccountItemSummary
      top 70px

    .addAccountItemOption
      top 184px

    .addAccountItemOptionSetup .addAccountItemOptionSetupFrames .addAccountItemOptionSetupFrame
      padding-top var(--wren-space-4)

.addAccountItem
  .addAccountItemOptionSetup .addAccountItemOptionSetupFrames .generatedWalletFrame
    padding 0 var(--wren-space-8)
    overflow hidden

  .generatedWalletFrameBody
    flex 1 1 auto
    width 100%
    max-width 620px
    min-height 0
    margin 0 auto
    padding var(--wren-space-5) 0 var(--wren-space-3)
    overflow-y auto
    box-sizing border-box
    scrollbar-width thin

  .generatedWalletGuidance,
  .generatedWalletConsequence,
  .generatedWalletClipboardNote,
  .generatedWalletSessionNote
    margin var(--wren-space-2) auto 0
    color var(--wren-text-secondary)
    font-size 13px
    line-height 20px
    text-align center
    text-transform none

  .generatedWalletConsequence
    color var(--wren-text-muted)

  .generatedWalletClipboardNote,
  .generatedWalletSessionNote
    margin var(--wren-space-2) auto 0
    color var(--wren-text-muted)
    font-size 12px
    line-height 18px
    text-align center
    text-transform none

  .generatedWalletSessionNote.generatedWalletExpiryNotice
    color var(--wren-text-secondary)
    font-weight 500

  .generatedWalletPhrase
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 0 var(--wren-space-4)
    width 100%
    margin var(--wren-space-4) 0
    padding var(--wren-space-2) var(--wren-space-3)
    border-radius var(--wren-radius-sm)
    background var(--wren-surface-inset)
    list-style none
    box-sizing border-box

    li
      display grid
      grid-template-columns 28px minmax(0, 1fr)
      align-items center
      min-height 40px
      padding 0 var(--wren-space-1)
      color var(--wren-text-primary)
      box-sizing border-box
      font-family var(--wren-font-mono)
      font-size 13px
      text-transform none

      span
        color var(--wren-text-muted)
        font-size 12px

      strong
        font-weight 500

  .generatedWalletActionShelf
    display flex
    flex 0 0 68px
    align-items center
    justify-content center
    width 100%
    border-top 1px solid var(--wren-border-subtle)

    .addAccountItemOptionSubmit
      min-height 44px
      margin 0

  .generatedWalletQuietControl
    display inline-flex
    align-items center
    justify-content center
    gap var(--wren-space-2)
    min-height 44px
    padding 0 var(--wren-space-3)
    border-radius var(--wren-radius-sm)
    font-family var(--wren-font-ui)
    font-size 13px
    text-transform none

  .generatedWalletCopyGroup
    position relative
    display inline-flex
    justify-content center

  .generatedWalletCopyStatus
    position absolute
    width 1px
    height 1px
    overflow hidden
    clip-path inset(50%)

  .generatedWalletScreenReaderOnly
    position absolute
    width 1px
    height 1px
    overflow hidden
    clip-path inset(50%)

  .generatedWalletEvidenceGroup
    margin-top var(--wren-space-4)
    padding var(--wren-space-4)
    border-radius var(--wren-radius-sm)
    background var(--wren-surface-inset)

  .generatedWalletEvidence
    display grid
    grid-template-columns minmax(0, 1fr) auto
    gap var(--wren-space-2) var(--wren-space-3)
    align-items center

    & + .generatedWalletEvidence
      margin-top var(--wren-space-5)

  .generatedWalletEvidenceLabel
    grid-column 1 / -1
    color var(--wren-text-secondary)
    font-size 12px
    font-weight 500
    text-transform none

  .generatedWalletEvidenceValue
    min-width 0
    overflow-wrap anywhere
    color var(--wren-text-primary)
    font-family var(--wren-font-mono)
    font-size 13px
    line-height 20px
    text-transform none

    &.concealed
      color var(--wren-text-secondary)
      letter-spacing 2px

  .generatedWalletEvidenceControls
    grid-column 1 / -1
    display flex
    flex-wrap wrap
    gap var(--wren-space-2)

  .generatedWalletVerify
    display flex
    align-items center
    flex-direction column

  .generatedWalletVerifyField
    display grid
    grid-template-columns 72px minmax(0, 1fr)
    gap var(--wren-space-3)
    align-items center
    width 100%
    max-width 440px
    margin-top var(--wren-space-3)
    color var(--wren-text-secondary)
    font-size 13px
    text-transform none

    .wrenInputGroup
      height 48px

    input
      width 100%
      height 44px
      padding 0 var(--wren-space-3)
      border 0
      outline 0
      color var(--wren-text-primary)
      background transparent
      font-family var(--wren-font-mono)
      font-size 14px

  .generatedWalletKeyInput
    width 100%
    max-width 620px
    min-height 108px
    margin-top var(--wren-space-4)

    textarea
      width 100%
      min-height 108px
      padding var(--wren-space-3)
      border 0
      outline 0
      resize none
      color var(--wren-text-primary)
      background transparent
      font-family var(--wren-font-mono)
      font-size 13px
      line-height 20px
      box-sizing border-box

  .generatedWalletVerifyError
    margin-top var(--wren-space-3)
    color var(--wren-danger)
    font-size 13px
    line-height 20px
    text-align center
    text-transform none

  .generatedWalletError
    display flex
    align-items center
    justify-content center
    flex-direction column

  &.generatedWalletSetup
    .addAccountItemOption
      top 170px

    .addAccountItemOptionSubmit
      min-height 44px

    // Recovery material must never share a moving viewport with its
    // verification step. Focus changes inside the translated track can make
    // an overflow-hidden carousel scroll and expose the adjacent secret step.
    .addAccountItemOptionSetup
      transform none !important
      transition none

      .addAccountItemOptionSetupFrames
        position relative
        width 100%

        .addAccountItemOptionSetupFrame
          display none
          width 100%
          transition none

          &[aria-hidden='false']
            display flex

@media (max-height: 760px)
  .addAccountItem
    &.generatedWalletSetup
      .addAccountItemOption
        top 160px

    .addAccountItemOptionSetup .addAccountItemOptionSetupFrames .generatedWalletFrame
      padding 0 var(--wren-space-5)

    .generatedWalletFrameBody
      padding-top var(--wren-space-3)

    .generatedWalletPhrase
      grid-template-columns repeat(3, minmax(0, 1fr))

    .generatedWalletActionShelf
      flex-basis 60px

.generatedWalletAbandonDialog
  position fixed
  z-index 50000000
  top 0
  right 0
  bottom 0
  left 0
  display flex
  align-items center
  justify-content center
  padding var(--wren-space-5)
  background rgba(18, 20, 22, .72)
