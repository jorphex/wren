body
  width 100%
  height 100%
  margin 0
  padding 0
  font-family 'MainFont'
  font-weight 300

  #dapp
    position relative
    width 100%
    height 100%
    padding 0

    .splash
      position absolute
      inset 0
      z-index 0

    .main
      position absolute
      inset 0
      z-index 9999
      display flex
      align-items center
      justify-content center
      color var(--outerspace)
      -webkit-user-select none

      .mainDappLoading
        .mainDappState
          display flex
          max-width 320px
          flex-direction column
          align-items center
          gap var(--wren-space-4)

        .mainDappLoadingText
          display flex
          flex-direction column
          gap var(--wren-space-1)
          color var(--wren-text-secondary)
          font-family var(--wren-font-ui)
          font-size var(--wren-type-body)
          font-weight 450
          text-align center
          line-height 1.45
          letter-spacing 0

          strong
            color var(--wren-text-primary)
            font-size 16px
            font-weight 560

        .mainDappStateAction
          min-height 44px
          min-width 112px

        .mainDappStateActions
          display flex
          flex-wrap wrap
          justify-content center
          gap var(--wren-space-2)

        .loader,
        .loader:after
          width 128px
          height 128px
          border-radius 100%

        .loader
          position relative
          border-top 3px solid var(--ghostY)
          border-right 3px solid var(--ghostY)
          border-bottom 3px solid var(--ghostY)
          border-left 3px solid var(--ghostD)
          font-size 7px
          text-indent -9999em
          transform translateZ(0)
          animation load8 .48s infinite linear !important
          will-change transform

        @keyframes load8
          0%
            transform rotate(0deg)
          100%
            transform rotate(360deg)

@import '../../resources/Components/Button'
