.requestNoticeApproval
  height 154px

.requestNoticeInnerApproval
  display block
  padding 8px 2px
  box-sizing border-box

.approveTransactionWarning
  width 100%
  height 100%
  overflow hidden

  .approveTransactionWarningBody
    display grid
    width 100%
    height 100%
    padding 10px 20px
    grid-template-rows auto auto 44px
    gap 6px
    box-sizing border-box
    overflow-wrap anywhere
    word-break normal

    .approveTransactionWarningTitle
      display flex
      align-items center
      min-height 30px
      gap var(--wren-space-2)
      color var(--wren-warning)
      font-family var(--wren-font-ui)
      font-size 16px
      font-weight 650
      letter-spacing 0
      line-height 20px
      text-transform none

      .approveTransactionWarningIcon
        color var(--wren-warning)
      
    .approveTransactionWarningMessage
      min-height 0
      padding 0
      overflow auto
      color var(--wren-text-secondary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-small)
      font-weight 400
      line-height 18px
      text-align left
      text-align-last left

    .approveTransactionWarningActions
      display grid
      grid-template-columns repeat(2, minmax(0, 1fr))
      gap var(--wren-space-2)

._txApproval
  font-size var(--wren-type-small)
  transition var(--standard)
  font-family 'MainFont'
  transform translateY(0px) 
  text-transform uppercase
  font-weight 300
  border-radius 24px
  border-top-right-radius 0px
  border-top-left-radius 0px
  z-index 99999999
  height 45px
  padding-bottom 8px
  pointer-events auto
  
  .requestApproveFee
    .requestApproveFeeButton 
      pointer-events auto

._txActionButton
  appearance none
  width 100%
  border 0
  color inherit
  background var(--ghostA)
  box-sizing border-box
  height 60px
  margin 1px
  flex 1
  cursor pointer
  display flex
  justify-content center
  align-items center
  padding-top 3px
  box-sizing border-box
  transition var(--standard)
  font-family 'MainFont'
  font-size 14px
  transform translateY(0px) 
  text-transform uppercase
  flex-grow 1

._txActionButton:hover
  background var(--ghostB)
  transform translateY(-1px)
  box-shadow 0px 3px 4px var(--ghostY)

._txActionButton:active
  background var(--ghostA)
  transform translateY(1px)
  box-shadow 0px 1px 0px var(--ghostY)

._txActionButtonGood
  color var(--good)

._txActionButtonBad
  color var(--bad)
