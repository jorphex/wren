.badgeWrap
  position absolute
  z-index 1000000001
  inset 0
  display flex
  align-items center
  justify-content center
  padding var(--wren-space-5)
  box-sizing border-box
  background rgba(7, 10, 8, .82)
  backdrop-filter blur(7px)

.updateDialog
  width min(100%, 440px)
  display flex
  box-sizing border-box
  padding var(--wren-space-6)
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  color var(--wren-text-primary)
  background-color var(--wren-bg-elevated)
  background-image var(--wren-control-texture-dark)
  box-shadow var(--wren-shadow-lg), var(--wren-shadow-inset)
  font-family var(--wren-font-ui)
  flex-direction column

.updateDialogCopy
  display flex
  flex-direction column

  h2
    margin var(--wren-space-2) 0 var(--wren-space-3)
    color var(--wren-text-primary)
    font-size 22px
    font-weight 640
    line-height 1.2

  p
    margin 0
    color var(--wren-text-secondary)
    font-size var(--wren-type-body)
    line-height 1.55

.updateDialogEyebrow
  color var(--wren-accent-primary-hover)
  font-size var(--wren-type-caption)
  font-weight 620
  letter-spacing .055em
  text-transform uppercase

.updateDialogActions
  display flex
  justify-content flex-end
  gap var(--wren-space-2)
  margin-top var(--wren-space-6)

  button
    min-width 118px

.updateDialogSkip
  align-self flex-start
  margin-top var(--wren-space-3)

@media (max-height: 560px)
  .badgeWrap
    align-items flex-start
    overflow-y auto

  .updateDialog
    margin auto 0
    padding var(--wren-space-5)

@media (max-width: 420px)
  .updateDialogActions
    align-items stretch
    flex-direction column

    button
      width 100%
