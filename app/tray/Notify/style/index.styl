.notify
  .notifyQueueContext
    display flex
    align-items center
    gap 8px
    flex-wrap wrap
    margin 0 24px 12px
    padding 9px 0
    border-top 1px solid var(--wren-border-subtle)
    border-bottom 1px solid var(--wren-border-subtle)
    color var(--wren-text-secondary)
    font-size 12px

  position fixed
  inset 0
  z-index 9999999999999999
  pointer-events auto
  display flex
  justify-content center
  align-items center
  text-align center
  color var(--wren-text-primary)
  background var(--wren-bg-canvas)
  font-family var(--wren-font-ui)

  ::selection
    color var(--wren-text-inverse)
    background var(--wren-accent-primary)

  .notifyCloseButton
    position absolute
    top var(--wren-space-4)
    left 50%
    width 100px
    height 28px
    margin-left -50px
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    display flex
    justify-content center
    align-items center
    background var(--wren-bg-elevated)
    color var(--wren-text-secondary)
    font-size var(--wren-type-caption)
    font-weight 500
    cursor pointer
    transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease)

    &:hover
      background var(--wren-surface-hover)
      border-color var(--wren-border-strong)
      color var(--wren-text-primary)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

    *
      pointer-events none

  .notifyBoxWrap
    position absolute
    inset 0
    box-sizing border-box
    display flex
    justify-content center
    align-items flex-start
    overflow-x hidden
    overflow-y auto
    z-index 4000000000
    padding var(--wren-space-3)
    background var(--wren-surface-overlay)

    .notifyBoxSlide
      width 100%
      max-height 100%
      overflow-y auto
      overflow-x hidden
      margin auto

    .notifyClose
      position absolute
      top var(--wren-space-2)
      right var(--wren-space-2)
      z-index 3
      width 32px
      height 32px
      display flex
      justify-content center
      align-items center
      border-radius var(--wren-radius-sm)
      color var(--wren-text-secondary)

      &:hover
        background var(--wren-surface-hover)
        color var(--wren-text-primary)

      &:focus-visible
        outline 2px solid var(--wren-focus)
        outline-offset 2px

    .notifyBox
      width 100%
      box-sizing border-box
      overflow hidden
      margin auto
      padding var(--wren-space-6) var(--wren-space-3)
      border 1px solid var(--wren-border-subtle)
      border-radius var(--wren-radius-md)
      background var(--wren-surface-card)
      box-shadow var(--wren-shadow-md)

      &.extensionConnectBox
        max-width 420px

      .extensionConnectIcon
        height 56px
        display flex
        align-items center
        justify-content center
        margin-bottom var(--wren-space-3)
        color var(--wren-text-secondary)

      .extensionPairingCode
        margin var(--wren-space-4) 0
        color var(--wren-success)
        font-family var(--wren-font-mono)
        font-size 28px
        font-weight 550
        letter-spacing 6px

      .extensionOriginButton
        width 100%
        max-width 100%
        overflow hidden
        font-family var(--wren-font-mono)
        font-size var(--wren-type-caption)
        text-overflow ellipsis
        white-space nowrap

      .notifySection
        margin var(--wren-space-2) 0

      .notifyTitle
        position relative
        z-index 3
        margin 0 0 var(--wren-space-3)
        color var(--wren-text-primary)
        font-size var(--wren-type-heading)
        font-weight 560
        font-variation-settings var(--wren-font-heading-settings)

      .notifySubtitle
        position relative
        z-index 3
        margin-bottom var(--wren-space-5)
        color var(--wren-text-secondary)
        font-size var(--wren-type-body)
        line-height 1.45

      .notifyWrenIcon
        width 100%
        height 72px
        position relative
        z-index 4
        display flex
        justify-content center
        align-items center

        img
          width 64px
          height 64px
          border-radius var(--wren-radius-md)

      .notifyBody
        position relative
        z-index 3
        width 100%
        box-sizing border-box
        padding var(--wren-space-2) 0
        color var(--wren-text-secondary)
        font-size var(--wren-type-small)
        font-variation-settings var(--wren-font-body-settings)
        line-height 1.5
        word-break break-word

        .notifyBodyLine
          padding 0
          font-size inherit
          font-weight 400

        .notifyBodyLineUrl
          padding-bottom var(--wren-space-5)
          font-family var(--wren-font-mono)
          font-size var(--wren-type-small)
          word-break break-all

        .notifyBodyUpdate
          margin-top var(--wren-space-5)
          margin-bottom var(--wren-space-2)
          padding var(--wren-space-3)
          border 1px solid var(--wren-warning)
          border-radius var(--wren-radius-sm)
          background var(--wren-warning-soft)
          color var(--wren-text-primary)
          font-size var(--wren-type-small)

        .notifyBodyBlock
          margin-bottom var(--wren-space-2)
          padding var(--wren-space-3)
          border 1px solid var(--wren-border-subtle)
          border-radius var(--wren-radius-sm)
          background var(--wren-bg-elevated)

        .notifyBodyBlockBig
          padding var(--wren-space-4)
          font-size var(--wren-type-small)

        .notifyBodyLink
          appearance none
          padding 0
          border 0
          border-radius var(--wren-radius-sm)
          background transparent
          color var(--wren-accent-primary-hover)
          font inherit
          text-decoration underline
          text-underline-offset 2px
          cursor pointer

          &:hover
            color var(--wren-accent-primary)

          &:focus-visible
            outline 2px solid var(--wren-focus)
            outline-offset 2px

        .notifyBodyHash
          max-height 58px
          margin-top var(--wren-space-3)
          padding var(--wren-space-3)
          overflow auto
          border 1px solid var(--wren-border-default)
          border-radius var(--wren-radius-sm)
          background var(--wren-surface-inset)
          color var(--wren-text-secondary)
          font-family var(--wren-font-mono)
          font-size var(--wren-type-small)
          line-height 20px

        .notifyBodyPrice
          margin-top var(--wren-space-1)
          color var(--wren-warning)
          font-size var(--wren-type-title)
          font-weight 540

        .notifyBodyQuestion
          padding-top var(--wren-space-5)
          color var(--wren-text-primary)

      .notifyCheck
        appearance none
        display flex
        position relative
        justify-content center
        align-items center
        margin-top var(--wren-space-4)
        padding var(--wren-space-1) var(--wren-space-3)
        border 0
        border-radius var(--wren-radius-sm)
        background transparent
        color var(--wren-text-secondary)
        font-family inherit
        cursor pointer

        &:hover .notifyCheckBox
          border-color var(--wren-border-strong)
          background var(--wren-surface-active)

        &:focus-visible
          outline 2px solid var(--wren-focus)
          outline-offset 2px

        .notifyCheckBox
          width 20px
          height 20px
          min-width 20px
          min-height 20px
          box-sizing border-box
          display flex
          justify-content center
          align-items center
          margin-right var(--wren-space-2)
          border 1px solid var(--wren-border-default)
          border-radius var(--wren-radius-sm)
          background var(--wren-surface-inset)
          color var(--wren-accent-primary)
          transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

          *
            pointer-events none

          svg
            height 16px

        .notifyCheckText
          width 210px
          text-align left
          font-size var(--wren-type-small)
          line-height 1.35

      .notifyInput
        position relative
        z-index 3
        display flex
        justify-content space-between
        gap var(--wren-space-2)
        margin var(--wren-space-6) 0 0

        .notifyInputOption
          width calc(50% - 4px)
          min-height 40px

          *
            pointer-events none

          .notifyInputOptionText
            position relative
            z-index 2

        .notifyInputSingleButton
          width 280px
          max-width 100%
          margin auto

    .introInstructions
      position relative
      z-index 3
      margin calc(var(--wren-space-2) * -1)
      color var(--wren-text-secondary)
      font-size var(--wren-type-small)
      font-weight 400
      line-height 1.45
      text-align left

      .introInstructionItem
        margin-bottom var(--wren-space-4)
        padding 0 var(--wren-space-4)

        span
          color var(--wren-info)
          text-decoration none

      .introInstructionList
        margin var(--wren-space-4) var(--wren-space-1) var(--wren-space-6)
        padding var(--wren-space-4)
        border 1px solid var(--wren-info)
        border-radius var(--wren-radius-sm)
        background var(--wren-info-soft)
        color var(--wren-text-primary)

        div
          font-size var(--wren-type-small)
          line-height 1.5
