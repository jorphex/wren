.accountSelector
  position absolute
  top 80px
  right 8px
  bottom 40px
  left 8px
  border-radius 26px
  z-index 999
  display flex
  align-items center
  overflow hidden
  display flex
  justify-content center
  align-items center
  transform translateY(0px)
  transition var(--standardFast)

  .accountSelectorScroll
    width 100%
    max-height 100%
    border-radius 30px
    transition var(--standard)
    overflow-y scroll
    overflow-x hidden

    .accountSelectorScrollWrap
      width 100%
      padding 48px 6px 48px 6px
      box-sizing border-box
      will-change scroll-position
      z-index 999
      pointer-events none

      .noSigners
        width 100%
        display flex
        justify-content center
        align-items center
        flex-direction column
        font-weight 300
        font-size 19px
        position relative
        z-index 100
        padding 24px

        .introLogo
          padding-bottom 38px

          svg
            fill var(--outerspace)

        .getStarted
          margin-top 30px
          box-sizing border-box
          border-radius 12px
          padding 20px
          font-size 14px
          margin 20px
          text-align center
          font-weight 300
          background var(--outerspace)
          color var(--spacewhite)
          line-height 24px

          .getStartedPlus
            display inline-block
            position relative
            top 4px
            border 2px solid var(--spacewhite)
            width 43px
            height 22px
            border-radius 11px
            text-align center
            margin 0px 5px 0px 5px
            box-sizing border-box

            span 
              position relative
              top -3px
              left 2px
              font-size 17px

        .featureBox
          display flex
          justify-content center
          align-items center
          flex-direction column
          margin-top 30px

          .featureBoxText
            font-size 13px
            font-weight 400
            letter-spacing 4px

          .featureBoxSubtext
            margin-top 8px
            font-size var(--wren-type-caption)
            font-family 'FiraCode'
            justify-content center
            opacity 0.7

@keyframes appear
  0%
    opacity 0
    transform translateY(2px)

  100%
    opacity 1
    transform translateY(0)

.panelFilterMain
  position fixed
  top 0px
  left 0px
  right 0px
  height 48px
  z-index 99
  overflow hidden
  animation appear var(--wren-motion-standard) var(--wren-ease)

.panelFilterAccount
  position sticky
  top 0px
  left 0px
  right 0px
  height 48px
  width 100%
  z-index 99
  overflow hidden
  animation appear var(--wren-motion-standard) var(--wren-ease)

.panelFilterIcon
  position absolute
  top 2px
  left 10px
  bottom 2px
  width 32px
  display flex
  justify-content center
  align-items center
  z-index 1
  color var(--wren-text-muted)
  pointer-events none

.panelFilterInput
  position absolute
  top 2px
  left 10px
  bottom 2px
  right 48px

  input, input:hover, input:focus
    box-sizing border-box
    width 100%
    height 100%
    padding 0 12px 0 34px
    border 1px solid var(--wren-border-subtle)
    border-radius var(--wren-radius-sm)
    outline none
    text-align left
    background var(--wren-surface-inset)
    color var(--wren-text-primary)
    font-size 13px
    font-family var(--wren-font-ui)
    font-weight 450
    box-shadow var(--wren-shadow-inset)

  input:focus-visible
    border-color var(--wren-border-strong)
    outline 2px solid var(--wren-focus)
    outline-offset 1px

.panelFilterClear
  padding 0
  position absolute
  top 8px
  right 8px
  width 32px
  min-width 32px
  height 32px
  min-height 32px
  display flex
  justify-content center
  align-items center
  border-radius var(--wren-radius-sm)

  *
    pointer-events none

.newAccountButton
  display flex

  .newAccountIcon
    padding-right 10px

// Wren account selector foundation
.accountSelector
  top 88px
  right 0
  bottom 40px
  left 0
  border-radius 0

  .accountSelectorScroll
    border-radius 0

    .accountSelectorScrollWrap
      padding 24px var(--wren-space-5) 48px

.accountSelectorWelcome
  padding var(--wren-space-4) var(--wren-space-2) var(--wren-space-5)
  pointer-events auto

  h1,
  p
    margin 0

  h1
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size 20px
    font-weight 640
    line-height 26px
    font-variation-settings var(--wren-font-heading-settings)

  p
    margin-top var(--wren-space-1)
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    line-height 20px

.accountSelector:not(.accountSelectorOpen)
  display grid
  padding 8px var(--wren-space-5) var(--wren-space-4)
  box-sizing border-box
  align-items stretch
  justify-content stretch
  grid-template-rows auto auto minmax(0, 1fr)

  .accountDrawerItem
    pointer-events auto

.accountSelectorEmpty
  width calc(100% - 32px)
  max-width 440px
  box-sizing border-box
  padding 32px 28px
  margin auto
  display flex
  align-items center
  flex-direction column
  pointer-events auto
  text-align center
  color var(--wren-text-primary)
  background transparent
  border 0
  border-radius 0
  box-shadow none

.accountSelectorEmptyArtwork
  width 176px
  max-width 100%
  height 132px
  margin-bottom 12px
  object-fit contain
  image-rendering auto

.accountSelectorEmptyTitle
  font-size 18px
  line-height 24px
  font-weight 600

.accountSelectorEmptyCopy
  max-width 300px
  margin-top 6px
  color var(--wren-text-secondary)
  font-size 13px
  line-height 20px

.accountSelectorEmpty .newAccountButton
  min-height 44px
  margin-top 22px
  align-items center
  justify-content center

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  .newAccountIcon
    display flex
    padding-right 8px

// Selected-account header and switcher drawer
.accountSelector.accountSelectorOpen
  top 80px
  right 0
  bottom 40px
  left 0
  z-index 999999999
  display block
  overflow visible
  transform none
  pointer-events none

.accountSwitcherBar
  position absolute
  top 0
  right var(--wren-space-5)
  left var(--wren-space-5)
  z-index 4
  display flex
  height 60px
  align-items center
  justify-content space-between
  pointer-events none

.accountSwitcherTrigger,
.accountSwitcherControls,
.accountSwitcherPrivacy,
.accountDrawerScrim,
.accountDrawer
  pointer-events auto

.accountSwitcherControls
  display flex
  flex none
  align-items center
  gap var(--wren-space-2)

.accountWorkspaceToggle
  width 40px
  height 40px
  flex none
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background-color var(--wren-bg-elevated)
  background-image none
  box-shadow none

  &:hover:not(:disabled)
    border-color var(--wren-border-default)
    color var(--wren-accent-primary-hover)
    background-color var(--wren-surface-hover)
    background-image none
    box-shadow none

  &:active:not(:disabled)
    color var(--wren-accent-primary-active)
    background-color var(--wren-surface-active)
    background-image none
    box-shadow none

  &[aria-pressed='true']
    color var(--wren-text-primary)
    background-color var(--wren-surface-active)
    background-image none
    box-shadow var(--wren-shadow-sm)

.accountSwitcherTrigger
  display grid
  width auto
  min-width 196px
  max-width 320px
  height 40px
  padding 0 9px
  grid-template-columns 24px minmax(0, 1fr) 18px
  align-items center
  column-gap 8px
  text-align left

  &[aria-expanded='true']
    color var(--wren-text-primary)
    border-color var(--wren-border-subtle)
    background-color var(--wren-surface-active)
    box-shadow var(--wren-shadow-sm)

.accountSwitcherIcon
  display flex
  align-items center
  justify-content center
  color var(--wren-accent-primary-hover)

.accountSwitcherIdentity
  min-width 0

.accountSwitcherName,
.accountSwitcherAddress
  display block
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.accountSwitcherName
  color var(--wren-text-primary)
  font-size var(--wren-type-small)
  font-weight 620

.accountSwitcherAddress
  margin-top 2px
  color var(--wren-text-muted)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)

.accountSwitcherChevron
  display flex
  justify-content flex-end
  color var(--wren-text-muted)

.accountSwitcherPrivacy
  display flex
  align-items center
  gap var(--wren-space-2)

.accountSwitcherPrivacyLabel
  color var(--wren-text-muted)
  font-size var(--wren-type-caption)

.accountPrivacyToggle
  position relative
  width 40px
  min-width 40px
  height 40px
  min-height 40px
  color var(--wren-text-secondary)

  &.accountPrivacyToggleHidden
    border-color rgba(183, 154, 112, .48)
    color var(--wren-accent-primary-hover)
    background rgba(166, 138, 97, .11)

    &:after
      position absolute
      width 20px
      height 1px
      content ''
      background currentColor
      transform rotate(45deg)

.accountDrawerScrim
  appearance none
  position absolute
  top 0
  right 0
  bottom 0
  left 0
  z-index 5
  padding 0
  border 0
  background rgba(4, 7, 5, .36)
  cursor default

.accountDrawer
  position absolute
  top 0
  bottom 0
  left 0
  z-index 6
  display grid
  width 332px
  padding 18px 16px 16px
  box-sizing border-box
  overflow hidden
  grid-template-rows auto auto minmax(0, 1fr) auto
  background radial-gradient(circle at 16% 92%, rgba(166, 138, 97, .055), transparent 30%), var(--wren-bg-elevated)
  box-shadow 18px 0 45px rgba(0, 0, 0, .46)

.accountChooserPanel
  position absolute
  top 60px
  right 0
  bottom 0
  left 0
  z-index 6
  display grid
  padding 8px var(--wren-space-5) var(--wren-space-4)
  box-sizing border-box
  overflow hidden
  grid-template-rows auto minmax(0, 1fr) auto
  background transparent
  pointer-events auto

.accountDrawerHeader
  display flex
  height 34px
  align-items center
  justify-content space-between

.accountDrawerTitle
  color var(--wren-text-primary)
  font-size 17px
  font-weight 650

.accountDrawerCount
  margin-left 7px
  color var(--wren-text-muted)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)

.accountDrawerClose
  width 30px
  min-width 30px
  height 30px
  min-height 30px

.panelFilterMain.accountDrawerFilter
  position relative
  top auto
  right auto
  left auto
  width 100%
  height 48px
  margin-top 8px
  animation none

  .panelFilterInput
    top 2px
    bottom 2px
    right 0
    left 0

    input, input:hover, input:focus
      padding-right 42px

  .panelFilterIcon
    left 0

  .panelFilterClear
    right 0

.accountSelector .accountDrawerScroll
  width 100%
  max-height none
  border-radius 0
  overflow-y auto

  .accountSelectorScrollWrap
    display grid
    width 100%
    padding 10px 0 18px
    gap 0
    pointer-events auto

.accountDrawerItem
  appearance none
  display grid
  width 100%
  height 54px
  padding 0 9px
  border 0
  border-radius 0
  color var(--wren-text-primary)
  background transparent
  grid-template-columns 28px minmax(0, 1fr) 24px
  align-items center
  text-align left
  cursor pointer

  &:hover
    background var(--wren-ledger-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset -2px

  &:disabled
    color var(--wren-text-disabled)
    cursor default
    opacity .58

  &.accountDrawerItemSelected
    background var(--wren-ledger-selected)

.accountDrawerItemIcon
  display flex
  align-items center
  justify-content center
  color var(--wren-accent-primary-hover)

.accountDrawerItemSelected .accountDrawerItemEnd
  color var(--wren-accent-primary-hover)

.accountDrawerItemSelected .accountDrawerItemIcon
  color var(--wren-accent-primary-hover)

.accountDrawerItemIdentity
  min-width 0

.accountDrawerItemName,
.accountDrawerItemAddress
  display block
  overflow hidden
  text-overflow ellipsis
  white-space nowrap

.accountDrawerItemName
  font-size var(--wren-type-small)
  font-weight 610

.accountDrawerItemAddress
  margin-top 3px
  color var(--wren-text-muted)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)

.accountDrawerItemEnd
  display flex
  justify-content flex-end
  color var(--wren-accent-primary)

.accountDrawerRequestCount
  display flex
  width 19px
  height 19px
  border-radius var(--wren-radius-sm)
  align-items center
  justify-content center
  color var(--wren-bg-canvas)
  background var(--wren-success)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)
  font-weight 700

.accountDrawerFooter
  position relative
  z-index 1
  display flex
  padding-top var(--wren-space-3)
  justify-content flex-end

.accountDrawerAdd
  display inline-flex
  height 44px
  min-height 44px
  padding 0 13px
  align-items center
  gap 7px
  font-size var(--wren-type-caption)
  font-weight 610
