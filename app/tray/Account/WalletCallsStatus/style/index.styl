.walletCallsStatus
  position absolute
  inset 0
  color var(--wren-text-primary)
  background transparent

.walletCallsStatusScroll
  position absolute
  inset 0
  padding 25px 30px 32px
  box-sizing border-box
  overflow-y auto

.walletCallsStatusSummary
  display flex
  min-height 82px
  padding 4px 0 21px
  justify-content space-between
  align-items center
  gap 24px

.walletCallsStatusEyebrow
  color var(--wren-accent-primary-hover)
  font-family var(--wren-font-utility)
  font-size 12px
  font-weight 550
  letter-spacing .03em
  text-transform uppercase

.walletCallsStatusSummaryCopy
  h2,
  p
    margin 0

  h2
    margin-top 3px
    font-size 25px
    font-weight 660
    line-height 1.18

  p
    margin-top 7px
    color var(--wren-text-secondary)
    font-size 13px
    line-height 1.45

.walletCallsStatusMark
  display flex
  flex 0 0 38px
  width 38px
  height 38px
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  color var(--wren-text-secondary)
  background var(--wren-bg-elevated)
  align-items center
  justify-content center

.walletCallsStatusSummary-success .walletCallsStatusMark
  color var(--wren-success)

.walletCallsStatusSummary-failure .walletCallsStatusMark
  color var(--wren-danger)

.walletCallsStatusSummary-warning .walletCallsStatusMark
  color var(--wren-warning)

.walletCallsStatusSummary-pending .walletCallsStatusMark
  color var(--wren-accent-primary-hover)

.walletCallsStatusUnavailableActions
  display flex
  padding 0 0 18px
  justify-content flex-end
  gap 8px

  button
    height 34px
    padding 0 14px
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    color var(--wren-text-secondary)
    background var(--wren-control-texture-dark), var(--wren-bg-elevated)
    box-shadow var(--wren-control-shadow)
    font-size 12px
    font-weight 620

    &:not(:disabled):hover
      color var(--wren-text-primary)
      border-color var(--wren-border-strong)
      background var(--wren-control-texture-dark), var(--wren-surface-hover)

    &:disabled
      opacity .5

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

.walletCallsStatusSection
  padding 18px 0
  border-top 1px solid var(--wren-ledger-rule)

  > h3
    margin 0 0 13px
    font-size 13px
    font-weight 650

.walletCallsStatusContext
  display grid
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap 18px

  div
    min-width 0

  span,
  strong
    display block

  span
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size 12px

  strong
    margin-top 5px
    overflow hidden
    color var(--wren-text-secondary)
    font-size 13px
    font-weight 570
    text-overflow ellipsis
    white-space nowrap

  .walletCallsStatusNonAtomic
    color var(--wren-warning)

.walletCallsStatusAtomic
  display flex
  margin-top 17px
  color var(--wren-warning)
  font-size 12px
  line-height 1.45
  align-items center
  gap 8px

.walletCallsStatusSectionHeading
  display flex
  margin-bottom 7px
  justify-content space-between
  align-items baseline
  gap 16px

  h3
    margin 0
    font-size 13px
    font-weight 650

  span
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size 12px

.walletCallsStatusReceipts
  border-bottom 1px solid var(--wren-ledger-rule)

.walletCallsStatusReceipt
  display grid
  min-height 88px
  padding 15px 0
  border-top 1px solid var(--wren-ledger-rule)
  box-sizing border-box
  grid-template-columns 42px minmax(0, 1fr) 76px
  gap 13px
  align-items start

  &:hover
    background linear-gradient(90deg, transparent, rgba(255, 255, 255, .016) 10%, rgba(255, 255, 255, .016) 90%, transparent)

.walletCallsStatusReceiptNumber
  padding-top 2px
  color var(--wren-text-muted)
  font-family var(--wren-font-utility)
  font-size 12px

.walletCallsStatusReceiptBody
  min-width 0

  > button
    display block
    max-width 100%
    padding 0
    border 0
    color inherit
    background transparent
    text-align left
    cursor copy

    strong,
    span
      display block

    strong
      color var(--wren-text-primary)
      font-size 14px
      font-weight 640

    span
      margin-top 4px
      overflow hidden
      color var(--wren-text-muted)
      font-family var(--wren-font-utility)
      font-size 12px
      text-overflow ellipsis
      white-space nowrap

    &:hover span
      color var(--wren-accent-primary-hover)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 3px

  dl
    display grid
    margin 12px 0 0
    grid-template-columns 100px 120px minmax(0, 1fr)
    gap 13px

    div
      min-width 0

    dt,
    dd,
    small
      display block

    dt
      color var(--wren-text-muted)
      font-family var(--wren-font-utility)
      font-size 12px

    dd
      margin 4px 0 0
      color var(--wren-text-secondary)
      font-family var(--wren-font-utility)
      font-size 12px

    small
      margin-top 3px
      color var(--wren-text-muted)
      font-family var(--wren-font-utility)
      font-size 12px
      line-height 1.4

.walletCallsStatusReceiptGood,
.walletCallsStatusReceiptBad
  padding-top 2px
  font-size 12px
  font-weight 650
  text-align right

.walletCallsStatusReceiptGood
  color var(--wren-success)

.walletCallsStatusReceiptBad
  color var(--wren-danger)

.walletCallsStatusEmpty
  padding 22px 0
  border-top 1px solid var(--wren-ledger-rule)
  border-bottom 1px solid var(--wren-ledger-rule)
  color var(--wren-text-secondary)
  font-size 13px

.walletCallsStatusMetadata
  display flex
  padding-top 13px
  color var(--wren-text-muted)
  font-family var(--wren-font-utility)
  font-size 12px
  gap 16px

  span
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

@media (max-width: 610px)
  .walletCallsStatusScroll
    padding-right 22px
    padding-left 22px

  .walletCallsStatusContext
    grid-template-columns repeat(2, minmax(0, 1fr))

  .walletCallsStatusReceiptBody dl
    grid-template-columns repeat(2, minmax(90px, 1fr))

    div:last-child
      grid-column 1 / -1
