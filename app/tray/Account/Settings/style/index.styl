.expandedModule
  padding var(--wren-space-5)

.accountSettingsExpandedView
  overflow-y auto

.accountSettingsIntro
  max-width 560px
  margin 0 auto
  padding 0 0 var(--wren-space-4)

  h2
    margin 0
    font-family var(--wren-font-heading)
    font-size 22px
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 620
    line-height 1.2

.previewButton
  padding var(--wren-space-2)
  border: 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-card)

.panelBlock
  max-width 560px
  margin 0 auto

  input
    z-index 200
    width 100%
    height 44px
    padding 0 var(--wren-space-3)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    font-weight 400
    text-align left
    user-select auto

.panelBlockTitle
  display block
  padding var(--wren-space-4) 0 var(--wren-space-2)
  color var(--wren-text-secondary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-caption)
  font-weight 560

.accountSettingsEditor
  padding var(--wren-space-4)
  box-sizing border-box
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-md)
  background var(--wren-surface-card)
  box-shadow var(--wren-shadow-sm)

.accountSettingsAddress
  min-width 0
  padding 0 0 var(--wren-space-4)
  border-bottom 1px solid var(--wren-ledger-rule)

  span,
  code
    display block

  span
    margin-bottom var(--wren-space-1)
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)

  code
    overflow hidden
    color var(--wren-text-secondary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    text-overflow ellipsis
    white-space nowrap

.panelBlockItem:not(:first-child)
  margin-top var(--wren-space-1)

.settingsRowInset
  margin-top var(--wren-space-2)
  padding var(--wren-space-2)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)

.settingsRowInsetConnected
  color var(--wren-success)

.settingsButton
  display flex
  align-items center
  justify-content center
  width 100%
  height 40px
  box-sizing border-box
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background var(--wren-surface-card)
  cursor pointer
  font-size var(--wren-type-small)
  font-weight 500
  transition background var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

  &:hover
    border-color var(--wren-border-strong)
    color var(--wren-text-primary)
    background var(--wren-surface-hover)

  &:active
    background var(--wren-surface-active)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  &:disabled
    color var(--wren-text-disabled)
    cursor default
    opacity .6
