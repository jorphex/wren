.clearPermissionsButton
  padding 6px

.clearPermissionsConfirm
  display flex
  gap 6px

.clearPermissionsAction
  appearance none
  padding 0 12px
  border 0
  color inherit
  font-family inherit

  &:focus-visible
    outline 2px solid var(--wren-focus, var(--moon))
    outline-offset 2px

  &:disabled
    cursor default
    opacity .55

.clearPermissionsConfirm .clearPermissionsAction
  flex 1

.clearPermissionsStatus
  padding 10px 12px
  color var(--wren-text-secondary)

  &:focus-visible
    outline 2px solid var(--wren-focus, var(--moon))
    outline-offset -2px

.signerBalanceTotal .signerBalanceShowAll
  appearance none
  border 0
  border-bottom 2px solid var(--ghostZ)
  color inherit
  font-family inherit

  &:focus-visible
    outline 2px solid var(--wren-focus, var(--moon))
    outline-offset 2px

  &:disabled
    cursor default
    opacity .55

.signerPermissionControls .wrenToggle
  margin-top 2px

.moduleMainPermissions
  border-radius 20px
  overflow auto

.signerPermissionOrigin
  background transparent
  width 250px
  direction rtl
  text-overflow ellipsis
  overflow hidden
  text-align left
  white-space nowrap
  font-weight 300
  margin-top 4px
  
.signerPermission
  position relative
  justify-content space-between
  padding 12px
  font-size 15px
  font-weight 300
  transform translateZ(0)
  z-index 2000
  width 100%

  .signerPermissionControls
    display flex
    position relative
    justify-content space-between
    transform translateZ(0)
    z-index 40

  .signerPermissionDetails
    display flex
    position relative
    justify-content space-between
    transform translateZ(0)
    font-size 13px
    padding 10px 0px 0px 1px
    z-index 20
    font-weight 300
