.clearPermissionsButton
  display grid
  min-height 60px
  padding var(--wren-space-2) var(--wren-space-3)
  align-items center
  gap var(--wren-space-3)
  grid-template-columns minmax(0, 1fr) auto
  border-top 1px solid var(--wren-border-subtle)

.clearPermissionsSummary
  min-width 0
  display grid
  gap 2px

  strong
    color var(--wren-text-primary)
    font-size var(--wren-type-small)
    font-weight 550
    line-height 18px

  span
    color var(--wren-text-tertiary)
    font-size var(--wren-type-caption)
    line-height 18px

.clearPermissionsConfirm
  display flex
  grid-column 1 / -1
  flex-direction column
  gap var(--wren-space-2)

.clearPermissionsCopy
  strong
    display block
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    font-weight 600

  p
    margin var(--wren-space-2) 0 0
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    line-height 20px

.clearPermissionsActions
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--wren-space-2)

.clearPermissionsAction
  width auto

button.wrenControl.clearPermissionsAction
  min-height 44px

.clearPermissionsButton > button.wrenControl.clearPermissionsAction
  min-width 88px
  color var(--wren-text-tertiary)

  &:hover:not(:disabled)
    color var(--wren-danger)

.clearPermissionsActions .clearPermissionsAction
  flex 1

.clearPermissionsStatus
  padding var(--wren-space-3)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background var(--wren-surface-inset)
  font-size var(--wren-type-small)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.signerPermissionControls .wrenToggle
  margin-top 0

.revokeAccessButton
  flex none
  padding 0

button.wrenControl.revokeAccessButton
  min-width 68px
  min-height 44px
  padding 0
  color var(--wren-text-tertiary)
  font-size var(--wren-type-caption)
  font-weight 500

  &:hover:not(:disabled)
    color var(--wren-danger)

  &:hover:not(:disabled),
  &:active:not(:disabled)
    border-color transparent
    background transparent

  &:hover:not(:disabled) .revokeAccessLabel
    border-color rgba(213, 116, 104, .32)
    color var(--wren-danger)
    background var(--wren-danger-soft)

.revokeAccessLabel
  display inline-flex
  min-height 28px
  padding 0 var(--wren-space-2)
  align-items center
  justify-content center
  box-sizing border-box
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background rgba(255, 255, 255, .015)

.revokeAccessDialog
  position absolute
  z-index 50000000
  inset 0
  display flex
  align-items center
  justify-content center
  padding var(--wren-space-4)
  box-sizing border-box
  background rgba(18, 20, 22, .76)

.revokeAccessPanel
  width 100%
  max-width 430px
  max-height calc(100vh - 32px)
  overflow auto
  padding var(--wren-space-5)
  box-sizing border-box
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  background var(--wren-bg-elevated)
  box-shadow var(--wren-shadow-lg), var(--wren-shadow-inset)

  strong
    display block
    overflow-wrap anywhere
    color var(--wren-text-primary)
    font-size var(--wren-type-body)
    font-weight 600

  p
    margin var(--wren-space-2) 0 0
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    line-height 20px

.revokeAccessActions
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--wren-space-2)
  margin-top var(--wren-space-5)

  button.wrenControl
    width 100%
    min-height 44px

.revokeAccessStatus
  min-height 18px
  margin var(--wren-space-2) var(--wren-space-2) 0
  padding 4px var(--wren-space-2) 0
  color var(--wren-text-secondary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-caption)
  line-height 18px
  text-align center

  &:focus
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.revokeAccessFailure
  margin-top var(--wren-space-3)
  padding var(--wren-space-2)
  border 1px solid var(--wren-danger)
  border-radius var(--wren-radius-sm)
  color var(--wren-danger)
  background var(--wren-danger-soft)
  font-size var(--wren-type-small)
  line-height 20px

.permissionsLedgerView:focus
  outline 2px solid var(--wren-focus)
  outline-offset -2px

.permissionsModuleFocusFallback
  position absolute
  width 1px
  height 1px
  margin -1px
  overflow hidden
  clip rect(0 0 0 0)
  white-space nowrap
  pointer-events none

  &:focus,
  &:focus-visible
    outline none

.moduleMainPermissions
  overflow auto
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-md)
  background var(--wren-surface-inset)

.signerPermissionOrigin
  width 250px
  overflow hidden
  color var(--wren-text-primary)
  direction ltr
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)
  line-height 18px
  text-align left
  text-overflow ellipsis
  white-space nowrap

.signerPermissionNoPermissions
  width 100%
  color var(--wren-text-tertiary)
  font-size var(--wren-type-small)
  text-align center

.signerPermission
  position relative
  z-index 2000
  width 100%
  padding var(--wren-space-3)
  box-sizing border-box
  border-bottom 1px solid var(--wren-border-subtle)
  color var(--wren-text-primary)
  font-size var(--wren-type-small)

  &:last-child
    border-bottom 0

  .signerPermissionControls
    position relative
    z-index 40
    display flex
    justify-content space-between

  .signerPermissionDetails
    position relative
    z-index 20
    display flex
    justify-content space-between
    padding-top var(--wren-space-2)
    color var(--wren-text-secondary)
    font-size var(--wren-type-caption)

.connectedAppsList
  .signerPermission
    min-height 60px
    padding var(--wren-space-1) var(--wren-space-2) var(--wren-space-1) var(--wren-space-3)
    border-bottom 0

  .signerPermissionControls
    min-height 52px
    align-items center
    gap var(--wren-space-2)

  .signerPermissionOrigin
    width auto
    min-width 0
    margin 0
    flex 1

  .signerPermissionIdentity
    min-width 0
    flex 1
    display grid
    align-content center
    gap 2px

  .revokeAccessButton
    flex none

.connectedAppMark
  width 30px
  height 30px
  display inline-flex
  flex none
  align-items center
  justify-content center
  box-sizing border-box
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  color var(--wren-text-tertiary)
  background var(--wren-surface-inset)

.connectedAppKind
  color var(--wren-text-tertiary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-caption)
  line-height 18px

.signerPermissionPrincipal
  overflow-wrap anywhere
  color var(--wren-text-tertiary)
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)
  line-height 18px

.dappGuardrailChainActions
  display grid
  gap 0
  padding 0
  border-top 1px solid var(--wren-border-subtle)

.dappGuardrailManage
  width 100%
  height auto
  padding var(--wren-space-2) 0
  overflow-wrap anywhere
  white-space normal

button.wrenControl.dappGuardrailManage
  min-height 52px
  justify-content space-between
  border 0
  border-radius 0
  text-align left

button.wrenControl.dappGuardrailManage.wrenControlCompact
  min-height 52px

.dappGuardrailIdentity
  min-width 0
  display grid
  gap 1px

  strong
    overflow hidden
    color var(--wren-text-primary)
    font-size var(--wren-type-small)
    font-weight 550
    line-height 18px
    text-overflow ellipsis
    white-space nowrap

  > span
    color var(--wren-text-tertiary)
    font-size var(--wren-type-caption)
    font-weight 400
    line-height 18px

.dappGuardrailAction
  flex none
  color var(--wren-text-secondary)
  font-size var(--wren-type-caption)
  font-weight 550

.connectedAppDetails
  border-top 1px solid var(--wren-border-subtle)

  summary
    min-height 44px
    display flex
    align-items center
    color var(--wren-text-tertiary)
    font-size var(--wren-type-caption)
    font-weight 500
    cursor pointer
    list-style none

    &:after
      content '+'
      margin-left auto
      color var(--wren-text-tertiary)
      font-family var(--wren-font-mono)
      font-size 14px

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset -2px

  &[open] summary:after
    content '−'

.connectedAppConnection
  display grid
  gap var(--wren-space-1)
  padding 0 0 var(--wren-space-3)

  span
    color var(--wren-text-tertiary)
    font-size var(--wren-type-caption)

  code
    overflow-wrap anywhere
    color var(--wren-text-secondary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    line-height 18px

.permissionsLedgerView
  .connectedAppsList
    margin 0
    padding 0
    border 0
    background transparent

    .moduleMainPermissions
      display grid
      overflow visible
      gap var(--wren-space-3)
      border 0
      background transparent

    .clusterRow + .clusterRow
      margin-top 0

    .clusterValue
      overflow visible
      border-radius var(--wren-radius-md)
      background var(--wren-surface-card)

    .signerPermission
      min-height 0
      padding var(--wren-space-3)

    .signerPermissionControls
      min-height 44px

    .signerPermissionOrigin
      font-family var(--wren-font-ui)
      font-size var(--wren-type-small)
      font-weight 600

    .connectedAppMark
      width 34px
      height 34px

    .revokeAccessButton
      margin-left var(--wren-space-1)

.dappGuardrailNoChains
  color var(--wren-text-tertiary)
  font-size var(--wren-type-caption)

.dappGuardrailEditor
  margin var(--wren-space-1) 0 var(--wren-space-2)
  padding var(--wren-space-3)
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)

  textarea
    min-height 88px

.dappGuardrailEditorHeader
  display flex
  align-items flex-start
  justify-content space-between
  gap var(--wren-space-2)

  > div
    min-width 0
    display grid
    gap var(--wren-space-1)

  strong
    color var(--wren-text-primary)
    font-size var(--wren-type-body)

  span
    overflow-wrap anywhere
    color var(--wren-text-secondary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)

.dappGuardrailEvidence
  display grid
  gap var(--wren-space-1)
  margin var(--wren-space-3) 0

  > div
    display grid
    grid-template-columns minmax(88px, auto) minmax(0, 1fr)
    gap var(--wren-space-2)

  dt
    color var(--wren-text-tertiary)
    font-size var(--wren-type-caption)
    text-transform uppercase

  dd
    min-width 0
    margin 0
    overflow-wrap anywhere
    color var(--wren-text-secondary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)

.dappGuardrailDisclosure
  margin 0 0 var(--wren-space-3)
  padding var(--wren-space-2)
  border-left 2px solid var(--wren-accent-primary)
  color var(--wren-text-secondary)
  background var(--wren-surface-overlay)
  font-size var(--wren-type-caption)
  line-height 1.45

.dappGuardrailField
  display grid
  gap var(--wren-space-1)
  margin-bottom var(--wren-space-3)

  > span
    color var(--wren-text-primary)
    font-size var(--wren-type-small)

  input,
  select,
  textarea
    width 100%
    min-height 44px
    padding var(--wren-space-2)

.dappGuardrailToggleField
  min-width 0
  margin 0 0 var(--wren-space-3)
  padding var(--wren-space-2)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)

  legend
    width 100%
    display flex
    align-items center
    justify-content space-between
    gap var(--wren-space-2)
    padding 0
    color var(--wren-text-primary)
    font-size var(--wren-type-small)

  > input,
  > textarea
    width 100%
    min-height 44px
    margin-top var(--wren-space-2)
    padding var(--wren-space-2)

.dappGuardrailFieldDetail
  display block
  padding-top var(--wren-space-1)
  color var(--wren-text-tertiary)
  font-size var(--wren-type-caption)
  line-height 1.4

.dappGuardrailMessage
  margin-bottom var(--wren-space-2)
  padding var(--wren-space-2)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  overflow-wrap anywhere
  font-size var(--wren-type-small)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.dappGuardrailMessage-status
  color var(--wren-text-secondary)

.dappGuardrailMessage-alert
  border-color var(--wren-danger)
  color var(--wren-danger)
  background var(--wren-danger-soft)

.dappGuardrailActions,
.dappGuardrailConfirmActions
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--wren-space-2)

.dappGuardrailActions
  grid-template-columns repeat(auto-fit, minmax(150px, 1fr))

  button.wrenControl
    width 100%
    min-height 44px

.dappGuardrailConfirm
  display grid
  gap var(--wren-space-2)
  margin-bottom var(--wren-space-2)
  padding var(--wren-space-2)
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-overlay)

  strong
    color var(--wren-text-primary)

  > span
    color var(--wren-text-secondary)
    font-size var(--wren-type-caption)

  button.wrenControl
    width 100%
    min-height 44px

@media (max-width: 540px)
  .dappGuardrailEditorHeader,
  .dappGuardrailEvidence > div
    grid-template-columns 1fr

  .dappGuardrailEditorHeader
    display grid

  .dappGuardrailActions,
  .dappGuardrailConfirmActions
    grid-template-columns 1fr

  .revokeAccessActions
    grid-template-columns 1fr
