.clearPermissionsButton
  padding var(--wren-space-2)

.clearPermissionsConfirm
  display flex
  gap var(--wren-space-2)

.clearPermissionsAction
  width 100%

.clearPermissionsConfirm .clearPermissionsAction
  flex 1

.clearPermissionsStatus
  padding var(--wren-space-3)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background var(--wren-surface-inset)
  font-size var(--wren-type-small)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.signerBalanceTotal .signerBalanceShowAll
  border 1px solid var(--wren-border-default)
  color inherit
  font-family var(--wren-font-ui)

.signerPermissionControls .wrenToggle
  margin-top 2px

.moduleMainPermissions
  overflow auto
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-md)
  background var(--wren-surface-inset)

.signerPermissionOrigin
  width 250px
  margin-top 2px
  overflow hidden
  color var(--wren-text-primary)
  direction rtl
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)
  text-align left
  text-overflow ellipsis
  white-space nowrap

.signerPermissionNoPermissions
  width 100%
  color var(--wren-text-tertiary)
  font-size var(--wren-type-small)
  text-align center

.signerPermission
  position relative
  z-index 2000
  width 100%
  padding var(--wren-space-3)
  box-sizing border-box
  border-bottom 1px solid var(--wren-border-subtle)
  color var(--wren-text-primary)
  font-size var(--wren-type-small)

  &:last-child
    border-bottom 0

  .signerPermissionControls
    position relative
    z-index 40
    display flex
    justify-content space-between

  .signerPermissionDetails
    position relative
    z-index 20
    display flex
    justify-content space-between
    padding-top var(--wren-space-2)
    color var(--wren-text-secondary)
    font-size var(--wren-type-caption)
