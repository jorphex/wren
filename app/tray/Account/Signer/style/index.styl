.moduleItem
  position relative
  z-index 2000
  display flex
  flex 1
  align-items center
  justify-content center
  min-height 40px
  padding var(--wren-space-4)
  box-sizing border-box
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-small)
  font-weight 500
  text-transform none

.moduleItemSignerType
  display flex
  align-items center
  justify-content center
  color var(--wren-text-primary)
  font-size var(--wren-type-body)
  font-weight 500

.signerPreviewSummary
  display flex
  width 100%
  min-height 54px
  padding 0 var(--wren-space-4)
  box-sizing border-box
  align-items center
  justify-content space-between
  gap var(--wren-space-4)

  .moduleItemSignerType
    justify-content flex-start

.signerPreviewStatus
  color var(--wren-text-tertiary)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  font-weight 450
  white-space nowrap

.moduleItemIcon
  margin-right var(--wren-space-2)
  color var(--wren-accent-primary-hover)

.moduleItemInput
  padding var(--wren-space-2)
  overflow hidden

.moduleItemButton
  border 1px solid transparent
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  cursor pointer
  transition background var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease)

  *
    pointer-events none

  &:hover
    border-color var(--wren-border-subtle)
    color var(--wren-text-primary)
    background var(--wren-surface-hover)

  &:active
    background var(--wren-surface-active)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  &:disabled
    color var(--wren-text-disabled)
    cursor default
    opacity .6

.moduleItemEditNameTitle
  position absolute
  top 28px
  left 30px
  right 0
  color var(--wren-text-tertiary)
  font-size var(--wren-type-caption)

.moduleItemEditName
  display flex
  width 100%
  overflow hidden

  input
    width 100%
    min-width 0
    padding var(--wren-space-3)
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    color var(--wren-text-primary)
    background var(--wren-surface-inset)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    outline none

    &:hover
      background var(--wren-surface-hover)

    &:focus
      border-color var(--wren-focus)
      box-shadow 0 0 0 2px var(--wren-focus)

  .moduleItemInputSubmit
    margin-left var(--wren-space-2)
    padding 0 var(--wren-space-3)
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    color var(--wren-text-secondary)
    background var(--wren-surface-card)
    box-sizing border-box
    cursor pointer
    transition background var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease)

    *
      pointer-events none

    &:hover
      color var(--wren-text-primary)
      background var(--wren-surface-hover)

    &:active
      background var(--wren-surface-active)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

.moduleItemSignerStatus
  display flex
  align-items center
  color var(--wren-text-secondary)
  font-family var(--wren-font-utility)

  span
    padding-left var(--wren-space-2)
