.accountViewScroll
  position absolute
  top 0
  right 0
  bottom 0
  left 0
  padding-top 30px
  padding-bottom 60px
  overflow-x hidden
  overflow-y scroll

.inventoryWrapper
  margin 0 var(--wren-space-2) var(--wren-space-2)
  padding 0 3px 1px
  overflow auto
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-md)
  background var(--wren-surface-inset)

.inventoryCollection
  position relative
  z-index 300
  width 100%
  border-bottom 1px solid var(--wren-border-subtle)
  color var(--wren-text-primary)

  &:last-child
    border-bottom 0

  &:hover
    background var(--wren-surface-hover)

  .inventoryCollectionTop
    position relative
    display flex
    align-items center
    justify-content space-between
    padding var(--wren-space-4)
    cursor pointer
    font-size var(--wren-type-small)
    font-weight 500

    *
      pointer-events none

  .inventoryCollectionLine
    display none

  .inventoryCollectionName
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  .inventoryCollectionCount
    display flex
    align-items center
    justify-content center
    min-width 24px
    height 24px
    margin-left var(--wren-space-3)
    padding 0 var(--wren-space-2)
    border 1px solid var(--wren-border-subtle)
    border-radius var(--wren-radius-sm)
    color var(--wren-text-secondary)
    background var(--wren-surface-card)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)

.inventoryNotFound
  display flex
  align-items center
  justify-content center
  height 48px
  margin-top 3px
  color var(--wren-text-tertiary)
  font-size var(--wren-type-small)
  font-weight 400

.inventoryPreviewTitle
  position relative
  z-index 4
  display flex
  align-items center
  justify-content center
  height 32px
  min-height 0
  box-sizing border-box
  padding-bottom 2px
  border 1px solid var(--wren-border-subtle)
  border-top 0
  border-radius 0 0 var(--wren-radius-sm) var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background var(--wren-surface-card)
  font-size var(--wren-type-caption)
  font-weight 500

.inventoryPreview
  position relative
  z-index 3
  min-height 0
  display flex
  align-items center
  justify-content center
  flex-direction column
  height auto
  padding var(--wren-space-4)
  box-sizing border-box
  overflow hidden
  border 1px solid var(--wren-border-subtle)
  border-bottom 0
  border-radius var(--wren-radius-md) var(--wren-radius-md) 0 0
  background var(--wren-surface-inset)

  .inventoryPreviewCollection
    position absolute
    left 50%
    z-index 2
    width 100px
    height 100px
    margin-left -56px
    border 3px solid var(--wren-border-default)
    border-radius 50%
    background-repeat no-repeat
    background-position center
    background-size cover
    box-shadow var(--wren-shadow-sm)

  .inventoryPreviewMedia
    position absolute
    top var(--wren-space-3)
    right var(--wren-space-3)
    bottom var(--wren-space-3)
    left var(--wren-space-3)
    z-index 4
    overflow hidden

    img
      width 100%
      height 100%
      object-fit contain

    img:before
      content attr(alt)
      display flex
      align-items center
      justify-content center
      width 100%
      height 100%
      color var(--wren-text-muted)
      background var(--wren-surface-inset)
      font-size var(--wren-type-caption)

.moduleExpanded .inventoryCollectionItems
  position relative

.inventoryDisplay
  position absolute
  top 0
  right 0
  bottom 0
  left 0
  display grid
  grid-template-rows minmax(132px, 42%) 32px minmax(96px, 1fr)
  padding var(--wren-space-4) var(--wren-space-1) 0
  box-sizing border-box

  .inventoryCollectionImage
    width 42px
    height 42px
    overflow hidden
    border-radius var(--wren-radius-sm)
    background var(--wren-surface-inset)

    img
      width 42px
      height 42px
      object-fit cover

  .inventoryCollectionItems
    position relative
    min-height 0
    display flex
    flex-wrap wrap
    align-content flex-start
    padding 14px 0 4px 4px
    overflow-x hidden
    overflow-y auto

    .inventoryCollectionItem
      appearance none
      width 94px
      height 94px
      padding var(--wren-space-1)
      box-sizing border-box
      border 0
      border-radius var(--wren-radius-md)
      color inherit
      background transparent
      cursor pointer

      *
        pointer-events none

      &:hover img,
      &:focus-visible img
        box-shadow 0 0 0 1px var(--wren-accent-primary)
        transform scale(1.03)

      &:focus-visible
        outline 2px solid var(--wren-focus)
        outline-offset -2px

    .inventoryItemImage
      width 94px
      height 94px
      object-fit cover

      img,
      img:before
        width 90px
        height 90px
        border-radius var(--wren-radius-md)

      img
        overflow hidden
        background var(--wren-surface-card)
        transition transform var(--wren-motion-fast) var(--wren-ease), box-shadow var(--wren-motion-fast) var(--wren-ease)

      img:before
        content attr(alt)
        display flex
        align-items center
        justify-content center
        padding var(--wren-space-1)
        box-sizing border-box
        color var(--wren-text-muted)
        background var(--wren-surface-inset)
        font-size var(--wren-type-caption)
        text-align center
