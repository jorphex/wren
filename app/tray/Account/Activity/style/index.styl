.activityModule
  width 100%
  box-sizing border-box
  overflow hidden
  color var(--wren-text-primary)

.activityList
  display flex
  margin 0
  padding 0 var(--wren-space-2)
  flex-direction column
  gap var(--wren-space-1)
  list-style none

.activityRow
  position relative
  display grid
  min-height 58px
  padding var(--wren-space-2)
  grid-template-columns 32px minmax(0, 1fr) auto
  align-items center
  gap var(--wren-space-2)
  box-sizing border-box
  border 0
  border-radius var(--wren-radius-sm)
  background transparent

.activityMark
  display flex
  width 28px
  height 28px
  align-items center
  justify-content center
  border 1px solid var(--wren-border-subtle)
  border-radius 2px
  color var(--wren-text-secondary)
  background var(--wren-surface-inset)

.activityIdentity,
.activityResult
  display flex
  min-width 0
  flex-direction column

.activityRowSelected
  outline 2px solid var(--wren-focus)
  outline-offset 2px

.activityTitle
  overflow hidden
  font-size var(--wren-type-small)
  font-weight 560
  text-overflow ellipsis
  white-space nowrap

.activityContext
  overflow hidden
  margin-top 2px
  color var(--wren-text-tertiary)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  text-overflow ellipsis
  white-space nowrap

.activityResult
  align-items flex-end
  color var(--wren-text-muted)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)

.activityOutcome
  margin-bottom 2px
  color var(--wren-text-secondary)
  font-weight 550

.activityOutcome-confirmed,
.activityOutcome-completed
  color var(--wren-success)

.activityOutcome-failed,
.activityOutcome-replaced
  color var(--wren-danger)

.activityOutcomeDetail
  max-width 260px
  margin-bottom 2px
  color var(--wren-text-tertiary)
  white-space normal
  text-align right

.activityFilters
  display grid
  padding var(--wren-space-1)
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap var(--wren-space-1)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-md)
  background var(--wren-surface-inset)

.activityFilter
  min-width 0
  padding 0 var(--wren-space-2)
  border 1px solid transparent
  border-radius var(--wren-radius-sm)
  font-size var(--wren-type-caption)
  transition background var(--wren-motion-fast) var(--wren-ease), color var(--wren-motion-fast) var(--wren-ease),
    border-color var(--wren-motion-fast) var(--wren-ease), box-shadow var(--wren-motion-fast) var(--wren-ease)

  &.wrenControl[aria-pressed='true']
    color var(--wren-text-primary)
    background var(--wren-bg-panel)
    border-color var(--wren-border-strong)
    box-shadow var(--wren-shadow-sm), var(--wren-shadow-inset)

  &:not([aria-pressed='true']):hover:not(:disabled)
    color var(--wren-text-secondary)
    background var(--wren-surface-hover)

.activityEmpty
  display flex
  min-height 92px
  padding var(--wren-space-4)
  box-sizing border-box
  flex-direction column
  align-items flex-start
  justify-content center
  color var(--wren-text-tertiary)

  strong
    color var(--wren-text-primary)
    font-size var(--wren-type-small)
    font-weight 600

  span
    max-width 420px
    margin-top var(--wren-space-1)
    font-size var(--wren-type-caption)
    line-height 1.45

.activityClear
  padding var(--wren-space-4) 0 var(--wren-space-2)

.activityClearButton
  width 100%

.activityClearDialog
  display flex
  padding var(--wren-space-3)
  flex-direction column
  gap var(--wren-space-3)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)

.activityClearCopy
  display flex
  flex-direction column
  gap var(--wren-space-1)

  strong
    color var(--wren-text-primary)
    font-size var(--wren-type-small)

  span
    color var(--wren-text-tertiary)
    font-size var(--wren-type-caption)
    line-height 1.45

.activityClearActions
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap var(--wren-space-2)

.activityClearStatus
  margin-top var(--wren-space-3)
  padding var(--wren-space-3)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background var(--wren-surface-inset)
  font-size var(--wren-type-small)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.activityModuleExpanded
  position absolute
  inset 0
  padding-bottom var(--wren-space-5)
  overflow-y auto

  .activityList
    padding 0

  .activityRow
    min-height 64px
    padding-right var(--wren-space-3)
    padding-left var(--wren-space-3)

@media (max-width: 560px)
  .activityFilters
    grid-template-columns repeat(2, minmax(0, 1fr))

  .activityRow
    grid-template-columns 28px minmax(0, 1fr)

  .activityResult
    grid-column 2
    align-items flex-start

  .activityOutcomeDetail
    text-align left

  .activityMark
    grid-row 1 / span 2
