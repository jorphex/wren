.balancesBlock
  box-sizing border-box
  overflow auto
  color var(--wren-text-primary)

.balanceFilter
  position relative
  top auto
  flex none
  margin-bottom var(--wren-space-2)

  .panelFilterInput
    right 10px

  &.balanceFilterHasValue
    .panelFilterInput input
      padding-right 46px

    .panelFilterClear
      top 5px
      right 13px
      width 38px
      min-width 38px
      height 38px
      min-height 38px

.balancesExpandedView
  display flex
  min-height 0
  padding-bottom 0
  overflow hidden
  flex-direction column

.balancesExpandedScroll
  flex 1
  min-height 0
  width 100%
  overflow-x hidden
  overflow-y auto
  padding-bottom 60px

.signerBalanceWarning
  appearance none
  position relative
  width 100%
  padding var(--wren-space-3) 0
  border 0
  color var(--wren-text-secondary)
  background transparent
  font-family inherit
  text-align left
  cursor pointer

  &:hover
    color var(--wren-text-primary)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset -2px

.signerBalancesExpanded
  width 100%

.signerBalancesWrap
  min-height 76px
  margin 0 var(--wren-space-2) var(--wren-space-2)
  padding 0
  box-sizing border-box
  overflow auto
  border 0
  border-radius 0
  background transparent
  position relative
  z-index 999

.balancesEmpty
  display flex
  align-items center
  justify-content center
  width 100%
  min-height 48px
  color var(--wren-text-tertiary)
  font-size var(--wren-type-small)
  font-weight 400

.signerBalanceWarningTitle
  position relative
  z-index 200000
  display flex
  align-items center
  height 24px
  color var(--wren-warning)
  font-size var(--wren-type-caption)
  font-weight 600
  letter-spacing .3px
  pointer-events none

.signerBalanceWarningMessage
  width 100%
  padding var(--wren-space-3) 0 0
  box-sizing border-box
  color var(--wren-text-secondary)
  font-size var(--wren-type-small)
  font-weight 400
  line-height 1.45

.signerBalanceTotal
  position relative
  z-index 200000
  width 100%
  height 52px
  margin-bottom var(--wren-space-2)
  font-size var(--wren-type-small)

  .signerBalanceButtons
    display flex
    align-items center
    height 100%

  .signerBalanceButton
    z-index 4000
    height 32px
    margin-left var(--wren-space-3)

  .signerBalanceTotalText
    position absolute
    top 0
    right var(--wren-space-4)
    bottom 0
    left var(--wren-space-4)
    display flex
    align-items center
    justify-content flex-end
    pointer-events none

    .signerBalanceTotalLabel
      margin-right 6px
      color var(--wren-text-tertiary)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)
      font-weight 500

    .signerBalanceTotalValue
      display flex
      align-items center
      color var(--wren-text-primary)
      font-family var(--wren-font-mono)
      font-size var(--wren-type-body)
      font-weight 400
      letter-spacing -.4px

.signerBalancesLoading
  position relative
  z-index 200
  display flex
  width 100%
  min-height 88px
  box-sizing border-box
  align-items center
  justify-content center
  border 0
  background transparent

  .loader, .loader:after
    width 22px
    height 22px
    border-radius 50%

  .loader
    position relative
    border-top 3px solid var(--wren-border-subtle)
    border-right 3px solid var(--wren-border-subtle)
    border-bottom 3px solid var(--wren-border-subtle)
    border-left 3px solid var(--wren-accent-primary)
    font-size 7px
    text-indent -9999em
    transform translateZ(0)
    animation load8 .6s infinite linear !important
    will-change transform

.signerBalance
  position relative
  width 100%
  height 70px
  overflow hidden
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  transition background var(--wren-motion-fast) var(--wren-ease)

  .signerBalanceLoading
    position absolute
    top 0
    bottom 0
    left 0
    width 400%
    background linear-gradient(90deg, transparent 25%, var(--wren-surface-hover) 50%, transparent 75%)
    transform translateX(-100%)
    animation sheenLoad 1.4s infinite linear
    will-change transform

  .signerBalanceInner
    position relative
    height 100%
    transition opacity var(--wren-motion-standard) var(--wren-ease)

  .signerBalanceCurrency
    position absolute
    top 25px
    right 53%
    left calc(var(--wren-space-4) + 40px)
    z-index 2
    overflow hidden
    display flex
    align-items center
    color var(--wren-text-primary)
    font-size var(--wren-type-small)
    font-weight 500
    text-overflow ellipsis
    white-space nowrap

  .signerBalanceChain
    position absolute
    top 8px
    left calc(var(--wren-space-4) + 40px)
    z-index 2
    display flex
    align-items center
    height 14px
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    font-weight 500
    letter-spacing .7px
    white-space nowrap

  .signerBalancePrice
    position absolute
    right var(--wren-space-3)
    bottom var(--wren-space-2)
    left calc(var(--wren-space-4) + 40px)
    display flex
    align-items center
    justify-content space-between
    color var(--wren-text-secondary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)

  .signerBalanceOk,
  .signerBalanceCurrentValue,
  .signerBalanceCurrentPrice,
  .signerBalanceCurrentPriceChange
    display flex
    align-items center

  .signerBalanceCurrentPriceChange
    margin-left var(--wren-space-1)

  .signerBalanceCurrentPriceChangeUp
    color var(--wren-success)

  .signerBalanceCurrentPriceChangeDown
    color var(--wren-danger)

  .signerBalanceIcon
    position absolute
    top 19px
    left var(--wren-space-4)
    z-index 1
    width 32px
    height 32px
    display flex
    overflow visible
    align-items center
    justify-content center

    .balancesAssetMark .assetMarkGlyph
      border-color transparent
      background transparent
      box-shadow none

  .signerBalanceValue
    position absolute
    top 22px
    right var(--wren-space-3)
    left 49%
    display flex
    align-items center
    justify-content flex-end
    min-width 0
    overflow hidden
    color var(--wren-text-primary)
    font-family var(--wren-font-mono)
    font-size 18px
    font-weight 400
    white-space nowrap

    .displayValue
      min-width 0
      max-width 100%

    .displayValueMain
      flex-shrink 0

    .displayValueSymbol
      min-width 0
      overflow hidden
      margin-right .36em
      color var(--wren-text-secondary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-caption)
      font-weight 600
      letter-spacing .3px
      text-overflow ellipsis
      white-space nowrap

    .signerBalancePrivateValue
      color var(--wren-text-muted)
      font-family var(--wren-font-mono)
      font-size 13px
      letter-spacing 1.4px

      span
        margin-left 2px
        font-family var(--wren-font-ui)
        font-size var(--wren-type-caption)
        font-weight 600
        letter-spacing .2px

  .signerBalancePrivatePrice
    width 100%
    color var(--wren-text-muted)
    text-align right
    letter-spacing 1.2px

@keyframes sheenLoad
  from
    transform translateX(-100%)
  to
    transform translateX(100%)
