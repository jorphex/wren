    color var(--wren-text-secondary)
    background transparent
    font-size var(--wren-type-small)
    text-transform none

    &:hover
      color var(--wren-text-primary)
      background var(--wren-surface-hover)

.requestsPreview
  height 48px
  border 0
  border-radius 0
  color var(--wren-text-secondary)
  background transparent
  font-size var(--wren-type-small)
  letter-spacing .4px
  text-transform none
  transition background var(--wren-motion-fast) var(--wren-ease)

  &:hover
    color var(--wren-text-primary)
    background var(--wren-surface-hover)

  .requestsPreviewOverlay,
  .requestsPreviewArrow
    display none

  .requestPreviewContent
    padding 0 var(--wren-space-4)
    border-radius var(--wren-radius-sm)

    .requestPreviewContentTitle
      font-family var(--wren-font-ui)
      font-variation-settings var(--wren-font-heading-settings)
      font-weight 590
      letter-spacing .1px

    .requestPreviewContentEnd
      display flex
      min-width 0
      align-items center
      gap var(--wren-space-3)

    .requestPreviewContentMeta
      min-width 0
      overflow hidden
      margin 0
      color var(--wren-text-muted)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)
      font-weight 450
      letter-spacing 0
      text-overflow ellipsis
      white-space nowrap

    .requestPreviewContentArrow
      flex 0 0 auto
      padding-right 0

.accountView
  right 0
  left 0
  border-radius 0

  .accountViewMenu
    right var(--wren-space-5)
    left var(--wren-space-5)
    height 52px
    border 0
    border-radius 0
    background transparent
    box-shadow none

    .accountViewTitle
      color var(--wren-text-secondary)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-small)
      font-weight 500
      letter-spacing .2px
      text-transform none

  .accountViewMain
    top 52px
    right var(--wren-space-5)
    left var(--wren-space-5)
    padding-top 0

    .accountViewScroll
      padding-top 0

  &:has(.signerRequest)
    .accountViewMain
      top 52px

  &.accountViewCompact
    .accountViewMenu
      top 0

  &.accountViewRequest
    .accountViewMenu
      top 0
      right var(--wren-space-5)
      left var(--wren-space-5)

      .accountViewTitle
        right 176px
        left 56px
        justify-content flex-start
        color var(--wren-text-primary)
        font-size 20px
        font-variation-settings var(--wren-font-heading-settings)
        font-weight 650
        line-height 1

        .accountViewText
          font-family inherit
          font-size inherit
          font-weight inherit

      .accountViewMeta
        position absolute
        top 10px
        right 0
        display flex
        max-width 152px
        height 32px
        padding 0 var(--wren-space-3)
        box-sizing border-box
        align-items center
        overflow hidden
        border 1px solid var(--wren-border-subtle)
        border-radius var(--wren-radius-sm)
        color var(--wren-text-secondary)
        background var(--wren-bg-subtle)
        font-family var(--wren-font-utility)
        font-size var(--wren-type-caption)
        text-overflow ellipsis
        white-space nowrap

    .accountViewMain
      top 52px
      right 0
      left 0

// Account home follows the approved controls study: the selected-account switcher
// owns the header, so the startup dashboard control stays out of the selected state.
#panel
  &:has(.accountSelectorOpen) .panelMenuItemOpen
    display none

  .accountSelector.accountSelectorOpen
    top 6px

  .accountMain
    top 88px
    right 0
    bottom 40px
    left 0
    border-radius 0
    background radial-gradient(circle at 86% 8%, rgba(166, 138, 97, .055), transparent 29%)

    .accountMainScroll
      border-radius 0

    .accountMainSlide
      padding-top var(--wren-space-4)
      padding-right var(--wren-space-5)
      padding-left var(--wren-space-5)

.accountHomeHeader
  display grid
  padding 0 var(--wren-space-5) var(--wren-space-5)
  margin-bottom var(--wren-space-2)
  grid-template-columns minmax(0, 1fr) auto
  column-gap var(--wren-space-5)
  row-gap var(--wren-space-4)

.accountHomeEyebrow,
.accountHomeTotalLabel
  color var(--wren-text-tertiary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-caption)
  font-weight 620
  letter-spacing 1.15px
  text-transform uppercase

.accountHomeEyebrow
  color var(--wren-accent-primary)

.accountHomeTitle
  min-width 0
  margin 0
  overflow hidden
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size 25px
  font-weight 660
  line-height 1.08
  text-overflow ellipsis
  white-space nowrap

.accountHomeNameRow
  display flex
  min-width 0
  min-height 32px
  margin-top 4px
  align-items center
  gap var(--wren-space-2)

.accountHomeRename
  flex none
  width 32px !important
  min-width 32px !important
  height 32px !important
  min-height 32px !important
  transform translateY(-1px)

.accountHomeNameInput
  width min(320px, 100%)
  min-width 180px
  height 32px
  min-height 32px
  padding 0 var(--wren-space-3)
  box-sizing border-box
  font-size 18px
  font-weight 620

.accountHomeAddressActions
  display flex
  max-width 100%
  min-height 44px
  margin-top 3px
  align-items center
  gap var(--wren-space-1)

.accountHomeAddress
  appearance none
  display inline-flex
  min-width 0
  min-height 44px
  max-width 100%
  padding 0 var(--wren-space-1)
  align-items center
  gap 7px
  overflow hidden
  border 0
  color var(--wren-text-muted)
  background transparent
  cursor pointer
  font-family var(--wren-font-mono)
  font-size var(--wren-type-caption)
  text-align left
  transition color var(--wren-motion-fast) var(--wren-ease)

  span
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  svg
    flex none

  &:hover
    color var(--wren-text-secondary)

  &:active
    color var(--wren-accent-primary)

  &:focus-visible
    border-radius 2px
    outline 2px solid var(--wren-focus)
    outline-offset 3px

.accountHomeTotal
  align-self end
  padding-bottom 1px
  text-align right

.accountHomeTotalValue
  margin-top 5px
  color var(--wren-text-secondary)
  font-family var(--wren-font-mono)
  font-size 20px
  font-weight 450
  letter-spacing .04em

.accountHomeActions
  grid-column 1 / -1
  display flex
  flex-wrap wrap
  align-items center
  gap var(--wren-space-2)

  .wrenControl
    svg
      flex none
