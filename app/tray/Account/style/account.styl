@keyframes arrowSlide
  0%
    opacity 0
    transform translateY(5px)
  20%
    opacity 1
  40%
    opacity 0
    transform translateY(-15px)
  100%
    opacity 0

@keyframes arrowSlideSingle
  0%
    opacity 0
    transform translateY(3px)
  50%
    opacity 1
  100%
    opacity 0
    transform translateY(-3px)

@keyframes headShake
  0%
    transform translateX(0)
  32%
    transform translateX(-3px)
  66%
    transform translateX(2px)
  100%
    transform translateX(0)

.headShake
  animation-duration var(--wren-motion-standard)
  animation-fill-mode both
  animation-timing-function var(--wren-ease)
  animation-name headShake
  transform translateZ(0)

.standardFade-enter
  opacity 0

.standardFade-enter.standardFade-enter-active
  opacity 1
  transition var(--standard)

.standardFade-leave
  opacity 1

.standardFade-leave.standardFade-leave-active
  opacity 0
  transition var(--standard)

.footerModule
