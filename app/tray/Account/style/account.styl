@import './view'

// Wren account surface
.accountMain
  right 0
  left 0
  border-radius 0

  .accountMainScroll
    border-radius 0

  .accountMainSlide
    padding-right var(--wren-space-5)
    padding-left var(--wren-space-5)
    box-sizing border-box

.accountModule
  right var(--wren-space-5)
  left var(--wren-space-5)
  padding-bottom 0

.accountModuleInner
  right 0
  bottom 0
  left 0
  padding 0
  border-radius var(--wren-radius-sm)

  .accountModuleCard
    overflow hidden
    border 0
    border-top 0
    border-radius 0
    background transparent
    box-shadow none

    // Preview modules use spacing and whole-row feedback instead of card outlines.
    .cluster
      margin 0
      padding 0
      border 0
      border-radius 0
      background transparent

      .clusterRow
        gap 0

      .clusterRow + .clusterRow
        margin-top var(--wren-space-2)

      .clusterValue
        border 0
        border-radius 0
        background transparent

      .clusterValueClickable:not(.clusterValueDisabled):hover
        border-color transparent
        background var(--wren-ledger-hover)

      .clusterValueClickable:not(.clusterValueDisabled):active
        border-color transparent
        background var(--wren-surface-active)

    // The compact account illustrations are intentionally opaque RGB assets.
    // Match their charcoal field to the ledger and feather the crop without
    // dimming transparent empty-state artwork on other surfaces.
    .wrenEmptyState
      background transparent

    .wrenEmptyStateImage
      opacity .9
      filter brightness(.7) saturate(.92)
      -webkit-mask-image radial-gradient(ellipse 66% 57% at 52% 52%, #000 32%, rgba(0, 0, 0, .82) 55%, transparent 88%)
      mask-image radial-gradient(ellipse 66% 57% at 52% 52%, #000 32%, rgba(0, 0, 0, .82) 55%, transparent 88%)

    .wrenEmptyStateImageTransparent
      opacity 1
      filter none
      -webkit-mask-image none
      mask-image none

    .wrenEmptyStateTransparent:not(.wrenEmptyStateExpanded)
      min-height 96px

      .wrenEmptyStateImageTransparent
        top 45%
        width 200px

    .accountLedgerModule
      .accountLedgerRow
        min-height 52px

      .settingsPreviewRemovalConfirm > .clusterValue:last-child
        min-height 42px
        margin 5px var(--wren-space-2)
        border 1px solid rgba(225, 154, 145, .42)
        border-radius var(--wren-radius-sm)
        color var(--wren-danger)
        background var(--wren-danger-soft)
        background-image var(--wren-control-texture-dark)
        box-shadow var(--wren-control-shadow)
        transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease), box-shadow var(--wren-motion-fast) var(--wren-ease), transform var(--wren-motion-fast) var(--wren-ease)

      .settingsPreviewRemovalConfirm > .clusterValue:last-child:not(.clusterValueDisabled):hover
        border-color var(--wren-danger)
        background var(--wren-danger-soft)
        background-image var(--wren-control-texture-dark)
        box-shadow var(--wren-control-shadow-hover)

      .settingsPreviewRemovalConfirm > .clusterValue:last-child:not(.clusterValueDisabled):active
        background var(--wren-danger-soft)
        box-shadow var(--wren-control-shadow-pressed)
        transform translateY(1px)

      .accountLedgerLabel
        display flex
        flex 0 0 112px
        min-width 112px
        padding 0 var(--wren-space-4)
        box-sizing border-box
        align-items center
        gap var(--wren-space-2)
        color var(--wren-text-tertiary)
        font-family var(--wren-font-ui)
        font-size var(--wren-type-small)
        font-weight 560

        svg
          color var(--wren-text-secondary)
          vertical-align middle

      .clusterValue
        min-height 52px

      .moduleItem
        min-height 52px
        padding var(--wren-space-3)

      .signerPreviewSummary
        min-height 52px
        padding 0 var(--wren-space-3)

    .chainMonitorPreview
      .chainMonitorNetworkRow,
      .chainMonitorGasRow
        display grid
        min-height 52px
        grid-template-columns minmax(0, 1fr) auto
        align-items center

      .chainMonitorControls
        display flex
        align-items center
        gap var(--wren-space-1)

      .chainMonitorIdentity
        display flex
        min-width 0
        min-height 44px
        padding-left var(--wren-space-3)
        box-sizing border-box
        flex 1
        align-items center
        gap var(--wren-space-2)
        color var(--wren-text-primary)

        .chainMonitorMark
          display flex
          width 24px
          height 24px
          flex none
          align-items center
          justify-content center

        strong
          overflow hidden
          font-size var(--wren-type-small)
          font-weight 590
          text-overflow ellipsis
          white-space nowrap

      .chainMonitorSwitchButton,
      .chainMonitorExplorer
        width 44px !important
        min-width 44px !important
        height 44px !important
        min-height 44px !important
        flex none

      .chainMonitorGasRow
        border-top 0

      .chainMonitorGasEvidence
        display flex
        min-width 0
        min-height 52px
        padding 0 var(--wren-space-3)
        align-items center
        justify-content space-between
        gap var(--wren-space-3)
        box-sizing border-box

        > span:first-child
          margin-left calc(var(--wren-space-5) + var(--wren-space-2))
          color var(--wren-text-secondary)
          font-size var(--wren-type-small)
          font-weight 560

      .chainMonitorDisclosure
        display flex
        width auto
        min-width 88px
        min-height 44px
        margin-right var(--wren-space-1)
        padding 0 var(--wren-space-2)
        align-items center
        justify-content center
        gap var(--wren-space-1)
        font-size var(--wren-type-small)

      .sliceTileGasPrice
        justify-content flex-end
        padding 0

