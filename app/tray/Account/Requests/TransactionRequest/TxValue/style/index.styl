.txSendingValue
  min-height 50px
  display flex
  justify-content center
  align-items center
  font-size 18px
  font-weight 300

._txMain
  position relative
  z-index 100001
  background var(--ghostAZ)
  margin 0px 6px 16px 6px
  border-radius 26px
  overflow hidden
  box-shadow 0px 4px 8px var(--ghostY), 0px 2px 8px var(--ghostY)
  border-bottom 2px solid var(--ghostZ)
  padding 0

  ._txMainInner
    position relative
    margin 0px 0px
    overflow hidden

    ._txMainBackground
      position absolute
      top 0
      right 0
      bottom 0
      left 0
      opacity 0.05
      display none
    
  ._txMainTag
    position relative
    z-index 100001
    // animation-name cardShow
    // animation-duration 0.2s
    // animation-fill-mode both
    overflow hidden
    font-size var(--wren-type-caption)
    font-weight 400
    text-transform uppercase
    letter-spacing 1px
    text-align center
    padding 8px 0px 8px 0px
    margin-top 1px

  ._txMainTagWarning
    color var(--moon)

  ._txMainTagBad
    color var(--bad)
  
  ._txMainTagGood
    color var(--good)

// Wren transaction review
._txMain
  margin 0 0 var(--wren-space-3)
  padding 0
  overflow hidden
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-card)
  box-shadow var(--wren-shadow-sm), var(--wren-shadow-inset)

  ._txMainInner
    overflow hidden

  ._txMainTag
    margin var(--wren-space-1) var(--wren-space-3) 0
    padding 6px var(--wren-space-2)
    border-radius var(--wren-radius-sm)
    background var(--wren-bg-elevated)
    font-size var(--wren-type-caption)
    letter-spacing .3px
    text-transform none

  ._txMainTagWarning
    color var(--wren-warning)
    background var(--wren-warning-soft, #2c2418)

  ._txMainTagBad
    color var(--wren-danger)
    background var(--wren-danger-soft, #2d1b1a)

  ._txMainTagGood
    color var(--wren-success)
    background var(--wren-success-soft, #1b291b)
