.transactionEvidenceView
  padding 0 var(--wren-space-5) var(--wren-space-8)
  box-sizing border-box

  .transactionEvidenceGroup
    margin 0
    padding var(--wren-space-5) 0 0
    border-top 1px solid var(--wren-ledger-rule)

    &:first-child
      border-top 0

  .transactionEvidenceGroupTitle
    margin 0 0 var(--wren-space-3)
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 650
    line-height 22px

  .transactionEvidenceGroupSummary
    display flex
    min-height 38px
    margin 0
    padding 0
    color var(--wren-text-primary)
    cursor pointer
    list-style none
    align-items flex-start
    justify-content space-between

    &::-webkit-details-marker
      display none

    &:hover
      color var(--wren-accent-primary-hover)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset -2px

    .transactionEvidenceGroupTitle
      margin 0

  .transactionEvidenceGroupChevron
    flex 0 0 auto
    margin-top 3px
    color var(--wren-text-tertiary)
    transition transform var(--wren-motion-fast) var(--wren-ease)

  .transactionEvidenceGroupDisclosure[open]
    .transactionEvidenceGroupSummary
      margin-bottom var(--wren-space-3)

    .transactionEvidenceGroupChevron
      transform rotate(180deg)

  .transactionEvidenceGroupBody
    > .txViewData + .txViewData
      border-top 1px solid var(--wren-ledger-rule)

  .txViewData
    margin 0
    padding 0 0 var(--wren-space-5)
    border 0
    border-radius 0
    background transparent
    box-shadow none

  .txViewDataHeader
    margin 0 0 var(--wren-space-3)
    padding 0
    color var(--wren-text-secondary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    font-weight 500
    letter-spacing 0
    line-height 18px
    text-align left
    text-transform none

  .decodedDataContract
    position relative
    padding 0 0 var(--wren-space-4)

  .dataUnverified,
  .dataSource
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    line-height 18px

  .dataUnverified
    color var(--wren-danger)

  .decodedDataContractTarget
    display grid
    min-height 58px
    padding var(--wren-space-3) 0
    border-top 1px solid var(--wren-ledger-rule)
    border-bottom 1px solid var(--wren-ledger-rule)
    box-sizing border-box
    place-items center

  .decodedDataSync
    display none

  .decodedDataContractName
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    font-weight 650
    line-height 18px
    text-align center

  .decodedDataContractMethod
    color var(--wren-text-secondary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    line-height 18px
    text-align center

  .decodedDataContractArgHeader
    padding var(--wren-space-3) 0 0
    color var(--wren-text-secondary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    font-weight 500
    line-height 18px

  .decodedDataContractArg
    padding var(--wren-space-3) 0
    border-bottom 1px solid var(--wren-ledger-rule)
    color var(--wren-text-primary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    line-height 18px

  .decodedDataSubtitle
    margin-top var(--wren-space-2)
    color var(--wren-text-secondary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    line-height 18px

  .overflowBox
    overflow-x auto
    overflow-y hidden
    overflow-wrap anywhere
    white-space pre-wrap

    div
      user-select all

  .simulationEffectsNotice,
  .simulationEffectsEmpty,
  .simulationEffectsTruncated
    margin 0 0 var(--wren-space-4)
    color var(--wren-text-secondary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    line-height 18px
    text-align left

  .simulationEffectsTruncated
    color var(--wren-danger)

  .simulationEffect
    margin 0
    padding var(--wren-space-4) 0
    border-top 1px solid var(--wren-ledger-rule)
    border-radius 0
    background transparent

  .simulationEffectTitle
    margin 0 0 var(--wren-space-3)
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    font-weight 650
    letter-spacing 0
    line-height 18px
    text-align left
    text-transform none

  .simulationEffectRisk
    color var(--wren-danger)

  .simpleJsonChild
    display grid
    width 100%
    margin 0
    padding var(--wren-space-3) 0
    border-top 1px solid var(--wren-ledger-rule)
    box-sizing border-box
    grid-template-columns 136px minmax(0, 1fr)
    align-items start
    column-gap var(--wren-space-5)

  .simpleJsonKey,
  .simpleJsonKeyTx
    width auto
    max-width none
    padding 0
    color var(--wren-text-secondary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    font-weight 500
    letter-spacing 0
    line-height 18px
    text-transform none

  .simpleJsonValue
    width 100%
    max-width none
    min-width 0
    margin 0
    padding 0
    border 0
    color var(--wren-text-primary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    font-weight 400
    line-height 18px
    overflow-wrap anywhere

  .simpleJsonStructuredValue
    margin 0
    white-space pre-wrap

@media (max-width: 560px)
  .transactionEvidenceView .simpleJsonChild
    grid-template-columns 104px minmax(0, 1fr)
