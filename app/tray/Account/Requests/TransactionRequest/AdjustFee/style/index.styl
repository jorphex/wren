.txAdjustFee
  .txFeeOverlayField,
  .txFeeOverlayLabel
    display flex

.txAdjustFeeInline
  display grid
  padding var(--wren-space-3) 0 var(--wren-space-1)
  border-top 1px solid var(--wren-ledger-rule)
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap var(--wren-space-3)

  .txAdjustFeeIntro
    grid-column 1 / -1
    padding 0 0 var(--wren-space-1)

    strong
      flex none
      font-size var(--wren-type-small)
      font-weight 620

  .txFeeOverlayBaseFee,
  .txFeeOverlayPriorityFee,
  .txFeeOverlayGasPrice,
  .txFeeOverlayLimit
    width auto
    min-width 0
    display flex
    flex-direction column

  .txFeeOverlayField
    position relative
    width 100%
    align-items center

  input.txFeeOverlayInput
    width 100%
    height 44px
    box-sizing border-box
    margin 0
    padding 0 58px 0 var(--wren-space-3)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-body)
    text-align left
    transform none

  input.txFeeOverlayInput:focus
    transform none

  .txFeeOverlayUnit
    position absolute
    right var(--wren-space-3)
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size 12px
    pointer-events none

  .txFeeOverlayLabel
    order -1
    justify-content flex-start
    margin-bottom var(--wren-space-1)
    color var(--wren-text-secondary)
    font-size var(--wren-type-caption)
    font-weight 520

@media (max-width: 520px)
  .txAdjustFeeInline
    grid-template-columns 1fr
