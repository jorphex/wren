.loader,
.loader:after {
  border-radius 100%
  width 7em
  height 7em
}
.loader {
  font-size 7px
  position relative
  text-indent -9999em
  border-top 6px solid var(--outerspace01)
  border-right 6px solid var(--outerspace01)
  border-bottom 6px solid var(--outerspace01)
  border-left 6px solid var(--outerspace08)
  transform translateZ(0)
  animation load8 1.1s infinite linear
}
@keyframes load8 {
  0% {
    transform rotate(0deg)
  }
  100% {
    transform rotate(360deg)
  }
}

.requestGroup
  padding 16px 20px 7px 20px
  display flex
  justify-content space-between

  img 
    border-radius 12px

  .requestGroupMain
    display flex
    align-items center

  .requestGroupName
    font-weight 400
    font-size var(--wren-type-small)

.requestGroupBlock
  border-top 0

  & + .requestGroupBlock
    border-top 1px solid var(--wren-ledger-rule)

  > .cluster
    margin 0
    padding 0
    border 0
    border-radius 0
    background transparent

.requestGroupClearConfirmation
  margin 0 var(--wren-space-4) var(--wren-space-2)
  padding var(--wren-space-3)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-card)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.requestGroupClearTitle
  color var(--wren-text-primary)
  font-size var(--wren-type-small)
  font-weight 560

.requestGroupClearBody
  margin-top var(--wren-space-1)
  color var(--wren-text-secondary)
  font-size var(--wren-type-caption)
  line-height 1.45

.requestGroupClearActions
  display flex
  justify-content flex-end
  gap var(--wren-space-2)
  margin-top var(--wren-space-3)

.requestInboxHeading
  position absolute
  width 1px
  height 1px
  overflow hidden
  clip rect(0 0 0 0)
  white-space nowrap
  clip-path inset(50%)

.requestViewScroll
  background transparent
  padding 20px var(--wren-page-gutter) var(--wren-space-5)
  box-sizing border-box

.requestGroupBlock
  margin-bottom var(--wren-space-3)
  overflow hidden
  border 1px solid var(--wren-border-default)
  border-radius 10px
  background var(--wren-surface-card)
  box-shadow var(--wren-shadow-sm), var(--wren-shadow-inset)

  & + .requestGroupBlock
    border-top 1px solid var(--wren-border-default)

.requestGroup
  min-height 44px
  padding 0 var(--wren-space-3)
  align-items center
  color var(--wren-text-tertiary)

  .requestGroupName
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    font-weight 600
    letter-spacing .055em
    text-transform uppercase

.requestGroupBlock .requestLedger
  margin 0 var(--wren-space-3) var(--wren-space-2)
  border-top 1px solid var(--wren-ledger-rule)

.requestViewScroll .requestLedger
  .clusterRow
    gap 0

  .clusterRow + .clusterRow
    margin-top 0

  .clusterValue
    border 0
    border-bottom 1px solid var(--wren-ledger-rule)
    border-radius 0
    background transparent
    box-shadow none

  .clusterRow:last-child .clusterValue
    border-bottom 0

  .clusterValueClickable:not(.clusterValueDisabled):hover
    border-color var(--wren-ledger-rule)
    background var(--wren-ledger-hover)

  .requestItem,
  .requestItem:hover,
  .requestItem:active
    margin-top 0
    border-radius 0
    background transparent

.requestViewScroll .requestQueueStatus
  margin-bottom var(--wren-space-3)
  overflow hidden
  border 1px solid var(--wren-border-default)
  border-radius 10px
  background var(--wren-surface-card)
  box-shadow var(--wren-shadow-sm), var(--wren-shadow-inset)

.requestQueueStatus
  position relative
  display grid
  min-height 52px
  grid-template-columns minmax(0, 1fr) auto
  align-items center
  gap var(--wren-space-3)
  padding var(--wren-space-2) var(--wren-space-4)
  box-sizing border-box
  border-bottom 1px solid var(--wren-ledger-rule)
  color var(--wren-text-secondary)
  background transparent
  font-size 12px

.requestQueueStatusSummary
  display flex
  min-width 0
  align-items flex-start
  justify-content flex-start
  flex-direction column
  gap 2px

.requestQueueStatusTitle
  color var(--wren-text-primary)
  font-size var(--wren-type-small)
  font-weight 560

.requestQueueStatusDetail
  color var(--wren-text-tertiary)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  line-height 1.35

.requestClearAll
  width auto
  min-width 0
  height 44px
  min-height 44px
  padding-right var(--wren-space-3)
  padding-left var(--wren-space-3)

.requestViewScrollEmpty
  display flex
  min-height 100%
  align-items center
  justify-content center

  .wrenEmptyState
    flex none

.noRequests
  display flex
  height 48px
  padding 0 var(--wren-space-4)
  align-items center
  justify-content center
  border-top 1px solid var(--wren-ledger-rule)
  color var(--wren-text-tertiary)
  background transparent
  font-size var(--wren-type-caption)

.signerRequest
  position absolute
  top 0
  right 0
  bottom 0
  left 0
  width 100%
  justify-content space-between
  transition var(--standardFast)
  z-index 2000
  color var(--outerspace)
  transform translateZ(0)

.signerRequestSuccess
  align-items center
  .requestApprove
    opacity 0
    pointer-events none

.signerRequestPending
  align-items center
  svg
    color var(--outerspace08)
  .requestApprove
    opacity 0
    pointer-events none

.signerRequestError
  align-items center
  .requestApprove
    opacity 0
    pointer-events none

.signerRequestDeclined
  align-items center
  .requestApprove
    opacity 0
    pointer-events none
  .approveTransaction
    pointer-events none

.requestNoticeError
  color var(--bad)

.requestNoticeSuccess
  color var(--good)

.requestNotice
  box-sizing border-box
  height 200px
  font-size 14px
  -webkit-app-region no-drag
  pointer-events auto
  opacity 1
  display flex
  justify-content space-around
  align-items center
  font-weight 300
  z-index 999999999999999
  transition var(--standard)
  animation 0.32s fadeUp ease-out

.requestNoticeInner
  height 100%
  width 100%
  position relative
  display flex
  justify-content center
  align-items center
  flex-direction column

  .requestNoticeInnerSymbol
    padding-bottom 20px

  .requestNoticeInnerText
    font-size var(--wren-type-small)
    font-weight 400
    text-transform uppercase
    letter-spacing 2px
    white-space normal
    padding 0px 40px
    text-align center

  .cancelRequest
    appearance none
    padding 0
    color inherit
    border 0
    font-family inherit
    font-size var(--wren-type-caption)
    background var(--thin)
    height 20px
    width  100px
    margin 16px auto 0px auto
    border-radius 8px
    letter-spacing 2px
    font-weight 400
    display flex
    justify-content center
    align-items center
    text-transform uppercase
    cursor pointer
    *
      pointer-events none

  .cancelRequest:hover
    background var(--thick)

.walletCallsReview
  width 100%
  box-sizing border-box
  padding 8px 12px 40px
  color var(--outerspace)

.walletCallsList
  display flex
  flex-direction column
  gap 8px

.approveTransaction, .approveRequest
  position absolute
  top 0
  right 0
  bottom 0px
  left 0
  padding 64px 0px
  border-radius 24px
  overflow-y scroll

  .approveTransactionPayload
    display flex
    align-items center
    flex-direction column
    width 100%

.unknownType
  display flex
  justify-content center
  align-items center
  width 100%
  margin-bottom 60px
  padding 20px

@keyframes fadeUp
  0%
    opacity 0
  70%
    opacity 0
    transform translateY(10px)
  100%
    opacity 1
    transform translateY(0px)

.requestApprove
  box-sizing border-box
  height 88px
  font-size 16px
  -webkit-app-region no-drag
  pointer-events auto
  opacity 1
  display flex
  justify-content space-around
  align-items center
  z-index 999999999
  border-radius 24px
  position relative
  background var(--ghostZ)
  animation 0.48s fadeUp ease-out
  margin 10px 8px 40px 8px

  .requestDecline
    appearance none
    padding 0
    color inherit
    border 0
    font-family inherit
    background transparent
    position absolute
    top 4px
    left 4px
    right calc(50% - 1px)
    bottom 4px
    z-index 40
    text-transform uppercase

  .requestDeclineButton
    position absolute
    top 0px
    right 0px
    bottom 0px
    left 0px
    transform translateZ(0px)
    display flex
    justify-content center
    align-items center
    -webkit-app-region no-drag
    letter-spacing 2px
    padding-left 2px
    padding-bottom 10px
    cursor pointer
    border-top-right-radius 12px
    border-bottom-right-radius 12px
    *
      pointer-events none

    span
      position relative
      z-index 99

  .requestDeclineButton:before
    content ''
    position absolute
    margin-left -1px
    height 4px
    border-radius 2px
    width 30px
    background var(--bad)
    bottom 26px
    z-index 80

  .requestDeclineButton:hover:before
    background var(--badOver)

  .requestSign
    appearance none
    padding 0
    color inherit
    border 0
    font-family inherit
    background transparent
    position absolute
    top 4px
    right 4px
    left calc(50% - 1px)
    bottom 4px
    z-index 40
    text-transform uppercase

  .requestSignButton
    position absolute
    top 0px
    left 6px
    bottom 0px
    right 0px
    transform translateZ(0px)
    display flex
    justify-content center
    align-items center
    -webkit-app-region no-drag
    letter-spacing 2px
    padding-left 2px
    padding-bottom 10px
    border-top-left-radius 12px
    border-bottom-left-radius 12px

    *
      pointer-events none

    span
      position relative
      z-index 99


  .requestSignButton:before
    content ''
    position absolute
    margin-left -1px
    height 4px
    border-radius 2px
    width 30px
    background var(--good)
    bottom 26px
    z-index 98

  .requestSignButton:hover:before
    background var(--goodOver)

.requestApprove
  .requestDecline:disabled,
  .requestSign:disabled
    cursor default
    opacity 0.35

    .requestDeclineButton,
    .requestSignButton
      cursor default

      &:hover
        background transparent
.requestApprove
  height 72px
  margin 8px 12px 20px
  color var(--wren-text-primary)
  background var(--wren-surface-card)
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  box-shadow var(--wren-shadow-sm), var(--wren-shadow-inset)
  animation 0.24s fadeUp ease-out

  .requestDecline,
  .requestSign
    top 4px
    bottom 4px
    text-transform none

  .requestDeclineButton,
  .requestSignButton
    padding 0
    border-radius var(--wren-radius-md)
    font-size 14px
    font-weight 600
    letter-spacing 0
    transition background var(--wren-motion-fast)

    &:hover
      background var(--wren-surface-hover)

  .requestDeclineButton:before,
  .requestSignButton:before
    display none

span
  padding 0px 3px 0px 0px

.simpleJsonHeader
  font-size 13px
  padding 8px 2px
  font-weight 400
  margin-top 40px
  border-bottom 2px solid var(--ghostZ)
  text-transform uppercase
  color var(--good)
  letter-spacing 1px

  &.simpleJsonHeaderFirst
    margin-top 0px

.typedDataWarnings, .messageSigningWarnings
  margin-top 24px

.typedDataWarning, .messageSigningWarning
  margin-top 10px
  padding 10px 12px
  border-left 2px solid var(--bad)
  background var(--bad01)
  color var(--bad)
  font-size var(--wren-type-small)
  line-height 1.5
  font-family 'FiraCode'

.simpleJson
  font-size 14px

  .simpleJsonChild
    width 100%
    margin-top 22px

  .simpleJsonKey
    font-size 13px
    width 100%
    font-weight 500
    padding 0px 0px 0px 2px
    border-radius 12.5px
    box-sizing border-box
    max-width fit-content

  .simpleJsonKeyTx
    text-transform uppercase
    font-size var(--wren-type-caption)

  .simpleJsonValue
    margin 8px 10px 10px 3px
    border-left 2px solid var(--good)
    padding 4px 7px 2px 7px
    font-size 13px
    width calc(100% - 3px)
    box-sizing border-box
    word-wrap break-word
    font-family 'FiraCode'
    font-weight 300
    user-select all !important
    max-width fit-content
    position relative

.simpleJsonEmpty
  margin-top 12px
  font-family 'FiraCode'
  color var(--moon)

.signMessageRaw
  margin-top 12px
  padding 12px
  background var(--ghostB)
  color var(--outerspace)
  font-family 'FiraCode'
  font-size 13px
  line-height 1.55
  overflow-wrap anywhere
  user-select all
  white-space pre-wrap


@import '../TransactionRequest/style'
@import '../ChainRequest/style'
@import '../AddTokenRequest/style'
@import './wren-lightweight-requests'

// Wren request-review surfaces
.approveTransaction, .approveRequest
  border-radius 0

.simpleJsonHeader
  border-bottom 1px solid var(--wren-border-default)
  color var(--wren-text-secondary)
  font-variation-settings var(--wren-font-heading-settings)
  text-transform none
  letter-spacing 0

.typedDataWarning, .messageSigningWarning
  border-left-color var(--wren-danger)
  color var(--wren-text-secondary)
  background var(--wren-danger-soft)

@import './wren-signing'
@import './wren-message-signing'
@import './wren-wallet-calls'
@import './wren-eip7702-revoke'

.signMessageRaw
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  color var(--wren-text-primary)
  background var(--wren-surface-inset)
