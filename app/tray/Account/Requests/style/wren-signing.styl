// Signing-critical surfaces use one continuous review canvas. Preserve the existing request and
// signer flow while removing the inherited card stack, animated split pill, and decorative chrome.
.approveTransaction
  padding 0 var(--wren-space-5)
  border-radius 0
  background var(--wren-bg-canvas)

  .transactionReviewQueueContext
    display flex
    min-height 36px
    align-items center
    justify-content space-between
    gap var(--wren-space-3)
    padding var(--wren-space-2) 0
    color var(--wren-text-tertiary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    line-height 1.35

    strong
      color var(--wren-text-secondary)
      font-weight 560
      text-align right

  .approveTransactionPayload,
  ._txBody
    width 100%

  ._txBody
    margin 0
    padding 0

  ._txMain
    margin 0
    overflow visible
    border 0
    border-bottom 0
    border-radius 0
    background transparent
    box-shadow none

    &:last-child
      border-bottom 0

    ._txMainInner
      overflow visible

  .requestItem,
  .requestItem:hover,
  .requestItem:active
    margin 0
    border-radius 0
    background transparent

  .requestItemBackground
    display none

  .transactionReviewMain
    .requestItem > .requestItemTitle
      display none

    .transactionReviewOverview > .clusterRow:first-child .clusterValue
      min-height 116px

    ._txDescription
      display grid
      width 100%
      min-height 116px
      padding var(--wren-space-3) 0
      box-sizing border-box
      grid-template-columns minmax(0, 1fr)
      align-items center
      gap var(--wren-space-6)

    ._txDescriptionSummary
      width 100%

    ._txDescriptionSummaryMain
      padding-top var(--wren-space-2)
      min-width 0
      font-size 26px
      line-height 32px
      overflow-wrap anywhere

      > div
        display flex
        min-width 0
        align-items baseline
        flex-wrap wrap
        gap var(--wren-space-2)

      .displayValue
        font-size inherit

      .transactionReviewApprovalSummary
        flex-wrap nowrap

      ._txDescriptionTransfer
        display grid
        justify-items start
        gap 2px

      .transactionReviewAmountLine
        display flex
        min-height 32px
        align-items center
        gap 10px

        .transactionReviewAssetMark .assetMarkGlyph
          border-color transparent
          box-shadow none

      ._txDescriptionAction
        color var(--wren-accent-primary)
        font-family var(--wren-font-ui)
        font-size var(--wren-type-caption)
        font-variation-settings var(--wren-font-body-settings)
        font-weight 620
        letter-spacing .8px
        line-height 16px
        text-transform uppercase

      ._txDescriptionFiat
        display flex
        align-items baseline
        gap var(--wren-space-1)
        color var(--wren-text-secondary)
        font-family var(--wren-font-utility)
        font-size var(--wren-type-small)
        font-weight 450
        line-height 18px

    .transactionReviewSummaryStatus
      width 100%
      max-width none
      min-height 42px
      box-sizing border-box
      padding var(--wren-space-2)
      display grid
      align-content center
      grid-template-rows auto
      gap 2px
      justify-self stretch
      font-family var(--wren-font-ui)
      font-size var(--wren-type-small)
      font-variation-settings var(--wren-font-body-settings)
      font-weight 540
      line-height 18px
      text-align left

      > span
        display block
        min-width 0

        &:empty
          display none

      ._txMainTagQuiet
        color var(--wren-text-muted)

    .transactionReviewStatusRow
      border-top 1px solid var(--wren-ledger-rule)

      .clusterValue
        padding 0

    ._txDescriptionSummaryTag
      display none

  .transactionReviewMainApproval
    .transactionReviewOverview > .clusterRow:first-child .clusterValue,
    ._txDescription
      min-height 72px

    ._txDescription
      padding var(--wren-space-1) 0

    ._txDescriptionSummaryMain
      padding-top 0

    .transactionReviewSummaryStatus
      min-height 36px
      padding var(--wren-space-1) var(--wren-space-2)

  .transactionReviewSectionTitle
    min-height 38px
    padding var(--wren-space-4) 0 var(--wren-space-1)
    color var(--wren-text-primary)
    font-size var(--wren-type-body)
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 650

  .transactionReviewRecipient,
  .transactionReviewFee,
  .transactionReviewNonce
    margin 0

    > ._txMainInner > ._txLabel
      display none

  .transactionReviewRecipient
    .cluster
      margin 0
      padding 0

    .clusterRow:first-child .clusterValue
      position relative
      display grid
      min-height 56px
      padding 0
      grid-template-columns 96px minmax(0, 1fr)
      align-items start
      justify-content stretch
      column-gap var(--wren-space-4)

    .transactionReviewRecipientLabel
      align-self start
      padding-top var(--wren-space-2)
      text-align left

    .clusterAddress
      min-width 0
      padding var(--wren-space-2) 0

    .clusterAddressRecipient,
    .clusterAddressRecipientLabeled
      align-items flex-start
      justify-content flex-start
      text-align left

    .clusterAddressEvidence
      color var(--wren-accent-primary-hover)

    .clusterRow + .clusterRow
      margin 0
      border-top 1px solid var(--wren-ledger-rule)

  .transactionReviewFeeRow,
  .transactionReviewNonceRow
    display grid
    width 100%
    min-height 62px
    box-sizing border-box
    padding var(--wren-space-3) 0
    grid-template-columns 96px minmax(0, 1fr) auto
    align-items center
    column-gap var(--wren-space-4)

  .transactionReviewNonceRow
    grid-template-columns 96px minmax(0, 1fr) auto

  .transactionReviewFeeValue,
  .transactionNonceDetails
    display flex
    min-width 0
    flex-direction column
    align-items flex-start

  .transactionReviewFeeValue
    max-width 330px

  .transactionReviewFeeTotal
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-body)
    font-weight 550

  .transactionReviewFeeSubline
    display flex
    min-width 0
    margin-top 2px
    align-items center
    gap var(--wren-space-2)
    color var(--wren-text-tertiary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

    .clusterTag,
    ._txFeeGwei
      display flex
      min-height 0
      padding 0
      color inherit
      font-size inherit
      gap 3px

    ._txFeeGweiValue,
    ._txFeeGweiLabel
      color inherit
      font-size inherit
      font-weight 400

  .transactionReviewFeeAdjust
    align-self center
    justify-self end
    min-width 88px
    height 32px

  .transactionReviewFeeNotice
    min-height 34px
    padding 8px 0 8px 112px
    border-top 1px solid var(--wren-ledger-rule)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

  .transactionReviewNonceHint
    margin-top 2px
    color var(--wren-text-tertiary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

  .transactionNonce
    display grid
    min-width 0
    grid-column 2 / 4
    grid-template-columns minmax(0, 1fr) auto
    align-items center
    gap var(--wren-space-6)

  .transactionNonceDetails
    min-width 0

  .transactionNonceValue
    display flex
    height 20px
    align-items center
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-body)
    font-weight 550
    line-height 20px

  .transactionNonceActions
    justify-self end

  .transactionReviewNonce
    padding-bottom var(--wren-space-3)

  .transactionReviewMeta,
  .transactionReviewRecipient,
  .transactionReviewFee,
  .transactionReviewNonce
    border 0
    background transparent
    box-shadow none

  ._txLabel
    min-height 38px
    padding var(--wren-space-4) 0 var(--wren-space-2)
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 650
    letter-spacing 0
    text-transform none

  .cluster
    margin 0
    padding 0
    border 0
    border-top 0
    border-radius 0
    background transparent

    .clusterRow
      gap 0
      border-bottom 0

      &:last-child
        border-bottom 0

    .clusterRow + .clusterRow
      margin-top 0

    .clusterValue
      min-height 48px
      justify-content flex-start
      border 0
      border-radius 0
      background transparent
      text-align left

    .clusterValue + .clusterValue,
    .clusterColumn + .clusterColumn
      border-left 0

    .clusterColumn
      gap 0

      .clusterValue + .clusterValue
        border-top 0
        border-left 0

    .clusterValueClickable:not(.clusterValueDisabled):hover
      border-color transparent
      background var(--wren-ledger-hover)

    .clusterValueClickable:not(.clusterValueDisabled):active
      border-color transparent
      background var(--wren-surface-active)

  .transactionReviewOverview
    > .clusterRow:first-child + .clusterRow,
    > .transactionReviewDataRow
      border-top 1px solid rgba(43, 53, 45, .68)

  .requestItemHeader
    margin 0
    border-radius 0
    background transparent

    > .requestItemTitle
      min-height 52px
      padding var(--wren-space-3) 0
      border-bottom 0

    .requestItemTitleMain
      font-size var(--wren-type-heading)
      font-weight 650

    .requestItemDetailsSlide
      color var(--wren-text-tertiary)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)

  ._txDescription
    width 100%
    padding var(--wren-space-4) 0

    ._txDescriptionSummaryMain
      padding-top var(--wren-space-2)
      font-size var(--wren-type-title)
      font-weight 650
      line-height 30px

    ._txDescriptionSummaryTag,
    .requestItemTitleSub
      color var(--wren-text-tertiary)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)

  ._txMainTag
    width 100%
    margin 0
    padding var(--wren-space-3) 0
    border-radius 0
    background transparent
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    line-height 18px
    text-align left

  ._txMainTagGood
    color var(--wren-success)
    background transparent

  ._txMainTagWarning
    color var(--wren-warning)
    background transparent

  ._txMainTagBad
    color var(--wren-danger)
    background transparent

  .txSendingValue
    min-height 52px
    justify-content flex-start
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size 18px
    font-weight 500
    text-align left

  ._txFeeGwei
    min-height 52px
    padding var(--wren-space-3)

    ._txFeeGweiValue
      font-family var(--wren-font-utility)
      font-size 18px
      font-weight 500

    ._txFeeGweiLabel
      color var(--wren-text-tertiary)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)
      text-transform none

  .transactionReviewFeeValue .transactionReviewFeeSubline
    ._txFeeGwei
      min-height 0
      padding 0
      justify-content flex-start
      text-align left

    ._txFeeGweiValue,
    ._txFeeGweiLabel
      font-size inherit
      font-weight 400

    ._txFeeAdjustLabel
      margin-left var(--wren-space-3)
      padding var(--wren-space-1) var(--wren-space-2)
      border 1px solid var(--wren-border-default)
      border-radius var(--wren-radius-sm)
      color var(--wren-text-secondary)
      background var(--wren-control-texture-dark), var(--wren-bg-elevated)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-caption)
      font-weight 550

  .transactionDataDisclosure
    display flex
    align-items center
    justify-content space-between
    color var(--wren-text-secondary)

    span:last-child
      color var(--wren-accent-primary-hover)

  .transactionReviewAssetChanges
    margin 0
    border-top 1px solid var(--wren-ledger-rule)

    .clusterValue
      padding 0

  .transactionReviewAssetChangesInner
    width 100%
    padding var(--wren-space-3) 0

  .transactionReviewAssetChangesHeader
    display grid
    min-height 32px
    align-content start
    gap 2px

    strong
      color var(--wren-text-primary)
      font-size var(--wren-type-small)
      font-weight 620

    span
      color var(--wren-text-muted)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)

  .transactionReviewAssetChange
    display grid
    min-height 48px
    padding var(--wren-space-2) 0
    box-sizing border-box
    align-items center
    grid-template-columns minmax(0, 1fr) auto
    column-gap var(--wren-space-4)
    border-top 1px solid var(--wren-ledger-rule)

  .transactionReviewAssetChangeIdentity
    display block
    min-width 0

    strong
      display block
      overflow hidden
      color var(--wren-text-primary)
      font-size var(--wren-type-small)
      font-weight 600
      text-overflow ellipsis
      white-space nowrap

  .transactionReviewAssetChangeAmount
    display flex
    align-items baseline
    gap var(--wren-space-1)
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-small)
    font-weight 620
    text-align right

  .transactionReviewAssetChangeIncoming .transactionReviewAssetChangeAmount
    color var(--wren-success)

  .transactionReviewAssetChangeOutgoing .transactionReviewAssetChangeAmount
    color var(--wren-warning)

  .transactionReviewTokenApproval
    ._txLabel
      min-height 32px
      padding var(--wren-space-3) 0 var(--wren-space-1)

    .clusterValue
      min-height 44px

    .clusterValueContent
      width 100%

  .transactionReviewApprovalLimit,
  .transactionReviewApprovalSpender
    display grid
    width 100%
    min-height 44px
    box-sizing border-box
    grid-template-columns 96px minmax(0, 1fr)
    align-items center
    column-gap var(--wren-space-4)

  .transactionReviewApprovalLimit strong
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-small)
    font-weight 620

  .transactionReviewApprovalSpender
    .clusterAddress
      min-width 0
      padding var(--wren-space-2) 0

  .transactionReviewAssetChangesNote
    padding-top var(--wren-space-2)
    color var(--wren-warning)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

  .clusterTag,
  ._txFeeValueDefault
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    text-align left

  .clusterFocus
    width 100%
    box-sizing border-box
    text-align left

  .clusterAddress
    padding var(--wren-space-3) 0

  .clusterValueClickable .clusterAddressRecipient,
  .clusterValueClickable .clusterAddressEvidence
    color var(--wren-accent-primary-hover)

  .clusterValueClickable .clusterAddressLabel
    color var(--wren-text-primary)

  .transactionReviewMeta
    border-top 0

  .transactionReviewAddress
    position relative
    display grid
    width 100%
    min-height 56px
    box-sizing border-box
    padding 0
    border 0
    border-bottom 0
    color var(--wren-text-primary)
    background transparent
    grid-template-columns 96px minmax(0, 1fr)
    align-items center
    column-gap var(--wren-space-4)
    text-align left

  .transactionReviewAddress
    cursor pointer
    transition background var(--wren-motion-fast) var(--wren-ease)

    &:hover
      background var(--wren-ledger-hover)

    &:active
      background var(--wren-surface-active)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset -2px

  .transactionReviewAddressValue
    position relative
    min-width 0
    padding var(--wren-space-2) 0

    .clusterAddressRecipient,
    .clusterAddressRecipientLabeled
      align-items flex-start

    .clusterAddressEvidence
      color var(--wren-accent-primary-hover)

  .transactionReviewCopyFeedback
    position absolute
    top var(--wren-space-2)
    right 0
    min-width 88px
    padding-left var(--wren-space-2)
    color var(--wren-success)
    background var(--wren-bg-canvas)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    text-align right
    opacity 0
    transition opacity var(--wren-motion-fast) var(--wren-ease)

  .transactionReviewCopyFeedbackVisible
    opacity 1

  .transactionReviewMetaLabel
    color var(--wren-text-tertiary)
    font-size var(--wren-type-small)

  .transactionReviewDeployment
    display grid
    gap 0

  .transactionReviewDeploymentTitle
    padding var(--wren-space-2) 0
    color var(--wren-text-tertiary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    letter-spacing .04em
    text-transform uppercase

  .transactionReviewDeploymentRow
    display grid
    min-height 56px
    grid-template-columns 96px minmax(0, 1fr)
    align-items center
    column-gap var(--wren-space-4)

  .transactionReviewDeploymentValue
    display grid
    min-width 0
    gap var(--wren-space-1)
    padding var(--wren-space-2) 0
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-small)

  .transactionReviewDeploymentHash
    overflow-wrap anywhere
    color var(--wren-text-secondary)

  .transactionReviewDeploymentIdentity
    display grid
    min-width 0
    gap 2px

  button.transactionReviewDeploymentCopy
    display flex
    align-items center
    width fit-content
    max-width 100%
    min-height 44px
    border 0
    padding 0
    background transparent
    font inherit
    text-align left
    cursor pointer

    &:hover
      color var(--wren-text-primary)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 3px

  .transactionReviewDeploymentCopyStatus
    min-height 15px
    color var(--wren-success)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

  .transactionReviewDeploymentNote
    color var(--wren-text-tertiary)
    font-family var(--wren-font-ui)
    line-height 1.4

  .transactionNonceActions
    display flex
    gap var(--wren-space-2)

  .transactionNonceButton
    display flex
    width 32px
    height 32px
    padding 0
    align-items center
    justify-content center
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    color var(--wren-text-secondary)
    background var(--wren-control-texture-dark), var(--wren-bg-elevated)
    box-shadow var(--wren-control-shadow)
    cursor pointer

    &:hover
      border-color var(--wren-border-strong)
      background var(--wren-control-texture-dark), var(--wren-surface-hover)

    &:active
      background var(--wren-control-texture-dark), var(--wren-surface-active)
      box-shadow var(--wren-control-shadow-pressed)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

  .transactionNonceReset
    margin-left var(--wren-space-1)
    color var(--wren-accent-primary-hover)

  .transactionNonceGlyph
    position relative
    top -1px
    font-family var(--wren-font-ui)
    font-size 18px
    font-weight 650
    line-height 1

.approvePermit
  ._txBody > ._txMain:last-child
    padding-top var(--wren-space-2)

  .permitReviewLedger
    .clusterRow + .clusterRow
      border-top 1px solid rgba(43, 53, 45, .68)

    .clusterValue
      min-height 58px

  .permitReviewRow
    display grid
    width 100%
    min-height 58px
    box-sizing border-box
    padding var(--wren-space-2)
    grid-template-columns 210px minmax(0, 1fr)
    align-items center
    gap var(--wren-space-4)

  .permitReviewLabel
    color var(--wren-text-tertiary)
    font-size var(--wren-type-small)
    line-height 18px

  .permitReviewValue
    min-width 0
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-small)
    font-weight 500
    text-align right
    overflow-wrap anywhere

  .permitReviewCountdown
    min-width 0

    > div:first-child
      display none

  .clusterAddress
    min-width 0
    padding 0

    .clusterAddressRecipient,
    .clusterAddressRecipientLabeled
      justify-content flex-end
      text-align right

.approvePermitPerch
  display flex
  gap 12px
  padding 10px 24px 24px
  flex-direction column
  background transparent

  .typedDataWarnings
    margin 0

.permitOriginCard,
.permitActionCard,
.permitDetailsCard
  flex none
  box-sizing border-box
  border 1px solid var(--wren-border-default)
  border-radius 10px
  background linear-gradient(172deg, rgba(255, 255, 255, .022), transparent 46%), rgba(13, 18, 16, .72)
  box-shadow 0 10px 26px rgba(0, 0, 0, .34), inset 0 1px rgba(255, 255, 255, .035)

.permitOriginCard
  display grid
  min-height 84px
  padding 14px 20px
  grid-template-columns 50px minmax(0, 1fr) auto
  align-items center
  gap 16px

.permitOriginMark
  display grid
  width 50px
  height 50px
  place-items center
  border 1px solid var(--wren-border-default)
  border-radius 10px
  color var(--wren-text-primary)
  background rgba(51, 111, 62, .84)

.permitOriginIdentity
  min-width 0

  strong,
  span
    display block
    overflow hidden
    text-overflow ellipsis
    white-space nowrap

  strong
    color var(--wren-text-primary)
    font-size 16px
    font-weight 650

  span
    margin-top 4px
    color var(--wren-text-secondary)
    font-size 14px

.permitOriginKind
  color var(--wren-text-secondary)
  font-family var(--wren-font-utility)
  font-size 13px

.permitActionCard,
.permitDetailsCard
  padding 16px 20px

  h2
    margin 0
    color var(--wren-text-tertiary)
    font-family var(--wren-font-mono)
    font-size 12px
    font-weight 600
    letter-spacing 1.4px
    text-transform uppercase

.permitActionCard
  > strong
    display block
    margin-top 16px
    color var(--wren-text-primary)
    font-size 15px
    font-weight 620
    line-height 22px

.permitRawAction
  appearance none
  display flex
  width 100%
  min-height 66px
  margin-top 12px
  padding 12px 14px
  box-sizing border-box
  border 1px solid var(--wren-border-default)
  border-radius 9px
  color var(--wren-text-secondary)
  background rgba(18, 24, 19, .82)
  font-family var(--wren-font-mono)
  font-size 12px
  line-height 19px
  text-align left
  cursor pointer
  flex-direction column

  code
    color var(--wren-text-tertiary)
    font inherit

  &:hover
    border-color var(--wren-border-strong)
    background var(--wren-surface-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.permitDetailsCard
  dl
    margin 16px 0 0

    > div
      display grid
      min-height 44px
      padding 0
      grid-template-columns 150px minmax(0, 1fr)
      align-items center
      border-bottom 1px solid rgba(43, 53, 45, .68)

      &:last-child
        border-bottom 0

  dt
    color var(--wren-text-tertiary)
    font-size 13px

  dd
    min-width 0
    margin 0
    overflow hidden
    color var(--wren-text-primary)
