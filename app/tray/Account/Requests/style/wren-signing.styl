// Signing-critical surfaces use one continuous review canvas. Preserve the existing request and
// signer flow while removing the inherited card stack, animated split pill, and decorative chrome.
.approveTransaction
  padding 0 24px 16px
  border-radius 0
  background var(--wren-bg-canvas)

  .approveTransactionPayload,
  ._txBody
    width 100%

  ._txBody
    margin 0
    padding 0

  ._txMain
    margin 0
    overflow visible
    border 0
    border-bottom 0
    border-radius 0
    background transparent
    box-shadow none

    &:last-child
      border-bottom 0

    ._txMainInner
      overflow visible

  .requestItem,
  .requestItem:hover,
  .requestItem:active
    margin 0
    border-radius 0
    background transparent

  .requestItemBackground
    display none

  .transactionReviewMain
    .requestItem > .requestItemTitle
      display none

    .transactionReviewOverview > .clusterRow:first-child .clusterValue
      min-height 116px

    ._txDescription
      display grid
      width 100%
      min-height 116px
      padding var(--wren-space-3) 0
      box-sizing border-box
      grid-template-columns minmax(0, 1fr) minmax(176px, 224px)
      align-items center
      gap var(--wren-space-6)

    ._txDescriptionSummary
      width 100%

    ._txDescriptionSummaryMain
      padding-top var(--wren-space-2)
      min-width 0
      font-size 26px
      line-height 32px
      overflow-wrap anywhere

      > div
        display flex
        min-width 0
        align-items baseline
        flex-wrap wrap
        gap var(--wren-space-2)

      .displayValue
        font-size inherit

      ._txDescriptionTransfer
        display grid
        justify-items start
        gap 2px

      .transactionReviewAmountLine
        display flex
        min-height 32px
        align-items center
        gap 10px

        .transactionReviewAssetMark .assetMarkGlyph
          border-color transparent
          box-shadow none

      ._txDescriptionAction
        color var(--wren-accent-primary)
        font-family var(--wren-font-ui)
        font-size var(--wren-type-caption)
        font-variation-settings var(--wren-font-body-settings)
        font-weight 620
        letter-spacing .8px
        line-height 16px
        text-transform uppercase

      ._txDescriptionFiat
        display flex
        align-items baseline
        gap var(--wren-space-1)
        color var(--wren-text-secondary)
        font-family var(--wren-font-utility)
        font-size var(--wren-type-small)
        font-weight 450
        line-height 18px

    .transactionReviewSummaryStatus
      width 100%
      max-width none
      min-height 54px
      box-sizing border-box
      padding var(--wren-space-2)
      display grid
      align-content center
      grid-template-rows repeat(2, minmax(18px, auto))
      justify-self stretch
      font-family var(--wren-font-ui)
      font-size var(--wren-type-small)
      font-variation-settings var(--wren-font-body-settings)
      font-weight 540
      line-height 18px
      text-align left

      > span
        display block
        min-width 0

        &:empty
          visibility hidden

      ._txMainTagQuiet
        color var(--wren-text-muted)

    .transactionReviewStatusRow
      border-top 1px solid var(--wren-ledger-rule)

      .clusterValue
        padding 0

    ._txDescriptionSummaryTag
      display none

  .transactionReviewSectionTitle
    min-height 38px
    padding var(--wren-space-4) var(--wren-space-2) var(--wren-space-1)
    color var(--wren-text-primary)
    font-size var(--wren-type-body)
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 650

  .transactionReviewRecipient,
  .transactionReviewFee,
  .transactionReviewNonce
    margin 0

    > ._txMainInner > ._txLabel
      display none

  .transactionReviewRecipient
    .cluster
      margin 0
      padding 0

    .clusterRow:first-child .clusterValue
      display grid
      min-height 56px
      padding 0
      grid-template-columns 112px minmax(0, 1fr) auto
      align-items start
      justify-content stretch
      column-gap var(--wren-space-6)

    .transactionReviewRecipientLabel
      align-self start
      padding-top var(--wren-space-2)
      text-align left

    .transactionReviewCopyFeedback
      align-self start
      padding-top var(--wren-space-2)

    .clusterAddress
      min-width 0
      padding var(--wren-space-2) 0

    .clusterAddressRecipient,
    .clusterAddressRecipientLabeled
      align-items flex-start
      justify-content flex-start
      text-align left

    .clusterAddressEvidence
      color var(--wren-accent-primary-hover)

    .clusterRow + .clusterRow
      margin 0
      border-top 1px solid var(--wren-ledger-rule)

  .transactionReviewFeeRow,
  .transactionReviewNonceRow
    display grid
    width 100%
    min-height 62px
    box-sizing border-box
    padding var(--wren-space-3) 0
    grid-template-columns 112px minmax(0, 1fr) auto
    align-items center
    column-gap var(--wren-space-6)

  .transactionReviewNonceRow
    grid-template-columns 112px minmax(0, 1fr) auto

  .transactionReviewFeeValue,
  .transactionNonceDetails
    display flex
    min-width 0
    flex-direction column
    align-items flex-start

  .transactionReviewFeeValue
    max-width 330px

  .transactionReviewFeeTotal
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-body)
    font-weight 550

  .transactionReviewFeeSubline
    display flex
    min-width 0
    margin-top 2px
    align-items center
    gap var(--wren-space-2)
    color var(--wren-text-tertiary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

    .clusterTag,
    ._txFeeGwei
      display flex
      min-height 0
      padding 0
      color inherit
      font-size inherit
      gap 3px

    ._txFeeGweiValue,
    ._txFeeGweiLabel
      color inherit
      font-size inherit
      font-weight 400

  .transactionReviewFeeAdjust
    align-self center
    justify-self end
    min-width 88px
    height 32px

  .transactionReviewFeeNotice
    min-height 34px
    padding 8px 0 8px 136px
    border-top 1px solid var(--wren-ledger-rule)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

  .transactionReviewNonceHint
    margin-top 2px
    color var(--wren-text-tertiary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)

  .transactionNonce
    display grid
    min-width 0
    grid-column 2 / 4
    grid-template-columns minmax(0, 1fr) auto
    align-items center
    gap var(--wren-space-6)

  .transactionNonceDetails
    min-width 0

  .transactionNonceValue
    display flex
    height 20px
    align-items center
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-body)
    font-weight 550
    line-height 20px

  .transactionNonceActions
    justify-self end

  .transactionReviewNonce
    padding-bottom var(--wren-space-3)

  .transactionReviewMeta,
  .transactionReviewRecipient,
  .transactionReviewFee,
  .transactionReviewNonce
    border 0
    background transparent
    box-shadow none

  ._txLabel
    min-height 38px
    padding var(--wren-space-4) var(--wren-space-2) var(--wren-space-2)
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 650
    letter-spacing 0
    text-transform none

  .cluster
    margin 0
    padding 0
    border 0
    border-top 0
    border-radius 0
    background transparent

    .clusterRow
      gap 0
      border-bottom 0

      &:last-child
        border-bottom 0

    .clusterRow + .clusterRow
      margin-top 0

    .clusterValue
      min-height 48px
      justify-content flex-start
      border 0
      border-radius 0
      background transparent
      text-align left

    .clusterValue + .clusterValue,
    .clusterColumn + .clusterColumn
      border-left 0

    .clusterColumn
      gap 0

      .clusterValue + .clusterValue
        border-top 0
        border-left 0

    .clusterValueClickable:not(.clusterValueDisabled):hover
      border-color transparent
      background var(--wren-ledger-hover)

    .clusterValueClickable:not(.clusterValueDisabled):active
      border-color transparent
      background var(--wren-surface-active)

  .transactionReviewOverview
    > .clusterRow:first-child + .clusterRow,
    > .transactionReviewDataRow
      border-top 1px solid rgba(43, 53, 45, .68)

  .requestItemHeader
    margin 0
    border-radius 0
    background transparent

    > .requestItemTitle
      min-height 52px
      padding var(--wren-space-3) var(--wren-space-2)
      border-bottom 0

    .requestItemTitleMain
      font-size var(--wren-type-heading)
      font-weight 650

    .requestItemDetailsSlide
      color var(--wren-text-tertiary)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)

  ._txDescription
    width 100%
    padding var(--wren-space-4) var(--wren-space-2)

    ._txDescriptionSummaryMain
      padding-top var(--wren-space-2)
      font-size var(--wren-type-title)
      font-weight 650
      line-height 30px

    ._txDescriptionSummaryTag,
    .requestItemTitleSub
      color var(--wren-text-tertiary)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)

  ._txMainTag
    width 100%
    margin 0
    padding var(--wren-space-3) var(--wren-space-2)
    border-radius 0
    background transparent
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    line-height 18px
    text-align left

  ._txMainTagGood
    color var(--wren-success)
    background transparent

  ._txMainTagWarning
    color var(--wren-warning)
    background transparent

  ._txMainTagBad
    color var(--wren-danger)
    background transparent

  .txSendingValue
    min-height 52px
    justify-content flex-start
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size 18px
    font-weight 500
    text-align left

  ._txFeeGwei
    min-height 52px
    padding var(--wren-space-3)

    ._txFeeGweiValue
      font-family var(--wren-font-utility)
      font-size 18px
      font-weight 500

    ._txFeeGweiLabel
      color var(--wren-text-tertiary)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)
      text-transform none

  .transactionReviewFeeValue .transactionReviewFeeSubline
    ._txFeeGwei
      min-height 0
      padding 0
      justify-content flex-start
      text-align left

    ._txFeeGweiValue,
    ._txFeeGweiLabel
      font-size inherit
      font-weight 400

    ._txFeeAdjustLabel
      margin-left var(--wren-space-3)
      padding var(--wren-space-1) var(--wren-space-2)
      border 1px solid var(--wren-border-default)
      border-radius var(--wren-radius-sm)
      color var(--wren-text-secondary)
      background var(--wren-control-texture-dark), var(--wren-bg-elevated)
      font-family var(--wren-font-ui)
      font-size var(--wren-type-caption)
      font-weight 550

  .transactionDataDisclosure
    display flex
    align-items center
    justify-content space-between
    color var(--wren-text-secondary)

    span:last-child
      color var(--wren-accent-primary-hover)

  .clusterTag,
  ._txFeeValueDefault
    color var(--wren-text-secondary)
    font-size var(--wren-type-small)
    text-align left

  .clusterFocus
    width 100%
    box-sizing border-box
    text-align left

  .clusterAddress
    padding var(--wren-space-3) var(--wren-space-2)

  .clusterValueClickable .clusterAddressRecipient,
  .clusterValueClickable .clusterAddressEvidence
    color var(--wren-accent-primary-hover)

  .clusterValueClickable .clusterAddressLabel
    color var(--wren-text-primary)

  .transactionReviewMeta
    border-top 0

  .transactionReviewAddress
    display grid
    width 100%
    min-height 56px
    box-sizing border-box
    padding 0
    border 0
    border-bottom 0
    color var(--wren-text-primary)
    background transparent
    grid-template-columns 112px minmax(0, 1fr) auto
    align-items center
    column-gap var(--wren-space-6)
    text-align left

  .transactionReviewAddress
    cursor pointer
    transition background var(--wren-motion-fast) var(--wren-ease)

    &:hover
      background var(--wren-ledger-hover)

    &:active
      background var(--wren-surface-active)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset -2px

  .transactionReviewAddressValue
    position relative
    min-width 0
    padding var(--wren-space-2) 0

    .clusterAddressRecipient,
    .clusterAddressRecipientLabeled
      align-items flex-start

    .clusterAddressEvidence
      color var(--wren-accent-primary-hover)

  .transactionReviewCopyFeedback
    min-width 88px
    color var(--wren-success)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    text-align right
    opacity 0
    transition opacity var(--wren-motion-fast) var(--wren-ease)

  .transactionReviewCopyFeedbackVisible
    opacity 1

  .transactionReviewMetaLabel
    color var(--wren-text-tertiary)
    font-size var(--wren-type-small)

  .transactionNonceActions
    display flex
    gap var(--wren-space-2)

  .transactionNonceButton
    display flex
    width 32px
    height 32px
    padding 0
    align-items center
    justify-content center
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    color var(--wren-text-secondary)
    background var(--wren-control-texture-dark), var(--wren-bg-elevated)
    box-shadow var(--wren-control-shadow)
    cursor pointer

    &:hover
      border-color var(--wren-border-strong)
      background var(--wren-control-texture-dark), var(--wren-surface-hover)

    &:active
      background var(--wren-control-texture-dark), var(--wren-surface-active)
      box-shadow var(--wren-control-shadow-pressed)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

  .transactionNonceReset
    margin-left var(--wren-space-1)
    color var(--wren-accent-primary-hover)

  .transactionNonceGlyph
    position relative
    top -1px
    font-family var(--wren-font-ui)
    font-size 18px
    font-weight 650
    line-height 1

.approvePermit
  ._txBody > ._txMain:last-child
    padding-top var(--wren-space-2)

  .permitReviewLedger
    .clusterRow + .clusterRow
      border-top 1px solid rgba(43, 53, 45, .68)

    .clusterValue
      min-height 58px

  .permitReviewRow
    display grid
    width 100%
    min-height 58px
    box-sizing border-box
    padding var(--wren-space-2)
    grid-template-columns 210px minmax(0, 1fr)
    align-items center
    gap var(--wren-space-4)

  .permitReviewLabel
    color var(--wren-text-tertiary)
    font-size var(--wren-type-small)
    line-height 18px

  .permitReviewValue
    min-width 0
    color var(--wren-text-primary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-small)
    font-weight 500
    text-align right
    overflow-wrap anywhere

  .permitReviewCountdown
    min-width 0

    > div:first-child
      display none

  .clusterAddress
    min-width 0
    padding 0

    .clusterAddressRecipient,
    .clusterAddressRecipientLabeled
      justify-content flex-end
      text-align right

.requestNoticeTransactionReview
  height 114px
  background var(--wren-bg-subtle)

  .requestNoticeInner
    display block

.requestNoticeTransactionStatus
  background var(--wren-bg-subtle)

.requestNoticeDeclined
  height 114px
  background var(--wren-bg-subtle)

  .requestNoticeDeclinedInner
    align-items flex-start
    padding 16px 24px
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    text-align left

    strong,
    span
      display block

    strong
      color var(--wren-text-primary)
      font-size 14px
      font-weight 650
      letter-spacing 0
      text-transform none

    span
      margin-top 4px
      color var(--wren-text-muted)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)
      letter-spacing 0
      line-height 16px
      text-transform none

.requestApproveTransaction,
.requestApproveSignature,
.requestApproveLightweight
  display grid
  width 100%
  height 114px
  margin 0
  padding 16px 24px
  border 0
  border-radius 0
  background var(--wren-bg-subtle)
  box-shadow none
  grid-template-columns minmax(0, 1fr) auto
  align-items center
  gap var(--wren-space-6)
  animation 0.24s fadeUp ease-out

  .requestActionContext
    display flex
    min-width 0
    align-items center
    gap var(--wren-space-3)

  .requestActionContextIcon
    display grid
    flex 0 0 40px
    width 40px
    height 40px
    box-sizing border-box
    place-items center
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-md)
    color var(--wren-accent-primary-hover)
    background var(--wren-bg-elevated)
    line-height 0

    > svg
      display block
      flex none

  .requestActionContextIconAlert > svg
    transform translateX(2px)

  .requestActionContextCopy
    display block
    min-width 0

    strong,
    span
      display block

    strong
      color var(--wren-text-primary)
      font-size 14px
      font-weight 650

    span
      margin-top 2px
      max-width 360px
      color var(--wren-text-muted)
      font-family var(--wren-font-utility)
      font-size var(--wren-type-caption)
      line-height 16px
      white-space normal

    span.requestActionError
      color var(--wren-danger)

  .requestActionButtons
    display flex
    gap var(--wren-space-2)

  .requestDecline,
  .requestSign
    position relative
    inset auto
    flex 0 0 156px
    width 156px
    min-width 156px
    max-width 156px
    height 46px
    padding 0
    border 0
    background transparent
    text-transform none

  .requestDeclineButton,
  .requestSignButton
    position absolute
    inset 0
    padding 0 var(--wren-space-4)
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-md)
    font-size 14px
    font-weight 650
    letter-spacing 0
    white-space nowrap
    transform none
    animation none
    box-shadow var(--wren-control-shadow)
    transition background var(--wren-motion-fast) var(--wren-ease), border-color var(--wren-motion-fast) var(--wren-ease), box-shadow var(--wren-motion-fast) var(--wren-ease)

    &::before,
    &::after
      display none

  .requestDeclineButton
    color var(--wren-danger)
    background var(--wren-control-texture-dark), var(--wren-bg-elevated)

  .requestSignButton
    color var(--wren-text-inverse)
    background var(--wren-control-texture-light), var(--wren-accent-primary)
    border-color var(--wren-control-primary-border)
    box-shadow var(--wren-control-primary-shadow)

  .requestDecline:not(:disabled):hover .requestDeclineButton
    border-color var(--wren-border-strong)
    background var(--wren-control-texture-dark), var(--wren-surface-hover)
    box-shadow var(--wren-control-shadow-hover)

  .requestSign:not(:disabled):hover .requestSignButton
    border-color var(--wren-control-primary-border-hover)
    background var(--wren-control-texture-light), var(--wren-accent-primary-hover)
    box-shadow var(--wren-control-primary-shadow-hover)

  .requestDecline:not(:disabled):active .requestDeclineButton
    background var(--wren-control-texture-dark), var(--wren-surface-active)
    box-shadow var(--wren-control-shadow-pressed)

  .requestSign:not(:disabled):active .requestSignButton
    background var(--wren-control-texture-light), var(--wren-accent-primary-active)
    box-shadow var(--wren-control-primary-shadow-pressed)

  .requestDecline:focus-visible,
  .requestSign:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  .requestDecline:disabled,
  .requestSign:disabled
    opacity .55

  .requestSign:disabled .requestSignButton,
  .requestSign:disabled .requestSignButton:hover
    border-color var(--wren-control-primary-border)
    color var(--wren-text-inverse)
    background var(--wren-control-texture-light), var(--wren-accent-primary)
    box-shadow var(--wren-control-primary-shadow)

.requestNoticeApproval
  background var(--wren-bg-subtle)

  .approveTransactionWarningBody > .cluster
    margin 0
    padding var(--wren-space-3) var(--wren-space-5)
    border 0
    border-radius 0
    background transparent

  .approveTransactionWarningTitle
    min-height 40px
    height auto
    padding var(--wren-space-2)
    color var(--wren-warning)
    font-family var(--wren-font-ui)
    font-size 16px
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 650
    letter-spacing 0
    text-transform none

  .approveTransactionWarningIconRight
    display none

  .approveTransactionWarningMessage
    height auto
    min-height 54px
    padding var(--wren-space-3)
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    line-height 19px
    text-align center

  ._txActionButton
    height 44px
    margin 0
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-md)
    background var(--wren-control-texture-dark), var(--wren-bg-elevated)
    font-family var(--wren-font-ui)
    font-size 14px
    font-weight 650
    text-transform none

    &:hover
      transform none
      background var(--wren-control-texture-dark), var(--wren-surface-hover)
      box-shadow var(--wren-control-shadow-hover)

    &:active
      transform none
      background var(--wren-control-texture-dark), var(--wren-surface-active)
      box-shadow var(--wren-control-shadow-pressed)

  ._txActionButtonGood
    color var(--wren-text-inverse)
    border-color var(--wren-control-primary-border)
    background var(--wren-control-texture-light), var(--wren-accent-primary)

  ._txActionButtonBad
    color var(--wren-danger)

@media (max-width: 560px)
  .requestNoticeTransactionReview
    height 132px

  .requestApproveTransaction,
  .requestApproveSignature,
  .requestApproveLightweight
    height auto
    min-height 132px
    padding var(--wren-space-4)
    grid-template-columns 1fr
    gap var(--wren-space-3)

    .requestActionButtons
      display grid
      grid-template-columns 1fr 1fr

    .requestDecline,
    .requestSign
      width 100%
      min-width 0
      max-width none

.requestNoticeTransactionStatus
  height auto
  min-height 200px

  .requestNoticeInner
    display block
    padding 17px 24px 18px
    box-sizing border-box

.txLifecycle
  display grid
  grid-template-columns minmax(0, 1fr) minmax(330px, .85fr)
  align-items center
  gap 26px

.txLifecycleSummary
  display flex
  min-width 0
  align-items center
  gap 12px

.txLifecycleMark
  display grid
  flex 0 0 40px
  width 40px
  height 40px
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-md)
  color var(--wren-accent-primary-hover)
  background var(--wren-bg-elevated)
  place-items center
  box-sizing border-box
  line-height 0

  > svg
    display block
    flex 0 0 auto
    overflow visible

.txLifecycle-success .txLifecycleMark
  color var(--wren-success)

.txLifecycle-failure .txLifecycleMark
  color var(--wren-danger)

.txLifecycleCopy
  display block
  min-width 0

  strong,
  span
    display block

  strong
    color var(--wren-text-primary)
    font-size 14px
    font-weight 650

  span
    margin-top 3px
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    line-height 16px

.txLifecycleSteps
  display grid
  margin 0
  padding 0
  list-style none
  grid-template-columns repeat(4, minmax(0, 1fr))

.txLifecycleStep
  position relative
  min-width 0
  padding-top 15px
  color var(--wren-text-muted)
  font-family var(--wren-font-utility)
  font-size 12px
  text-align center

  &::before
    position absolute
    top 5px
    right 50%
    left -50%
    height 1px
    background var(--wren-border-default)
    content ''

  &:first-child::before
    display none

.txLifecycleStepMarker
  position absolute
  z-index 1
  top 2px
  left 50%
  width 7px
  height 7px
  margin-left -4px
  border 1px solid var(--wren-border-strong)
  border-radius 50%
  background var(--wren-bg-subtle)

.txLifecycleStep-complete,
.txLifecycleStep-current
  color var(--wren-text-secondary)

  &::before
    background var(--wren-accent-primary)

  .txLifecycleStepMarker
    border-color var(--wren-accent-primary)
    background var(--wren-accent-primary)

.txLifecycle-success
  .txLifecycleStep-complete::before,
  .txLifecycleStep-current::before
    background var(--wren-success)

  .txLifecycleStep-complete .txLifecycleStepMarker,
  .txLifecycleStep-current .txLifecycleStepMarker
    border-color var(--wren-success)
    background var(--wren-success)

.txLifecycle-failure .txLifecycleStep-current .txLifecycleStepMarker
  border-color var(--wren-danger)
  background var(--wren-danger)

.requestApproveRecoverable
  min-height 114px
  padding-top 14px
  padding-bottom 14px

  .requestActionContextCopy span
    max-width 390px

.txLifecycleEvidence
  position relative
  margin-top 16px
  padding-top 14px
  border-top 1px solid var(--wren-ledger-rule)

.txLifecycleFacts
  display grid
  margin 0
  padding 0 0 13px
  grid-template-columns repeat(4, minmax(0, 1fr))
  gap 16px

  div
    min-width 0

  dt,
  dd
    display block
    margin 0
    overflow hidden
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    text-overflow ellipsis
    white-space nowrap

  dt
    color var(--wren-text-muted)

  dd
    margin-top 4px
    color var(--wren-text-secondary)

.txLifecycleEvidence > .txProgressSuccessItemRight
  position static
  display flex
  margin 0 0 10px
  color var(--wren-text-muted)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  justify-content flex-end
  gap 4px

  .txProgressSuccessItemLabel,
  .txProgressSuccessItemValue
    font-size inherit

.txLifecycleActions
  display flex
  justify-content flex-end
  gap 8px

.txLifecycleAction,
.txLifecycleDetails button,
.txLifecycleCancelRequest
  min-height 44px
  height 44px
  padding 0 13px
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background var(--wren-control-texture-dark), var(--wren-bg-elevated)
  box-shadow var(--wren-control-shadow)
  font-family var(--wren-font-ui)
  font-size 12px
  font-weight 620

  &:hover
    color var(--wren-text-primary)
    border-color var(--wren-border-strong)
    background var(--wren-control-texture-dark), var(--wren-surface-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.txLifecycleActionBad
  color var(--wren-danger)

.txLifecycleActionGood
  color var(--wren-success)

.txLifecycleDetails
  margin-top 12px
  padding 11px 12px
  border 1px solid var(--wren-border-subtle)
  border-radius var(--wren-radius-sm)
  background var(--wren-surface-inset)

  > span
    display block
    overflow-wrap anywhere
    color var(--wren-text-secondary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    line-height 17px

  > div
    display flex
    margin-top 9px
    align-items center
    gap 8px

.txLifecycleCopyStatus
  min-height 16px
  color var(--wren-success)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)

.txLifecycleCancelRequest
  display block
  margin 12px 0 0 auto

@media (max-width: 610px)
  .txLifecycle
    grid-template-columns 1fr
    gap 14px

  .txLifecycleFacts
    grid-template-columns repeat(2, minmax(0, 1fr))

  .txLifecycleActions
    justify-content stretch

    .txLifecycleAction
      flex 1

@media (max-width: 560px)
  .approveTransaction .transactionReviewMain
    ._txDescription
      grid-template-columns minmax(0, 1fr)
      gap var(--wren-space-2)

    ._txDescriptionSummaryMain
      font-size 22px
      line-height 28px

    .transactionReviewSummaryStatus
      width 100%
      max-width none
      min-height 0
      padding 0 0 var(--wren-space-2)
      justify-self stretch


// Transaction evidence is a continuation of the review ledger, not a stack of cards.
.transactionEvidenceView
  padding 0 var(--wren-space-5) var(--wren-space-8)
  box-sizing border-box

  .txViewData
    margin 0
    padding var(--wren-space-5) 0
    border 0
    border-top 1px solid var(--wren-ledger-rule)
    border-radius 0
    background transparent
    box-shadow none

    &:first-child
      border-top 0

  .txViewDataHeader
    margin 0 0 var(--wren-space-4)
    padding 0
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 650
    letter-spacing 0
    line-height 22px
    text-align left
    text-transform none

  .simulationEffectsNotice,
  .simulationEffectsEmpty,
  .simulationEffectsTruncated
    margin 0 0 var(--wren-space-4)
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-caption)
    line-height 18px
    text-align left

  .simulationEffectsTruncated
    color var(--wren-danger)

  .accountDelegationEvidence + .accountDelegationEvidence
    margin-top var(--wren-space-5)

  .simulationEffect
    margin 0
    padding var(--wren-space-4) 0
    border-top 1px solid var(--wren-ledger-rule)
    border-radius 0
    background transparent

  .simulationEffectTitle
    margin 0 0 var(--wren-space-3)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    font-weight 650
    letter-spacing 0
    text-align left
    text-transform none

  .simpleJsonChild
    display grid
    width 100%
    margin 0
    padding var(--wren-space-3) 0
    border-top 1px solid var(--wren-ledger-rule)
    box-sizing border-box
    grid-template-columns 136px minmax(0, 1fr)
    align-items start
    column-gap var(--wren-space-5)

  .simpleJsonKey,
  .simpleJsonKeyTx
    width auto
    max-width none
    padding 0
    color var(--wren-text-secondary)
    font-family var(--wren-font-utility)
    font-size var(--wren-type-caption)
    font-weight 500
    letter-spacing 0
    line-height 18px
    text-transform none

  .simpleJsonValue
    width 100%
    max-width none
    min-width 0
    margin 0
    padding 0
    border 0
    color var(--wren-text-primary)
    font-family var(--wren-font-mono)
    font-size var(--wren-type-caption)
    font-weight 400
    line-height 18px
    overflow-wrap anywhere

  .simpleJsonStructuredValue
    margin 0
    white-space pre-wrap

@media (max-width: 560px)
  .transactionEvidenceView .simpleJsonChild
    grid-template-columns 104px minmax(0, 1fr)
