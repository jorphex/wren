.eip7702RevokeRequest
  min-height 100%
  color var(--wren-text-primary)
  background transparent

.eip7702RevokeDocument
  width 100%
  box-sizing border-box
  padding var(--wren-space-4) var(--wren-space-5) var(--wren-space-5)

.eip7702RevokeSummary
  padding 0 0 var(--wren-space-3)

  h1
    margin 0 0 var(--wren-space-2)
    font-family var(--wren-font-heading)
    font-size 20px
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 620
    line-height 1.25

  p
    margin 0
    color var(--wren-text-secondary)
    font-size 13px
    line-height 1.55
    overflow-wrap anywhere

.eip7702RevokeSection
  padding var(--wren-space-3) 0

  > h2
    margin 0 0 var(--wren-space-1)
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size 12px
    font-weight 600

.eip7702RevokeFacts
  margin 0

  > div
    display grid
    grid-template-columns var(--wren-review-label-column) minmax(0, 1fr)
    gap var(--wren-space-3)
    align-items start
    min-height 40px
    box-sizing border-box
    padding var(--wren-space-2) 0

  dt
    color var(--wren-text-secondary)
    font-size 12px
    line-height 1.45

  dd
    min-width 0
    margin 0
    font-size 13px
    line-height 1.45
    overflow-wrap anywhere

.eip7702RevokeIdentity
  dd
    display flex
    min-width 0
    flex-direction column
    gap 3px

  small
    color var(--wren-text-muted)
    font-family var(--wren-font-mono)
    font-size 12px
    overflow-wrap anywhere

.eip7702RevokeIdentityName
  font-weight 560

.eip7702RevokeIdentity .lightweightRequestCopy,
.eip7702RevokeEvidence .lightweightRequestCopy
  display flex
  width 100%
  min-height 44px
  padding var(--wren-space-1) 0
  justify-content flex-start
  border 1px solid transparent
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background transparent
  font-family var(--wren-font-mono)
  font-size 12px
  line-height 1.45
  overflow-wrap anywhere
  text-align left

  &:hover
    border-color var(--wren-border-subtle)
    background var(--wren-ledger-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  .lightweightRequestCopyValue
    min-width 0
    overflow-wrap anywhere

  .lightweightRequestCopyFeedback
    margin-left auto
    padding-left var(--wren-space-2)
    color var(--wren-success)

.eip7702RevokeEvidence
  .eip7702RevokeMono
    overflow hidden
    font-family var(--wren-font-mono)
    font-size 12px
    text-overflow ellipsis
    white-space nowrap

.eip7702RevokeEvidenceDisclosure
  box-shadow none

  .eip7702RevokeEvidenceSummary
    appearance none
    display flex
    width 100%
    min-height 48px
    padding var(--wren-space-2) 0
    box-sizing border-box
    border 0
    color var(--wren-text-primary)
    background transparent
    align-items center
    justify-content space-between
    gap var(--wren-space-3)
    cursor pointer
    text-align left

    > span:first-child
      min-width 0

    strong
      display block
      font-size 12px
      font-weight 600

    > span:last-child
      flex none
      color var(--wren-text-secondary)
      font-size 12px

      &::after
        content ' +'
        color var(--wren-accent-primary-hover)

    &:hover > span:last-child
      color var(--wren-text-primary)

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

  &.eip7702RevokeEvidenceDisclosure-open
    padding-bottom var(--wren-space-2)

    .eip7702RevokeEvidenceSummary > span:last-child::after
      content ' −'

.eip7702RevokeFee
  padding-bottom var(--wren-space-3)

.eip7702RevokeFeeRow
  display grid
  grid-template-columns var(--wren-review-label-column) minmax(0, 1fr) auto
  grid-template-rows auto auto
  align-items center
  gap 2px var(--wren-space-3)
  min-height 52px
  padding var(--wren-space-1) 0 var(--wren-space-2)

  > span:first-child
    display contents

    strong
      grid-column 1
      grid-row 1
      color var(--wren-text-tertiary)
      font-size var(--wren-type-caption)
      font-weight 400

    small
      grid-column 2
      grid-row 2
      color var(--wren-text-secondary)
      font-size var(--wren-type-caption)
      line-height 1.4

  > button
    grid-column 3
    grid-row 1 / 3
    min-height 44px

.eip7702RevokeFeeAmount
  grid-column 2
  grid-row 1
  color var(--wren-text-primary)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-body)
  font-weight 550

.eip7702RevokeFeeUpdated
  color var(--wren-success)
  font-size 12px

.eip7702RevokeFeeBody .txFeeOverlay
  margin-top var(--wren-space-2)

.eip7702RevokeFeeBody .txAdjustFeeInline
  padding-left 0

.eip7702RevokeOutcome
  display flex
  margin-top var(--wren-space-4)
  padding var(--wren-space-3)
  border-left 3px solid var(--wren-border-strong)
  color var(--wren-text-secondary)
  background var(--wren-surface-inset)
  flex-direction column
  gap var(--wren-space-1)
  font-size 12px
  line-height 1.5

  strong
    color var(--wren-text-primary)
    font-size 13px

.eip7702RevokeRequest-verified .eip7702RevokeOutcome
  border-left-color var(--wren-success)

.eip7702RevokeRequest-changed .eip7702RevokeOutcome,
.eip7702RevokeRequest-unclear .eip7702RevokeOutcome,
.eip7702RevokeRequest-unverified .eip7702RevokeOutcome,
.eip7702RevokeRequest-unavailable .eip7702RevokeOutcome
  border-left-color var(--wren-warning)

.eip7702RevokeHash
  color var(--wren-text-muted)
  font-family var(--wren-font-mono)
  font-size 12px

.eip7702RevokeRequestSummary
  padding var(--wren-space-2) var(--wren-space-3) var(--wren-space-3)
  color var(--wren-text-secondary)
  font-family var(--wren-font-ui)
  font-size 12px

  > span
    font-family var(--wren-font-mono)

.eip7702StopMonitoringDialog
  min-height 148px
  height auto

  .requestActionContext
    align-items flex-start

  .requestActionButtons
    align-items center

  .requestDecline
    flex-basis 144px
    width 144px
    min-width 144px
    max-width 144px

  .requestSign
    flex-basis 252px
    width 252px
    min-width 252px
    max-width 252px

.eip7702RevokeActionsReview
  min-height 86px
  height 86px
  grid-template-columns 1fr

  .requestActionButtons
    justify-self end

.eip7702RevokeActions
  .requestActionContextCopy strong
    white-space nowrap

  .requestDecline
    flex-basis 100px
    width 100px
    min-width 100px
    max-width 100px

  .requestSign
    flex-basis 156px
    width 156px
    min-width 156px
    max-width 156px

@media (max-width: 600px)
  .eip7702RevokeFacts > div
    grid-template-columns 1fr
    gap var(--wren-space-1)

  .eip7702RevokeSummary h1
    font-size 18px

  .eip7702RevokeFeeRow
    grid-template-columns 1fr auto

    > span:first-child
      strong
        grid-column 1

      small
        grid-column 1 / -1
        grid-row 2

    .eip7702RevokeFeeAmount
      grid-column 2

    > button
      grid-column 1 / -1
      grid-row 3
      width 100%

@media (max-width: 560px)
  .eip7702StopMonitoringDialog
    .requestDecline,
    .requestSign
      width 100%
      min-width 0
      max-width none

@media (max-height: 760px)
  .eip7702RevokeDocument
    padding-top var(--wren-space-3)

  .eip7702RevokeSection
    padding var(--wren-space-3) 0
