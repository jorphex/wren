.eip7702RevokeRequest
  min-height 100%
  color var(--wren-text-primary)
  background var(--wren-surface-card)

.eip7702RevokeDocument
  width 100%
  box-sizing border-box
  padding var(--wren-space-4) var(--wren-space-5) var(--wren-space-6)

.eip7702RevokeSummary
  padding 0 0 var(--wren-space-4)
  border-bottom 1px solid var(--wren-ledger-rule)

  h1
    margin var(--wren-space-1) 0 var(--wren-space-2)
    font-family var(--wren-font-heading)
    font-size 20px
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 620
    line-height 1.25

  p
    margin 0
    color var(--wren-text-secondary)
    font-size 13px
    line-height 1.55
    overflow-wrap anywhere

.eip7702RevokeEyebrow
  color var(--wren-accent-primary-hover)
  font-size 12px
  font-weight 600
  letter-spacing .02em

.eip7702RevokeSection
  padding var(--wren-space-4) 0
  border-bottom 1px solid var(--wren-ledger-rule)

  > h2
    margin 0 0 var(--wren-space-2)
    color var(--wren-text-secondary)
    font-family var(--wren-font-ui)
    font-size 12px
    font-weight 600

.eip7702RevokeFacts
  margin 0

  > div
    display grid
    grid-template-columns minmax(112px, .45fr) minmax(0, 1fr)
    gap var(--wren-space-3)
    align-items start
    min-height 44px
    box-sizing border-box
    padding var(--wren-space-2) 0
    border-top 1px solid var(--wren-ledger-rule)

  dt
    color var(--wren-text-secondary)
    font-size 12px
    line-height 1.45

  dd
    min-width 0
    margin 0
    font-size 13px
    line-height 1.45
    overflow-wrap anywhere

.eip7702RevokeIdentity
  dd
    display flex
    min-width 0
    flex-direction column
    gap 3px

  small
    color var(--wren-text-muted)
    font-family var(--wren-font-mono)
    font-size 12px
    overflow-wrap anywhere

.eip7702RevokeIdentityName
  font-weight 560

.eip7702RevokeIdentity .lightweightRequestCopy,
.eip7702RevokeEvidence .lightweightRequestCopy
  display flex
  width 100%
  min-height 44px
  padding var(--wren-space-2)
  justify-content flex-start
  border 1px solid transparent
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background transparent
  font-family var(--wren-font-mono)
  font-size 12px
  line-height 1.45
  overflow-wrap anywhere
  text-align left

  &:hover
    border-color var(--wren-border-subtle)
    background var(--wren-ledger-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

  .lightweightRequestCopyValue
    min-width 0
    overflow-wrap anywhere

  .lightweightRequestCopyFeedback
    margin-left auto
    padding-left var(--wren-space-2)
    color var(--wren-success)

.eip7702RevokeEvidence
  .eip7702RevokeMono
    overflow hidden
    font-family var(--wren-font-mono)
    font-size 12px
    text-overflow ellipsis
    white-space nowrap

.eip7702RevokeFee
  padding-bottom var(--wren-space-3)

.eip7702RevokeFeeRow
  display grid
  grid-template-columns minmax(0, 1fr) auto auto
  align-items center
  gap var(--wren-space-3)
  min-height 52px
  padding var(--wren-space-2) 0
  border-top 1px solid var(--wren-ledger-rule)

  > span:first-child
    display flex
    min-width 0
    flex-direction column
    gap 3px

    strong
      font-size 13px
      font-weight 560

    small
      color var(--wren-text-secondary)
      font-size 12px
      line-height 1.4

  > button
    min-height 44px

.eip7702RevokeFeeAmount
  color var(--wren-text-primary)
  font-size 13px

.eip7702RevokeFeeUpdated
  color var(--wren-success)
  font-size 12px

.eip7702RevokeFeeBody .txFeeOverlay
  margin-top var(--wren-space-2)

.eip7702RevokeOutcome
  display flex
  margin-top var(--wren-space-4)
  padding var(--wren-space-3)
  border-left 3px solid var(--wren-border-strong)
  color var(--wren-text-secondary)
  background var(--wren-surface-inset)
  flex-direction column
  gap var(--wren-space-1)
  font-size 12px
  line-height 1.5

  strong
    color var(--wren-text-primary)
    font-size 13px

.eip7702RevokeRequest-verified .eip7702RevokeOutcome
  border-left-color var(--wren-success)

.eip7702RevokeRequest-changed .eip7702RevokeOutcome,
.eip7702RevokeRequest-unclear .eip7702RevokeOutcome,
.eip7702RevokeRequest-unverified .eip7702RevokeOutcome,
.eip7702RevokeRequest-unavailable .eip7702RevokeOutcome
  border-left-color var(--wren-warning)

.eip7702RevokeHash
  color var(--wren-text-muted)
  font-family var(--wren-font-mono)
  font-size 12px

.eip7702RevokeRequestSummary
  padding var(--wren-space-2) var(--wren-space-3) var(--wren-space-3)
  color var(--wren-text-secondary)
  font-family var(--wren-font-ui)
  font-size 12px

  > span
    font-family var(--wren-font-mono)

.eip7702StopMonitoringDialog
  min-height 148px
  height auto

  .requestActionContext
    align-items flex-start

  .requestActionButtons
    align-items center

  .requestDecline
    flex-basis 144px
    width 144px
    min-width 144px
    max-width 144px

  .requestSign
    flex-basis 252px
    width 252px
    min-width 252px
    max-width 252px

@media (max-width: 620px)
  .eip7702RevokeDocument
    padding-right var(--wren-space-3)
    padding-left var(--wren-space-3)

  .eip7702RevokeFacts > div
    grid-template-columns 1fr
    gap var(--wren-space-1)

  .eip7702RevokeSummary h1
    font-size 18px

  .eip7702RevokeFeeRow
    grid-template-columns 1fr auto

    > button
      grid-column 1 / -1
      width 100%

@media (max-width: 560px)
  .eip7702StopMonitoringDialog
    .requestDecline,
    .requestSign
      width 100%
      min-width 0
      max-width none

@media (max-height: 760px)
  .eip7702RevokeDocument
    padding-top var(--wren-space-3)

  .eip7702RevokeSection
    padding var(--wren-space-3) 0
