.walletCallsSurface
  position absolute
  inset 0
  box-sizing border-box
  padding 18px 30px 24px
  overflow-y auto
  color var(--wren-text-primary)
  background transparent

  h2,
  h3,
  p
    margin 0

  h2
    margin-top 3px
    font-size 22px
    font-weight 660
    line-height 1.18

  h3
    color var(--wren-text-primary)
    font-size 13px
    font-weight 650

  button,
  input
    font-family var(--wren-font-ui)

.walletCallsEyebrow
  color var(--wren-accent-primary-hover)
  font-family var(--wren-font-utility)
  font-size 12px
  font-weight 550
  letter-spacing .03em
  text-transform uppercase

.walletCallsSummary
  display grid
  min-height 78px
  padding 2px 0 14px
  grid-template-columns minmax(0, 1fr) 220px
  gap 22px
  align-items end

  p
    margin-top 7px
    color var(--wren-text-secondary)
    font-size 13px
    line-height 1.45

.walletCallsAtomicWarning
  padding-left 17px
  border-left 1px solid var(--wren-warning)

  strong,
  span
    display block

  strong
    display flex
    color var(--wren-warning)
    font-size 13px
    font-weight 650
    align-items center
    gap 7px

  span
    margin-top 6px
    color var(--wren-text-secondary)
    font-size 12px
    line-height 1.45

.walletCallsSection
  padding 14px 0
  border-top 0

  > h3
    margin-bottom 12px

.walletCallsContext
  display grid
  grid-template-columns repeat(2, minmax(0, 1fr))
  gap 12px 22px

  div
    min-width 0

  span,
  strong
    display block

  span
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size 12px

  strong
    margin-top 5px
    overflow hidden
    color var(--wren-text-secondary)
    font-size 13px
    font-weight 570
    text-overflow ellipsis
    white-space nowrap

.walletCallsContextAccount
  grid-column 1 / -1

.walletCallsFeeSummary
  display grid
  grid-template-columns minmax(0, 1fr) auto 92px
  gap 24px
  align-items center

  > span
    color var(--wren-text-secondary)
    font-size 13px
    font-weight 570

  > div
    text-align right

    strong,
    small
      display block

    strong
      font-family var(--wren-font-utility)
      font-size 14px
      font-weight 600

    small
      margin-top 3px
      color var(--wren-text-muted)
      font-size 12px

  > button
    height 44px
    min-height 44px
    padding 0 13px
    border 1px solid var(--wren-border-default)
    border-radius var(--wren-radius-sm)
    color var(--wren-text-secondary)
    background var(--wren-control-texture-dark), var(--wren-bg-elevated)
    box-shadow var(--wren-control-shadow)
    font-size 12px
    font-weight 620

    &:not(:disabled):hover
      color var(--wren-text-primary)
      border-color var(--wren-border-strong)
      background var(--wren-control-texture-dark), var(--wren-surface-hover)

    &:not(:disabled):active
      background var(--wren-control-texture-dark), var(--wren-surface-active)
      box-shadow var(--wren-control-shadow-pressed)

    &:disabled
      opacity .48

    &:focus-visible
      outline 2px solid var(--wren-focus)
      outline-offset 2px

.walletCallsReviewActions .requestActionButtons
  margin-left auto

.walletCallsSectionHeading
  display flex
  margin-bottom 7px
  justify-content space-between
  align-items baseline
  gap 16px

  > span
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size 12px

.walletCallsSimulationState-success
  color var(--wren-success) !important

.walletCallsSimulationState-warning
  color var(--wren-warning) !important

.walletCallsSimulationState-danger
  color var(--wren-danger) !important

.walletCallsList,
.walletCallsAdjustList
  gap 0
  border-bottom 0

.walletCall
  display grid
  min-height 70px
  padding 11px 0
  border-top 0
  border-radius 0
  box-sizing border-box
  background transparent
  box-shadow none
  grid-template-columns 42px minmax(0, 1fr) 142px
  gap 13px
  align-items start

  &:hover
    background linear-gradient(90deg, transparent, rgba(255, 255, 255, .016) 10%, rgba(255, 255, 255, .016) 90%, transparent)

.walletCallsCallNumber
  padding-top 2px
  color var(--wren-text-muted)
  font-family var(--wren-font-utility)
  font-size 12px
  font-weight 550

.walletCallsCallBody
  min-width 0

.walletCallsDestination
  display block
  width 100%
  min-width 0
  padding 0
  min-height 44px
  border 0
  color inherit
  background transparent
  text-align left

  strong,
  span
    display block

  strong
    overflow hidden
    color var(--wren-text-primary)
    font-size 14px
    font-weight 640
    text-overflow ellipsis
    white-space nowrap

  span
    margin-top 4px
    overflow hidden
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size 12px
    text-overflow ellipsis
    white-space nowrap

  &:not(:disabled)
    cursor copy

  &:not(:disabled):hover span
    color var(--wren-accent-primary-hover)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 3px

.walletCallsCallEvidence
  display flex
  margin-top 7px
  color var(--wren-text-secondary)
  font-family var(--wren-font-utility)
  font-size 12px
  flex-wrap wrap
  gap 6px 14px

  button
    display inline-flex
    min-height 44px
    padding 0 8px
    border 0
    color var(--wren-text-secondary)
    background transparent
    font-family var(--wren-font-utility)
    font-size 12px
    align-items center

    &:hover
      color var(--wren-accent-primary-hover)

.walletCallsCalldata
  margin-top 10px
  padding 10px 12px
  overflow-wrap anywhere
  color var(--wren-text-tertiary)
  background var(--wren-surface-inset)
  font-family var(--wren-font-utility)
  font-size 12px
  line-height 1.5
  box-shadow inset 0 1px 2px rgba(0, 0, 0, .32)

.walletCallsCallMaximum
  padding-top 1px
  text-align right

  span,
  strong
    display block

  span
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size 12px

  strong
    margin-top 5px
    color var(--wren-text-secondary)
    font-family var(--wren-font-utility)
    font-size 12px
    font-weight 600

.walletCallsCallWarning,
.walletCallsEvidenceWarning,
.walletCallsAdjustError
  color var(--wren-warning)
  font-size 12px
  line-height 1.45

.walletCallsCallWarning
  margin-top 8px

.walletCallsTargetDelegation
  margin-top 9px
  color var(--wren-warning)
  font-family var(--wren-font-utility)
  font-size 12px
  line-height 1.45

  strong,
  span
    display block

  strong
    font-weight 620

  span
    margin-top 3px
    overflow-wrap anywhere
    color var(--wren-text-secondary)

.walletCallsTargetDelegation-danger
  color var(--wren-danger)

.walletCallsEvidenceWarning
  display flex
  padding 13px 0
  border-top 0
  align-items flex-start
  gap 9px

.walletCallsEvidenceWarning-danger
  color var(--wren-danger)

.walletCallsAdjustSummary
  min-height 108px
  padding 14px 0 18px

  h2
    margin 0

  .walletCallsAdjustControls
    display grid
    margin-top 12px
    grid-template-columns var(--wren-review-label-column) minmax(0, 1fr)
    align-items end
    gap 18px

  p
    max-width 400px
    margin-top 6px
    color var(--wren-text-secondary)
    font-size 12px
    line-height 1.5

.walletCallsAdjustTotal
  display grid
  grid-template-rows auto 44px
  row-gap 5px
  text-align left

  span,
  strong
    display block

  span
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size 12px

  strong
    display flex
    align-items center
    font-family var(--wren-font-utility)
    font-size 14px

.walletCallsAdjustNonce
  display flex
  min-width 0
  flex-direction column
  align-items stretch

  > span
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size 12px

.walletCallsNonceInput.wrenInput
  width 100%
  height 44px
  margin-top 5px
  padding 0 var(--wren-space-2)
  font-family var(--wren-font-utility)
  font-size 13px
  text-align right

.walletCallsAdjustCall
  display grid
  padding 16px 0 18px
  border-top 0
  grid-template-columns 30px minmax(0, 1fr)
  gap 12px

.walletCallsCallNumber
  display flex
  width 24px
  height 24px
  border 1px solid var(--wren-border-subtle)
  border-radius 50%
  color var(--wren-text-secondary)
  background var(--wren-surface-inset)
  align-items center
  justify-content center
  font-family var(--wren-font-utility)
  font-size 12px
  font-weight 620

.walletCallsAdjustCallHeader
  display flex
  justify-content space-between
  gap 16px

  > div:first-child
    min-width 0

    strong
      display block

    strong
      overflow hidden
      font-size 14px
      font-weight 640
      text-overflow ellipsis
      white-space nowrap

.walletCallsDestinationAddress
  margin-top 4px
  color var(--wren-text-muted)
  font-family var(--wren-font-utility)
  font-size 12px
  overflow-wrap anywhere
  white-space normal

  .clusterAddressRecipient,
  .clusterAddressRecipient span
    display inline
    margin 0
    overflow visible
    color inherit
    font-family inherit
    font-size inherit
    text-overflow clip
    white-space normal

  .clusterAddressRecipientFull
    display none

  .clusterAddressLookalikeEnd
    color var(--wren-warning)

.walletCallsAdjustFields
  display grid
  margin-top 13px
  grid-template-columns repeat(3, minmax(108px, 1fr))
  gap 10px
  align-items end

  label > span:first-child
    display block
    margin-bottom 6px
    color var(--wren-text-secondary)
    font-size 12px

  label > input,
  .walletCallsUnitInput
    display flex
    height 46px
    box-sizing border-box

  label > input
    width 100%
    height 44px
    padding 0 10px
    font-family var(--wren-font-utility)
    font-size 12px

.walletCallsUnitInput
  align-items center

  input
    min-width 0
    width 100%
    height 100%
    padding 0 5px 0 10px
    border 0
    color var(--wren-text-primary)
    background transparent
    font-family var(--wren-font-utility)
    font-size 12px

    &:focus
      outline 0

  em
    padding-right 9px
    color var(--wren-text-muted)
    font-family var(--wren-font-utility)
    font-size 12px
    font-style normal

.walletCallsAdjustError
  margin-top 12px
  color var(--wren-danger)

.walletCallsAdjustActions .walletCallsCancelButton
  color var(--wren-text-secondary)

.walletCallsSimulationAcknowledgement
  min-height 150px
  height auto

  .requestActionContext
    align-items flex-start

  .requestActionContextIcon
    margin-top 2px
    color var(--wren-warning)

  .walletCallsSimulationAcknowledgementCheck
    display flex
    margin-top 8px
    color var(--wren-text-secondary)
    align-items flex-start
    gap 7px

    input
      flex none
      margin 2px 0 0
      accent-color var(--wren-accent-primary)

    span
      margin 0
      color var(--wren-text-secondary)

  .requestDecline
    flex-basis 92px
    width 92px
    min-width 92px
    max-width 92px

  .requestSign
    flex-basis 220px
    width 220px
    min-width 220px
    max-width 220px

.walletCallsTerminalActions .requestActionContextIcon
  color var(--wren-text-muted)

@media (max-width: 610px)
  .walletCallsSurface
    padding-right 22px
    padding-left 22px

  .walletCallsSummary
    grid-template-columns minmax(0, 1fr) 205px
    gap 20px

  .walletCallsAdjustFields
    grid-template-columns repeat(2, minmax(110px, 1fr))

  .walletCallsSimulationAcknowledgement
    .requestDecline,
    .requestSign
      width 100%
      min-width 0
      max-width none
