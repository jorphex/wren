// Permission and configuration requests use a lighter evidence hierarchy than signing surfaces.
// They remain flat, explicit, and tactile without implying that Review completes the operation.
.approveRequest.lightweightRequest
  position absolute
  inset 0
  padding 74px 30px 28px
  overflow-y auto
  border 0
  border-radius 0
  color var(--wren-text-primary)
  background var(--wren-bg-canvas)
  box-shadow none

  .approveTransactionPayload
    display block
    width 100%

.lightweightRequestSummary
  display grid
  min-height 96px
  padding 2px 6px 18px
  grid-template-columns 42px minmax(0, 1fr)
  align-items start
  gap var(--wren-space-4)

  h2
    margin var(--wren-space-1) 0 0
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size 23px
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 680
    line-height 28px

  p
    max-width 560px
    margin var(--wren-space-1) 0 0
    color var(--wren-text-tertiary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-small)
    line-height 18px

.lightweightRequestSummaryIcon
  display flex
  width 36px
  height 36px
  margin-top 3px
  align-items center
  justify-content center
  color var(--wren-accent-primary-hover)

.lightweightRequestEyebrow
  color var(--wren-accent-primary-hover)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  letter-spacing .06em
  text-transform uppercase

.lightweightRequestSection
  padding 0 6px

  + .lightweightRequestSection
    margin-top 18px
    padding-top 17px
    border-top 1px solid rgba(43, 53, 45, .68)

  h3
    margin 0 0 var(--wren-space-3)
    color var(--wren-text-primary)
    font-family var(--wren-font-ui)
    font-size var(--wren-type-body)
    font-variation-settings var(--wren-font-heading-settings)
    font-weight 650
    line-height 20px

.lightweightRequestFactGrid
  display grid
  grid-template-columns 1fr
  gap 0

.lightweightRequestFact
  display grid
  min-width 0
  min-height 48px
  padding var(--wren-space-2) 0
  grid-template-columns 150px minmax(0, 1fr)
  align-items center
  gap var(--wren-space-4)

  + .lightweightRequestFact
    border-top 1px solid var(--wren-ledger-rule)

.lightweightRequestFactLabel
  display block
  color var(--wren-text-tertiary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-caption)
  line-height 17px

.lightweightRequestFactValue
  display block
  max-width 100%
  margin-top 0
  color var(--wren-text-primary)
  font-family var(--wren-font-ui)
  font-size var(--wren-type-body)
  font-weight 590
  line-height 20px
  overflow-wrap anywhere
  text-align right

.lightweightRequestFactValueTechnical
  color var(--wren-text-secondary)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  font-weight 400

.lightweightRequestCopy
  appearance none
  display grid
  grid-template-columns minmax(0, 1fr) 48px
  gap var(--wren-space-2)
  width 100%
  max-width 100%
  justify-self end
  padding 0
  border 0
  border-radius var(--wren-radius-sm)
  color var(--wren-accent-primary-hover)
  background transparent
  text-align right
  cursor pointer

  &:hover
    color var(--wren-text-primary)

  &:focus-visible
    outline 2px solid var(--wren-focus)
    outline-offset 2px

.lightweightRequestCopyValue
  min-width 0
  overflow-wrap anywhere

.lightweightRequestCopyFeedback
  color var(--wren-success)
  font-family var(--wren-font-utility)
  font-size var(--wren-type-caption)
  opacity 0
  transition opacity var(--wren-motion-fast) var(--wren-ease)

.lightweightRequestCopyFeedbackVisible
  opacity 1

.lightweightRequestPermissionList
  display grid
  gap 13px

.lightweightRequestPermission
  display grid
  grid-template-columns 24px minmax(0, 1fr)
  align-items start
  gap var(--wren-space-2)

  > svg
    margin-top 1px
    color var(--wren-accent-primary-hover)

  strong,
  span
    display block

  strong
    color var(--wren-text-secondary)
    font-size 14px
    font-weight 590
    line-height 19px

  span
    margin-top 2px
    color var(--wren-text-muted)
    font-size var(--wren-type-caption)
    line-height 17px

.lightweightRequestNote
  display grid
  margin-top 18px
  padding var(--wren-space-3)
  border 0
  border-radius var(--wren-radius-sm)
  color var(--wren-text-secondary)
  background var(--wren-surface-hover)
  grid-template-columns 19px minmax(0, 1fr)
  align-items start
  gap var(--wren-space-2)
  font-size var(--wren-type-small)
  line-height 18px

  > svg
    margin-top 1px
    color var(--wren-accent-primary-hover)

  strong
    font-weight 650

.lightweightRequestNoteWarning
  background var(--wren-warning-soft)

  > svg,
  strong
    color var(--wren-warning)

@media (max-width: 560px)
  .approveRequest.lightweightRequest
    padding-right var(--wren-space-5)
    padding-left var(--wren-space-5)

  .lightweightRequestSummary
    grid-template-columns 34px minmax(0, 1fr)
    gap var(--wren-space-3)

    h2
      font-size 22px
      line-height 27px

  .lightweightRequestSummaryIcon
    width 30px
    height 30px

    svg
      width 24px
      height 24px

  .lightweightRequestFactGrid
    gap 0

  .lightweightRequestFact
    grid-template-columns 1fr
    gap 2px

  .lightweightRequestCopy
    text-align left

  .lightweightRequestFactValue
    text-align left

  .lightweightRequestNote
    margin-top var(--wren-space-4)
