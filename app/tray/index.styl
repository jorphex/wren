html, body
  margin 0
  width 100%
  height 100%
  border 0
  box-sizing border-box
  font-family 'MainFont'
  font-weight 300
  -webkit-app-region no-drag
  overflow hidden
  color var(--outerspace)
  background transparent

body
  position relative
  border 0
  border-radius var(--wren-radius-xl)

.frameOverlay
  display none

body::before
  content ''
  position fixed
  top 0
  right 0
  bottom 0
  width 620px
  max-width 100%
  border-radius var(--wren-radius-xl)
  background var(--wren-bg-canvas)
  box-shadow var(--wren-shadow-lg), var(--wren-shadow-inset)
  pointer-events none

.workspace-edge-left::before
  right auto
  left 0

body::before
  transition width var(--wren-motion-standard) var(--wren-ease)

.workspace-joined::before,
.workspace-open::before
  width 100%

div
  user-select none
  cursor default

::-webkit-scrollbar
  width 6px
  height 6px
  background transparent

::-webkit-scrollbar-track
  background transparent

::-webkit-scrollbar-thumb
  border 2px solid transparent
  border-radius 2px
  background-color var(--wren-text-muted)
  background-clip content-box

::-webkit-scrollbar-thumb:hover
  border-width 1px
  background-color var(--wren-text-tertiary)

.clip
  *
    transition none !important

#panel
  // background rgba(228, 232, 248, 1)
  margin 0px
  // border-radius 12px
  // box-shadow 0px 1px 5px 1px rgba(33, 45, 46, 0.1), 0px 0px 0px 1px rgba(110, 120, 140, 0.2)
  overflow hidden
  border 0
  box-sizing border-box

  #bar
    right 360px

  #bot
    left 5px
    right 360px

  #drop
    left 5px
    bottom 5px
    right 360px
    border-radius 3px

  #views
    right 360px
    bottom 5px
    left 5px
    border-bottom-right-radius 3px
    border-bottom-left-radius 3px

    .screen
      z-index 20000

.session
  position fixed
  top 0px
  right 15px
  height 37px
  font-weight 400
  border-bottom-left-radius 4px
  display flex
  justify-content center
  align-items center
  user-select none
  cursor default
  font-size 14px
  transition var(--standard)
  z-index 1000

.hidden
  visibility hidden
  
@import './style'

// Wren wallet shell
#panel
  width 620px
  max-width 100vw
  left auto
  right 0
  border 0
  border-radius var(--wren-radius-xl)
  color var(--wren-text-primary)
  background var(--wren-bg-canvas)
  box-shadow none

.workspace-edge-left #panel
  left 0
  right auto

.workspace-joined.workspace-edge-right #panel,
.workspace-open.workspace-edge-right #panel
  border-top-left-radius 0
  border-bottom-left-radius 0

.workspace-joined.workspace-edge-left #panel,
.workspace-open.workspace-edge-left #panel
  border-top-right-radius 0
  border-bottom-right-radius 0

.backdrop,
.overlay
  right 0
  left 0
  border 0
  border-radius 0
  background transparent
  box-shadow none

.overlayMonitor::before
  display none

.cardShow
  animation-duration var(--wren-motion-slow)
  animation-timing-function var(--wren-ease)

@import '../../resources/Components/Button'
@import '../../resources/Components/Input'
