html, body
  margin 0
  border 0
  font-family 'MainFont'
  font-weight 300
  -webkit-app-region no-drag
  overflow hidden
  color var(--outerspace)
  background-color var(--wren-bg-canvas)
  background-image radial-gradient(circle at 12% 8%, rgba(208, 168, 94, 0.025), transparent 34%), radial-gradient(circle at 88% 92%, rgba(127, 170, 188, 0.018), transparent 30%)

div
  user-select none
  cursor default

::-webkit-scrollbar
  width 0px
  background transparent

.clip
  *
    transition none !important

#panel
  // background rgba(228, 232, 248, 1)
  margin 0px
  // border-radius 12px
  // box-shadow 0px 1px 5px 1px rgba(33, 45, 46, 0.1), 0px 0px 0px 1px rgba(110, 120, 140, 0.2)
  overflow hidden
  border 1px solid var(--wren-border-subtle)
  box-sizing border-box

  #bar
    right 360px

  #bot
    left 5px
    right 360px

  #drop
    left 5px
    bottom 5px
    right 360px
    border-radius 3px

  #views
    right 360px
    bottom 5px
    left 5px
    border-bottom-right-radius 3px
    border-bottom-left-radius 3px

    .screen
      z-index 20000

.session
  position fixed
  top 0px
  right 15px
  height 37px
  font-weight 400
  border-bottom-left-radius 4px
  display flex
  justify-content center
  align-items center
  user-select none
  cursor default
  font-size 14px
  transition var(--standard)
  z-index 1000

.hidden
  visibility hidden
  
@import './style'

// Wren wallet shell
#panel
  width 760px
  max-width 100vw
  left auto
  right 0
  border 1px solid var(--wren-border-default)
  border-radius var(--wren-radius-xl)
  color var(--wren-text-primary)
  background var(--wren-bg-canvas)
  box-shadow var(--wren-shadow-lg), var(--wren-shadow-inset)

.workspace-edge-left #panel
  left 0
  right auto

.workspace-joined.workspace-edge-right #panel
  border-left 0
  border-top-left-radius 0
  border-bottom-left-radius 0

.workspace-joined.workspace-edge-left #panel
  border-right 0
  border-top-right-radius 0
  border-bottom-right-radius 0

.backdrop,
.overlay
  right 0
  left 0
  border 0
  border-radius 0
  background transparent
  box-shadow none

.overlayMonitor::before
  display none

.cardShow
  animation-duration var(--wren-motion-slow)
  animation-timing-function var(--wren-ease)
